@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject ReaderSettingsService ReaderSettings
@inject II18nService I18n

<div class="@ViewportClass"
     tabindex="0" @ref="_viewportElement" @onkeydown="HandleKeyDownAsync" @onkeydown:preventDefault="true">
    @if (_realisticPreparing)
    {
        <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Reading" Text="@I18n.T("pdfReader.preparing")" />
    }
    <div id="@_elementId" class="pdf-reader-frame @(_realisticPreparing ? "pdf-reader-frame--hidden" : "")"></div>
</div>
<div class="@NavClass">
    <button type="button" class="btn" @onclick="PrevAsync">@I18n.T("pdfReader.previous")</button>
    <span>
        @I18n.T("pdfReader.pageLabel")
        <input type="number" min="1" max="@_pageCount" value="@_currentPage" @onchange="OnPageInputChangedAsync" />
        / @_pageCount
    </span>
    <span class="pdf-reader-zoom">
        <button type="button" class="btn" @onclick="DecreaseZoomAsync" disabled="@(_zoom <= MinZoom)" aria-label="@I18n.T("pdfReader.zoomOut")">−</button>
        <button type="button" class="btn pdf-reader-zoom-reset" @onclick="ResetZoomAsync" title="@I18n.T("pdfReader.zoomReset")">@((_zoom * 100).ToString("F0"))%</button>
        <button type="button" class="btn" @onclick="IncreaseZoomAsync" disabled="@(_zoom >= MaxZoom)" aria-label="@I18n.T("pdfReader.zoomIn")">+</button>
    </span>
    <button type="button" class="btn" @onclick="NextAsync">@I18n.T("pdfReader.next")</button>
</div>
