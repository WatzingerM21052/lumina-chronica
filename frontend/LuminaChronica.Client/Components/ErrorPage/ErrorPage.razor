@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject II18nService I18n

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent>
        <div class="error-state">
            <p class="error-state-message">@(Message ?? I18n.T("errorPage.defaultMessage"))</p>
            <button class="btn btn-primary" @onclick="Reset">@I18n.T("errorMessage.retryButton")</button>
        </div>
    </ErrorContent>
</ErrorBoundary>
