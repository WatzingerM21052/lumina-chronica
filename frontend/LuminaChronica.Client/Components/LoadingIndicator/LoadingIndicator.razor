@namespace LuminaChronica.Client.Components

<div class="loading-indicator @ModeClass" data-loading-type="@TypeAttribute" role="status" aria-live="polite" aria-busy="true">
    @if (IllustrationPath is not null)
    {
        <img src="@IllustrationPath" alt="" class="loading-illustration" />
    }
    else
    {
        <svg class="loading-progress">
            <circle r="40%" cx="50%" cy="50%" />
            <circle r="40%" cx="50%" cy="50%" />
        </svg>
    }
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <div class="loading-progress-text">@Text</div>
    }
</div>
