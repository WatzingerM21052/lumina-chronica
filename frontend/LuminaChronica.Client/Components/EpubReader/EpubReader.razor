@namespace LuminaChronica.Client.Components
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div id="@_elementId" class="@FrameClass"></div>
<div class="epub-reader-nav">
    <button type="button" class="btn" @onclick="PrevAsync">◀ Zurück</button>
    <span class="epub-reader-progress">@_lastPercentage.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%</span>
    <button type="button" class="btn" @onclick="NextAsync">Weiter ▶</button>
</div>
