@namespace LuminaChronica.Client.Components
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="@ViewportClass">
    <div id="@_elementId" class="@FrameClass" tabindex="0" @ref="_frameElement" @onkeydown="HandleKeyDownAsync" @onkeydown:preventDefault="true"></div>
    @* The inner div (StPageFlip's actual container) deliberately has no Razor-bound
       attributes -- StPageFlip mutates its classList directly (adds "stf__parent"
       etc.), and a Blazor-owned class/style binding on the same element would get
       re-diffed and clobber that on the next render, the same class of bug found
       and fixed on PdfReader.razor's realistic-mode container (see pdfReader.js's
       initRealisticView comment). Only the *outer* wrapper's show/hide class is
       Razor-bound; JS never touches that element. *@
    <div class="epub-reader-frame--realistic @(ReaderMode == "realistic" ? "is-active" : "")">
        <div id="@_realisticElementId"></div>
    </div>
</div>
<div class="epub-reader-nav">
    @if (ReaderMode != "scroll")
    {
        <button type="button" class="btn" @onclick="PrevAsync">◀ Zurück</button>
    }
    @if (_toc.Count > 0)
    {
        <div class="epub-toc-menu">
            <button type="button" class="btn" @onclick="ToggleTocMenu">📑 Inhaltsverzeichnis</button>
            @if (_tocMenuOpen)
            {
                <div class="epub-toc-popover">
                    @foreach (var item in _toc)
                    {
                        <button type="button" class="epub-toc-item" style="padding-left: @(1 + item.Level * 1.25)rem" @onclick="() => GoToTocItemAsync(item.Href)">@item.Label</button>
                    }
                </div>
            }
        </div>
    }
    <span class="epub-reader-progress">@_lastPercentage.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%</span>
    @if (ReaderMode != "scroll")
    {
        <button type="button" class="btn" @onclick="NextAsync">Weiter ▶</button>
    }
</div>
