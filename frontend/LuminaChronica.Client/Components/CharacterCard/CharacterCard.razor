@namespace LuminaChronica.Client.Components
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService

<a class="project-card" href="@($"projects/{Character.ProjectId}/characters/{Character.Id}")">
    <div class="project-card-cover">
        @if (_imageObjectUrl is not null)
        {
            <img src="@_imageObjectUrl" alt="@Character.Name" />
        }
        else
        {
            <div class="project-card-cover-placeholder project-card-initials" aria-hidden="true">@CardInitials.Of(Character.Name)</div>
        }
    </div>
    <div class="project-card-info">
        <div class="project-card-title">@Character.Name</div>
        @if (!string.IsNullOrWhiteSpace(Character.Origin))
        {
            <div class="project-card-type">@Character.Origin</div>
        }
    </div>
</a>
