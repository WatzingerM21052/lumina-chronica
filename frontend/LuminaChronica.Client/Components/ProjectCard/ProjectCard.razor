@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject II18nService I18n

@* A project: its cover (or initials) as a wide picture, the title, the
   kind as a chip and two lines of the description. *@
<a class="entity-card entity-card--project" href="@($"projects/{Project.Id}")">
    <span class="entity-card-media">
        @if (_coverObjectUrl is not null)
        {
            <img src="@_coverObjectUrl" alt="" />
        }
        else
        {
            <span class="entity-card-initials" aria-hidden="true">@CardInitials.Of(Project.Title)</span>
        }
    </span>
    <span class="entity-card-body">
        <span class="entity-card-title">@Project.Title</span>
        <span class="entity-card-chip">@ProjectTypeLabel.For(Project.Type, I18n)</span>
        @if (TextExcerpt.Of(Project.Description) is { } excerpt)
        {
            <span class="entity-card-excerpt">@excerpt</span>
        }
    </span>
</a>
