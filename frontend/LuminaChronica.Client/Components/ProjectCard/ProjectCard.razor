@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject II18nService I18n

<a class="project-card" href="@($"projects/{Project.Id}")">
    <div class="project-card-cover">
        @if (_coverObjectUrl is not null)
        {
            <img src="@_coverObjectUrl" alt="@Project.Title" />
        }
        else
        {
            <div class="project-card-cover-placeholder project-card-initials" aria-hidden="true">@CardInitials.Of(Project.Title)</div>
        }
    </div>
    <div class="project-card-info">
        <div class="project-card-title">@Project.Title</div>
        <div class="project-card-type">@ProjectTypeLabel.For(Project.Type, I18n)</div>
    </div>
</a>
