@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient Api
@inject II18nService I18n

@* Silent while the backend answers: "Backend: online" is a developer
   signal, not something a reader needs on the home page. Only an
   unreachable backend is worth telling the user about. *@
@if (_failed)
{
    <p class="status-error" role="alert">
        @I18n.T("statusWidget.unreachable")@(_errorMessage is not null ? $" ({_errorMessage})" : "")
    </p>
}

@code {
    private bool _failed;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var response = await Api.GetAsync<StatusResult>("/api/status");
        if (response is not { Success: true, Data: not null })
        {
            _failed = true;
            _errorMessage = response?.Error?.Message;
        }
    }
}
