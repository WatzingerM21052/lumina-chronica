@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services

<Dialog @ref="_dialog" IsOpen="IsOpen" Title="@DialogTitle" Size="DialogSize.Small"
        CloseOnOverlayClick="CanDismissFromCurrentStep" CloseOnEscape="CanDismissFromCurrentStep"
        OnClose="CloseAsync">
    <ChildContent>
        @if (_step != PasswordResetStep.Success && _hasCodeStep)
        {
            <div class="password-reset-steps" aria-hidden="true">
                <span class="password-reset-step @(_step >= PasswordResetStep.Identify ? "is-active" : "")">@I18n.T("passwordReset.stepIdentify")</span>
                <span class="password-reset-step-divider"></span>
                <span class="password-reset-step @(_step >= PasswordResetStep.CodeEntry ? "is-active" : "")">@I18n.T("passwordReset.stepCode")</span>
                <span class="password-reset-step-divider"></span>
                <span class="password-reset-step @(_step >= PasswordResetStep.PasswordEntry ? "is-active" : "")">@I18n.T("passwordReset.stepPassword")</span>
            </div>
        }

        @* Keyed on the step, so every step change mounts a fresh panel and its
           enter animation replays (§7.3 motion) -- and so each step's inputs
           are always new elements, never patched leftovers of the last step. *@
        <div class="password-reset-panel @(_steppedBack ? "is-back" : "")" @key="_step">
        @if (_step == PasswordResetStep.Identify)
        {
            @if (_requestError is not null)
            {
                <p class="form-error">@_requestError</p>
            }
            <div class="form-group">
                <label for="passwordResetIdentifier">@I18n.T("passwordReset.identifierLabel")</label>
                <input id="passwordResetIdentifier" @bind="_identifier" @bind:event="oninput" @onkeydown="HandleIdentifierKeyDownAsync" />
            </div>
        }
        else if (_step == PasswordResetStep.CodeEntry)
        {
            <p class="text-muted">@CodeIntroText()</p>

            @if (_requestError is not null)
            {
                <p class="form-error">@_requestError</p>
            }

            @if (_codeState == CodeCheckState.Burned)
            {
                <p class="form-error">@I18n.T("passwordReset.codeBurnedMessage")</p>
                <button type="button" class="btn btn-primary" @onclick="RequestNewCodeAsync">@I18n.T("passwordReset.requestNewCodeButton")</button>
            }
            else
            {
                <div class="form-group">
                    <label for="passwordResetCode">@I18n.T("passwordReset.codeLabel")</label>
                    <input id="passwordResetCode" class="password-reset-code-input @(_codeState switch { CodeCheckState.Invalid => "is-invalid", CodeCheckState.Valid => "is-valid", _ => "" })"
                           inputmode="numeric" autocomplete="one-time-code" maxlength="7" pattern="[0-9 ]*"
                           @oninput="OnCodeInputAsync" />
                    @if (_codeState == CodeCheckState.Checking)
                    {
                        <span class="password-reset-code-spinner" aria-hidden="true"></span>
                    }
                    <p class="password-reset-code-message" aria-live="polite">
                        @if (_codeState == CodeCheckState.Invalid)
                        {
                            <span class="form-error">@I18n.T("passwordReset.codeInvalid")</span>
                            @if (_attemptsLeft is >= 0 and <= 3)
                            {
                                <span class="password-reset-attempts-left">@string.Format(I18n.T("passwordReset.attemptsLeft"), _attemptsLeft)</span>
                            }
                        }
                        else if (_codeState == CodeCheckState.Valid)
                        {
                            <span class="form-success">@I18n.T("passwordReset.codeConfirmedAnnouncement")</span>
                        }
                    </p>
                </div>

                <p class="password-reset-resend">
                    @I18n.T("passwordReset.resendPrompt")
                    @if (_resendSecondsRemaining > 0)
                    {
                        <span class="text-muted">@string.Format(I18n.T("passwordReset.resendCooldown"), _resendSecondsRemaining)</span>
                    }
                    else
                    {
                        <button type="button" class="link-button" @onclick="ResendAsync">@I18n.T("passwordReset.resendButton")</button>
                    }
                </p>

                <p class="text-muted"><button type="button" class="link-button" @onclick="ChangeIdentifierAsync">@I18n.T("passwordReset.changeIdentifierLink")</button></p>
            }
        }
        else if (_step == PasswordResetStep.PasswordEntry)
        {
            @if (_resetError is not null)
            {
                <p class="form-error">@_resetError</p>
            }

            <div class="form-group">
                <label for="passwordResetNewPassword">@I18n.T("passwordReset.newPasswordLabel")</label>
                <input id="passwordResetNewPassword" type="password" value="@_newPassword" @oninput="OnNewPasswordInput" />
            </div>

            <ul class="password-reset-rule-list">
                <li class="@(_newPassword.Length >= MinPasswordLength ? "is-met" : "")">@I18n.T("passwordReset.passwordTooShort")</li>
            </ul>

            <div class="form-group">
                <label for="passwordResetConfirmPassword">@I18n.T("passwordReset.confirmPasswordLabel")</label>
                <input id="passwordResetConfirmPassword" type="password" value="@_confirmPassword"
                       @oninput="OnConfirmPasswordInputAsync" @onblur="OnConfirmPasswordBlur" @onkeydown="HandlePasswordKeyDownAsync" />
            </div>
            <p aria-live="polite">
                @if (PasswordsMatch)
                {
                    <span class="form-success">@I18n.T("passwordReset.passwordsMatch")</span>
                }
                else if (ShowConfirmMismatch)
                {
                    <span class="form-error">@I18n.T("passwordReset.passwordsMismatch")</span>
                }
            </p>
        }
        else
        {
            <div class="password-reset-success">
                <span class="password-reset-success-check" aria-hidden="true">✓</span>
                <p>@I18n.T("passwordReset.successMessage")</p>
                <p class="text-muted">@SuccessEmailNote()</p>
            </div>
        }
        </div>
    </ChildContent>
    <Footer>
        @if (_step == PasswordResetStep.Identify)
        {
            <button type="button" class="btn btn-primary" disabled="@_isSubmittingIdentify" @onclick="SubmitIdentifyAsync">
                @(_isSubmittingIdentify ? I18n.T("passwordReset.identifySubmitting") : I18n.T("passwordReset.identifySubmitButton"))
            </button>
        }
        else if (_step == PasswordResetStep.PasswordEntry)
        {
            <button type="button" class="btn btn-primary" disabled="@(!CanSubmitPassword || _isSubmittingReset)" @onclick="SubmitPasswordAsync">
                @(_isSubmittingReset ? I18n.T("passwordReset.submitting") : I18n.T("passwordReset.submitButton"))
            </button>
        }
        else if (_step == PasswordResetStep.Success)
        {
            <button type="button" class="btn btn-primary" @onclick="CloseAsync">@I18n.T("passwordReset.successContinueButton")</button>
        }
    </Footer>
</Dialog>
