@namespace LuminaChronica.Client.Components
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject LuminaChronica.Client.Services.II18nService I18n

<a class="project-card project-card--landscape" href="@($"projects/{Location.ProjectId}/locations/{Location.Id}")">
    <div class="project-card-cover">
        @if (_imageObjectUrl is not null)
        {
            <img src="@_imageObjectUrl" alt="@Location.Name" />
        }
        else
        {
            <div class="project-card-cover-placeholder project-card-initials" aria-hidden="true">@CardInitials.Of(Location.Name)</div>
        }
    </div>
    <div class="project-card-info">
        <div class="project-card-title">@Location.Name</div>
        <div class="project-card-type">@(Location.X is not null ? I18n.T("locationDetail.placedOnMap") : I18n.T("locationDetail.notPlacedOnMap"))</div>
    </div>
</a>
