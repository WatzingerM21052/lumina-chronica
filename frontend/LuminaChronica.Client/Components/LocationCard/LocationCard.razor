@namespace LuminaChronica.Client.Components
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject LuminaChronica.Client.Services.II18nService I18n

@* A place: a landscape picture (or its initials), the name, whether it is
   on the map, and two lines of its description. *@
<a class="entity-card entity-card--location" href="@($"projects/{Location.ProjectId}/locations/{Location.Id}")">
    <span class="entity-card-media">
        @if (_imageObjectUrl is not null)
        {
            <img src="@_imageObjectUrl" alt="" />
        }
        else
        {
            <span class="entity-card-initials" aria-hidden="true">@CardInitials.Of(Location.Name)</span>
        }
    </span>
    <span class="entity-card-body">
        <span class="entity-card-title">@Location.Name</span>
        <span class="entity-card-chip @(Location.X is not null ? "entity-card-chip--on" : null)">
            @(Location.X is not null ? I18n.T("locationDetail.placedOnMap") : I18n.T("locationDetail.notPlacedOnMap"))
        </span>
        @if (TextExcerpt.Of(Location.Description) is { } excerpt)
        {
            <span class="entity-card-excerpt">@excerpt</span>
        }
    </span>
</a>
