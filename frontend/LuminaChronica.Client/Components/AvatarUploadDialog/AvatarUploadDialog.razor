@namespace LuminaChronica.Client.Components
@using Microsoft.AspNetCore.Components.Forms
@using LuminaChronica.Client.Models

<Dialog IsOpen="IsOpen" Title="@I18n.T("avatarUploadDialog.title")" ShowCloseButton="false" OnClose="CancelAsync">
    <ChildContent>
        @if (_errorMessage is not null)
        {
            <p class="form-error">@_errorMessage</p>
        }

        <div class="dropzone @(_previewUrl is not null ? "dropzone--filled" : "") @(_isDragging ? "dropzone--active" : "")"
             @ondragenter="() => _isDragging = true" @ondragleave="() => _isDragging = false"
             @ondragover:preventDefault @ondrop="() => _isDragging = false">
            <InputFile id="avatarDialogInput" OnChange="OnFileSelectedAsync" />
            @if (_previewUrl is { } previewUrl)
            {
                <img src="@previewUrl" alt="" class="avatar-upload-dialog-preview" />
            }
            else
            {
                <span class="dropzone-label">@I18n.T("avatarUploadDialog.dropzoneLabel")</span>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="CancelAsync">@I18n.T("avatarUploadDialog.cancelButton")</button>
        <button type="button" id="avatarDialogUpload" class="btn btn-primary"
                disabled="@(_selectedBytes is null || _uploadState != ButtonBusyState.Idle)"
                style="min-width: @(AsyncButtonContent.MinWidthCh(I18n.T("avatarUploadDialog.uploadButton"), null, I18n.T("avatarUploadDialog.uploadSuccess")))ch"
                @onclick="UploadAsync">
            <AsyncButtonContent State="_uploadState" IdleText="@I18n.T("avatarUploadDialog.uploadButton")" SuccessText="@I18n.T("avatarUploadDialog.uploadSuccess")" />
        </button>
    </Footer>
</Dialog>
