@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject II18nService I18n

<Dialog IsOpen="IsOpen" Title="@Title" OnClose="() => OnClose.InvokeAsync()">
    <ChildContent>
        @if (_isLoading && _items is null)
        {
            <p class="text-muted">@I18n.T("followListDialog.loading")</p>
        }
        else if (_items is { Count: 0 })
        {
            <p class="text-muted">@EmptyText</p>
        }
        else if (_items is not null)
        {
            <ul class="follow-list-dialog-items">
                @foreach (var item in _items)
                {
                    <li class="follow-list-dialog-row">
                        <a href="@($"u/{item.Username}")" class="follow-list-dialog-user" @onclick="() => OnClose.InvokeAsync()">
                            @if (item.AvatarUrl is { } avatarUrl)
                            {
                                <img src="@avatarUrl" alt="" class="follow-list-dialog-avatar" />
                            }
                            else
                            {
                                <div class="follow-list-dialog-avatar follow-list-dialog-avatar-placeholder" aria-hidden="true">
                                    <Icon Name="person" Class="follow-list-dialog-avatar-placeholder-icon" />
                                </div>
                            }
                            <span>@item.Username</span>
                        </a>
                        @if (item.IsFollowing is { } isFollowing)
                        {
                            <button type="button" class="btn-follow @(isFollowing ? "is-following" : "")"
                                    disabled="@(_togglingUsername == item.Username)"
                                    @onclick="() => ToggleFollowAsync(item)">
                                @(isFollowing ? I18n.T("followListDialog.following") : I18n.T("followListDialog.follow"))
                            </button>
                        }
                    </li>
                }
            </ul>

            @if (_items.Count < _total)
            {
                <div class="follow-list-dialog-load-more">
                    <button type="button" class="btn" disabled="@_isLoading" @onclick="LoadMoreAsync">@I18n.T("followListDialog.loadMore")</button>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => OnClose.InvokeAsync()">@I18n.T("followListDialog.closeButton")</button>
    </Footer>
</Dialog>
