@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject NavigationManager NavigationManager
@inject II18nService I18n

<Dialog IsOpen="IsOpen" Title="@I18n.T("addBookChooser.title")" OnClose="() => OnClose.InvokeAsync()">
    <ChildContent>
        <div class="add-book-chooser-options">
            <button type="button" class="add-book-chooser-option" @onclick="GoToUpload">
                <Icon Name="document" Class="add-book-chooser-option-icon" />
                <span>
                    <strong>@I18n.T("addBookChooser.fileOptionLabel")</strong>
                    <span class="text-muted">@I18n.T("addBookChooser.fileOptionDescription")</span>
                </span>
            </button>
            <button type="button" class="add-book-chooser-option" @onclick="GoToUpload">
                <Icon Name="search" Class="add-book-chooser-option-icon" />
                <span>
                    <strong>@I18n.T("addBookChooser.isbnOptionLabel")</strong>
                    <span class="text-muted">@I18n.T("addBookChooser.isbnOptionDescription")</span>
                </span>
            </button>
            <button type="button" class="add-book-chooser-option" @onclick="GoToUpload">
                <Icon Name="book" Class="add-book-chooser-option-icon" />
                <span>
                    <strong>@I18n.T("addBookChooser.manualOptionLabel")</strong>
                    <span class="text-muted">@I18n.T("addBookChooser.manualOptionDescription")</span>
                </span>
            </button>
        </div>
    </ChildContent>
</Dialog>
