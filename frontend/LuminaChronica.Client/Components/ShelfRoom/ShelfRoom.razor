@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject II18nService I18n

@* Shelf style C "3D-Raum" (spec 2026-10-11 §6, polish 2026-10-12): a WebGL
   cabinet (js/shelfRoom.js) that stands on the page like any other
   element -- no frame, transparent around it, scrolling 1:1 with the page.
   A click takes the book out (OnOpen → BookSpread). The scene is
   decoration for pointer users; the list of links is what keyboards and
   screen readers use. Without WebGL the classic shelf stands in. *@
@if (_fallback)
{
    <p class="shelf-room-fallback text-muted">@I18n.T("shelfRoom.noWebGl")</p>
    <ClassicShelf Sections="Sections" Zoom="Zoom" ShowCoverText="ShowCoverText" OnOpen="OnOpen" />
}
else
{
    <div class="shelf-room" @ref="_containerRef">
        <div class="shelf-room-stage" aria-hidden="true"></div>
        @* The scene reads the theme's pictures from these. *@
        <span class="shelf-decor shelf-decor--left shelf-room-probe" aria-hidden="true"></span>
        <span class="shelf-decor shelf-decor--right shelf-room-probe" aria-hidden="true"></span>
        <span class="shelf-object shelf-object--1 shelf-room-probe" aria-hidden="true"></span>
        <span class="shelf-object shelf-object--2 shelf-room-probe" aria-hidden="true"></span>
        <span class="shelf-object shelf-object--3 shelf-room-probe" aria-hidden="true"></span>
        <nav class="shelf-room-index" aria-label="@I18n.T("shelfRoom.indexLabel")">
            @foreach (var bay in Sections)
            {
                <h3 class="shelf-room-index-heading">@bay.Label</h3>
                <ul>
                    @foreach (var book in bay.Books)
                    {
                        <li @key="(bay.Label, book.Id)">
                            <a href="library/books/@book.Id" data-book-id="@book.Id" @onfocus="() => FocusAsync(book)"
                               @onclick="() => PickAsync(book)" @onclick:preventDefault="true">@Label(book)</a>
                        </li>
                    }
                </ul>
            }
        </nav>
    </div>
}
