@namespace LuminaChronica.Client.Components

@* Detail pages in the themed worlds (Babylon, Alexandria): the entry's own
   picture -- a book's cover, a project's, a character's portrait -- across
   the full width behind the top of the page, heavily blurred and tinted in
   the theme's colours, fading into the page. The page's own header (cover,
   title, actions) stays as it is and sits on it as a card. Without a
   picture the theme's own texture stands in. Hidden under the classic
   themes; purely decorative, so hidden from assistive tech. *@
<div class="world-backdrop" data-kind="@Kind" aria-hidden="true">
    <div class="world-backdrop-image @(ImageStyle is null ? "world-backdrop-image--texture" : null)" style="@ImageStyle"></div>
    <div class="world-backdrop-shade"></div>
</div>

@code {
    // book, project, character, location, shelf, lore, profile
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    // An object URL (blob:) or same-origin URL of the entry's picture.
    [Parameter] public string? ImageUrl { get; set; }

    // Only blob:/relative URLs come in here; quotes would break out of url().
    private string? ImageStyle => ImageUrl is { } url && !url.Contains('\'') && !url.Contains('"') && !url.Contains(')')
        ? $"background-image: url('{url}')"
        : null;
}
