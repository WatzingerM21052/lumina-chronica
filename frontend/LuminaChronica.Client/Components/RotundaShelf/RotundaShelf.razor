@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using System.Globalization
@using LuminaChronica.Client.Services
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject II18nService I18n

@* Shelf style D "Rotunde" (spec 2026-10-11 §6, polish 2026-10-12): the
   compartments stand as bays around the reader -- a full ring from twelve
   bays, an arc below -- who turns through them (drag, wheel, arrows, keys
   or the bay list). The room is dark; a warm light follows the pointer. A
   click takes the book out (OnOpen → BookSpread). rotunda.js owns
   rotation, lantern, title and the hint; the markup is Blazor's. *@
<div class="rotunda @(Partial ? "is-arc" : null)" @ref="_roomRef" tabindex="0" role="region" aria-label="@I18n.T("rotunda.label")" aria-describedby="rotunda-hint"
     style="@($"--r: {Px(_radius)}; --bay-w: {Px(BayWidth)}; --step: {_step.ToString("0.###", CultureInfo.InvariantCulture)}")">
    <div class="rotunda-title" aria-hidden="true"><span class="rotunda-title-text"></span></div>
    <div class="rotunda-stage">
        <div class="rotunda-world">
            <div class="rotunda-ring">
                @for (var i = 0; i < _bays.Count; i++)
                {
                    var bay = _bays[i];
                    var index = i;
                    <section class="rotunda-bay" style="--i: @i" data-label="@bay.Label" aria-label="@bay.Label">
                        <div class="rotunda-crown" aria-hidden="true">
                            @if (!bay.Continued)
                            {
                                <span class="shelf-plaque rotunda-plaque">@bay.Label</span>
                            }
                            @if (index == 0)
                            {
                                <span class="shelf-decor shelf-decor--left rotunda-decor"></span>
                            }
                            @if (index == _bays.Count - 1)
                            {
                                <span class="shelf-decor shelf-decor--right rotunda-decor"></span>
                            }
                        </div>
                        <span class="rotunda-pillar rotunda-pillar--left" aria-hidden="true"></span>
                        @for (var row = 0; row < RotundaLayout.RowsPerBay; row++)
                        {
                            var books = row < bay.Rows.Count ? bay.Rows[row] : [];
                            <div class="rotunda-row">
                                @foreach (var book in books)
                                {
                                    var spine = RotundaLayout.SpineSize(book);
                                    <a class="rotunda-spine" href="library/books/@book.Id" data-book-id="@book.Id" data-spread-key="@SpreadKey(index, book)"
                                       data-title="@book.Title" data-author="@book.Author" aria-label="@Label(book)"
                                       style="@($"--w: {Px(spine.Width)}; --h: {Px(spine.Height)}; --c: {Leather(book)}")"
                                       @onclick="() => OpenAsync(index, bay, book)" @onclick:preventDefault="true">
                                        <span class="rotunda-gilt" style="top: 9%"></span>
                                        <span class="rotunda-gilt" style="top: 13%"></span>
                                        <span class="rotunda-spine-title">@book.Title</span>
                                        <span class="rotunda-gilt" style="bottom: 9%"></span>
                                        <span class="rotunda-shine"></span>
                                    </a>
                                }
                            </div>
                            <div class="rotunda-ledge" aria-hidden="true"></div>
                        }
                    </section>
                }
            </div>
        </div>
    </div>
    <div class="rotunda-dark" aria-hidden="true"></div>
    <div class="rotunda-warm" aria-hidden="true"></div>
    <div class="rotunda-tip" aria-hidden="true"><strong></strong><span></span></div>
    <span id="rotunda-hint" class="visually-hidden">@I18n.T("rotunda.hint")</span>
    <div class="rotunda-ui">
        <nav class="rotunda-nav" aria-label="@I18n.T("rotunda.bays")">
            @for (var i = 0; i < _bays.Count; i++)
            {
                @if (!_bays[i].Continued)
                {
                    <button type="button" class="rotunda-nav-item" data-index="@i">@_bays[i].Label</button>
                }
            }
        </nav>
        <div class="rotunda-arrows">
            <button type="button" class="rotunda-turn rotunda-turn--prev" aria-label="@I18n.T("rotunda.turnLeft")">‹</button>
            <button type="button" class="rotunda-turn rotunda-turn--next" aria-label="@I18n.T("rotunda.turnRight")">›</button>
        </div>
    </div>
</div>
