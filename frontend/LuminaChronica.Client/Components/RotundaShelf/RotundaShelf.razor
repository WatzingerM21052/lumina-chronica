@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject II18nService I18n

@* Shelf style D "Rotunde" (spec 2026-10-11 §6): the compartments stand as
   bays in a ring around the reader, who turns through them (drag, wheel,
   arrows, keyboard). The room is dark; a lantern follows the pointer. A
   book opens as a two-page spread. rotunda.js owns rotation and lantern;
   the open book is Blazor state. *@
<div class="rotunda" @ref="_roomRef" tabindex="0" role="region" aria-label="@I18n.T("rotunda.label")" aria-describedby="rotunda-hint"
     style="@($"--r: {Px(_radius)}; --bay-w: {Px(BayWidth)}")">
    <div class="rotunda-title" aria-hidden="true"><span class="rotunda-title-text"></span></div>
    <div class="rotunda-stage" inert="@(_open is not null)">
        <div class="rotunda-world">
            <div class="rotunda-ring">
                @for (var i = 0; i < _bays.Count; i++)
                {
                    var bay = _bays[i];
                    var index = i;
                    <section class="rotunda-bay @(bay.Rows.Count == 0 ? "is-empty" : null)" style="--i: @i; --n: @_bays.Count"
                             data-label="@bay.Label" aria-label="@(bay.Label ?? I18n.T("rotunda.emptyBay"))">
                        <span class="rotunda-pillar rotunda-pillar--left" aria-hidden="true"></span>
                        @for (var row = 0; row < RotundaLayout.RowsPerBay; row++)
                        {
                            var books = row < bay.Rows.Count ? bay.Rows[row] : [];
                            <div class="rotunda-row">
                                @foreach (var book in books)
                                {
                                    var spine = RotundaLayout.SpineSize(book);
                                    <a class="rotunda-spine" href="library/books/@book.Id" data-book-id="@book.Id" aria-label="@Label(book)"
                                       style="@($"--w: {Px(spine.Width)}; --h: {Px(spine.Height)}; --c: {Leather(book)}")"
                                       @onclick="() => Open(book, bay)" @onclick:preventDefault="true">
                                        <span class="rotunda-gilt" style="top: 9%"></span>
                                        <span class="rotunda-gilt" style="top: 13%"></span>
                                        <span class="rotunda-gilt" style="bottom: 9%"></span>
                                        @if (bay.Progress?.ContainsKey(book.Id) == true)
                                        {
                                            <span class="rotunda-ribbon"></span>
                                        }
                                        <span class="rotunda-shine"></span>
                                    </a>
                                }
                                @if (bay.Rows.Count == 0 && row == 1)
                                {
                                    <span class="shelf-decor @(index % 2 == 0 ? "shelf-decor--left" : "shelf-decor--right") rotunda-decor" aria-hidden="true"></span>
                                }
                            </div>
                            <div class="rotunda-ledge" aria-hidden="true"></div>
                        }
                    </section>
                }
            </div>
        </div>
    </div>
    <div class="rotunda-dark" aria-hidden="true"></div>
    <div class="rotunda-warm" aria-hidden="true"></div>
    <svg class="rotunda-lantern" viewBox="0 0 34 52" aria-hidden="true" focusable="false">
        <path d="M17 2v6" stroke="var(--shelf-brass)" stroke-width="2" />
        <path d="M9 10h16l2 6H7z" class="rotunda-lantern-metal" />
        <rect x="8" y="16" width="18" height="24" rx="3" fill="rgba(255,214,140,.85)" stroke="var(--shelf-brass)" stroke-width="2" />
        <path class="rotunda-lantern-flame" d="M17 22c3 4 3 8 0 11-3-3-3-7 0-11z" fill="#fff1c4" />
        <path d="M6 40h22l-2 6H8z" class="rotunda-lantern-metal" />
    </svg>
    <div class="rotunda-ui">
        <span id="rotunda-hint" class="rotunda-hint">@I18n.T("rotunda.hint")</span>
        <div class="rotunda-arrows">
            <button type="button" class="rotunda-turn rotunda-turn--prev" aria-label="@I18n.T("rotunda.turnLeft")">‹</button>
            <button type="button" class="rotunda-turn rotunda-turn--next" aria-label="@I18n.T("rotunda.turnRight")">›</button>
        </div>
    </div>
    @if (_open is { } open)
    {
        <RotundaTome Book="open.Book" ProgressPercentage="open.Progress" OnClose="CloseAsync" />
    }
</div>
