@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject II18nService I18n

<a class="book-card book-card-@Size.ToString().ToLowerInvariant()" href="@(Href ?? $"library/books/{Book.Id}")">
    <div class="book-card-cover">
        @if (_coverObjectUrl is not null)
        {
            <img src="@_coverObjectUrl" alt="@Book.Title" />
        }
        else
        {
            <div class="book-card-cover-placeholder">
                <TextCover Title="@Book.Title" Author="@Book.Author" />
            </div>
        }
        @if (ShowFavorite)
        {
            <button type="button" class="book-card-favorite @(_isFavorite ? "is-favorite" : "")"
                    title="@(_isFavorite ? I18n.T("bookCard.removeFavorite") : I18n.T("bookCard.addFavorite"))"
                    @onclick="ToggleFavoriteAsync" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                @(_isFavorite ? "★" : "☆")
            </button>
        }
        @if (OwnerUsername is { } ownerUsername)
        {
            <span class="book-card-borrowed-badge" title="@string.Format(I18n.T("bookCard.sharedByTitle"), ownerUsername)">@string.Format(I18n.T("bookCard.borrowedFrom"), ownerUsername)</span>
        }
    </div>
    <div class="book-card-info">
        <div class="book-card-title">@Book.Title</div>
        @if (!string.IsNullOrWhiteSpace(Book.Author))
        {
            <div class="book-card-author">@Book.Author</div>
        }
        @if (ProgressPercentage is { } progress)
        {
            <div class="book-card-progress">
                <div class="book-card-progress-bar" style="width: @(progress.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
        }
    </div>
</a>
