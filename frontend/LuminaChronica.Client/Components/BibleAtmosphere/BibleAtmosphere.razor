@namespace LuminaChronica.Client.Components
@implements IDisposable
@inject BibleAtmosphereService Atmosphere

@* .ba-curtain is a top-level sibling (not nested in .bible-atmosphere) so
   its z-index can sit above literally everything, including .bible-page's
   own content, for the brief entrance sequence -- see BibleAtmosphere.razor.css.
   Both this and .ba-ignite default to invisible in plain CSS; JS only ever
   makes them visible right before animating them back out, so a failed/slow
   GSAP load degrades to "no intro" rather than a stuck black screen. *@
<div class="ba-curtain" aria-hidden="true"></div>

@* Fixed, full-viewport -- deliberately a sibling of .bible-page's content,
   not a wrapper around it, so it never affects layout/scroll of the real
   content and can't be clipped by any ancestor's overflow. See
   BibleAtmosphere.razor.css for the full visual treatment (background
   image, gradient grading, glow, dust) and for the stacking-order fix
   (issue #143 v2): z-index:-1 here silently lost to the app shell's own
   paint layer in the real browser, confirmed live -- the background image
   never actually rendered visibly despite every CSS property on it being
   correct. Explicit low-but-positive z-index + .bible-page--dark-academia's
   own explicit z-index:1 replaces the implicit "-1 always loses" assumption. *@
<div class="bible-atmosphere" aria-hidden="true">
    <div class="ba-ignite" aria-hidden="true"></div>
    <div id="@BackgroundId" class="bible-atmosphere-background"></div>
    <div class="bible-atmosphere-vignette"></div>
    <div class="bible-atmosphere-glow bible-atmosphere-glow--1"></div>
    <div class="bible-atmosphere-glow bible-atmosphere-glow--2"></div>
    <div class="bible-atmosphere-dust">
        @for (var i = 0; i < DustMoteCount; i++)
        {
            <span class="bible-atmosphere-mote"></span>
        }
    </div>
</div>

@* Photo credit relocated here from the (removed, in this theme) hero banner
   -- the CC BY-SA license requires it stay visible regardless of layout. *@
<p class="bible-atmosphere-credit">
    Foto: Diego Delso,
    <a href="https://delso.photo" target="_blank" rel="noopener noreferrer">delso.photo</a>,
    Lizenz <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA</a>
</p>

@code {
    private const int DustMoteCount = 14;
    private const string BackgroundId = "bible-atmosphere-background";

    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            await Atmosphere.InitAsync(BackgroundId);
            // Fire-and-forget: the entrance is a decorative flourish, not
            // something the rest of the page's readiness should wait on.
            _ = Atmosphere.PlayEntranceAsync();
        }
    }

    public void Dispose()
    {
        if (_initialized)
        {
            _ = Atmosphere.DestroyAsync();
        }
    }
}
