@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject CoverColorService CoverColorService

@* One book of the classic shelf: a 3D body (spine in front, cover on the
   right side, page edges on top) that turns its cover towards the reader
   on hover/focus. The link is the slot; everything inside is decoration. *@
<a class="classic-shelf-slot" href="library/books/@Book.Id" aria-label="@AccessibleLabel" data-book-id="@Book.Id" style="@SlotStyle">
    <span class="classic-shelf-book" aria-hidden="true">
        <span class="classic-shelf-face classic-shelf-spine">
            <span class="classic-shelf-band classic-shelf-band--1"></span>
            <span class="classic-shelf-band classic-shelf-band--2"></span>
            <span class="classic-shelf-label"><span>@Book.Title</span></span>
            <span class="classic-shelf-ornament"></span>
            <span class="classic-shelf-band classic-shelf-band--3"></span>
            <span class="classic-shelf-band classic-shelf-band--4"></span>
            @if (ProgressPercentage is { } spineProgress)
            {
                <span class="classic-shelf-spine-progress" style="height: @Percent(spineProgress)"></span>
            }
        </span>
        <span class="classic-shelf-face classic-shelf-cover @(_coverObjectUrl is not null ? "has-image" : null) @(ShowCoverText ? null : "hide-text")">
            @if (_coverObjectUrl is not null)
            {
                <img src="@_coverObjectUrl" alt="" />
            }
            <span class="classic-shelf-cover-title">@Book.Title</span>
            @if (!string.IsNullOrWhiteSpace(Book.Author))
            {
                <span class="classic-shelf-cover-author">@Book.Author</span>
            }
            @if (ProgressPercentage is { } progress)
            {
                <span class="classic-shelf-progress"><span style="width: @Percent(progress)"></span></span>
            }
        </span>
        <span class="classic-shelf-face classic-shelf-top"></span>
        <span class="classic-shelf-shadow"></span>
    </span>
</a>
