@namespace LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@inherits ShelfBase

@* Shelf style A "Klassisch" (spec 2026-10-11 §6): a wooden cabinet, one
   compartment per ShelfSection with a brass plaque and the theme's decor on the cornice, books broken into
   planks by ShelfLineLayout once shelfLayout.js has reported the width. *@
<div class="classic-shelf" style="--zoom: @Zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    <div class="classic-shelf-cabinet">
        <span class="classic-shelf-post classic-shelf-post--left" aria-hidden="true"></span>
        <span class="classic-shelf-post classic-shelf-post--right" aria-hidden="true"></span>
        <div class="classic-shelf-measure" @ref="MeasureRef" aria-hidden="true"></div>
        @foreach (var bay in Sections)
        {
            <section class="classic-shelf-bay classic-shelf-bay--@bay.Kind.ToString().ToLowerInvariant()" aria-label="@bay.Label" @key="bay.Label" style="@BayStyle(bay)">
                <span class="shelf-plaque classic-shelf-plaque" title="@bay.Label">@bay.Label</span>
                @{
                    var coverForward = bay.Kind == ShelfSectionKind.Recent;
                    Func<Book, int> widthOf = coverForward ? _ => CoverWidth : b => ShelfLineLayout.SizeFor(b).Width;
                }
                @foreach (var line in ShelfLineLayout.Lines(bay.Books, Width, Zoom, widthOf))
                {
                    <div class="classic-shelf-back">
                        <div class="classic-shelf-row">
                            @{ double left = 0; }
                            @foreach (var book in line)
                            {
                                <ClassicShelfBook @key="book.Id" Book="book" Zoom="Zoom" ShowCoverText="ShowCoverText" CoverForward="coverForward" CoverWidth="CoverWidth"
                                                  ProgressPercentage="@ProgressOf(bay, book)" HoverShift="@HoverShift(left)" />
                                left += widthOf(book) * Zoom + ShelfLineLayout.Gap;
                            }
                            @if (HasRoomForBookend(line, widthOf))
                            {
                                <span class="classic-shelf-bookend" aria-hidden="true"></span>
                            }
                        </div>
                    </div>
                    <div class="classic-shelf-plank" aria-hidden="true"></div>
                }
            </section>
        }
        @* Theme decor standing on the cornice (shelf-decor.css). *@
        <span class="shelf-decor shelf-decor--left classic-shelf-decor" aria-hidden="true"></span>
        <span class="shelf-decor shelf-decor--right classic-shelf-decor" aria-hidden="true"></span>
    </div>
</div>
