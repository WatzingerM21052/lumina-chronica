@inherits LayoutComponentBase
@implements IAsyncDisposable
@using LuminaChronica.Client.Components
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<div class="app-shell">
    <header class="app-header" @ref="_headerRef">
        <a class="app-logo" href="">
            <img src="branding/logo-mark.svg" alt="" class="app-logo-mark" />
            Lumina Chronica
        </a>
        <NavMenu />
        <AuthorizeView>
            <Authorized>
                <div class="app-header-actions">
                    <NotificationBell />
                    <a class="app-profile" href="profile"><Icon Name="person" /> Profil</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="app-profile" href="login"><Icon Name="person" /> Anmelden</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    @* Sentinel for JS-side header scroll-compaction (motion.js
       initHeaderCompact) -- observed instead of a scroll-event listener.
       The header is `position: sticky` (MainLayout.razor.css) precisely so
       this compaction is ever visible; that's a deliberate, app-wide layout
       change, not a side effect -- see the issue #341 PR description. *@
    <div class="scroll-sentinel" @ref="_sentinelRef" aria-hidden="true"></div>

    <main class="@ContentClass">
        <div class="page-enter" @ref="_pageEnterRef">
            <ErrorPage>
                @Body
            </ErrorPage>
        </div>
    </main>

    <footer class="app-footer">
        <span class="text-muted">Lumina Chronica — Where stories become knowledge and knowledge becomes worlds.</span>
        <a class="app-footer-link" href="impressum">Impressum</a>
    </footer>
</div>

@code {
    // The reader's own Seitenbreite tiers (min(90vw, 90rem) up to
    // min(94vw, 140rem) -- see EpubReader/PdfReader's ViewportClass) were
    // silently having zero visible effect: this shared layout's .app-content
    // caps every page's content column to 88rem regardless, so both Normal
    // and Breit were being clamped down to the same ~88rem well before
    // either tier's own max-width ever came into play. The reader route
    // opts out of that outer cap entirely so its own, more granular width
    // tiers are what actually governs. MainLayout persists across
    // client-side navigations (only @Body swaps), so this needs an explicit
    // LocationChanged subscription -- @Body changing alone doesn't re-render
    // this component's own markup.
    private string ContentClass => Navigation.Uri.EndsWith("/read") ? "app-content app-content--reader" : "app-content";

    private ElementReference _headerRef;
    private ElementReference _sentinelRef;
    private ElementReference _pageEnterRef;
    private IJSObjectReference? _motionModule;
    private string _lastPath = string.Empty;
    private bool _pendingPageEnterReplay;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _lastPath = PathOf(Navigation.Uri);
    }

    // Only re-plays the page-enter fade when the path actually changed --
    // LocationChanged also fires for same-page navigation (e.g. a deep link
    // that resolves to the page already showing), where replaying would
    // just read as an unwanted flicker rather than a page change.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var path = PathOf(e.Location);
        _pendingPageEnterReplay = path != _lastPath;
        _lastPath = path;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _motionModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
                await _motionModule.InvokeVoidAsync("initHeaderCompact", _headerRef, _sentinelRef);
                await _motionModule.InvokeVoidAsync("initReveal");
            }
            catch (JSException)
            {
                // Motion is a progressive enhancement -- see motion.js:
                // a failed/blocked module load just leaves every
                // [data-reveal] section in its normal, fully visible state.
            }
            return;
        }

        // StateHasChanged() above is the only thing that re-renders this
        // layout, and it only runs from OnLocationChanged -- so a
        // non-first render here always corresponds to a completed
        // navigation, meaning @Body's new markup (and any of its own
        // [data-reveal] sections) is already in the DOM by this point.
        if (_pendingPageEnterReplay && _motionModule is not null)
        {
            _pendingPageEnterReplay = false;
            try
            {
                await _motionModule.InvokeVoidAsync("replayPageEnter", _pageEnterRef);
                await _motionModule.InvokeVoidAsync("initReveal");
            }
            catch (JSException)
            {
            }
        }
    }

    private static string PathOf(string uri) => uri.Split('?')[0].Split('#')[0];

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_motionModule is not null)
        {
            try
            {
                await _motionModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
