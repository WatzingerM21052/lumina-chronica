@inherits LayoutComponentBase
@using LuminaChronica.Client.Components

<div class="app-shell">
    <header class="app-header">
        <a class="app-logo" href="">Lumina Chronica</a>
        <NavMenu />
        <AuthorizeView>
            <Authorized>
                <a class="app-profile" href="profile">👤 Profil</a>
            </Authorized>
            <NotAuthorized>
                <a class="app-profile" href="login">👤 Anmelden</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="app-content">
        <ErrorPage>
            @Body
        </ErrorPage>
    </main>

    <footer class="app-footer">
        <span class="text-muted">Lumina Chronica — Where stories become knowledge and knowledge becomes worlds.</span>
        <a class="app-footer-link" href="impressum">Impressum</a>
    </footer>
</div>
