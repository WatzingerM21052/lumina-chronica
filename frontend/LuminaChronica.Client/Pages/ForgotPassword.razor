@page "/forgot-password"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@I18n.T("forgotPassword.title") — Lumina Chronica</PageTitle>

<PasswordResetDialog IsOpen="true" OnClose="CloseAsync" />

@code {
    // D14: the route survives as a thin shell so a bookmark or an old
    // reset email's link still works -- the dialog now does all the real
    // work (§4.1). Closing (Escape/overlay/✕/success) always means
    // "back to wherever forgot-password itself would have gone" -- home.
    private Task CloseAsync()
    {
        NavigationManager.NavigateTo("");
        return Task.CompletedTask;
    }
}
