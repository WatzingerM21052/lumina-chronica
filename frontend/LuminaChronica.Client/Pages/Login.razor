@page "/login"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject LuminaAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject II18nService I18n

<PageTitle>@I18n.T("login.title") — Lumina Chronica</PageTitle>

<h1>@I18n.T("login.title")</h1>

<EditForm Model="_request" OnValidSubmit="SubmitAsync" class="auth-form">
    <DataAnnotationsValidator />

    @if (_errorMessage is not null)
    {
        <p class="form-error">@_errorMessage</p>
    }

    <div class="form-group">
        <label for="identifier">@I18n.T("login.identifierLabel")</label>
        <InputText id="identifier" @bind-Value="_request.Identifier" />
    </div>

    <div class="form-group">
        <label for="password">@I18n.T("login.passwordLabel")</label>
        <InputText id="password" type="password" @bind-Value="_request.Password" />
    </div>

    <p class="text-muted"><a href="forgot-password">@I18n.T("login.forgotPasswordLink")</a></p>

    @if (_isSubmitting)
    {
        <LoadingIndicator Text="@I18n.T("login.submitting")" />
    }
    else
    {
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">@I18n.T("login.submitButton")</button>
        </div>
    }
</EditForm>

<OAuthButtons ApiBaseUrl="@(HttpClient.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty)" />

<p class="text-muted">@I18n.T("login.noAccount") <a href="register">@I18n.T("login.registerLink")</a></p>

@code {
    private readonly LoginRequest _request = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var response = await ApiClient.PostAsync<LoginRequest, AuthResult>("/api/auth/login", _request);

        if (response is { Success: true, Data: not null })
        {
            await AuthStateProvider.MarkUserAsAuthenticatedAsync(response.Data.Token);
            NavigationManager.NavigateTo("");
            return;
        }

        _errorMessage = response?.Error?.Message ?? I18n.T("login.defaultError");
        _isSubmitting = false;
    }
}
