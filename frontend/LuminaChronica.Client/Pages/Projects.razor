@page "/projects"
@attribute [Authorize]
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@I18n.T("projects.title") — Lumina Chronica</PageTitle>

<div class="library-header">
    <h1>@I18n.T("projects.title")</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
        @I18n.T("projects.createButton")
    </button>
</div>

<Dialog IsOpen="_showCreateForm" Title="@I18n.T("projects.createButton")" OnClose="RequestCloseCreate">
    <ChildContent>
        <EditForm id="project-create-form" Model="_createForm" OnValidSubmit="CreateProjectAsync" class="auth-form">
            @if (_createErrorMessage is not null)
            {
                <p class="form-error">@_createErrorMessage</p>
            }
            <div class="form-group">
                <label for="project-title">@I18n.T("projects.titleLabel")</label>
                <InputText id="project-title" @bind-Value="_createForm.Title" />
            </div>
            <div class="form-group">
                <label for="project-type">@I18n.T("projects.typeLabel")</label>
                <InputSelect id="project-type" @bind-Value="_createForm.Type">
                    @foreach (var type in ProjectTypeLabel.Options)
                    {
                        <option value="@type">@ProjectTypeLabel.For(type, I18n)</option>
                    }
                </InputSelect>
            </div>
            <div class="form-group">
                <label for="project-description">@I18n.T("projects.descriptionLabel")</label>
                <InputTextArea id="project-description" @bind-Value="_createForm.Description" />
            </div>
            <div class="form-group">
                <label for="project-cover">@I18n.T("projects.coverLabel")</label>
                <InputFile id="project-cover" OnChange="OnCoverSelected" />
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="RequestCloseCreate">@I18n.T("projects.cancelButton")</button>
        <button type="submit" form="project-create-form" class="btn btn-primary" disabled="@_isCreating">@I18n.T("projects.createSubmitButton")</button>
    </Footer>
</Dialog>
<ConfirmDialog IsOpen="_confirmingDiscardCreate" Message="@I18n.T("dialog.discardChangesMessage")"
               ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
               OnConfirm="ConfirmDiscardCreate" OnCancel="() => _confirmingDiscardCreate = false" />

@if (_errorMessage is not null)
{
    <p class="form-error">@_errorMessage</p>
}
else if (_projects is null)
{
    <LoadingIndicator Text="@I18n.T("projects.loading")" />
}
else if (_projects.Count == 0)
{
    <EmptyState Message="@I18n.T("projects.emptyMessage")"
                ActionText="@I18n.T("projects.createButton")"
                OnAction="OpenCreateForm" />
}
else
{
    <div class="library-grid">
        @foreach (var project in _projects)
        {
            <ProjectCard Project="project" />
        }
    </div>
}

@code {
    private List<Project>? _projects;
    private string? _errorMessage;
    private bool _showCreateForm;
    private string? _createErrorMessage;
    private CreateProjectFormModel _createForm = new();
    private bool _confirmingDiscardCreate;
    private bool _isCreating;
    private IBrowserFile? _selectedCover;

    protected override Task OnInitializedAsync() => LoadProjectsAsync();

    private async Task LoadProjectsAsync()
    {
        _errorMessage = null;
        var response = await ApiClient.GetAsync<List<Project>>("/api/projects");
        if (response is { Success: true, Data: not null })
        {
            _projects = response.Data;
        }
        else
        {
            _errorMessage = response?.Error?.Message ?? I18n.T("projects.loadError");
        }
    }

    private void OnCoverSelected(InputFileChangeEventArgs e) => _selectedCover = e.File;

    // Every open starts from a clean form: cancelling used to only hide the
    // dialog, so a reopen showed -- and would submit -- the previous
    // half-filled values and cover (review N-2).
    private void OpenCreateForm()
    {
        _createForm = new CreateProjectFormModel();
        _selectedCover = null;
        _createErrorMessage = null;
        _showCreateForm = true;
    }

    private bool IsCreateFormDirty => _createForm != new CreateProjectFormModel() || _selectedCover is not null;

    private void RequestCloseCreate()
    {
        if (IsCreateFormDirty)
        {
            _confirmingDiscardCreate = true;
            return;
        }
        _showCreateForm = false;
    }

    private void ConfirmDiscardCreate()
    {
        _confirmingDiscardCreate = false;
        _showCreateForm = false;
    }

    private async Task CreateProjectAsync()
    {
        if (_isCreating) return;
        _isCreating = true;
        try
        {
            await CreateProjectCoreAsync();
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task CreateProjectCoreAsync()
    {
        _createErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_createForm.Title))
        {
            _createErrorMessage = I18n.T("projects.titleRequiredError");
            return;
        }

        const long maxCoverBytes = 5 * 1024 * 1024;
        using var content = new MultipartFormDataContent
        {
            { new StringContent(_createForm.Title), QuoteFieldName("title") },
            { new StringContent(_createForm.Type), QuoteFieldName("type") }
        };
        if (!string.IsNullOrWhiteSpace(_createForm.Description))
        {
            content.Add(new StringContent(_createForm.Description), QuoteFieldName("description"));
        }
        if (_selectedCover is not null)
        {
            var streamContent = new StreamContent(_selectedCover.OpenReadStream(maxCoverBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedCover.ContentType) ? "application/octet-stream" : _selectedCover.ContentType);
            content.Add(streamContent, QuoteFieldName("cover"), QuoteFieldName(_selectedCover.Name));
        }

        var response = await ApiClient.PostMultipartAsync<Project>("/api/projects", content);
        if (response is { Success: true, Data: not null })
        {
            _showCreateForm = false;
            _createForm = new CreateProjectFormModel();
            _selectedCover = null;
            await LoadProjectsAsync();
        }
        else
        {
            _createErrorMessage = response?.Error?.Message ?? I18n.T("projects.createError");
        }
    }

    // Same RFC 7578 quoting requirement as BookUpload.razor's QuoteFieldName --
    // .NET's MultipartFormDataContent only quotes a Content-Disposition
    // name/filename when it contains characters outside the plain HTTP
    // "token" grammar, but the backend's parser requires it always quoted.
    private static string QuoteFieldName(string value) => $"\"{value}\"";

    private record CreateProjectFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Type { get; set; } = "WORLD";
        public string? Description { get; set; }
    }
}
