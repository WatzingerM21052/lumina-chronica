@page "/projects/{ProjectId:int}/lore/{Id:int}"
@attribute [Authorize]
@using Markdig
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@(_entry?.Title ?? I18n.T("loreEntryDetail.defaultTitle")) — Lumina Chronica</PageTitle>
<WorldBackdrop Kind="lore" Pending="@(_entry is null)" />

<a class="back-link" href="@($"projects/{ProjectId}")">@I18n.T("loreEntryDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_entry is null)
{
    <LoadingIndicator Text="@I18n.T("loreEntryDetail.loading")" />
}
else
{
    @* Title and actions first, like the other detail pages -- a long entry
       would otherwise push "Bearbeiten" far below the fold. *@
    <header class="lore-header">
        <h1>@_entry.Title</h1>
        <div class="form-actions">
            <button type="button" id="lore-edit-button" class="btn btn-icon" @onclick="StartEditing" title="@I18n.T("loreEntryDetail.editButton")"><Icon Name="edit" /><span class="visually-hidden">@I18n.T("loreEntryDetail.editButton")</span></button>
            <button type="button" class="btn btn-icon btn-icon-danger" @onclick="() => _confirmingDelete = true" title="@I18n.T("loreEntryDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("loreEntryDetail.deleteButton")</span></button>
        </div>
    </header>
    @if (!string.IsNullOrWhiteSpace(_entry.Content))
    {
        <article class="lore-content">@((MarkupString)Markdown.ToHtml(_entry.Content, MarkdownPipeline))</article>
    }
    <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("loreEntryDetail.deleteConfirmMessage")"
                   OnConfirm="DeleteEntryAsync" OnCancel="() => _confirmingDelete = false" />

    @* UI/UX plan A5: edit in a large dialog, so the rendered entry stays visible behind it. *@
    <Dialog IsOpen="_isEditing" Size="DialogSize.Large" Title="@I18n.T("loreEntryDetail.editDialogTitle")"
            OnClose="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">
        <ChildContent>
            <EditForm id="lore-edit-form" Model="_editForm" OnValidSubmit="() => _guard.SubmitAsync(SaveAsync)" class="auth-form">
                @if (_saveErrorMessage is not null)
                {
                    <p class="form-error">@_saveErrorMessage</p>
                }
                <div class="form-group">
                    <label for="lore-edit-title">@I18n.T("loreEntryDetail.titleLabel")</label>
                    <InputText id="lore-edit-title" maxlength="@TextLimits.Title" @bind-Value="_editForm.Title" />
                </div>
                <div class="form-group">
                    <label for="lore-edit-content">@I18n.T("loreEntryDetail.contentLabel")</label>
                    <InputTextArea id="lore-edit-content" maxlength="@TextLimits.LoreContent" @bind-Value="_editForm.Content" rows="16" />
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">@I18n.T("loreEntryDetail.cancelButton")</button>
            <button type="submit" form="lore-edit-form" class="btn btn-primary" disabled="@_guard.IsSubmitting">@I18n.T("loreEntryDetail.saveButton")</button>
        </Footer>
    </Dialog>

    <ConfirmDialog IsOpen="_guard.IsConfirmingDiscard" Message="@I18n.T("dialog.discardChangesMessage")"
                   ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
                   OnConfirm="_guard.ConfirmDiscard" OnCancel="_guard.CancelDiscard" />
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int Id { get; set; }

    // DisableHtml matches the reader's Markdown pipeline (Reader.razor) --
    // keeps the "no untrusted user-generated HTML anywhere" premise that
    // the localStorage JWT storage decision relies on, see Architecture.md.
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder().DisableHtml().Build();

    private LoreEntry? _entry;
    private string? _loadErrorMessage;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private UpdateLoreEntryRequest _editForm = new();
    private (string? Title, string? Content) _editSnapshot;
    private readonly DialogGuard _guard = new();

    private bool IsEditFormDirty =>
        (_editForm.Title ?? "") != (_editSnapshot.Title ?? "") ||
        (_editForm.Content ?? "") != (_editSnapshot.Content ?? "");
    private bool _confirmingDelete;

    protected override Task OnParametersSetAsync() => LoadEntryAsync();

    private async Task LoadEntryAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<LoreEntry>($"/api/projects/{ProjectId}/lore/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _entry = response.Data;
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? I18n.T("loreEntryDetail.loadError");
        }
    }

    private void StartEditing()
    {
        if (_entry is null) return;
        _editForm = new UpdateLoreEntryRequest { Title = _entry.Title, Content = _entry.Content };
        _editSnapshot = (_entry.Title, _entry.Content);
        _saveErrorMessage = null;
        _isEditing = true;
    }

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateLoreEntryRequest, LoreEntry>($"/api/projects/{ProjectId}/lore/{Id}", _editForm);
        if (response is { Success: true, Data: not null })
        {
            _entry = response.Data;
            _isEditing = false;
        }
        else
        {
            _saveErrorMessage = response?.Error?.Message ?? I18n.T("loreEntryDetail.saveError");
        }
    }

    private async Task DeleteEntryAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/lore/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = I18n.T("loreEntryDetail.deleteError");
        }
    }
}
