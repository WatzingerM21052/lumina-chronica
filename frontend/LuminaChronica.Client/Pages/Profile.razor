@page "/profile"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject LuminaAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Profil — Lumina Chronica</PageTitle>

<div class="profile-seal-header">
    <img src="images/profile-ex-libris-seal.webp" alt="" class="profile-seal-image" loading="eager" decoding="async" />
    <h1>Profil</h1>
</div>

@if (_profile is null)
{
    <LoadingIndicator Text="Profil wird geladen..." />
}
else
{
    <p><a href="@($"u/{_profile.Username}")">Öffentliches Profil ansehen</a></p>

    <div class="profile-avatar-row">
        @if (_avatarPreviewUrl is { } previewUrl)
        {
            <img src="@previewUrl" alt="" class="profile-avatar-preview" />
        }
        else if (_profile.AvatarUrl is { } avatarUrl)
        {
            <img src="@avatarUrl" alt="" class="profile-avatar-preview" />
        }
        else
        {
            <div class="profile-avatar-preview profile-avatar-placeholder" aria-hidden="true">
                <Icon Name="person" Class="profile-avatar-placeholder-icon" />
            </div>
        }
        <div class="dropzone dropzone--compact @(_isDraggingAvatar ? "dropzone--active" : "")"
             @ondragenter="() => _isDraggingAvatar = true" @ondragleave="() => _isDraggingAvatar = false"
             @ondragover:preventDefault @ondrop="() => _isDraggingAvatar = false">
            <InputFile id="avatar" OnChange="OnAvatarSelectedAsync" />
            <span class="dropzone-label">Profilbild hierher ziehen oder klicken zum Auswählen</span>
        </div>
    </div>
    @if (_avatarErrorMessage is not null)
    {
        <p class="form-error">@_avatarErrorMessage</p>
    }

    <h2>Konto</h2>
    <EditForm Model="_profileForm" OnValidSubmit="SaveProfileAsync" class="auth-form">
        @if (_profileErrorMessage is not null)
        {
            <p class="form-error">@_profileErrorMessage</p>
        }

        <div class="form-group">
            <label for="username">Benutzername</label>
            <InputText id="username" @bind-Value="_profileForm.Username" />
        </div>

        <div class="form-group">
            <label for="email">E-Mail</label>
            <InputText id="email" type="email" @bind-Value="_profileForm.Email" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(_saveProfileState != ButtonBusyState.Idle)" style="min-width: @(AsyncButtonContent.MinWidthCh("Speichern", null, "Gespeichert"))ch">
                <AsyncButtonContent State="_saveProfileState" IdleText="Speichern" SuccessText="Gespeichert" />
            </button>
        </div>
    </EditForm>

    <h2>Passwort ändern</h2>
    <EditForm Model="_passwordForm" OnValidSubmit="ChangePasswordAsync" class="auth-form">
        @if (_passwordErrorMessage is not null)
        {
            <p class="form-error">@_passwordErrorMessage</p>
        }
        @if (_passwordSuccessMessage is not null)
        {
            <p class="form-success">@_passwordSuccessMessage</p>
        }

        <div class="form-group">
            <label for="currentPassword">Aktuelles Passwort</label>
            <InputText id="currentPassword" type="password" @bind-Value="_passwordForm.CurrentPassword" />
        </div>

        <div class="form-group">
            <label for="newPassword">Neues Passwort</label>
            <InputText id="newPassword" type="password" @bind-Value="_passwordForm.NewPassword" />
        </div>

        <div class="form-group">
            <label for="confirmNewPassword">Neues Passwort bestätigen</label>
            <InputText id="confirmNewPassword" type="password" @bind-Value="_passwordForm.ConfirmNewPassword" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@_isSavingPassword">Passwort ändern</button>
        </div>
    </EditForm>

    <div class="form-actions">
        <button type="button" class="btn" @onclick="LogoutAsync">Abmelden</button>
    </div>
}

@code {
    private UserProfile? _profile;
    private ProfileFormModel _profileForm = new();
    private PasswordFormModel _passwordForm = new();

    private ButtonBusyState _saveProfileState;
    private string? _profileErrorMessage;

    private bool _isSavingPassword;
    private string? _passwordErrorMessage;
    private string? _passwordSuccessMessage;

    private bool _isDraggingAvatar;
    private string? _avatarPreviewUrl;
    private string? _avatarErrorMessage;

    private const long MaxAvatarBytes = 5 * 1024 * 1024;
    private static readonly string[] AllowedAvatarExtensions = [".jpg", ".jpeg", ".png", ".webp"];

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiClient.GetAsync<UserProfile>("/api/users/me");
        if (response is { Success: true, Data: not null })
        {
            _profile = response.Data;
            _profileForm = new ProfileFormModel { Username = _profile.Username, Email = _profile.Email };
        }
    }

    private Task SaveProfileAsync() =>
        AsyncButtonRunner.RunAsync(SaveProfileCoreAsync, state =>
        {
            _saveProfileState = state;
            StateHasChanged();
        });

    private async Task<bool> SaveProfileCoreAsync()
    {
        _profileErrorMessage = null;

        var request = new UpdateProfileRequest { Username = _profileForm.Username, Email = _profileForm.Email };
        var response = await ApiClient.PutAsync<UpdateProfileRequest, UserProfile>("/api/users/me", request);

        if (response is { Success: true, Data: not null })
        {
            _profile = response.Data;
            return true;
        }

        _profileErrorMessage = response?.Error?.Message ?? "Speichern fehlgeschlagen. Bitte versuche es erneut.";
        return false;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordErrorMessage = null;
        _passwordSuccessMessage = null;

        if (_passwordForm.NewPassword != _passwordForm.ConfirmNewPassword)
        {
            _passwordErrorMessage = "Die neuen Passwörter stimmen nicht überein.";
            return;
        }

        _isSavingPassword = true;

        var request = new UpdateProfileRequest
        {
            CurrentPassword = _passwordForm.CurrentPassword,
            NewPassword = _passwordForm.NewPassword,
        };
        var response = await ApiClient.PutAsync<UpdateProfileRequest, UserProfile>("/api/users/me", request);

        if (response is { Success: true })
        {
            _passwordSuccessMessage = "Passwort geändert.";
            _passwordForm = new PasswordFormModel();
        }
        else
        {
            _passwordErrorMessage = response?.Error?.Message ?? "Passwort ändern fehlgeschlagen. Bitte versuche es erneut.";
        }

        _isSavingPassword = false;
    }

    private async Task LogoutAsync()
    {
        await ApiClient.PostAsync("/api/auth/logout");
        await AuthStateProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("");
    }

    // Uploads immediately on selection, unlike the Konto/Passwort forms
    // below -- the avatar has its own backend endpoint (PUT /me/avatar,
    // separate from PUT /me) and no other field it needs to be saved
    // together with, so a "Speichern" button here would only add a step.
    private async Task OnAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        _avatarErrorMessage = null;

        var extension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (!AllowedAvatarExtensions.Contains(extension))
        {
            _avatarErrorMessage = $"Dateityp muss eines von {string.Join(", ", AllowedAvatarExtensions)} sein.";
            return;
        }
        if (e.File.Size > MaxAvatarBytes)
        {
            _avatarErrorMessage = $"Datei überschreitet das {MaxAvatarBytes / (1024 * 1024)}MB-Limit.";
            return;
        }

        using var stream = e.File.OpenReadStream(MaxAvatarBytes);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var bytes = memoryStream.ToArray();
        var contentType = string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType;

        if (_avatarPreviewUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_avatarPreviewUrl);
        }
        _avatarPreviewUrl = await BlobUrlService.CreateObjectUrlAsync(bytes, contentType);
        StateHasChanged();

        using var content = new MultipartFormDataContent();
        var byteContent = new ByteArrayContent(bytes);
        byteContent.Headers.ContentType = new MediaTypeHeaderValue(contentType);
        content.Add(byteContent, "\"avatar\"", $"\"{e.File.Name}\"");

        var response = await ApiClient.PutMultipartAsync<UserProfile>("/api/users/me/avatar", content);
        if (response is { Success: true, Data: not null })
        {
            _profile = response.Data;
        }
        else
        {
            _avatarErrorMessage = response?.Error?.Message ?? "Profilbild konnte nicht hochgeladen werden.";
        }
    }

    public void Dispose()
    {
        if (_avatarPreviewUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_avatarPreviewUrl);
        }
    }

    private class ProfileFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }

    private class PasswordFormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
