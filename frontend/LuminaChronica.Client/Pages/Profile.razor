@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject LuminaAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject II18nService I18n
@inject ToastService ToastService

<PageTitle>@I18n.T("profile.title") — Lumina Chronica</PageTitle>

<div class="profile-seal-header">
    <img src="images/profile-ex-libris-seal.webp" alt="" class="profile-seal-image" loading="eager" decoding="async" />
    <h1>@I18n.T("profile.title")</h1>
</div>

@if (_profile is null)
{
    <LoadingIndicator Text="@I18n.T("profile.loading")" />
}
else
{
    @* One centred column of equal-width cards under the centred seal
       (design audit F7): before, the header was centred, the forms hugged
       the left edge at 32rem and the linked-account rows spanned the full
       page, so nothing shared an axis. *@
    <div class="profile-layout">
        <section class="profile-card profile-identity">
            <div class="profile-avatar-row">
                @if (_profile.AvatarUrl is { } avatarUrl)
                {
                    <img src="@avatarUrl" alt="" class="profile-avatar-preview" />
                }
                else
                {
                    <div class="profile-avatar-preview profile-avatar-placeholder" aria-hidden="true">
                        <Icon Name="person" Class="profile-avatar-placeholder-icon" />
                    </div>
                }
                <div class="profile-identity-text">
                    <strong>@_profile.Username</strong>
                    <a href="@($"u/{_profile.Username}")">@I18n.T("profile.viewPublicProfile")</a>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" id="changeAvatarButton" class="btn" @onclick="() => _isAvatarDialogOpen = true">@I18n.T("profile.changeAvatarButton")</button>
            </div>
        </section>

        <AvatarUploadDialog IsOpen="_isAvatarDialogOpen" OnUploaded="OnAvatarUploaded" OnClose="() => _isAvatarDialogOpen = false" />

        <section class="profile-card">
            <h2>@I18n.T("profile.accountTitle")</h2>
            <EditForm Model="_profileForm" OnValidSubmit="SaveProfileAsync" class="auth-form profile-form">
                @if (_profileErrorMessage is not null)
                {
                    <p class="form-error">@_profileErrorMessage</p>
                }

                <div class="form-group">
                    <label for="username">@I18n.T("profile.usernameLabel")</label>
                    <InputText id="username" @bind-Value="_profileForm.Username" />
                </div>

                <div class="form-group">
                    <label for="email">@I18n.T("profile.emailLabel")</label>
                    @* Plain input bound on every keystroke (not InputText, which only
                       updates on blur) so the password field below appears as soon
                       as the address actually differs. *@
                    <input id="email" type="email" @bind="_profileForm.Email" @bind:event="oninput" />
                </div>

                @if (RequiresPasswordForEmailChange)
                {
                    @* Review M-6: the backend refuses an email change without the
                       current password -- the email is the account's recovery channel. *@
                    <div class="form-group">
                        <label for="emailChangePassword">@I18n.T("profile.emailChangePasswordLabel")</label>
                        <input id="emailChangePassword" type="password" autocomplete="current-password" @bind="_profileForm.CurrentPassword" @bind:event="oninput" />
                        <p class="text-muted">@I18n.T("profile.emailChangeHint")</p>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@(_saveProfileState != ButtonBusyState.Idle)" style="min-width: @(AsyncButtonContent.MinWidthCh(I18n.T("profile.saveButton"), null, I18n.T("profile.saveSuccess")))ch">
                        <AsyncButtonContent State="_saveProfileState" IdleText="@I18n.T("profile.saveButton")" SuccessText="@I18n.T("profile.saveSuccess")" />
                    </button>
                </div>
            </EditForm>
        </section>

        @* Rarely used: collapsed by default so the page isn't three forms long. *@
        <details class="profile-card profile-collapsible">
            <summary>
                <h2>@I18n.T("profile.changePasswordTitle")</h2>
                <Icon Name="chevron-down" Class="profile-collapsible-chevron" />
            </summary>
            <EditForm Model="_passwordForm" OnValidSubmit="ChangePasswordAsync" class="auth-form profile-form">
                @if (_passwordErrorMessage is not null)
                {
                    <p class="form-error">@_passwordErrorMessage</p>
                }
                @if (_passwordSuccessMessage is not null)
                {
                    <p class="form-success">@_passwordSuccessMessage</p>
                }

                <div class="form-group">
                    <label for="currentPassword">@I18n.T("profile.currentPasswordLabel")</label>
                    <InputText id="currentPassword" type="password" @bind-Value="_passwordForm.CurrentPassword" />
                </div>

                <div class="form-group">
                    <label for="newPassword">@I18n.T("profile.newPasswordLabel")</label>
                    <InputText id="newPassword" type="password" @bind-Value="_passwordForm.NewPassword" />
                </div>

                <div class="form-group">
                    <label for="confirmNewPassword">@I18n.T("profile.confirmNewPasswordLabel")</label>
                    <InputText id="confirmNewPassword" type="password" @bind-Value="_passwordForm.ConfirmNewPassword" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@_isSavingPassword">@I18n.T("profile.changePasswordButton")</button>
                </div>
            </EditForm>

            @if (_hasRealPassword)
            {
                <div class="profile-password-reset">
                    <p class="text-muted">@I18n.T("profile.passwordResetHint")</p>
                    <button type="button" class="btn" disabled="@(_profile is null)" @onclick="() => _showPasswordResetDialog = true">
                        @I18n.T("profile.passwordResetButton")
                    </button>
                    <PasswordResetDialog IsOpen="_showPasswordResetDialog" InitialIdentifier="@_profile?.Email" OnClose="() => _showPasswordResetDialog = false" />
                </div>
            }
        </details>

        <section class="profile-card">
            <h2>@I18n.T("profile.linkedAccountsTitle")</h2>
            @if (_linkBanner is not null)
            {
                <p class="@(_linkBannerIsError ? "form-error" : "form-success")">@_linkBanner</p>
            }
            @if (_linkedProviders is null)
            {
                <p class="text-muted">@I18n.T("profile.loadingLinkedAccounts")</p>
            }
            else
            {
                <div class="linked-accounts-list">
                    @foreach (var (providerKey, label) in OAuthProviders)
                    {
                        var linked = _linkedProviders.FirstOrDefault(p => p.Provider == providerKey);
                        <div class="linked-account-row">
                            <span>@label@(linked is not null ? $" — {linked.Email}" : "")</span>
                            @if (linked is not null)
                            {
                                <button type="button" class="btn" @onclick="() => UnlinkProviderAsync(providerKey)">@I18n.T("profile.unlinkButton")</button>
                            }
                            else
                            {
                                <button type="button" class="btn" @onclick="() => LinkProviderAsync(providerKey)">@I18n.T("profile.linkButton")</button>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <details class="profile-card profile-danger-zone profile-collapsible">
            <summary>
                <h2>@I18n.T("profile.deleteAccountTitle")</h2>
                <Icon Name="chevron-down" Class="profile-collapsible-chevron" />
            </summary>
            <p class="text-muted">@I18n.T("profile.deleteAccountWarning")</p>

            @if (_deleteAccountErrorMessage is not null)
            {
                <p class="form-error">@_deleteAccountErrorMessage</p>
            }

            @if (_hasRealPassword)
            {
                <div class="form-group">
                    <label for="deleteAccountPassword">@I18n.T("profile.currentPasswordLabel")</label>
                    <input id="deleteAccountPassword" type="password" @bind="_deleteAccountPassword" @bind:event="oninput" />
                </div>
            }

            @if (!_isConfirmingDelete)
            {
                <div class="form-actions">
                    <button type="button" id="confirmDeleteAccount" class="btn btn-danger" @onclick="() => _isConfirmingDelete = true">@I18n.T("profile.deleteAccountButton")</button>
                </div>
            }
            else
            {
                <p class="form-error">@I18n.T("profile.deleteConfirmWarning")</p>
                <div class="form-actions">
                    <button type="button" class="btn" @onclick="() => _isConfirmingDelete = false">@I18n.T("profile.deleteCancelButton")</button>
                    <button type="button" id="deleteAccountButton" class="btn btn-danger" disabled="@(_isDeletingAccount || (_hasRealPassword && string.IsNullOrEmpty(_deleteAccountPassword)))" @onclick="DeleteAccountAsync">
                        @I18n.T("profile.deleteConfirmButton")
                    </button>
                </div>
            }
        </details>
    </div>
}

@code {
    private UserProfile? _profile;
    private ProfileFormModel _profileForm = new();
    private PasswordFormModel _passwordForm = new();

    private ButtonBusyState _saveProfileState;
    private string? _profileErrorMessage;

    private bool _isSavingPassword;
    private string? _passwordErrorMessage;
    private string? _passwordSuccessMessage;

    private bool _isAvatarDialogOpen;
    private bool _showPasswordResetDialog;

    // Set from UserProfile.HasPassword once loaded -- defaults true so the
    // password field/requirement doesn't flash away then back during the
    // initial load, matching how a real-password account (the common case)
    // actually behaves.
    private bool _hasRealPassword = true;
    private bool _isConfirmingDelete;
    private bool _isDeletingAccount;
    private string _deleteAccountPassword = string.Empty;
    private string? _deleteAccountErrorMessage;

    private static readonly (string Key, string Label)[] OAuthProviders =
    [
        ("google", "Google"),
        ("github", "GitHub"),
    ];

    private List<LinkedOAuthProvider>? _linkedProviders;
    private string? _linkBanner;
    private bool _linkBannerIsError;

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiClient.GetAsync<UserProfile>("/api/users/me");
        if (response is { Success: true, Data: not null })
        {
            _profile = response.Data;
            _profileForm = new ProfileFormModel { Username = _profile.Username, Email = _profile.Email };
            _hasRealPassword = _profile.HasPassword;
        }

        var linkedResponse = await ApiClient.GetAsync<List<LinkedOAuthProvider>>("/api/auth/oauth/linked");
        _linkedProviders = linkedResponse is { Success: true, Data: not null } ? linkedResponse.Data : [];

        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;
            if (parts[0] == "linked")
            {
                var providerKey = Uri.UnescapeDataString(parts[1]);
                var label = OAuthProviders.FirstOrDefault(p => p.Key == providerKey).Label ?? providerKey;
                _linkBanner = $"{label} {I18n.T("profile.linkedSuffix")}";
                _linkBannerIsError = false;
            }
            else if (parts[0] == "linkError")
            {
                _linkBanner = DescribeLinkError(Uri.UnescapeDataString(parts[1]));
                _linkBannerIsError = true;
            }
        }
        if (_linkBanner is not null)
        {
            NavigationManager.NavigateTo("profile", replace: true);
        }
    }

    // Mirrors OAuthCallback.razor's DescribeError switch pattern -- branches
    // on the actual reason code from the query string instead of a single
    // hardcoded message, since routes/auth.ts's callback can redirect here
    // with more than one linkError reason (already_linked, exchange_failed).
    private string DescribeLinkError(string reason) => reason switch
    {
        "already_linked" => I18n.T("profile.linkErrorAlreadyLinked"),
        "exchange_failed" => I18n.T("profile.linkErrorExchangeFailed"),
        _ => I18n.T("profile.linkErrorGeneric"),
    };

    private async Task LinkProviderAsync(string provider)
    {
        var response = await ApiClient.GetAsync<OAuthLinkStartResult>($"/api/auth/oauth/{provider}/link/start");
        if (response is { Success: true, Data: not null })
        {
            NavigationManager.NavigateTo(response.Data.RedirectUrl, forceLoad: true);
            return;
        }

        _linkBanner = response?.Error?.Message ?? I18n.T("profile.linkFailed");
        _linkBannerIsError = true;
    }

    private async Task UnlinkProviderAsync(string provider)
    {
        var response = await ApiClient.DeleteAsync<object, object>($"/api/auth/oauth/{provider}", new { });
        if (response is { Success: true })
        {
            _linkedProviders = _linkedProviders?.Where(p => p.Provider != provider).ToList();
            _linkBanner = null;
        }
        else
        {
            _linkBanner = response?.Error?.Message ?? I18n.T("profile.unlinkFailed");
            _linkBannerIsError = true;
        }
    }

    private Task SaveProfileAsync() =>
        AsyncButtonRunner.RunAsync(SaveProfileCoreAsync, state =>
        {
            _saveProfileState = state;
            StateHasChanged();
        });

    private async Task<bool> SaveProfileCoreAsync()
    {
        _profileErrorMessage = null;

        // Only a changed username has to follow the rule -- legacy ones from
        // before it existed can still save the rest of the form.
        if (_profileForm.Username != _profile?.Username && !AccountRules.IsValidUsername(_profileForm.Username))
        {
            _profileErrorMessage = I18n.T("profile.usernameInvalid");
            return false;
        }

        var request = new UpdateProfileRequest
        {
            Username = _profileForm.Username,
            Email = _profileForm.Email,
            CurrentPassword = RequiresPasswordForEmailChange ? _profileForm.CurrentPassword : null,
        };
        var response = await ApiClient.PutAsync<UpdateProfileRequest, UserProfile>("/api/users/me", request);

        if (response is { Success: true, Data: not null })
        {
            _profile = response.Data;
            _profileForm.CurrentPassword = string.Empty;
            return true;
        }

        _profileErrorMessage = response?.Error?.Message ?? I18n.T("profile.saveError");
        return false;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordErrorMessage = null;
        _passwordSuccessMessage = null;

        if (_passwordForm.NewPassword.Length < AccountRules.MinPasswordLength)
        {
            _passwordErrorMessage = I18n.T("profile.passwordTooShort");
            return;
        }

        if (_passwordForm.NewPassword != _passwordForm.ConfirmNewPassword)
        {
            _passwordErrorMessage = I18n.T("profile.passwordMismatch");
            return;
        }

        _isSavingPassword = true;

        var request = new UpdateProfileRequest
        {
            CurrentPassword = _passwordForm.CurrentPassword,
            NewPassword = _passwordForm.NewPassword,
        };
        var response = await ApiClient.PutAsync<UpdateProfileRequest, UserProfile>("/api/users/me", request);

        if (response is { Success: true })
        {
            _passwordSuccessMessage = I18n.T("profile.passwordChangeSuccess");
            _passwordForm = new PasswordFormModel();
        }
        else
        {
            _passwordErrorMessage = response?.Error?.Message ?? I18n.T("profile.passwordChangeError");
        }

        _isSavingPassword = false;
    }

    // _showPasswordResetDialog above opens PasswordResetDialog directly at
    // CodeEntry (InitialIdentifier = _profile.Email, already loaded by
    // OnInitializedAsync, fires the request immediately) -- there's no
    // identifier to type in, unlike the Login-page flow, since Profile
    // already knows who's asking. Lives here rather than on Settings
    // because it's the alternative for a user who doesn't know their
    // *current* password -- the "Passwort ändern" form above requires it.

    private async Task DeleteAccountAsync()
    {
        if (_isDeletingAccount) return;
        _isDeletingAccount = true;
        _deleteAccountErrorMessage = null;

        try
        {
            var request = new DeleteAccountRequest { CurrentPassword = _hasRealPassword ? _deleteAccountPassword : null };
            var response = await ApiClient.DeleteAsync<DeleteAccountRequest, object>("/api/users/me", request);

            if (response is { Success: true })
            {
                await AuthStateProvider.MarkUserAsLoggedOutAsync();
                NavigationManager.NavigateTo("");
                return;
            }

            _deleteAccountErrorMessage = response?.Error?.Message ?? I18n.T("profile.deleteAccountError");
            _isConfirmingDelete = false;
        }
        finally
        {
            _isDeletingAccount = false;
        }
    }

    private void OnAvatarUploaded(UserProfile profile)
    {
        _profile = profile;
        _isAvatarDialogOpen = false;
    }

    // OAuth-only accounts have no password to confirm with -- the backend
    // lets their session stand as the proof (userService.ts's
    // updateUserProfile), so the field would be a dead end for them.
    private bool RequiresPasswordForEmailChange =>
        _hasRealPassword && _profile is not null && !string.Equals(_profileForm.Email, _profile.Email, StringComparison.Ordinal);

    private class ProfileFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string CurrentPassword { get; set; } = string.Empty;
    }

    private class PasswordFormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
