@page "/nutzungsbedingungen"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject II18nService I18n

@* Terms of use (point 9, 2026-10-04). The copyright rule is the user's
   decision: uploading for private reading is fine, but only own or free
   (public-domain) works may be made public or shared; infringements are
   reported by email and removed. Reachable logged out. *@
<PageTitle>@I18n.T("terms.pageTitle") — Lumina Chronica</PageTitle>

<WorldBanner Page="legal" Title="@I18n.T("terms.pageTitle")" />
<div class="page-header">
    <h1>@I18n.T("terms.pageTitle")</h1>
</div>

<div class="world-surface">
    <LegalDocument Prefix="terms" Sections="Sections" ContactSectionKey="report" CurrentPath="nutzungsbedingungen">
        <p class="legal-related">
            <a href="datenschutz">@I18n.T("legal.privacyLink")</a>
            <a href="impressum">@I18n.T("nav.impressum")</a>
        </p>
    </LegalDocument>
</div>

@code {
    private static readonly LegalDocument.Section[] Sections =
    [
        new("scope", 2),
        new("account", 1, 3),
        new("content", 2),
        new("copyright", 1, 3),
        new("rules", 1, 5),
        new("report", 2, 3),
        new("availability", 2),
        new("liability", 2),
        new("ending", 2),
        new("changes", 2),
    ];
}
