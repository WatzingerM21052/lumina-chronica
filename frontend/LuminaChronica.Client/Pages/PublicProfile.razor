@page "/u/{Username}"
@using System.Globalization
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService

<PageTitle>@(_profile?.Username ?? Username) — Lumina Chronica</PageTitle>

@if (_notFound)
{
    <div class="empty-state">
        <p>Dieses Profil existiert nicht.</p>
    </div>
}
else if (_profile is null)
{
    <p>Lädt…</p>
}
else
{
    <div class="public-profile-header">
        @if (_profile.AvatarUrl is { } avatarUrl)
        {
            <img src="@avatarUrl" alt="@_profile.Username" class="public-profile-avatar" />
        }
        else
        {
            <div class="public-profile-avatar public-profile-avatar-placeholder" aria-hidden="true">👤</div>
        }
        <div>
            <h1>@_profile.Username</h1>
            <p class="text-muted">
                <strong>@_profile.FollowerCount</strong> Follower · <strong>@_profile.FollowingCount</strong> Folgt
            </p>
            @if (!_profile.IsOwnProfile)
            {
                <AuthorizeView>
                    <Authorized>
                        <button type="button" class="btn @(_profile.IsFollowing ? "" : "btn-primary")" disabled="@_isTogglingFollow" @onclick="ToggleFollowAsync">
                            @(_profile.IsFollowing ? "Entfolgen" : "Folgen")
                        </button>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>

    <section>
        <h2>Bibliothek</h2>
        @if (_profile.Books.Count == 0)
        {
            <p class="text-muted">@_profile.Username hat noch keine öffentlichen Bücher.</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var book in _profile.Books)
                {
                    // The whole card links to the book's own overview page
                    // (not straight into the reader) when the viewer can
                    // actually open it -- an <a> with no href renders as a
                    // plain, non-interactive container for the CanRead-false
                    // case, same idea as BookCard.razor's Href fallback.
                    <a class="book-card book-card-normal" href="@(book.CanRead ? $"library/books/{book.Id}" : null)">
                        <div class="book-card-cover">
                            @if (_coverObjectUrls.TryGetValue($"book-{book.Id}", out var coverUrl))
                            {
                                <img src="@coverUrl" alt="@book.Title" />
                            }
                            else
                            {
                                <div class="book-card-cover-placeholder" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                                        <path d="M4 5.5c2.2-1 5-1 8 0v13c-3-1-5.8-1-8 0z" />
                                        <path d="M20 5.5c-2.2-1-5-1-8 0v13c3-1 5.8-1 8 0z" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="book-card-info">
                            <div class="book-card-title">@book.Title</div>
                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <div class="book-card-author">@book.Author</div>
                            }
                            @if (book.Visibility == "PUBLIC")
                            {
                                <div class="book-card-rating">
                                    @if (book.RatingCount > 0)
                                    {
                                        <span>★ @book.AverageRating?.ToString("0.0", CultureInfo.InvariantCulture) (@book.RatingCount)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Noch keine Bewertungen</span>
                                    }
                                </div>
                            }
                            @if (!book.CanRead)
                            {
                                @if (book.Visibility == "PUBLIC")
                                {
                                    <AuthorizeView>
                                        <NotAuthorized>
                                            <span class="text-muted">Anmelden zum Lesen</span>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                }
                                else
                                {
                                    <span class="text-muted">Privat geteilt</span>
                                }
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </section>

    <section>
        <h2>Projekte</h2>
        @if (_profile.Projects.Count == 0)
        {
            <p class="text-muted">@_profile.Username hat noch keine öffentlichen Projekte.</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var project in _profile.Projects)
                {
                    <div class="project-card">
                        <div class="project-card-cover">
                            @if (_coverObjectUrls.TryGetValue($"project-{project.Id}", out var coverUrl))
                            {
                                <img src="@coverUrl" alt="@project.Title" />
                            }
                            else
                            {
                                <div class="project-card-cover-placeholder" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M3 12h18" />
                                        <path d="M12 3c2.8 2.6 4.2 5.8 4.2 9s-1.4 6.4-4.2 9c-2.8-2.6-4.2-5.8-4.2-9s1.4-6.4 4.2-9z" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="project-card-info">
                            <div class="project-card-title">@project.Title</div>
                            <div class="project-card-type">@ProjectTypeLabel.For(project.Type)</div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section>
        <h2>Aktivitäten</h2>
        @if (_profile.Activities.Count == 0)
        {
            <p class="text-muted">@_profile.Username hat noch keine öffentlichen Aktivitäten.</p>
        }
        else
        {
            <ul class="profile-activity-list">
                @foreach (var activity in _profile.Activities)
                {
                    <li class="profile-activity-item">
                        <span class="profile-activity-text">@ActivityText(activity)</span>
                        <span class="profile-activity-date text-muted">@FormatActivityDate(activity.CreatedAt)</span>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;

    private PublicProfileResponse? _profile;
    private bool _notFound;
    private bool _isTogglingFollow;
    private readonly Dictionary<string, string> _coverObjectUrls = [];

    protected override async Task OnParametersSetAsync()
    {
        await ClearCoversAsync();
        _profile = null;
        _notFound = false;
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        var response = await ApiClient.GetAsync<PublicProfileResponse>($"/api/users/{Username}/public");
        if (response is not { Success: true, Data: not null })
        {
            _notFound = true;
            return;
        }

        _profile = response.Data;

        foreach (var book in _profile.Books)
        {
            if (book.CoverUrl is null || _coverObjectUrls.ContainsKey($"book-{book.Id}")) continue;
            var result = await ApiClient.GetBytesAsync(book.CoverUrl);
            if (result is { } cover)
            {
                _coverObjectUrls[$"book-{book.Id}"] = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
            }
        }

        foreach (var project in _profile.Projects)
        {
            if (project.CoverUrl is null || _coverObjectUrls.ContainsKey($"project-{project.Id}")) continue;
            var result = await ApiClient.GetBytesAsync(project.CoverUrl);
            if (result is { } cover)
            {
                _coverObjectUrls[$"project-{project.Id}"] = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
            }
        }
    }

    private async Task ToggleFollowAsync()
    {
        if (_profile is null || _isTogglingFollow) return;
        _isTogglingFollow = true;

        var wasFollowing = _profile.IsFollowing;
        var succeeded = wasFollowing
            ? await ApiClient.DeleteAsync($"/api/users/{Username}/follow")
            : await ApiClient.PostAsync($"/api/users/{Username}/follow");

        if (succeeded)
        {
            _profile.IsFollowing = !wasFollowing;
            _profile.FollowerCount += wasFollowing ? -1 : 1;
        }

        _isTogglingFollow = false;
    }

    // activity.CreatedAt is D1's raw "yyyy-MM-dd HH:mm:ss" (UTC, no offset)
    // -- parsed explicitly here rather than via System.Text.Json (which
    // rejects that format outright), same reasoning as ProfileActivity's
    // CreatedAt being string, not DateTime.
    private static string FormatActivityDate(string createdAt)
    {
        if (!DateTime.TryParse(createdAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var parsed))
        {
            return createdAt;
        }
        return parsed.ToLocalTime().ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
    }

    // No deep link for now -- the linked book/project may have gone
    // non-public again since the activity was logged, and the activity
    // response doesn't carry a per-viewer canRead flag to gate a link
    // correctly. Plain text avoids offering a link that 404s.
    private static string ActivityText(ProfileActivity activity)
    {
        var title = activity.TargetTitle ?? "(gelöscht)";
        return activity.Type switch
        {
            "RATING_GIVEN" => $"hat „{title}“ mit {activity.Rating ?? 0} {(activity.Rating == 1 ? "Stern" : "Sternen")} bewertet",
            "BOOK_PUBLIC" => $"hat das Buch „{title}“ veröffentlicht",
            "PROJECT_PUBLIC" => $"hat das Projekt „{title}“ veröffentlicht",
            _ => title,
        };
    }

    private async Task ClearCoversAsync()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            await BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _coverObjectUrls.Clear();
    }

    public void Dispose()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
    }
}
