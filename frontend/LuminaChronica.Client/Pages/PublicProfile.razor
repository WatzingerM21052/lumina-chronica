@page "/u/{Username}"
@using System.Globalization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject IJSRuntime JsRuntime

<PageTitle>@(_profile?.Username ?? Username) — Lumina Chronica</PageTitle>

@if (_notFound)
{
    <div class="empty-state">
        <p>Dieses Profil existiert nicht.</p>
    </div>
}
else if (_profile is null)
{
    <span class="visually-hidden" role="status">Profil wird geladen…</span>
    <div class="profile-hero profile-hero-skeleton" aria-hidden="true" aria-busy="true">
        <div class="profile-hero-portrait skeleton-shape"></div>
        <div class="profile-hero-body">
            <div class="skeleton-shape skeleton-line skeleton-line-eyebrow"></div>
            <div class="skeleton-shape skeleton-line skeleton-line-name"></div>
            <div class="skeleton-shape skeleton-line skeleton-line-meta"></div>
        </div>
    </div>
}
else
{
    <div class="profile-hero" data-reveal style="--reveal-delay: 0ms">
        <div class="profile-hero-portrait-wrap">
            @if (_profile.AvatarUrl is { } avatarUrl)
            {
                <img src="@avatarUrl" alt="@_profile.Username" class="profile-hero-portrait" />
            }
            else
            {
                <div class="profile-hero-portrait profile-hero-portrait-placeholder" aria-hidden="true">
                    <Icon Name="person" Class="profile-hero-portrait-icon" />
                </div>
            }
        </div>
        <div class="profile-hero-body">
            <p class="profile-hero-eyebrow">Öffentliches Archiv</p>
            <h1 class="profile-hero-name">@_profile.Username</h1>
            <p class="profile-hero-meta">
                <span><strong>@_profile.FollowerCount</strong> Follower</span>
                <span><strong>@_profile.FollowingCount</strong> Folgt</span>
            </p>
        </div>
        @if (!_profile.IsOwnProfile)
        {
            <div class="profile-hero-actions">
                <AuthorizeView>
                    <Authorized>
                        <button type="button" class="btn-follow @(_profile.IsFollowing ? "is-following" : "")" disabled="@_isTogglingFollow" @onclick="ToggleFollowAsync">
                            @(_profile.IsFollowing ? "✓ Gefolgt" : "+ Folgen")
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>

    <section class="profile-chapter" data-reveal>
        <div class="profile-chapter-numeral-row"><span>I</span></div>
        <h2 class="chapter-title">Bibliothek <span class="chapter-caption">— Werke dieser Sammlung</span></h2>
        @if (_profile.Books.Count == 0)
        {
            <div class="empty-state-literary">
                <span class="empty-state-ornament" aria-hidden="true">❦</span>
                @if (_profile.IsOwnProfile)
                {
                    <p>Beginne deine Sammlung.</p>
                    <a class="btn btn-primary" href="library/upload">Buch hinzufügen</a>
                }
                else
                {
                    <p>@_profile.Username hat noch keine öffentlichen Bücher.</p>
                }
            </div>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var book in _profile.Books)
                {
                    <CatalogCard Kind="book"
                                 Href="@(book.CanRead ? $"library/books/{book.Id}" : null)"
                                 Title="@book.Title"
                                 Subtitle="@book.Author"
                                 CoverUrl="@(_coverObjectUrls.TryGetValue($"book-{book.Id}", out var coverUrl) ? coverUrl : null)"
                                 ShowRating="@(book.Visibility == "PUBLIC")"
                                 RatingAverage="@book.AverageRating"
                                 RatingCount="@book.RatingCount">
                        <FooterContent>
                            @if (!book.CanRead)
                            {
                                @if (book.Visibility == "PUBLIC")
                                {
                                    <AuthorizeView>
                                        <NotAuthorized>
                                            <span class="text-muted">Anmelden zum Lesen</span>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                }
                                else
                                {
                                    <span class="text-muted">Privat geteilt</span>
                                }
                            }
                        </FooterContent>
                    </CatalogCard>
                }
            </div>
        }
    </section>

    <section class="profile-chapter" data-reveal>
        <div class="profile-chapter-numeral-row"><span>II</span></div>
        <h2 class="chapter-title">Projekte <span class="chapter-caption">— Welten dieser Sammlung</span></h2>
        @if (_profile.Projects.Count == 0)
        {
            <div class="empty-state-literary">
                <span class="empty-state-ornament" aria-hidden="true">❦</span>
                <p>Dieses Archiv wurde noch mit keiner Welt gefüllt.</p>
            </div>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var project in _profile.Projects)
                {
                    @* No Href: ProjectDetail.razor is still the owner's private
                       editing workspace (characters/locations/timeline/lore,
                       all owner-only) with no public read-only view yet --
                       linking here would leak those controls to any visitor,
                       the same permission gap fixed for books earlier this
                       session. Matches the current (pre-redesign) behavior,
                       which also doesn't link this card. Public project
                       viewing is real scope, but a separate feature/story. *@
                    <CatalogCard Kind="project"
                                 Title="@project.Title"
                                 CoverUrl="@(_coverObjectUrls.TryGetValue($"project-{project.Id}", out var coverUrl) ? coverUrl : null)"
                                 TypeLabel="@ProjectTypeLabel.For(project.Type)" />
                }
            </div>
        }
    </section>

    <section class="profile-chapter" data-reveal>
        <div class="profile-chapter-numeral-row"><span>III</span></div>
        <h2 class="chapter-title">Aktivität <span class="chapter-caption">— zuletzt geschehen</span></h2>
        @if (_profile.Activities.Count == 0)
        {
            <div class="empty-state-literary">
                <span class="empty-state-ornament" aria-hidden="true">❦</span>
                <p>Noch keine öffentlichen Aktivitäten.</p>
            </div>
        }
        else
        {
            <ul class="profile-activity-list">
                @foreach (var activity in _profile.Activities)
                {
                    <li class="profile-activity-item">
                        <span class="profile-activity-dot" aria-hidden="true"></span>
                        <span class="profile-activity-text">@ActivityText(activity)</span>
                        <span class="profile-activity-date">@FormatActivityDate(activity.CreatedAt)</span>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;

    private PublicProfileResponse? _profile;
    private bool _notFound;
    private bool _isTogglingFollow;
    private readonly Dictionary<string, string> _coverObjectUrls = [];
    private IJSObjectReference? _motionModule;

    protected override async Task OnParametersSetAsync()
    {
        await ClearCoversAsync();
        _profile = null;
        _notFound = false;
        await LoadProfileAsync();
    }

    // Wires the hero + chapters' [data-reveal] scroll animation (issue
    // #341) on every render, not just the first -- MainLayout's own
    // OnAfterRenderAsync only fires for *its* renders, not this page's, so
    // it can't be the one to call initReveal after _profile finishes
    // loading (the actual chapters don't exist in the DOM until then).
    // initReveal itself is idempotent (skips sections it's already wired)
    // and re-checks viewport intersection fresh each call, so repeat calls
    // here are cheap and correct as layout settles (e.g. covers loading in).
    // Best-effort like LoadOfflineStatusAsync: motion is a progressive
    // enhancement, and this also swallows bUnit's unconfigured-JSInterop
    // exception in tests that don't set up ./js/motion.js.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _motionModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
            await _motionModule.InvokeVoidAsync("initReveal");
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadProfileAsync()
    {
        var response = await ApiClient.GetAsync<PublicProfileResponse>($"/api/users/{Username}/public");
        if (response is not { Success: true, Data: not null })
        {
            _notFound = true;
            return;
        }

        _profile = response.Data;

        // Covers are independent requests -- fetch them concurrently instead
        // of one-at-a-time (issue #349 Phase C). Capped at 6 in flight so a
        // full profile page doesn't fire more simultaneous requests than the
        // backend needs to see.
        using var throttle = new SemaphoreSlim(6);

        async Task<(string Key, string? Url)> FetchCoverAsync(string key, string? coverUrl)
        {
            await throttle.WaitAsync();
            try
            {
                var result = await ApiClient.GetBytesAsync(coverUrl!);
                return (key, result is { } cover ? await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType) : null);
            }
            finally
            {
                throttle.Release();
            }
        }

        var coverFetches = _profile.Books
            .Where(book => book.CoverUrl is not null && !_coverObjectUrls.ContainsKey($"book-{book.Id}"))
            .Select(book => FetchCoverAsync($"book-{book.Id}", book.CoverUrl))
            .Concat(_profile.Projects
                .Where(project => project.CoverUrl is not null && !_coverObjectUrls.ContainsKey($"project-{project.Id}"))
                .Select(project => FetchCoverAsync($"project-{project.Id}", project.CoverUrl)));

        foreach (var (key, url) in await Task.WhenAll(coverFetches))
        {
            if (url is not null) _coverObjectUrls[key] = url;
        }
    }

    private async Task ToggleFollowAsync()
    {
        if (_profile is null || _isTogglingFollow) return;
        _isTogglingFollow = true;

        var wasFollowing = _profile.IsFollowing;
        var succeeded = wasFollowing
            ? await ApiClient.DeleteAsync($"/api/users/{Username}/follow")
            : await ApiClient.PostAsync($"/api/users/{Username}/follow");

        if (succeeded)
        {
            _profile.IsFollowing = !wasFollowing;
            _profile.FollowerCount += wasFollowing ? -1 : 1;
        }

        _isTogglingFollow = false;
    }

    // activity.CreatedAt is D1's raw "yyyy-MM-dd HH:mm:ss" (UTC, no offset)
    // -- parsed explicitly here rather than via System.Text.Json (which
    // rejects that format outright), same reasoning as ProfileActivity's
    // CreatedAt being string, not DateTime.
    private static string FormatActivityDate(string createdAt)
    {
        if (!DateTime.TryParse(createdAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var parsed))
        {
            return createdAt;
        }
        return parsed.ToLocalTime().ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
    }

    // No deep link for now -- the linked book/project may have gone
    // non-public again since the activity was logged, and the activity
    // response doesn't carry a per-viewer canRead flag to gate a link
    // correctly. Plain text avoids offering a link that 404s.
    //
    // activity.Rating is null whenever the rater had ACTIVITY_RATING_STARS
    // off at the time they rated (activityService.recordRatingActivity
    // stores null, not a real value, in that case) -- rendered without a
    // star count rather than falling back to "0 Sternen", which would read
    // as a real (and wrong) rating value.
    private static string ActivityText(ProfileActivity activity)
    {
        var title = activity.TargetTitle ?? "(gelöscht)";
        return (activity.Type, activity.Rating) switch
        {
            ("RATING_GIVEN", { } rating) => $"hat „{title}“ mit {rating} {(rating == 1 ? "Stern" : "Sternen")} bewertet",
            ("RATING_GIVEN", null) => $"hat „{title}“ bewertet",
            ("BOOK_PUBLIC", _) => $"hat das Buch „{title}“ veröffentlicht",
            ("PROJECT_PUBLIC", _) => $"hat das Projekt „{title}“ veröffentlicht",
            _ => title,
        };
    }

    private async Task ClearCoversAsync()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            await BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _coverObjectUrls.Clear();
    }

    public void Dispose()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
        if (_motionModule is not null)
        {
            _ = _motionModule.DisposeAsync();
        }
    }
}
