@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject II18nService I18n
@inject IThemeService ThemeService

<PageTitle>Lumina Chronica</PageTitle>


<div class="home-hero-sentinel" @ref="_heroSentinelRef" aria-hidden="true"></div>
<div class="home-hero" @ref="_heroRef">
    <img src="images/dashboard-hero-layer1-background.webp" alt="" class="home-hero-layer home-hero-layer-1" fetchpriority="high" />
    <img src="images/dashboard-hero-layer2-lights.webp" alt="" class="home-hero-layer home-hero-layer-2" fetchpriority="low" decoding="async" />
    <img src="images/dashboard-hero-layer3-foreground.webp" alt="" class="home-hero-layer home-hero-layer-3" fetchpriority="low" decoding="async" />
    <div class="home-hero-scrim"></div>
    @* Themed worlds (Babylon, Alexandria): their own picture, light and
       plants. Hidden for every other theme; the pictures are CSS
       backgrounds in the theme files, so nothing loads unless one of those
       themes is active. *@
    <div class="home-hero-world" aria-hidden="true">
        <div class="home-hero-world-image"></div>
        <div class="home-hero-world-shade"></div>
        <div class="home-hero-rays"></div>
        <canvas class="home-hero-motes" @ref="_motesRef"></canvas>
        <div class="home-hero-flora">
            <span class="home-hero-wisteria home-hero-wisteria--a"></span>
            <span class="home-hero-wisteria home-hero-wisteria--b"></span>
            <span class="home-hero-wisteria home-hero-wisteria--c"></span>
            <span class="home-hero-wisteria home-hero-wisteria--d"></span>
        </div>
    </div>
    <div class="home-hero-content">
        <p class="home-hero-eyebrow home-hero-eyebrow--babylon">@I18n.T("home.eyebrowBabylon")</p>
        <p class="home-hero-eyebrow home-hero-eyebrow--alexandria">@I18n.T("home.eyebrowAlexandria")</p>
        <h1>@I18n.T("home.welcomeBack")</h1>
        <p class="home-hero-greek" lang="grc">ΒΙΒΛΙΟΘΗΚΗ ΑΛΕΞΑΝΔΡΕΙΑΣ</p>
        @if (_world is not null && _dashboard is { ContinueReading.Count: > 0 } && _dashboard.ContinueReading[0] is { } lastRead)
        {
            <p class="home-hero-lead">@HeroLead(lastRead)</p>
            <a class="home-hero-cta" href="@($"library/books/{lastRead.Book.Id}/read")">
                @I18n.T("home.continueReadingTitle")
                @if (CurrentPage(lastRead) is { } page)
                {
                    <small>@string.Format(System.Globalization.CultureInfo.InvariantCulture, I18n.T("home.pageShort"), page)</small>
                }
                <span class="home-hero-cta-go" aria-hidden="true">→</span>
            </a>
        }
    </div>
</div>

<StatusWidget />

@if (_world is not null)
{
    <WorldDashboard Dashboard="_dashboard" Books="_books" TotalBooks="_totalBooks" Projects="_projects" Genres="_genres"
                    ShowScrollShelf="_showScrollShelf" Goal="_goal" CalendarDays="_calendarDays" FeaturedPages="_featuredPages" />
}
else
{
    @if (_dashboard is { ContinueReading.Count: > 0 })
    {
        <h2>@I18n.T("home.continueReadingTitle")</h2>
        @* Bottom-aligned: the first card is the large featured one, so the
           smaller cards' titles and progress bars line up with its own. *@
        <div class="library-grid library-grid--strip continue-reading-grid">
            @for (var i = 0; i < _dashboard.ContinueReading.Count; i++)
            {
                var item = _dashboard.ContinueReading[i];
                <BookCard Book="item.Book" ProgressPercentage="item.Percentage" Href="@($"library/books/{item.Book.Id}/read")"
                          ShowFavorite="item.OwnerUsername is null" OwnerUsername="@item.OwnerUsername"
                          Size="@(i == 0 ? BookCardSize.Large : BookCardSize.Normal)" />
            }
        </div>
    }

    <h2>@I18n.T("home.libraryTitle")</h2>
    @if (_dashboard is not null)
    {
        <div class="dashboard-overview">
            <StatCard Value="@_dashboard.Overview.TotalBooks.ToString()" Label="@I18n.T("home.statBooks")" />
            <StatCard Value="@_dashboard.Overview.TotalShelves.ToString()" Label="@I18n.T("home.statShelves")" />
            <StatCard Value="@_dashboard.Overview.TotalFavorites.ToString()" Label="@I18n.T("home.statFavorites")" />
            <StatCard Value="@_dashboard.Overview.FinishedBooks.ToString()" Label="@I18n.T("home.statFinished")" />
        </div>
    }
    @if (_books is null)
    {
        <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Library" Text="@I18n.T("home.libraryLoading")" />
    }
    else if (_books.Count == 0)
    {
        <EmptyState Message="@I18n.T("home.emptyLibraryMessage")"
                    ActionText="@I18n.T("home.addBookAction")"
                    ActionHref="library/upload" />
    }
    else
    {
        @if (_showScrollShelf)
        {
            <ScrollShelf Books="_books" Genres="_genres" />
        }
        else
        {
            <div class="library-grid library-grid--strip">
                @foreach (var book in _books)
                {
                    <BookCard Book="book" />
                }
            </div>
        }
        @if (_totalBooks > _books.Count)
        {
            <p class="section-more"><a class="btn-link" href="library">@string.Format(I18n.T("home.viewFullLibraryLink"), _totalBooks) →</a></p>
        }
    }

    @if (_dashboard is { Recommendations.Count: > 0 })
    {
        <h2>@I18n.T("home.recommendationsTitle")</h2>
        <div class="library-grid library-grid--strip">
            @foreach (var book in _dashboard.Recommendations)
            {
                <BookCard Book="book" />
            }
        </div>
    }

    <h2>@I18n.T("home.recentProjectsTitle")</h2>
    @if (_projects is null)
    {
        <LoadingIndicator Text="@I18n.T("home.projectsLoading")" />
    }
    else if (_projects.Count == 0)
    {
        <EmptyState Message="@I18n.T("home.emptyProjectsMessage")"
                    ActionText="@I18n.T("home.createProjectAction")"
                    ActionHref="projects" />
    }
    else
    {
        <div class="library-grid library-grid--strip">
            @* Only shows newest projects; backend orders by created_at DESC (see projectService.listProjects) *@
            @foreach (var project in _projects.Take(RecentProjectsLimit))
            {
                <ProjectCard Project="project" />
            }
        </div>
        @if (_projects.Count > RecentProjectsLimit)
        {
            <p class="section-more"><a class="btn-link" href="projects">@string.Format(I18n.T("home.viewAllProjectsLink"), _projects.Count) →</a></p>
        }
    }
}

@code {
    private const int RecentBooksLimit = 6;
    private const int RecentProjectsLimit = 6;

    private ElementReference _heroRef;
    private ElementReference _heroSentinelRef;
    private IJSObjectReference? _motionModule;
    private ElementReference _motesRef;
    private IJSObjectReference? _atmosphereModule;
    private IJSObjectReference? _atmosphereHandle;

    private List<Book>? _books;
    private int _totalBooks;
    private DashboardResponse? _dashboard;
    private List<Project>? _projects;

    // Alexandria shows the library as its scroll shelf unless the user
    // switched back to the cover strip in Settings (only offered there).
    private bool _showScrollShelf;
    private IReadOnlyList<string> _genres = [];

    // "babylon" / "alexandria" while one of the themed worlds is active:
    // Home then uses the studio dashboard (WorldDashboard) and loads the
    // goal, the calendar and the featured book's page count for it.
    private string? _world;
    private ReadingGoal? _goal;
    private List<CalendarDay> _calendarDays = [];
    private int? _featuredPages;

    protected override async Task OnInitializedAsync()
    {
        _world = await WorldThemeAsync();
        _showScrollShelf = _world == "alexandria" && await ScrollShelfPreferenceAsync();
        var facetsTask = _showScrollShelf ? ApiClient.GetAsync<BookFacets>("/api/books/facets") : null;
        var statisticsTask = _world is not null ? ApiClient.GetAsync<StatisticsResponse>("/api/statistics") : null;
        var dashboardTask = ApiClient.GetAsync<DashboardResponse>("/api/dashboard");
        var projectsTask = ApiClient.GetAsync<List<Project>>("/api/projects");
        var response = await ApiClient.GetAsync<BookListResponse>($"/api/books?sort=createdAt&order=desc&pageSize={RecentBooksLimit}");
        if (response is { Success: true, Data: not null })
        {
            _books = response.Data.Items;
            _totalBooks = response.Data.Total;
        }
        else
        {
            _books = [];
        }

        var dashboardResponse = await dashboardTask;
        _dashboard = dashboardResponse is { Success: true, Data: not null } ? dashboardResponse.Data : new DashboardResponse();

        var projectsResponse = await projectsTask;
        _projects = projectsResponse is { Success: true, Data: not null } ? projectsResponse.Data : [];

        if (facetsTask is not null && await facetsTask is { Success: true, Data: not null } facetsResponse)
        {
            _genres = facetsResponse.Data.Genres;
        }

        if (statisticsTask is not null && await statisticsTask is { Success: true, Data: not null } statistics)
        {
            _goal = statistics.Data.Goal;
            _calendarDays = statistics.Data.ReadingCalendar;
        }

        if (_world is not null && _dashboard.ContinueReading.FirstOrDefault() is { } featured)
        {
            var detail = await ApiClient.GetAsync<Book>($"/api/books/{featured.Book.Id}");
            _featuredPages = detail is { Success: true, Data.Pages: > 0 } ? detail.Data.Pages : null;
        }
    }

    private async Task<string?> WorldThemeAsync()
    {
        try
        {
            var theme = await ThemeService.GetThemeAsync();
            return theme is "babylon" or "alexandria" ? theme : null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private int? CurrentPage(ContinueReadingItem item) =>
        _featuredPages is { } pages ? Math.Max(1, (int)Math.Round(Math.Clamp(item.Percentage, 0, 100) / 100 * pages)) : null;

    // "Du warst gestern zuletzt bei „Dune“. Noch 86 Seiten bis zum Ende."
    private string HeroLead(ContinueReadingItem item)
    {
        var when = WorldDashboard.RelativeDay(I18n, item.LastOpened);
        var lead = string.Format(I18n.T("home.heroLead"), when, item.Book.Title);
        if (_featuredPages is { } pages && CurrentPage(item) is { } page && pages - page > 0)
        {
            lead += " " + string.Format(System.Globalization.CultureInfo.InvariantCulture, I18n.T("home.heroPagesLeft"), pages - page);
        }
        return lead;
    }

    private async Task<bool> ScrollShelfPreferenceAsync()
    {
        try
        {
            var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
            // null = never chosen: the shelf is the default.
            return await module.InvokeAsync<bool?>("getHomeScrollShelf") ?? true;
        }
        catch (Exception)
        {
            return false;
        }
    }

    // Reuses motion.js's initHeaderCompact for the hero itself (already
    // generic over any header/sentinel element pair, not app-header-
    // specific). Wired here rather than in MainLayout because this
    // sentinel is Home-page-only; MainLayout's own OnAfterRenderAsync only
    // ever wires the app-wide header. Wrapped in try/catch matching
    // Discover.razor/PublicProfile.razor's own motion.js wiring — a
    // blocked/failed module load just leaves the hero uncompacted, same
    // "progressive enhancement" shape as everywhere else this module is used.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _motionModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
            await _motionModule.InvokeVoidAsync("initHeaderCompact", _heroRef, _heroSentinelRef);
        }
        catch (Exception)
        {
        }

        // Fireflies (Babylon) or dust in the light (Alexandria); the module
        // itself idles under every other theme and wakes on a theme switch.
        try
        {
            _atmosphereModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/themeAtmosphere.js");
            _atmosphereHandle = await _atmosphereModule.InvokeAsync<IJSObjectReference>("start", _motesRef);
        }
        catch (Exception)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_atmosphereModule is not null && _atmosphereHandle is not null)
            {
                await _atmosphereModule.InvokeVoidAsync("stop", _atmosphereHandle);
            }
            if (_atmosphereHandle is not null) await _atmosphereHandle.DisposeAsync();
            if (_atmosphereModule is not null) await _atmosphereModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        if (_motionModule is not null)
        {
            try
            {
                await _motionModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
