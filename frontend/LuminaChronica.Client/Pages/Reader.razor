@page "/library/books/{Id:int}/read"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using Markdig
@using Markdig.Extensions.AutoIdentifiers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject ScrollTrackerService ScrollTracker
@inject TextPaginatorService TextPaginator
@inject ReaderSettingsService ReaderSettings
@inject OfflineStorageService OfflineStorage

<PageTitle>@(_book?.Title ?? "Lesen") — Lumina Chronica</PageTitle>

<a href="@($"library/books/{Id}")">← Zurück zum Buch</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_book is null)
{
    <LoadingIndicator Text="Buch wird geladen..." />
}
else if (_book.File is null)
{
    <p class="form-error">Für dieses Buch ist keine Datei hinterlegt.</p>
}
else
{
    @if (_book.File.Format is "TXT" or "MD" or "EPUB" or "PDF")
    {
        <div class="reader-controls">
            <div class="reader-settings-menu">
                <button type="button" class="btn" @onclick="ToggleSettingsMenu">⚙ Einstellungen</button>
                @if (_settingsMenuOpen)
                {
                    <div class="reader-settings-popover">
                        @if (_book.File.Format is "TXT" or "MD" or "EPUB" or "PDF")
                        {
                            <div class="reader-setting-row">
                                <span class="reader-setting-label">Ansicht</span>
                                <span class="reader-setting-group">
                                    <button type="button" class="btn @(_readerMode == "book" ? "is-active" : "")" @onclick='() => SetReaderMode("book")'>Buch</button>
                                    <button type="button" class="btn @(_readerMode == "scroll" ? "is-active" : "")" @onclick='() => SetReaderMode("scroll")'>Scroll</button>
                                    @* EPUB's Realistic View (issue #189) stays gated off here -- the section-capture
                                       implementation still has an unresolved bug where it silently falls back to
                                       looking identical to Buch View, so the toggle is hidden again rather than
                                       offering a mode that doesn't actually work. epubReader.js's realistic-view
                                       code is deliberately left in place (not reverted) as a starting point for a
                                       future attempt -- only this toggle is hidden. PDF's Realistic View is
                                       unaffected and stays available. *@
                                    @if (_book.File.Format is "PDF")
                                    {
                                        <button type="button" class="btn @(_readerMode == "realistic" ? "is-active" : "")" @onclick='() => SetReaderMode("realistic")'>Realistisch</button>
                                    }
                                </span>
                            </div>
                            @if (_readerMode == "scroll" && _book.File.Format is "EPUB" or "PDF")
                            {
                                <div class="reader-setting-row">
                                    <span class="reader-setting-label">Scrollbalken ausblenden</span>
                                    <input type="checkbox" checked="@_hideScrollbars" @onchange="SetHideScrollbars" />
                                </div>
                            }
                            @if (_readerMode == "book" && _book.File.Format is "TXT" or "MD")
                            {
                                <div class="reader-setting-row">
                                    <span class="reader-setting-label">Seite pro Kapitel</span>
                                    <input type="checkbox" checked="@_pagePerChapter" @onchange="SetPagePerChapter" />
                                </div>
                                @if (_pagePerChapter)
                                {
                                    <div class="reader-setting-row">
                                        <span class="reader-setting-label">Scrollbalken ausblenden</span>
                                        <input type="checkbox" checked="@_hideScrollbars" @onchange="SetHideScrollbars" />
                                    </div>
                                }
                            }
                        }
                        @if (_book.File.Format is not "PDF")
                        {
                            <div class="reader-setting-row">
                                <span class="reader-setting-label">Schriftgröße</span>
                                <span class="reader-setting-group">
                                    <button type="button" class="btn" @onclick="DecreaseFontSize">A-</button>
                                    <span>@(_fontSize)px</span>
                                    <button type="button" class="btn" @onclick="IncreaseFontSize">A+</button>
                                </span>
                            </div>
                            <div class="reader-setting-row">
                                <span class="reader-setting-label">Schriftart</span>
                                <span class="reader-setting-group">
                                    <button type="button" class="btn @(_fontFamily == "serif" ? "is-active" : "")" @onclick='() => SetFontFamily("serif")'>Serif</button>
                                    <button type="button" class="btn @(_fontFamily == "sans" ? "is-active" : "")" @onclick='() => SetFontFamily("sans")'>Sans</button>
                                </span>
                            </div>
                            <div class="reader-setting-row">
                                <span class="reader-setting-label">Zeilenabstand</span>
                                <span class="reader-setting-group">
                                    <button type="button" class="btn @(_lineHeight == "tight" ? "is-active" : "")" @onclick='() => SetLineHeight("tight")'>Eng</button>
                                    <button type="button" class="btn @(_lineHeight == "normal" ? "is-active" : "")" @onclick='() => SetLineHeight("normal")'>Normal</button>
                                    <button type="button" class="btn @(_lineHeight == "loose" ? "is-active" : "")" @onclick='() => SetLineHeight("loose")'>Weit</button>
                                </span>
                            </div>
                        }
                        <div class="reader-setting-row">
                            <span class="reader-setting-label">Seitenbreite</span>
                            <span class="reader-setting-group">
                                <button type="button" class="btn @(_pageWidth == "narrow" ? "is-active" : "")" @onclick='() => SetPageWidth("narrow")'>Schmal</button>
                                <button type="button" class="btn @(_pageWidth == "normal" ? "is-active" : "")" @onclick='() => SetPageWidth("normal")'>Normal</button>
                                <button type="button" class="btn @(_pageWidth == "wide" ? "is-active" : "")" @onclick='() => SetPageWidth("wide")'>Breit</button>
                            </span>
                        </div>
                        <button type="button" class="btn reader-settings-done" @onclick="ToggleSettingsMenu">Fertig</button>
                    </div>
                }
            </div>
            <div class="reader-settings-menu">
                <button type="button" class="btn" @onclick="ToggleBookmarksMenuAsync">🔖 Lesezeichen</button>
                @if (_bookmarksMenuOpen)
                {
                    <div class="reader-settings-popover reader-bookmarks-popover">
                        <div class="reader-setting-row">
                            <input type="text" class="reader-bookmark-note-input" placeholder="Notiz (optional)" value="@_newBookmarkNote" @oninput="e => _newBookmarkNote = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <button type="button" class="btn btn-primary" @onclick="AddBookmarkAsync">+ Aktuelle Seite merken</button>
                        @if (_bookmarks is { Count: 0 })
                        {
                            <p class="text-muted">Noch keine Lesezeichen.</p>
                        }
                        else if (_bookmarks is not null)
                        {
                            <ul class="reader-bookmarks-list">
                                @foreach (var bookmark in _bookmarks)
                                {
                                    <li class="reader-bookmark-item">
                                        <button type="button" class="reader-bookmark-jump" @onclick="() => GoToBookmarkAsync(bookmark)">
                                            <span class="reader-bookmark-percentage">@bookmark.Percentage.ToString("F0", CultureInfo.InvariantCulture)%</span>
                                            <span class="reader-bookmark-note">@(string.IsNullOrWhiteSpace(bookmark.Note) ? "Lesezeichen" : bookmark.Note)</span>
                                        </button>
                                        <button type="button" class="btn reader-bookmark-delete" @onclick="() => DeleteBookmarkAsync(bookmark.Id)" aria-label="Lesezeichen löschen">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                        <button type="button" class="btn reader-settings-done" @onclick="ToggleBookmarksMenuAsync">Fertig</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_book.File.Format is "TXT" or "MD")
    {
        <div id="@ContentViewportId" class="@ReaderContentClass" style="font-size: @(_fontSize)px">
            @* #reader-content-inner is left without a Razor-bound style attribute
               deliberately -- textPaginator.js sets column-width/column-gap/
               height/transform on it directly, and a Blazor-bound style would
               clobber those on every re-render (the same lesson PdfReader hit
               with its own JS-sized elements, see Architecture.md). *@
            <div id="@ContentInnerId">
                @if (_readerMode == "book" && _pagePerChapter)
                {
                    @if (_book.File.Format == "TXT")
                    {
                        <pre class="reader-content-txt-segment">@CurrentChapterSegment</pre>
                    }
                    else
                    {
                        @((MarkupString)CurrentChapterSegment)
                    }
                }
                else if (_book.File.Format == "TXT")
                {
                    @foreach (var segment in _txtSegments)
                    {
                        <pre class="reader-content-txt-segment">@segment</pre>
                    }
                }
                else
                {
                    @((MarkupString)(_renderedMarkdown ?? string.Empty))
                }
            </div>
        </div>
        @if (_readerMode == "book")
        {
            <div class="reader-content-nav @(_pageWidth switch { "narrow" => "reader-content-nav--width-narrow", "wide" => "reader-content-nav--width-wide", _ => "" })">
                <button type="button" class="btn" @onclick="PrevTxtMdPageAsync" disabled="@(_txtMdCurrentPage <= 1)">◀ Zurück</button>
                <span>Seite @_txtMdCurrentPage / @_txtMdPageCount</span>
                <button type="button" class="btn" @onclick="NextTxtMdPageAsync" disabled="@(_txtMdCurrentPage >= _txtMdPageCount)">Weiter ▶</button>
            </div>
        }
    }
    else if (_book.File.Format == "EPUB" && _epubBytes is not null)
    {
        <EpubReader @ref="_epubReaderRef" Bytes="@_epubBytes" InitialCfi="@_initialCfi" FontSize="@_fontSize" FontFamily="@_fontFamily" LineHeight="@_lineHeight" PageWidth="@_pageWidth" ReaderMode="@_readerMode" HideScrollbars="@_hideScrollbars" OnProgress="HandleEpubProgress" />
    }
    else if (_book.File.Format == "PDF" && _pdfBytes is not null)
    {
        <PdfReader @ref="_pdfReaderRef" Bytes="@_pdfBytes" InitialPage="@_initialPage" ReaderMode="@_readerMode" PageWidth="@_pageWidth" HideScrollbars="@_hideScrollbars" OnProgress="HandlePdfProgress" OnRealisticUnavailable="HandleRealisticUnavailable" />
    }
    else
    {
        <p class="text-muted">Dieses Format wird in einer späteren Story unterstützt.</p>
    }
}

@code {
    // UseAutoIdentifiers: without it, Markdig headings get no id attribute at
    // all, so a hand-written TOC's #kapitel-1--... links have nothing to
    // target -- confirmed via a real MD file with such a TOC, reported live.
    // GitHub option specifically: Markdig's *default* slug algorithm collapses
    // "Kapitel 1 – Der..." to a single hyphen (kapitel-1-der-...), but a TOC
    // written assuming GitHub's own preview renderer expects GitHub's algorithm
    // (kapitel-1--der..., double hyphen from " – ") -- verified directly
    // against the reported file's exact heading text before picking this,
    // not assumed.
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder().DisableHtml().UseAutoIdentifiers(AutoIdentifierOptions.GitHub).Build();
    private static readonly TimeSpan SaveInterval = TimeSpan.FromSeconds(15);

    [Parameter]
    public int Id { get; set; }

    // A literal marker line a TXT author can place to force a page break in
    // Book View (there's no other structure in plain text to hang one off,
    // unlike MD's "---" which already renders as a real <hr> element) --
    // user-requested. Split out at render time into separate <pre> blocks so
    // CSS break-after (see .reader-content-txt-segment in app.css) has an
    // element boundary to act on.
    private const string TxtPageBreakMarker = "---Seitenumbruch---";

    private Book? _book;
    private string? _loadErrorMessage;
    private string? _textContent;
    private List<string> _txtSegments = [];
    private string? _renderedMarkdown;
    private List<string> _mdSegments = [];
    private Dictionary<string, int> _mdHeadingSegmentIndex = new();
    private byte[]? _epubBytes;
    private string? _initialCfi;
    private EpubProgress? _latestEpubProgress;
    private byte[]? _pdfBytes;
    private int _initialPage = 1;
    private PdfProgress? _latestPdfProgress;
    private int _fontSize = 18;
    private string _fontFamily = "serif";
    private string _lineHeight = "normal";
    private string _pageWidth = "normal";
    private string _readerMode = "book";
    private bool _hideScrollbars;
    // "Seite pro Kapitel" (source follow-up to issue #155): each chapter/
    // segment becomes its own scrollable page instead of flowing through
    // textPaginator.js's fixed-size CSS-column pages -- see the checkbox's
    // reader-setting-row and CurrentChapterSegment/ChapterSegments below.
    private bool _pagePerChapter;
    private bool _settingsMenuOpen;
    private Timer? _saveTimer;

    // Bookmarks (v1.5) -- distinct from _saveTimer's auto-saved resume
    // position: a user can have any number of these per book. _bookmarks
    // stays null until the popover is opened once (lazy-loaded, not fetched
    // on every page load) and is kept in sync locally after add/delete so
    // reopening the popover doesn't need a second round trip.
    private EpubReader? _epubReaderRef;
    private PdfReader? _pdfReaderRef;
    private List<Bookmark>? _bookmarks;
    private bool _bookmarksMenuOpen;
    private string _newBookmarkNote = "";

    // TXT/MD Book View pagination (issue #155) -- textPaginator.js state.
    private const string ContentViewportId = "reader-content";
    private const string ContentInnerId = "reader-content-inner";
    private int _txtMdPageCount = 1;
    private int _txtMdCurrentPage = 1;
    private string? _pendingRestorePosition;
    private bool _txtMdReaderModeChangedSinceRender;
    private bool _txtMdLayoutChangedSinceRender;
    private bool _txtMdPaginationInitialized;
    private DotNetObjectReference<Reader>? _txtMdDotNetRef;

    private string ReaderContentClass => string.Join(" ", new[]
    {
        "reader-content",
        _fontFamily == "sans" ? "reader-content--font-sans" : null,
        _lineHeight switch { "tight" => "reader-content--line-tight", "loose" => "reader-content--line-loose", _ => null },
        _pageWidth switch { "narrow" => "reader-content--width-narrow", "wide" => "reader-content--width-wide", _ => null },
        _book?.File?.Format is "TXT" or "MD" && _readerMode == "book" && !_pagePerChapter ? "reader-content--paginated" : null,
        _book?.File?.Format is "TXT" or "MD" && _readerMode == "book" && _pagePerChapter && _hideScrollbars ? "scrollbar-hide-both" : null,
    }.Where(c => c is not null));

    // The segmentation source for "Seite pro Kapitel" mode -- TXT reuses the
    // same marker-split segments the flowed layout's break-after rule
    // already relies on; MD splits on rendered <hr> boundaries (Markdig
    // always renders a thematic break as <hr /> regardless of whether the
    // source used "---", "***", or "___").
    private List<string> ChapterSegments => _book?.File?.Format == "TXT" ? _txtSegments : _mdSegments;

    private string CurrentChapterSegment
    {
        get
        {
            var segments = ChapterSegments;
            if (segments.Count == 0) return string.Empty;
            var index = Math.Clamp(_txtMdCurrentPage - 1, 0, segments.Count - 1);
            return segments[index];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _fontSize = await ReaderSettings.GetFontSizeAsync();
        _fontFamily = await ReaderSettings.GetFontFamilyAsync();
        _lineHeight = await ReaderSettings.GetLineHeightAsync();
        _pageWidth = await ReaderSettings.GetPageWidthAsync();
        _readerMode = await ReaderSettings.GetReaderModeAsync();
        _hideScrollbars = await ReaderSettings.GetHideScrollbarsAsync();
        _pagePerChapter = await ReaderSettings.GetPagePerChapterAsync();

        var bookResponse = await ApiClient.GetAsync<Book>($"/api/books/{Id}");

        Book? book = null;
        OfflineBookFile? offlineFile = null;
        if (bookResponse is { Success: true, Data: { } data })
        {
            book = data;
        }
        else
        {
            // No network/backend reachable -- fall back to a copy the user
            // explicitly saved earlier via BookDetail.razor's "Offline
            // speichern". Without this, losing connectivity would break the
            // exact feature it exists to support.
            offlineFile = await TryGetOfflineFileAsync();
            if (offlineFile is not null)
            {
                book = new Book { Id = Id, Title = offlineFile.Title, Author = offlineFile.Author, File = new BookFile { Format = offlineFile.Format, Size = offlineFile.FileBytes.LongLength } };
            }
        }

        if (book is null)
        {
            _loadErrorMessage = bookResponse?.Error?.Message ?? "Buch konnte nicht geladen werden.";
            return;
        }
        _book = book;

        // A "realistic" mode saved from before the toggle above was hidden again
        // (issue #189) would otherwise still reach EpubReader's ReaderMode
        // parameter and try to init the broken realistic view on every load --
        // the toggle being hidden only stops new selections, not an already
        // -persisted one. Correct and persist it once here instead.
        if (_book.File?.Format == "EPUB" && _readerMode == "realistic")
        {
            _readerMode = "book";
            await ReaderSettings.SetReaderModeAsync(_readerMode);
        }

        // _readerMode is a single global persisted setting shared across every
        // format -- a user who last read a PDF in "realistic" mode would
        // otherwise arrive at a TXT/MD file with that same invalid value, and
        // TXT/MD only ever understands "book"/"scroll". Same coercion pattern
        // as the EPUB guard above.
        if (_book.File?.Format is "TXT" or "MD" && _readerMode is not ("book" or "scroll"))
        {
            _readerMode = "book";
            await ReaderSettings.SetReaderModeAsync(_readerMode);
        }

        if (_book.File is null || _book.File.Format is not ("TXT" or "MD" or "EPUB" or "PDF"))
        {
            return;
        }

        var fileBytes = offlineFile?.FileBytes;
        if (fileBytes is null)
        {
            var fileResult = await ApiClient.GetBytesAsync($"/api/books/{Id}/file");
            fileBytes = fileResult?.Bytes ?? (await TryGetOfflineFileAsync())?.FileBytes;
        }

        if (fileBytes is null)
        {
            _loadErrorMessage = "Buchdatei konnte nicht geladen werden.";
            return;
        }

        var progressResponse = await ApiClient.GetAsync<ReadingProgress>($"/api/reading/{Id}");
        var savedPosition = progressResponse is { Success: true, Data: not null } ? progressResponse.Data.Position : null;

        if (_book.File.Format == "EPUB")
        {
            _epubBytes = fileBytes;
            _initialCfi = savedPosition;
            _saveTimer?.Dispose();
            _saveTimer = new Timer(_ => _ = SaveProgressAsync(), null, SaveInterval, SaveInterval);
            return;
        }

        if (_book.File.Format == "PDF")
        {
            _pdfBytes = fileBytes;
            _initialPage = savedPosition is { } pageText && int.TryParse(pageText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var page)
                ? page
                : 1;
            _saveTimer?.Dispose();
            _saveTimer = new Timer(_ => _ = SaveProgressAsync(), null, SaveInterval, SaveInterval);
            return;
        }

        var text = Encoding.UTF8.GetString(fileBytes);
        if (_book.File.Format == "MD")
        {
            _renderedMarkdown = Markdown.ToHtml(text, MarkdownPipeline);
            _mdSegments = Regex.Split(_renderedMarkdown, @"<hr\s*/?>", RegexOptions.IgnoreCase)
                .Select(segment => segment.Trim())
                .Where(segment => segment.Length > 0)
                .ToList();
            if (_mdSegments.Count == 0)
            {
                _mdSegments = [_renderedMarkdown];
            }

            // Maps each heading id to the segment it lives in, so a TOC link
            // clicked while a *different* segment is showing (the common
            // case -- the TOC itself is usually its own leading segment)
            // knows which page to switch to; see OnChapterAnchorNotFound.
            _mdHeadingSegmentIndex = new Dictionary<string, int>();
            for (var i = 0; i < _mdSegments.Count; i++)
            {
                foreach (Match match in Regex.Matches(_mdSegments[i], "id=\"([^\"]+)\""))
                {
                    _mdHeadingSegmentIndex[match.Groups[1].Value] = i;
                }
            }
        }
        else
        {
            _textContent = text;
            _txtSegments = text.Split(TxtPageBreakMarker)
                .Select(segment => segment.Trim('\r', '\n'))
                .ToList();
        }

        // Book mode's restore (a page index, not a fraction) happens in
        // OnAfterRenderAsync instead -- textPaginator.js needs to measure
        // real layout first to know the page count savedPosition converts
        // against, which isn't available yet at this point in the lifecycle.
        _pendingRestorePosition = savedPosition;

        StateHasChanged();

        if (_readerMode == "scroll")
        {
            var savedFraction = savedPosition is { } positionText &&
                double.TryParse(positionText, NumberStyles.Float, CultureInfo.InvariantCulture, out var fraction)
                ? fraction
                : (double?)null;

            if (savedFraction is { } resumeFraction)
            {
                await Task.Delay(50); // let the content render before restoring scroll position
                await ScrollTracker.SetScrollFractionAsync(ContentViewportId, resumeFraction);
            }
        }

        _saveTimer?.Dispose();
        _saveTimer = new Timer(_ => _ = SaveProgressAsync(), null, SaveInterval, SaveInterval);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_book?.File?.Format is not ("TXT" or "MD")) return;

        // Deliberately not gated on Blazor's own `firstRender` -- that flag
        // means "the first time this component ever rendered", which fires
        // during OnParametersSetAsync's very first await suspension (while
        // _book/_textContent/_renderedMarkdown are all still null, well
        // before the content that needs paginating exists). Gating on
        // firstRender here silently skipped pagination init on every real
        // load; this checks readiness directly and only runs once instead.
        if (!_txtMdPaginationInitialized && (_textContent is not null || _renderedMarkdown is not null))
        {
            _txtMdPaginationInitialized = true;
            if (_readerMode == "book" && _pagePerChapter)
            {
                await InitChapterModeAsync(restorePosition: true);
            }
            else if (_readerMode == "book")
            {
                await InitTxtMdPaginationAsync(restorePosition: true);
            }
            return;
        }

        if (_txtMdReaderModeChangedSinceRender)
        {
            _txtMdReaderModeChangedSinceRender = false;
            if (_readerMode == "book" && _pagePerChapter)
            {
                await TextPaginator.DestroyAsync(ContentInnerId);
                await InitChapterModeAsync(restorePosition: false);
            }
            else if (_readerMode == "book")
            {
                await TextPaginator.DestroyChapterModeAsync(ContentInnerId);
                await InitTxtMdPaginationAsync(restorePosition: false);
            }
            else
            {
                await TextPaginator.DestroyAsync(ContentInnerId);
                await TextPaginator.DestroyChapterModeAsync(ContentInnerId);
            }
            StateHasChanged();
        }
        else if (_txtMdLayoutChangedSinceRender && _readerMode == "book" && !_pagePerChapter)
        {
            // A font-size/family/line-height/page-width change resizes the
            // content -- pageCount can change entirely, so the current page
            // index alone is meaningless afterward. Convert through a
            // fraction (same conversion the saved-position migration uses)
            // instead of just clamping the old page number into the new range.
            _txtMdLayoutChangedSinceRender = false;
            var fraction = _txtMdPageCount > 1 ? (double)(_txtMdCurrentPage - 1) / (_txtMdPageCount - 1) : 0;
            _txtMdPageCount = await TextPaginator.RelayoutAsync(ContentViewportId, ContentInnerId);
            var targetPage = _txtMdPageCount > 1 ? (int)Math.Round(fraction * (_txtMdPageCount - 1)) + 1 : 1;
            _txtMdCurrentPage = await TextPaginator.GoToPageAsync(ContentInnerId, targetPage);
            StateHasChanged();
        }
        else if (_txtMdLayoutChangedSinceRender)
        {
            // Chapter-mode page count is the segment count, which a font-
            // size/width change never affects -- nothing to relayout, the
            // div's own style attribute already picks up the new font-size.
            _txtMdLayoutChangedSinceRender = false;
        }
    }

    private async Task InitTxtMdPaginationAsync(bool restorePosition)
    {
        _txtMdDotNetRef ??= DotNetObjectReference.Create(this);
        _txtMdPageCount = await TextPaginator.InitAsync(ContentViewportId, ContentInnerId, _txtMdDotNetRef);
        var targetPage = restorePosition && _pendingRestorePosition is { } raw
            ? ConvertSavedPositionToPage(raw, _txtMdPageCount)
            : 1;
        _txtMdCurrentPage = await TextPaginator.GoToPageAsync(ContentInnerId, targetPage);
        StateHasChanged();
    }

    private async Task InitChapterModeAsync(bool restorePosition)
    {
        _txtMdPageCount = Math.Max(1, ChapterSegments.Count);
        _txtMdDotNetRef ??= DotNetObjectReference.Create(this);
        var targetPage = restorePosition && _pendingRestorePosition is { } raw
            ? ConvertSavedPositionToPage(raw, _txtMdPageCount)
            : 1;
        _txtMdCurrentPage = Math.Clamp(targetPage, 1, _txtMdPageCount);
        await TextPaginator.InitChapterModeAsync(ContentInnerId, _txtMdDotNetRef);
        StateHasChanged();
    }

    // Fired from textPaginator.js's initChapterMode when a TOC/anchor click
    // targets a heading id that isn't in the currently-rendered segment
    // (chapter mode only ever renders one segment at a time, unlike the
    // flowed layout where every page already sits in the DOM) -- look up
    // which segment owns it and switch. Native scroll already handled the
    // case where the id IS in the current segment, so this only needs to
    // move to the right page; the new segment renders from its own top,
    // which is normally exactly where the heading is.
    [JSInvokable]
    public void OnChapterAnchorNotFound(string id)
    {
        if (_book?.File?.Format == "MD" && _mdHeadingSegmentIndex.TryGetValue(id, out var index))
        {
            _txtMdCurrentPage = Math.Clamp(index + 1, 1, _txtMdPageCount);
            StateHasChanged();
        }
    }

    // Fired from textPaginator.js when a TOC/anchor link click inside the
    // paginated content jumps to a different page -- native browser anchor
    // scrolling can't work through #reader-content's overflow:hidden +
    // transform-based pagination, so the JS click handler computes the
    // target page and turns to it directly, then reports back here so the
    // "Seite X / Y" nav bar (and the next Weiter/Zurück click, which reads
    // _txtMdCurrentPage) doesn't go stale.
    [JSInvokable]
    public void OnTxtMdPageChanged(int page)
    {
        _txtMdCurrentPage = page;
        StateHasChanged();
    }

    // Saved TXT/MD positions predate real pagination and are 0-1 scroll
    // fractions (always written with "F4" -- see SaveProgressAsync -- so
    // they always contain a '.'); a page index written by this feature
    // never does. That's a real invariant of the existing data, not a
    // guess, and is how a legacy fraction is told apart from a page index
    // without a schema change.
    private static int ConvertSavedPositionToPage(string raw, int pageCount)
    {
        if (raw.Contains('.') && double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var fraction))
        {
            var clamped = Math.Clamp(fraction, 0, 1);
            return pageCount > 1 ? (int)Math.Round(clamped * (pageCount - 1)) + 1 : 1;
        }

        if (int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var page))
        {
            return Math.Clamp(page, 1, pageCount);
        }

        return 1;
    }

    private async Task PrevTxtMdPageAsync()
    {
        _txtMdCurrentPage = _pagePerChapter
            ? Math.Max(1, _txtMdCurrentPage - 1)
            : await TextPaginator.GoToPageAsync(ContentInnerId, _txtMdCurrentPage - 1);
    }

    private async Task NextTxtMdPageAsync()
    {
        _txtMdCurrentPage = _pagePerChapter
            ? Math.Min(_txtMdPageCount, _txtMdCurrentPage + 1)
            : await TextPaginator.GoToPageAsync(ContentInnerId, _txtMdCurrentPage + 1);
    }

    private async Task<OfflineBookFile?> TryGetOfflineFileAsync()
    {
        try
        {
            return await OfflineStorage.GetBookFileAsync(Id);
        }
        catch (Exception)
        {
            return null;
        }
    }

    private Task HandleEpubProgress(EpubProgress progress)
    {
        _latestEpubProgress = progress;
        return Task.CompletedTask;
    }

    private Task HandlePdfProgress(PdfProgress progress)
    {
        _latestPdfProgress = progress;
        return Task.CompletedTask;
    }

    // Realistic View failed inside pdfReader.js and already fell back to
    // Book View on its own -- this just corrects _readerMode/persisted
    // settings to match, so the Ansicht toggle stops claiming Realistisch
    // is still active while a single Book View page is what's on screen.
    // Explicit StateHasChanged (unlike SetReaderMode's other callers, all
    // plain @onclick handlers where Blazor re-renders automatically): this
    // one arrives via a [JSInvokable] call on a child component, a path
    // that doesn't reliably trigger this component's own re-render on its
    // own.
    private async Task HandleRealisticUnavailable()
    {
        await SetReaderMode("book");
        StateHasChanged();
    }

    // Shared by SaveProgressAsync (auto-save) and AddBookmarkAsync (a
    // user-created marker at the same current position) -- both need the
    // exact same per-format location. Returns null only for EPUB/PDF before
    // their first OnProgress callback has fired; TXT/MD always has a
    // position (current page or scroll fraction) as soon as content exists.
    private async Task<(int? Chapter, string? Position, double Percentage)?> BuildCurrentLocationAsync()
    {
        if (_book?.File is null) return null;

        if (_book.File.Format == "EPUB")
        {
            if (_latestEpubProgress is not { } epubProgress) return null;
            return (epubProgress.ChapterIndex, epubProgress.Cfi, epubProgress.Percentage);
        }

        if (_book.File.Format == "PDF")
        {
            if (_latestPdfProgress is not { } pdfProgress) return null;
            return (
                pdfProgress.Page,
                pdfProgress.Page.ToString(CultureInfo.InvariantCulture),
                pdfProgress.PageCount > 0 ? Math.Round(pdfProgress.Page * 100.0 / pdfProgress.PageCount, 1) : 0
            );
        }

        if (_readerMode == "book")
        {
            return (
                null,
                _txtMdCurrentPage.ToString(CultureInfo.InvariantCulture),
                _txtMdPageCount > 0 ? Math.Round(_txtMdCurrentPage * 100.0 / _txtMdPageCount, 1) : 0
            );
        }

        var fraction = await ScrollTracker.GetScrollFractionAsync(ContentViewportId);
        return (null, fraction.ToString("F4", CultureInfo.InvariantCulture), Math.Round(fraction * 100, 1));
    }

    private async Task SaveProgressAsync()
    {
        if (_book?.File is null) return;
        if (await BuildCurrentLocationAsync() is not { } location) return;

        var request = new SaveProgressRequest { BookId = Id, Chapter = location.Chapter, Position = location.Position, Percentage = location.Percentage };
        await ApiClient.PostAsync<SaveProgressRequest, ReadingProgress>("/api/reading/update", request);
    }

    private async Task ToggleBookmarksMenuAsync()
    {
        _bookmarksMenuOpen = !_bookmarksMenuOpen;
        if (_bookmarksMenuOpen && _bookmarks is null)
        {
            var response = await ApiClient.GetAsync<List<Bookmark>>($"/api/bookmarks/{Id}");
            _bookmarks = response is { Success: true, Data: { } data } ? data : [];
        }
    }

    private async Task AddBookmarkAsync()
    {
        if (await BuildCurrentLocationAsync() is not { } location) return;

        var request = new CreateBookmarkRequest
        {
            BookId = Id,
            Chapter = location.Chapter,
            Position = location.Position,
            Percentage = location.Percentage,
            Note = string.IsNullOrWhiteSpace(_newBookmarkNote) ? null : _newBookmarkNote.Trim(),
        };

        var response = await ApiClient.PostAsync<CreateBookmarkRequest, Bookmark>("/api/bookmarks", request);
        if (response is { Success: true, Data: { } bookmark })
        {
            _bookmarks = (_bookmarks ?? []).Append(bookmark).OrderBy(b => b.Percentage).ThenBy(b => b.CreatedAt).ToList();
            _newBookmarkNote = "";
        }
    }

    private async Task DeleteBookmarkAsync(int bookmarkId)
    {
        if (await ApiClient.DeleteAsync($"/api/bookmarks/{bookmarkId}"))
        {
            _bookmarks = _bookmarks?.Where(b => b.Id != bookmarkId).ToList();
        }
    }

    // Dispatches to whichever child reader/pagination mechanism owns
    // navigation for the current format -- mirrors the exact per-format
    // resume logic in OnParametersSetAsync/OnAfterRenderAsync, just
    // triggered by a bookmark click instead of the initial load.
    private async Task GoToBookmarkAsync(Bookmark bookmark)
    {
        _bookmarksMenuOpen = false;
        if (_book?.File is null || bookmark.Position is not { } position) return;

        if (_book.File.Format == "EPUB")
        {
            if (_epubReaderRef is not null) await _epubReaderRef.GoToLocationAsync(position);
            return;
        }

        if (_book.File.Format == "PDF")
        {
            if (_pdfReaderRef is not null && int.TryParse(position, NumberStyles.Integer, CultureInfo.InvariantCulture, out var page))
            {
                await _pdfReaderRef.GoToPageAsync(page);
            }
            return;
        }

        if (_readerMode == "book")
        {
            var targetPage = ConvertSavedPositionToPage(position, _txtMdPageCount);
            _txtMdCurrentPage = _pagePerChapter
                ? Math.Clamp(targetPage, 1, _txtMdPageCount)
                : await TextPaginator.GoToPageAsync(ContentInnerId, targetPage);
            StateHasChanged();
        }
        else if (double.TryParse(position, NumberStyles.Float, CultureInfo.InvariantCulture, out var fraction))
        {
            await ScrollTracker.SetScrollFractionAsync(ContentViewportId, fraction);
        }
    }

    private bool IsTxtMd => _book?.File?.Format is "TXT" or "MD";

    private async Task IncreaseFontSize()
    {
        _fontSize = Math.Min(_fontSize + 2, 32);
        await ReaderSettings.SetFontSizeAsync(_fontSize);
        if (IsTxtMd) _txtMdLayoutChangedSinceRender = true;
    }

    private async Task DecreaseFontSize()
    {
        _fontSize = Math.Max(_fontSize - 2, 12);
        await ReaderSettings.SetFontSizeAsync(_fontSize);
        if (IsTxtMd) _txtMdLayoutChangedSinceRender = true;
    }

    private async Task SetFontFamily(string fontFamily)
    {
        _fontFamily = fontFamily;
        await ReaderSettings.SetFontFamilyAsync(_fontFamily);
        if (IsTxtMd) _txtMdLayoutChangedSinceRender = true;
    }

    private async Task SetLineHeight(string lineHeight)
    {
        _lineHeight = lineHeight;
        await ReaderSettings.SetLineHeightAsync(_lineHeight);
        if (IsTxtMd) _txtMdLayoutChangedSinceRender = true;
    }

    private async Task SetPageWidth(string pageWidth)
    {
        _pageWidth = pageWidth;
        await ReaderSettings.SetPageWidthAsync(_pageWidth);
        if (IsTxtMd) _txtMdLayoutChangedSinceRender = true;
    }

    private async Task SetHideScrollbars(ChangeEventArgs e)
    {
        _hideScrollbars = e.Value is bool b && b;
        await ReaderSettings.SetHideScrollbarsAsync(_hideScrollbars);
    }

    private async Task SetPagePerChapter(ChangeEventArgs e)
    {
        _pagePerChapter = e.Value is bool b && b;
        await ReaderSettings.SetPagePerChapterAsync(_pagePerChapter);
        // Reuses the same re-init dance as the Ansicht (Buch/Scroll) toggle --
        // tear down whichever pagination mode was active and bring up the other.
        if (IsTxtMd) _txtMdReaderModeChangedSinceRender = true;
    }

    private async Task SetReaderMode(string mode)
    {
        _readerMode = mode;
        await ReaderSettings.SetReaderModeAsync(_readerMode);
        if (IsTxtMd) _txtMdReaderModeChangedSinceRender = true;
    }

    private void ToggleSettingsMenu() => _settingsMenuOpen = !_settingsMenuOpen;

    public void Dispose()
    {
        _saveTimer?.Dispose();
        if (_book?.File is not null)
        {
            _ = SaveProgressAsync();
        }
        _txtMdDotNetRef?.Dispose();
    }
}
