@page "/library/books/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject OfflineStorageService OfflineStorage
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(_book?.Title ?? "Buch") — Lumina Chronica</PageTitle>

<a href="library">← Zurück zur Bibliothek</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_book is null)
{
    <LoadingIndicator Text="Buch wird geladen..." />
}
else
{
    <div class="book-detail">
        <div class="book-detail-cover">
            @if (_coverObjectUrl is not null)
            {
                <img src="@_coverObjectUrl" alt="@_book.Title" />
            }
            else
            {
                <div class="book-card-cover-placeholder">📖</div>
            }
        </div>

        <div class="book-detail-info">
            @if (!_isEditing)
            {
                <div class="book-detail-title-row">
                    <h1>@_book.Title</h1>
                    @if (_book.IsOwner)
                    {
                        <button type="button" class="book-detail-favorite @(_book.IsFavorite ? "is-favorite" : "")"
                                title="@(_book.IsFavorite ? "Aus Favoriten entfernen" : "Zu Favoriten hinzufügen")"
                                @onclick="ToggleFavoriteAsync">
                            @(_book.IsFavorite ? "★" : "☆")
                        </button>
                    }
                </div>
                @if (!_book.IsOwner && _book.OwnerUsername is not null)
                {
                    <p class="book-detail-borrowed-badge">Geliehen von <a href="@($"u/{_book.OwnerUsername}")">@_book.OwnerUsername</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(_book.Author))
                {
                    <p class="text-muted">@_book.Author</p>
                }
                @if (!string.IsNullOrWhiteSpace(_book.Description))
                {
                    <p>@_book.Description</p>
                }

                @if (_book.Visibility == "PUBLIC")
                {
                    <div class="book-detail-rating">
                        @if (_book.RatingCount > 0)
                        {
                            <span>★ @_book.AverageRating?.ToString("0.0", CultureInfo.InvariantCulture) (@_book.RatingCount)</span>
                        }
                        else
                        {
                            <span class="text-muted">Noch keine Bewertungen</span>
                        }
                        @if (!_book.IsOwner)
                        {
                            <div class="book-detail-rate-stars">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var starValue = star;
                                    <button type="button" class="star-button @(starValue <= (_book.MyRating ?? 0) ? "is-filled" : "")"
                                            disabled="@_isRatingInProgress"
                                            title="@($"Mit {starValue} Sternen bewerten")"
                                            @onclick="() => RateBookAsync(starValue)">★</button>
                                }
                            </div>
                        }
                    </div>
                }

                <dl class="book-detail-meta">
                    @if (!string.IsNullOrWhiteSpace(_book.Genre))
                    {
                        <dt>Genre</dt><dd>@_book.Genre</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_book.Language))
                    {
                        <dt>Sprache</dt><dd>@_book.Language</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_book.Isbn))
                    {
                        <dt>ISBN</dt><dd>@_book.Isbn</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_book.Publisher))
                    {
                        <dt>Verlag</dt><dd>@_book.Publisher</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_book.ReleaseDate))
                    {
                        <dt>Erscheinungsdatum</dt><dd>@_book.ReleaseDate</dd>
                    }
                    @if (_book.Pages is { } pages)
                    {
                        <dt>Seiten</dt><dd>@pages</dd>
                    }
                    @if (_book.Tags.Count > 0)
                    {
                        <dt>Tags</dt>
                        <dd>
                            @for (var i = 0; i < _book.Tags.Count; i++)
                            {
                                var tag = _book.Tags[i];
                                <a href="@($"library?tag={Uri.EscapeDataString(tag)}")">@tag</a>@(i < _book.Tags.Count - 1 ? ", " : "")
                            }
                        </dd>
                    }
                </dl>

                <div class="form-actions">
                    @if (_book.File is not null)
                    {
                        <a class="btn btn-primary" href="@($"library/books/{Id}/read")">Lesen</a>
                        @if (_isOfflineSaved)
                        {
                            <button type="button" class="btn" disabled="@_isSavingOffline" @onclick="RemoveOfflineAsync">
                                Offline entfernen (@FormatSize(_offlineSizeBytes))
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn" disabled="@_isSavingOffline" @onclick="SaveOfflineAsync">
                                @(_isSavingOffline ? "Wird gespeichert..." : "Offline speichern")
                            </button>
                        }
                    }
                    @if (_book.IsOwner)
                    {
                        <button type="button" id="edit-button" class="btn" @onclick="StartEditingAsync">Bearbeiten</button>
                        <button type="button" class="btn" @onclick="() => _confirmingDelete = true">Löschen</button>
                    }
                </div>
                @if (_book.IsOwner)
                {
                    <ConfirmDialog IsOpen="_confirmingDelete" Message="Buch wirklich löschen?"
                                   OnConfirm="DeleteAsync" OnCancel="() => _confirmingDelete = false" />
                }
                @if (_offlineErrorMessage is not null)
                {
                    <p class="form-error">@_offlineErrorMessage</p>
                }

                @if (_book.IsOwner && _shelves is { Count: > 0 })
                {
                    <div class="book-detail-shelves">
                        <span class="text-muted">Zu Regal hinzufügen</span>
                        @foreach (var shelf in _shelves)
                        {
                            <label class="book-detail-shelf-option">
                                <input type="checkbox" checked="@_shelfIds.Contains(shelf.Id)"
                                       @onchange="e => ToggleShelfAsync(shelf.Id, (bool)e.Value!)" />
                                @shelf.Name
                            </label>
                        }
                    </div>
                }
            }
            else
            {
                <EditForm Model="_editForm" OnValidSubmit="SaveAsync" class="auth-form">
                    @if (_saveErrorMessage is not null)
                    {
                        <p class="form-error">@_saveErrorMessage</p>
                    }

                    <div class="form-group">
                        <label for="edit-cover">Cover ersetzen</label>
                        <div class="dropzone @(_isDraggingCover ? "dropzone--active" : "") @(_selectedEditCover is not null ? "dropzone--filled" : "")"
                             @ondragenter="() => _isDraggingCover = true" @ondragleave="() => _isDraggingCover = false"
                             @ondragover:preventDefault @ondrop="() => _isDraggingCover = false">
                            <InputFile id="edit-cover" OnChange="OnEditCoverSelected" />
                            <span class="dropzone-label">
                                @if (_selectedEditCover is not null)
                                {
                                    <text>📄 @_selectedEditCover.Name</text>
                                }
                                else
                                {
                                    <text>Cover hierher ziehen oder klicken zum Auswählen</text>
                                }
                            </span>
                        </div>
                        @if (_coverSaveErrorMessage is not null)
                        {
                            <p class="form-error">@_coverSaveErrorMessage</p>
                        }
                    </div>
                    <div class="form-group">
                        <label for="edit-title">Titel</label>
                        <InputText id="edit-title" @bind-Value="_editForm.Title" />
                    </div>
                    <div class="form-group">
                        <label for="edit-author">Autor</label>
                        <InputText id="edit-author" @bind-Value="_editForm.Author" />
                    </div>
                    <div class="form-group">
                        <label for="edit-description">Beschreibung</label>
                        <InputTextArea id="edit-description" @bind-Value="_editForm.Description" />
                    </div>
                    <div class="form-group">
                        <label for="edit-genre">Genre</label>
                        <InputText id="edit-genre" @bind-Value="_editForm.Genre" />
                    </div>
                    <div class="form-group">
                        <label for="edit-language">Sprache</label>
                        <InputText id="edit-language" @bind-Value="_editForm.Language" />
                    </div>
                    <div class="form-group">
                        <label for="edit-tags">Tags (durch Komma getrennt)</label>
                        <InputText id="edit-tags" @bind-Value="_editForm.Tags" />
                    </div>
                    <div class="form-group">
                        <label for="edit-isbn">ISBN</label>
                        <div class="isbn-enrichment-row">
                            <InputText id="edit-isbn" @bind-Value="_editForm.Isbn" />
                            <button type="button" class="btn" disabled="@(string.IsNullOrWhiteSpace(_editForm.Isbn) || _isLookingUpEnrichment)" @onclick="LookupEnrichmentAsync">
                                Info abrufen
                            </button>
                        </div>

                        <div class="isbn-enrichment-row enrichment-search-row">
                            <input id="edit-enrichment-search" placeholder="oder nach Titel/Autor suchen" @bind="_searchQuery" />
                            <button type="button" class="btn" disabled="@(string.IsNullOrWhiteSpace(_searchQuery) || _isLookingUpEnrichment)" @onclick="SearchEnrichmentAsync">
                                Suchen
                            </button>
                        </div>

                        @if (_enrichmentStatus is not null)
                        {
                            <p class="text-muted">@_enrichmentStatus</p>
                        }

                        @if (_searchResults is { Count: > 0 })
                        {
                            <ul class="enrichment-search-results">
                                @foreach (var result in _searchResults)
                                {
                                    <li>
                                        <button type="button" class="enrichment-search-result" @onclick="() => SelectSearchResultAsync(result)">
                                            @if (result.CoverUrl is { } coverUrl)
                                            {
                                                <img src="@coverUrl" alt="" class="enrichment-search-cover" />
                                            }
                                            <span>
                                                <strong>@result.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(result.Author))
                                                {
                                                    <text> — @result.Author</text>
                                                }
                                                @if (result.Year is { } year)
                                                {
                                                    <text> (@year)</text>
                                                }
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }

                        @if (_pendingEnrichment is not null)
                        {
                            <div class="enrichment-preview">
                                <p><strong>Gefundene Daten:</strong></p>
                                <ul>
                                    <li>Beschreibung: @DescribeField(_editForm.Description, _pendingEnrichment.Description)</li>
                                    <li>Genre: @DescribeField(_editForm.Genre, _pendingEnrichment.Genre)</li>
                                    <li>Verlag: @DescribeField(_editForm.Publisher, _pendingEnrichment.Publisher)</li>
                                    <li>Seiten: @DescribePages(_editForm.Pages, _pendingEnrichment.Pages)</li>
                                    <li>Erscheinungsdatum: @DescribeReleaseDate(_editForm.ReleaseDate, _pendingEnrichment.ReleaseDate)</li>
                                    <li>Cover: @DescribeCover()</li>
                                </ul>
                                <div class="form-actions">
                                    <button type="button" class="btn btn-primary" @onclick="ApplyPendingEnrichmentAsync">Übernehmen</button>
                                    <button type="button" class="btn" @onclick="DiscardPendingEnrichment">Verwerfen</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label for="edit-publisher">Verlag</label>
                        <InputText id="edit-publisher" @bind-Value="_editForm.Publisher" />
                    </div>
                    <div class="form-group">
                        <label for="edit-releaseDate">Erscheinungsdatum</label>
                        <InputDate id="edit-releaseDate" @bind-Value="_editForm.ReleaseDateValue" />
                    </div>
                    <div class="form-group">
                        <label for="edit-pages">Seiten</label>
                        <InputNumber id="edit-pages" @bind-Value="_editForm.Pages" />
                    </div>
                    <div class="form-group">
                        <label for="edit-visibility">Sichtbarkeit</label>
                        <InputSelect id="edit-visibility" @bind-Value="_editForm.Visibility" @bind-Value:after="OnVisibilityChangedAsync">
                            @foreach (var option in BookVisibilityOption.Options)
                            {
                                <option value="@option">@BookVisibilityOption.For(option)</option>
                            }
                        </InputSelect>
                        @if (_editForm.Visibility == "SHARED")
                        {
                            <p class="text-muted">Geteilte Bücher können nur von den unten ausgewählten Personen vollständig gelesen werden (eigener Lesefortschritt und eigene Lesezeichen) — spart Speicherplatz, da diese Personen keine eigene Kopie hochladen müssen.</p>
                            <label class="checkbox-label">
                                <InputCheckbox @bind-Value="_editForm.SharedTeaserVisible" />
                                Cover und Beschreibung auch für alle anderen sichtbar (auf deinem öffentlichen Profil)
                            </label>
                        }
                        else if (_editForm.Visibility == "PUBLIC")
                        {
                            <p class="text-muted">Öffentliche Bücher sind mit Cover und Beschreibung für jeden sichtbar (auch nicht angemeldete Besucher) und für jeden angemeldeten Nutzer vollständig lesbar.</p>
                        }
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">Speichern</button>
                        <button type="button" class="btn" @onclick="CancelEditing">Abbrechen</button>
                    </div>
                </EditForm>

                @if (_editForm.Visibility == "SHARED")
                {
                    <div class="book-share-manager">
                        <h3>Geteilt mit</h3>
                        @if (_shareUsers is { Count: > 0 })
                        {
                            <ul class="book-share-list">
                                @foreach (var user in _shareUsers)
                                {
                                    <li>
                                        <span>@user.Username</span>
                                        <button type="button" class="btn" disabled="@_shareActionInProgress.Contains(user.Username)" @onclick="() => RemoveShareAsync(user.Username)">Entfernen</button>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">Noch mit niemandem geteilt.</p>
                        }

                        <input placeholder="Benutzername suchen..." @oninput="OnShareSearchInput" value="@_shareSearchTerm" />
                        @if (_shareSearchResults is { Count: > 0 })
                        {
                            <ul class="book-share-search-results">
                                @foreach (var candidate in _shareSearchResults)
                                {
                                    <li>
                                        <span>@candidate.Username</span>
                                        <button type="button" class="btn" disabled="@_shareActionInProgress.Contains(candidate.Username)" @onclick="() => AddShareAsync(candidate.Username)">Hinzufügen</button>
                                    </li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrWhiteSpace(_shareSearchTerm))
                        {
                            <p class="text-muted">Keine Nutzer gefunden.</p>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <section class="book-comments">
        <h2>Kommentare</h2>
        @if (_comments is null)
        {
            <p class="text-muted">Kommentare werden geladen...</p>
        }
        else
        {
            @if (_comments.Count == 0)
            {
                <p class="text-muted">Noch keine Kommentare.</p>
            }
            else
            {
                <ul class="book-comment-list">
                    @foreach (var comment in _comments)
                    {
                        <li class="book-comment-item">
                            <div class="book-comment-header">
                                <strong>@comment.Username</strong>
                                <span class="text-muted">@comment.CreatedAt</span>
                            </div>
                            <p>@comment.Content</p>
                            @if (comment.UserId == _currentUserId)
                            {
                                <button type="button" class="btn" disabled="@_commentActionInProgress.Contains(comment.Id)" @onclick="() => DeleteCommentAsync(comment.Id)">Löschen</button>
                            }
                        </li>
                    }
                </ul>
            }

            <EditForm Model="_commentForm" OnValidSubmit="SubmitCommentAsync" class="comment-form">
                @if (_commentErrorMessage is not null)
                {
                    <p class="form-error">@_commentErrorMessage</p>
                }
                <InputTextArea @bind-Value="_commentForm.Content" placeholder="Kommentar schreiben..." />
                <button type="submit" class="btn btn-primary" disabled="@(_isSubmittingComment || string.IsNullOrWhiteSpace(_commentForm.Content))">Kommentieren</button>
            </EditForm>
        }
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Book? _book;
    private string? _loadErrorMessage;
    private string? _coverObjectUrl;
    private bool _isRatingInProgress;

    private bool _isEditing;
    private bool _isSaving;
    private string? _saveErrorMessage;
    private string? _coverSaveErrorMessage;
    private IBrowserFile? _selectedEditCover;
    private bool _isDraggingCover;
    private EditFormModel _editForm = new();

    private List<DiscoverUser>? _shareUsers;
    private readonly HashSet<string> _shareActionInProgress = [];
    private string _shareSearchTerm = string.Empty;
    private List<DiscoverUser>? _shareSearchResults;
    private System.Threading.Timer? _shareSearchDebounceTimer;

    private bool _isLookingUpEnrichment;
    private string? _enrichmentStatus;
    private string _searchQuery = string.Empty;
    private List<EnrichmentSearchResult>? _searchResults;
    private EnrichedMetadata? _pendingEnrichment;
    private byte[]? _pendingCoverBytes;
    private string? _pendingCoverContentType;
    private IJSObjectReference? _enrichmentModule;

    private bool _confirmingDelete;

    private List<Shelf>? _shelves;
    private HashSet<int> _shelfIds = [];

    private bool _isOfflineSaved;
    private long _offlineSizeBytes;
    private bool _isSavingOffline;
    private string? _offlineErrorMessage;

    // Comments (v3.3, issue #325). _currentUserId gates the delete button on
    // a comment's own author only -- the backend also lets the book's owner
    // moderate (delete) anyone's comment, but Book.cs doesn't carry an
    // ownerId/isOwner field for this page to key an equivalent button off
    // of, so that capability isn't exposed in this MVP UI.
    private List<Comment>? _comments;
    private int? _currentUserId;
    private CommentFormModel _commentForm = new();
    private bool _isSubmittingComment;
    private string? _commentErrorMessage;
    private readonly HashSet<int> _commentActionInProgress = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadBookAsync();
        await LoadShelvesAsync();
        await LoadOfflineStatusAsync();
        await LoadCurrentUserIdAsync();
        await LoadCommentsAsync();
    }

    private async Task LoadCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _currentUserId = int.TryParse(idClaim, out var id) ? id : null;
    }

    private async Task LoadCommentsAsync()
    {
        if (_book is null)
        {
            _comments = [];
            return;
        }

        // Best-effort like LoadShelvesAsync -- comments are supplementary to
        // the book's own data, a failure here (including a response shape
        // mismatch) shouldn't take down the rest of the page.
        try
        {
            var response = await ApiClient.GetAsync<List<Comment>>($"/api/books/{Id}/comments");
            _comments = response is { Success: true, Data: not null } ? response.Data : [];
        }
        catch (System.Text.Json.JsonException)
        {
            _comments = [];
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentForm.Content)) return;

        _isSubmittingComment = true;
        _commentErrorMessage = null;

        var succeeded = await ApiClient.PostAsync($"/api/books/{Id}/comments", new { content = _commentForm.Content });
        if (succeeded)
        {
            _commentForm = new CommentFormModel();
            await LoadCommentsAsync();
        }
        else
        {
            _commentErrorMessage = "Kommentar konnte nicht gespeichert werden.";
        }

        _isSubmittingComment = false;
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        if (!_commentActionInProgress.Add(commentId)) return;

        var succeeded = await ApiClient.DeleteAsync($"/api/comments/{commentId}");
        if (succeeded) await LoadCommentsAsync();

        _commentActionInProgress.Remove(commentId);
    }

    // Best-effort like LoadShelvesAsync -- a device with no IndexedDB support
    // (or a test harness with no JS interop configured) should still render
    // the rest of the page, just without the offline button reflecting a
    // saved state.
    private async Task LoadOfflineStatusAsync()
    {
        try
        {
            var status = await OfflineStorage.GetStatusAsync(Id);
            _isOfflineSaved = status.Saved;
            _offlineSizeBytes = status.SizeBytes;
        }
        catch (Exception)
        {
            _isOfflineSaved = false;
        }
    }

    private async Task SaveOfflineAsync()
    {
        if (_book?.File is null) return;

        _isSavingOffline = true;
        _offlineErrorMessage = null;

        var fileResult = await ApiClient.GetBytesAsync($"/api/books/{Id}/file");
        if (fileResult is null)
        {
            _offlineErrorMessage = "Buchdatei konnte nicht heruntergeladen werden.";
            _isSavingOffline = false;
            return;
        }

        try
        {
            await OfflineStorage.SaveBookAsync(Id, _book.Title, _book.Author, _book.File.Format, fileResult.Value.Bytes, fileResult.Value.ContentType);
            await LoadOfflineStatusAsync();
        }
        catch (Exception)
        {
            _offlineErrorMessage = "Offline-Speicherung fehlgeschlagen (evtl. ist der Speicherplatz voll).";
        }
        finally
        {
            _isSavingOffline = false;
        }
    }

    private async Task RemoveOfflineAsync()
    {
        try
        {
            await OfflineStorage.DeleteBookAsync(Id);
        }
        catch (Exception)
        {
        }
        _isOfflineSaved = false;
        _offlineSizeBytes = 0;
    }

    private static string FormatSize(long bytes)
    {
        var mb = bytes / 1024.0 / 1024.0;
        return mb >= 1
            ? mb.ToString("F1", CultureInfo.InvariantCulture) + " MB"
            : (bytes / 1024.0).ToString("F0", CultureInfo.InvariantCulture) + " KB";
    }

    private async Task LoadBookAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Book>($"/api/books/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _book = response.Data;
            await LoadCoverAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? "Buch konnte nicht geladen werden.";
        }
    }

    private async Task LoadShelvesAsync()
    {
        // The shelf picker is supplementary to the book's own data -- a
        // failure here (including a response shape mismatch) shouldn't take
        // down the rest of the page.
        try
        {
            var shelvesResponse = await ApiClient.GetAsync<List<Shelf>>("/api/shelves");
            if (shelvesResponse is { Success: true, Data: not null })
            {
                _shelves = shelvesResponse.Data;
            }

            var shelfIdsResponse = await ApiClient.GetAsync<List<int>>($"/api/books/{Id}/shelves");
            if (shelfIdsResponse is { Success: true, Data: not null })
            {
                _shelfIds = [.. shelfIdsResponse.Data];
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }
    }

    private async Task ToggleShelfAsync(int shelfId, bool addToShelf)
    {
        var succeeded = addToShelf
            ? await ApiClient.PostAsync($"/api/shelves/{shelfId}/books/{Id}")
            : await ApiClient.DeleteAsync($"/api/shelves/{shelfId}/books/{Id}");

        if (succeeded)
        {
            if (addToShelf) _shelfIds.Add(shelfId);
            else _shelfIds.Remove(shelfId);
        }
    }

    private async Task LoadCoverAsync()
    {
        if (_coverObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
            _coverObjectUrl = null;
        }

        if (_book?.CoverUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_book.CoverUrl);
        if (result is { } cover)
        {
            _coverObjectUrl = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (_book is null) return;

        var wasFavorite = _book.IsFavorite;
        _book.IsFavorite = !wasFavorite;

        var succeeded = wasFavorite
            ? await ApiClient.DeleteAsync($"/api/books/{Id}/favorite")
            : await ApiClient.PostAsync($"/api/books/{Id}/favorite");

        if (!succeeded)
        {
            _book.IsFavorite = wasFavorite;
        }
    }

    private async Task RateBookAsync(int star)
    {
        if (_book is null || _isRatingInProgress) return;
        _isRatingInProgress = true;

        // Clicking the star that's already your own rating removes it
        // instead of re-submitting the same value -- a toggle, not just a
        // set. Same pattern as PublicProfile.razor's rate-stars widget used
        // before rating capability moved here.
        var succeeded = _book.MyRating == star
            ? await ApiClient.DeleteAsync($"/api/books/{Id}/rating")
            : await ApiClient.PutAsync($"/api/books/{Id}/rating", new { rating = star });

        // Re-fetches rather than computing the new average locally -- the
        // average depends on every other rater's value, which the client
        // doesn't have.
        if (succeeded) await LoadBookAsync();

        _isRatingInProgress = false;
    }

    private async Task StartEditingAsync()
    {
        if (_book is null) return;

        _editForm = new EditFormModel
        {
            Title = _book.Title,
            Author = _book.Author,
            Description = _book.Description,
            Genre = _book.Genre,
            Language = _book.Language,
            Tags = string.Join(", ", _book.Tags),
            Isbn = _book.Isbn,
            Publisher = _book.Publisher,
            ReleaseDate = _book.ReleaseDate,
            Pages = _book.Pages,
            Visibility = _book.Visibility,
            SharedTeaserVisible = _book.SharedTeaserVisible,
        };
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;
        _enrichmentStatus = null;
        _searchQuery = string.Empty;
        _searchResults = null;
        _pendingEnrichment = null;
        ClearPendingCover();
        _selectedEditCover = null;
        _isEditing = true;
        _shareSearchTerm = string.Empty;
        _shareSearchResults = null;
        _shareUsers = null;
        if (_editForm.Visibility == "SHARED") await LoadSharesAsync();
    }

    // Fetch the share list lazily, the first time the dropdown is switched
    // to SHARED -- avoids an always-on request for every book regardless of
    // visibility, and keeps a book that was never SHARED from ever needing
    // this endpoint at all.
    private async Task OnVisibilityChangedAsync()
    {
        if (_editForm.Visibility == "SHARED" && _shareUsers is null) await LoadSharesAsync();
    }

    private void CancelEditing() => _isEditing = false;

    private async Task LoadSharesAsync()
    {
        var response = await ApiClient.GetAsync<List<DiscoverUser>>($"/api/books/{Id}/shares");
        _shareUsers = response is { Success: true, Data: not null } ? response.Data : [];
    }

    private void OnShareSearchInput(ChangeEventArgs e)
    {
        _shareSearchTerm = e.Value?.ToString() ?? string.Empty;

        _shareSearchDebounceTimer?.Dispose();
        _shareSearchDebounceTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () =>
            {
                await SearchShareCandidatesAsync();
                // Same gap as Discover.razor's user search: a Timer callback
                // reached via InvokeAsync doesn't auto-render.
                StateHasChanged();
            }),
            null,
            400,
            Timeout.Infinite);
    }

    private async Task SearchShareCandidatesAsync()
    {
        if (string.IsNullOrWhiteSpace(_shareSearchTerm))
        {
            _shareSearchResults = null;
            return;
        }

        var response = await ApiClient.GetAsync<DiscoverUserListResponse>($"/api/discover/users?search={Uri.EscapeDataString(_shareSearchTerm)}");
        var alreadyShared = (_shareUsers ?? []).Select(u => u.Username).ToHashSet();
        _shareSearchResults = response is { Success: true, Data: not null }
            ? response.Data.Items.Where(u => !alreadyShared.Contains(u.Username)).ToList()
            : [];
    }

    private async Task AddShareAsync(string username)
    {
        if (!_shareActionInProgress.Add(username)) return;

        var succeeded = await ApiClient.PostAsync($"/api/books/{Id}/shares", new { username });
        if (succeeded) await LoadSharesAsync();
        _shareActionInProgress.Remove(username);
        _shareSearchResults = _shareSearchResults?.Where(u => u.Username != username).ToList();
    }

    private async Task RemoveShareAsync(string username)
    {
        if (!_shareActionInProgress.Add(username)) return;

        var succeeded = await ApiClient.DeleteAsync($"/api/books/{Id}/shares/{Uri.EscapeDataString(username)}");
        if (succeeded) await LoadSharesAsync();
        _shareActionInProgress.Remove(username);
    }

    private void OnEditCoverSelected(InputFileChangeEventArgs e) => _selectedEditCover = e.File;

    private Task LookupEnrichmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_editForm.Isbn)) return Task.CompletedTask;
        return RunEnrichmentLookupAsync(() => LookupByIsbnCoreAsync(_editForm.Isbn));
    }

    private async Task SearchEnrichmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;

        _enrichmentStatus = null;
        _searchResults = null;
        _pendingEnrichment = null;
        ClearPendingCover();
        _isLookingUpEnrichment = true;

        try
        {
            _enrichmentModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/metadataEnrichment.js");
            var results = await _enrichmentModule.InvokeAsync<List<EnrichmentSearchResult>>("searchByQuery", _searchQuery);
            _searchResults = results;
            if (results.Count == 0)
            {
                _enrichmentStatus = "Keine Treffer gefunden.";
            }
        }
        catch (Exception)
        {
            _enrichmentStatus = "Keine Treffer gefunden.";
        }
        finally
        {
            _isLookingUpEnrichment = false;
        }
    }

    // A Google Books result is resolved by its own volume ID regardless of
    // whether it happens to have an ISBN -- re-routing it through the ISBN
    // path would call OpenLibrary's lookupByIsbn instead, silently mixing
    // sources for a result the user picked specifically from Google Books.
    private Task SelectSearchResultAsync(EnrichmentSearchResult result)
    {
        _searchResults = null;

        if (result.Source == "googlebooks")
        {
            return RunEnrichmentLookupAsync(() => LookupByGoogleBooksIdCoreAsync(result.GoogleBooksId));
        }

        if (!string.IsNullOrWhiteSpace(result.Isbn))
        {
            _editForm.Isbn = result.Isbn;
            return RunEnrichmentLookupAsync(() => LookupByIsbnCoreAsync(result.Isbn));
        }

        return RunEnrichmentLookupAsync(() => LookupByWorkCoreAsync(result.Key, result.CoverId));
    }

    private async Task<EnrichedMetadata> LookupByIsbnCoreAsync(string isbn)
    {
        _enrichmentModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/metadataEnrichment.js");
        return await _enrichmentModule.InvokeAsync<EnrichedMetadata>("lookupByIsbn", isbn);
    }

    private async Task<EnrichedMetadata> LookupByWorkCoreAsync(string? workKey, int? coverId)
    {
        _enrichmentModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/metadataEnrichment.js");
        return await _enrichmentModule.InvokeAsync<EnrichedMetadata>("lookupByWork", workKey, coverId);
    }

    private async Task<EnrichedMetadata> LookupByGoogleBooksIdCoreAsync(string? volumeId)
    {
        _enrichmentModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/metadataEnrichment.js");
        return await _enrichmentModule.InvokeAsync<EnrichedMetadata>("lookupByGoogleBooksId", volumeId);
    }

    // Fetches into `_pendingEnrichment`/`_pendingCoverBytes` only -- nothing
    // touches the form or the book until the user reviews the preview card
    // and clicks "Übernehmen" (ApplyPendingEnrichmentAsync). Shared by the
    // ISBN button and search-result selection.
    private async Task RunEnrichmentLookupAsync(Func<Task<EnrichedMetadata>> lookup)
    {
        _enrichmentStatus = null;
        _searchResults = null;
        _isLookingUpEnrichment = true;
        ClearPendingCover();

        try
        {
            var metadata = await lookup();
            if (!metadata.Found)
            {
                _enrichmentStatus = "Keine Daten gefunden.";
                _pendingEnrichment = null;
                return;
            }

            _pendingEnrichment = metadata;

            if (metadata.HasCover)
            {
                var coverBytes = await _enrichmentModule!.InvokeAsync<byte[]?>("getCoverBytes");
                if (coverBytes is { Length: > 0 })
                {
                    var contentType = await _enrichmentModule!.InvokeAsync<string?>("getCoverContentType");
                    _pendingCoverBytes = coverBytes;
                    _pendingCoverContentType = string.IsNullOrWhiteSpace(contentType) ? "image/jpeg" : contentType;
                }
            }
        }
        catch (Exception)
        {
            _enrichmentStatus = "Keine Daten gefunden.";
            _pendingEnrichment = null;
        }
        finally
        {
            _isLookingUpEnrichment = false;
        }
    }

    private async Task ApplyPendingEnrichmentAsync()
    {
        if (_pendingEnrichment is null) return;
        var metadata = _pendingEnrichment;

        // Same "fill gaps only, never overwrite" rule as file extraction.
        if (string.IsNullOrWhiteSpace(_editForm.Description) && !string.IsNullOrWhiteSpace(metadata.Description)) _editForm.Description = metadata.Description;
        if (string.IsNullOrWhiteSpace(_editForm.Genre) && !string.IsNullOrWhiteSpace(metadata.Genre)) _editForm.Genre = metadata.Genre;
        if (string.IsNullOrWhiteSpace(_editForm.Publisher) && !string.IsNullOrWhiteSpace(metadata.Publisher)) _editForm.Publisher = metadata.Publisher;
        if (_editForm.Pages is null && metadata.Pages is { } pages) _editForm.Pages = pages;
        if (string.IsNullOrWhiteSpace(_editForm.ReleaseDate) && IsValidReleaseDate(metadata.ReleaseDate))
        {
            _editForm.ReleaseDate = metadata.ReleaseDate;
        }

        // The book already has an id here, unlike the Upload form -- go
        // straight through the already-existing cover-replace endpoint
        // rather than staging bytes for a later multipart submit.
        if (_pendingCoverBytes is not null && _selectedEditCover is null && string.IsNullOrWhiteSpace(_book?.CoverUrl))
        {
            var byteContent = new ByteArrayContent(_pendingCoverBytes);
            byteContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_pendingCoverContentType) ? "image/jpeg" : _pendingCoverContentType);

            using var content = new MultipartFormDataContent { { byteContent, "\"cover\"", "\"cover.jpg\"" } };
            var coverResponse = await ApiClient.PutMultipartAsync<Book>($"/api/books/{Id}/cover", content);
            if (coverResponse is { Success: true, Data: not null })
            {
                _book = coverResponse.Data;
                await LoadCoverAsync();
            }
        }

        _pendingEnrichment = null;
        ClearPendingCover();
    }

    private void DiscardPendingEnrichment()
    {
        _pendingEnrichment = null;
        ClearPendingCover();
    }

    private void ClearPendingCover()
    {
        _pendingCoverBytes = null;
        _pendingCoverContentType = null;
    }

    private static bool IsValidReleaseDate(string? value) => DateOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out _);

    private static string Truncate(string value, int maxLength = 80) => value.Length <= maxLength ? value : value[..maxLength] + "…";

    private static string DescribeField(string? currentValue, string? fetchedValue)
    {
        if (!string.IsNullOrWhiteSpace(currentValue)) return "bleibt unverändert";
        if (!string.IsNullOrWhiteSpace(fetchedValue)) return $"wird gesetzt: {Truncate(fetchedValue)}";
        return "keine Daten gefunden";
    }

    private static string DescribePages(int? currentValue, int? fetchedValue)
    {
        if (currentValue is not null) return "bleibt unverändert";
        return fetchedValue is { } pages ? $"wird gesetzt: {pages}" : "keine Daten gefunden";
    }

    private static string DescribeReleaseDate(string? currentValue, string? fetchedValue)
    {
        if (!string.IsNullOrWhiteSpace(currentValue)) return "bleibt unverändert";
        return IsValidReleaseDate(fetchedValue) ? $"wird gesetzt: {fetchedValue}" : "keine Daten gefunden";
    }

    private string DescribeCover()
    {
        if (_selectedEditCover is not null || !string.IsNullOrWhiteSpace(_book?.CoverUrl)) return "bleibt unverändert";
        return _pendingCoverBytes is not null ? "wird gesetzt" : "keine Daten gefunden";
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;

        var request = new UpdateBookRequest
        {
            Title = _editForm.Title,
            Author = _editForm.Author,
            Description = _editForm.Description,
            Genre = _editForm.Genre,
            Language = _editForm.Language,
            Tags = _editForm.Tags?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() ?? [],
            Isbn = _editForm.Isbn,
            Publisher = _editForm.Publisher,
            ReleaseDate = _editForm.ReleaseDate,
            Pages = _editForm.Pages,
            Visibility = _editForm.Visibility,
            SharedTeaserVisible = _editForm.SharedTeaserVisible,
        };

        var response = await ApiClient.PutAsync<UpdateBookRequest, Book>($"/api/books/{Id}", request);
        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? "Speichern fehlgeschlagen. Bitte versuche es erneut.";
            _isSaving = false;
            return;
        }

        _book = response.Data;

        if (_selectedEditCover is not null)
        {
            const long maxCoverBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditCover.OpenReadStream(maxCoverBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditCover.ContentType) ? "application/octet-stream" : _selectedEditCover.ContentType);
            content.Add(streamContent, "\"cover\"", $"\"{_selectedEditCover.Name}\"");

            var coverResponse = await ApiClient.PutMultipartAsync<Book>($"/api/books/{Id}/cover", content);
            if (coverResponse is { Success: true, Data: not null })
            {
                _book = coverResponse.Data;
                await LoadCoverAsync();
            }
            else
            {
                _coverSaveErrorMessage = coverResponse?.Error?.Message ?? "Cover konnte nicht ersetzt werden.";
                _isSaving = false;
                return;
            }
        }

        _isEditing = false;
        _isSaving = false;
    }

    private async Task DeleteAsync()
    {
        var deleted = await ApiClient.DeleteAsync($"/api/books/{Id}");
        if (deleted)
        {
            NavigationManager.NavigateTo("library");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = "Löschen fehlgeschlagen. Bitte versuche es erneut.";
        }
    }

    public void Dispose()
    {
        if (_coverObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
        }
        if (_enrichmentModule is not null)
        {
            _ = _enrichmentModule.DisposeAsync();
        }
        _shareSearchDebounceTimer?.Dispose();
    }

    private class EditFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string? Author { get; set; }
        public string? Description { get; set; }
        public string? Genre { get; set; }
        public string? Language { get; set; }
        public string? Tags { get; set; }
        public string? Isbn { get; set; }
        public string? Publisher { get; set; }
        public string? ReleaseDate { get; set; }
        public int? Pages { get; set; }
        public string Visibility { get; set; } = "PRIVATE";
        public bool SharedTeaserVisible { get; set; } = true;

        // InputDate needs a DateOnly?-typed property to bind to; ReleaseDate
        // itself stays a string since that's what crosses the wire.
        public DateOnly? ReleaseDateValue
        {
            get => DateOnly.TryParse(ReleaseDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
            set => ReleaseDate = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    private class CommentFormModel
    {
        public string Content { get; set; } = string.Empty;
    }
