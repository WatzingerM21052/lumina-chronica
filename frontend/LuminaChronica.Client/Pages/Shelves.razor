@page "/library/shelves"
@attribute [Authorize]
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@I18n.T("shelves.title") — Lumina Chronica</PageTitle>

<div class="page-header">
    <h1>@I18n.T("shelves.title")</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
        @I18n.T("shelves.createButton")
    </button>
</div>

<Dialog IsOpen="_showCreateForm" Title="@I18n.T("shelves.createButton")" OnClose="RequestCloseCreate">
    <ChildContent>
        <EditForm id="shelf-create-form" Model="_createForm" OnValidSubmit="CreateShelfAsync" class="auth-form">
            @if (_createErrorMessage is not null)
            {
                <p class="form-error">@_createErrorMessage</p>
            }
            <div class="form-group">
                <label for="shelf-name">@I18n.T("shelves.nameLabel")</label>
                <InputText id="shelf-name" maxlength="@TextLimits.Title" @bind-Value="_createForm.Name" />
            </div>
            <div class="form-group">
                <label for="shelf-description">@I18n.T("shelves.descriptionLabel")</label>
                <InputTextArea id="shelf-description" maxlength="@TextLimits.Description" @bind-Value="_createForm.Description" />
            </div>
            <div class="form-group">
                <label for="shelf-cover">@I18n.T("shelves.coverLabel")</label>
                <div class="dropzone @(_isDraggingCover ? "dropzone--active" : "") @(_selectedCover is not null ? "dropzone--filled" : "")"
                     @ondragenter="() => _isDraggingCover = true" @ondragleave="() => _isDraggingCover = false"
                     @ondragover:preventDefault @ondrop="() => _isDraggingCover = false">
                    <InputFile id="shelf-cover" OnChange="OnCoverSelected" />
                    <span class="dropzone-label">
                        @if (_selectedCover is not null)
                        {
                            <text><Icon Name="document" /> @_selectedCover.Name</text>
                        }
                        else
                        {
                            <text>@I18n.T("shelves.dropzoneLabel")</text>
                        }
                    </span>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="RequestCloseCreate">@I18n.T("shelves.cancelButton")</button>
        <button type="submit" form="shelf-create-form" class="btn btn-primary" disabled="@_isCreating">@I18n.T("shelves.createSubmitButton")</button>
    </Footer>
</Dialog>
<ConfirmDialog IsOpen="_confirmingDiscardCreate" Message="@I18n.T("dialog.discardChangesMessage")"
               ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
               OnConfirm="ConfirmDiscardCreate" OnCancel="() => _confirmingDiscardCreate = false" />

@if (_errorMessage is not null)
{
    <p class="form-error">@_errorMessage</p>
}
else if (_shelves is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Library" Text="@I18n.T("shelves.loading")" />
}
else if (_shelves.Count == 0)
{
    <EmptyState Message="@I18n.T("shelves.emptyMessage")"
                ActionText="@I18n.T("shelves.createButton")"
                OnAction="OpenCreateForm" />
}
else
{
    <div class="library-grid">
        @foreach (var shelf in _shelves)
        {
            <ShelfCard Shelf="shelf" />
        }
    </div>
}

@code {
    private List<Shelf>? _shelves;
    private string? _errorMessage;
    private bool _showCreateForm;
    private string? _createErrorMessage;
    private CreateShelfFormModel _createForm = new();
    private bool _confirmingDiscardCreate;
    private bool _isCreating;
    private IBrowserFile? _selectedCover;
    private bool _isDraggingCover;

    protected override Task OnInitializedAsync() => LoadShelvesAsync();

    private async Task LoadShelvesAsync()
    {
        _errorMessage = null;
        var response = await ApiClient.GetAsync<List<Shelf>>("/api/shelves");
        if (response is { Success: true, Data: not null })
        {
            _shelves = response.Data;
        }
        else
        {
            _errorMessage = response?.Error?.Message ?? I18n.T("shelves.loadError");
        }
    }

    private void OnCoverSelected(InputFileChangeEventArgs e) => _selectedCover = e.File;

    // Every open starts from a clean form: cancelling used to only hide the
    // dialog, so a reopen showed -- and would submit -- the previous
    // half-filled values and cover (review N-2).
    private void OpenCreateForm()
    {
        _createForm = new CreateShelfFormModel();
        _selectedCover = null;
        _createErrorMessage = null;
        _showCreateForm = true;
    }

    private bool IsCreateFormDirty => _createForm != new CreateShelfFormModel() || _selectedCover is not null;

    private void RequestCloseCreate()
    {
        if (IsCreateFormDirty)
        {
            _confirmingDiscardCreate = true;
            return;
        }
        _showCreateForm = false;
    }

    private void ConfirmDiscardCreate()
    {
        _confirmingDiscardCreate = false;
        _showCreateForm = false;
    }

    private async Task CreateShelfAsync()
    {
        if (_isCreating) return;
        _isCreating = true;
        try
        {
            await CreateShelfCoreAsync();
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task CreateShelfCoreAsync()
    {
        _createErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_createForm.Name))
        {
            _createErrorMessage = I18n.T("shelves.nameRequiredError");
            return;
        }

        const long maxCoverBytes = 5 * 1024 * 1024;
        using var content = new MultipartFormDataContent
        {
            { new StringContent(_createForm.Name), QuoteFieldName("name") }
        };
        if (!string.IsNullOrWhiteSpace(_createForm.Description))
        {
            content.Add(new StringContent(_createForm.Description), QuoteFieldName("description"));
        }
        if (_selectedCover is not null)
        {
            var streamContent = new StreamContent(_selectedCover.OpenReadStream(maxCoverBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedCover.ContentType) ? "application/octet-stream" : _selectedCover.ContentType);
            content.Add(streamContent, QuoteFieldName("cover"), QuoteFieldName(_selectedCover.Name));
        }

        var response = await ApiClient.PostMultipartAsync<Shelf>("/api/shelves", content);
        if (response is { Success: true, Data: not null })
        {
            _showCreateForm = false;
            _createForm.Name = string.Empty;
            _createForm.Description = null;
            _selectedCover = null;
            await LoadShelvesAsync();
        }
        else
        {
            _createErrorMessage = response?.Error?.Message ?? I18n.T("shelves.createError");
        }
    }

    // Same RFC 7578 quoting requirement as BookUpload.razor's QuoteFieldName --
    // .NET's MultipartFormDataContent only quotes a Content-Disposition
    // name/filename when it contains characters outside the plain HTTP
    // "token" grammar, but the backend's parser requires it always quoted.
    private static string QuoteFieldName(string value) => $"\"{value}\"";

    private record CreateShelfFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
