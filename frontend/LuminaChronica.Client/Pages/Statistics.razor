@page "/statistics"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject II18nService I18n

<PageTitle>@I18n.T("statistics.pageTitle") — Lumina Chronica</PageTitle>

<div class="stats-hero-sentinel" @ref="_heroSentinelRef" aria-hidden="true"></div>
<div class="stats-hero" @ref="_heroRef">
    <img src="images/statistics-hero-layer1-background.webp" alt="" class="stats-hero-layer stats-hero-layer-1" fetchpriority="high" />
    <img src="images/statistics-hero-layer2-moonlight.webp" alt="" class="stats-hero-layer stats-hero-layer-2" fetchpriority="low" decoding="async" />
    <img src="images/statistics-hero-layer3-armillary.webp" alt="" class="stats-hero-layer stats-hero-layer-3" fetchpriority="low" decoding="async" />
    <div class="stats-hero-scrim"></div>
    <div class="stats-hero-content">
        <h1>@I18n.T("statistics.heroTitle")</h1>
        <p class="stats-subtitle">@I18n.T("statistics.heroSubtitle")</p>
    </div>
</div>

@if (_stats is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Processing" Text="@I18n.T("statistics.loadingText")" />
}
else if (_stats is { BooksRead: 0, BooksInProgress: 0 })
{
    <EmptyState Message="@I18n.T("statistics.emptyMessage")" />
}
else
{
    <div class="dashboard-overview stats-overview">
        <StatCard Value="@_stats.BooksRead.ToString()" Label="@I18n.T("statistics.statBooksRead")" />
        <StatCard Value="@_stats.BooksInProgress.ToString()" Label="@I18n.T("statistics.statInProgress")" />
        <StatCard Value="@_stats.PagesRead.ToString()" Label="@I18n.T("statistics.statPagesRead")" />
        <StatCard Value="@_stats.Streaks.CurrentStreak.ToString()" Label="@I18n.T("statistics.statCurrentStreak")" IconName="flame" />
        <StatCard Value="@_stats.Streaks.LongestStreak.ToString()" Label="@I18n.T("statistics.statLongestStreak")" IconName="trophy" />
    </div>

    <div class="stats-panels">
        <section class="stats-panel goal-card">
            <h2><Icon Name="target" /> @I18n.T("statistics.goalTitle")</h2>
            @if (_stats.Goal.TargetBooks is { } target && target > 0)
            {
                var pct = Math.Clamp(_stats.Goal.BooksFinishedThisYear * 100.0 / target, 0, 100);
                <div class="goal-ring" style="--goal-pct: @(pct.ToString("F0", CultureInfo.InvariantCulture))">
                    <div class="goal-ring-inner">
                        <span class="goal-ring-value">@_stats.Goal.BooksFinishedThisYear</span>
                        <span class="goal-ring-of">@string.Format(I18n.T("statistics.goalOfLabel"), target)</span>
                    </div>
                </div>
                <p class="goal-status">
                    @if (_stats.Goal.BooksFinishedThisYear >= target)
                    {
                        <text>@I18n.T("statistics.goalReached")</text>
                    }
                    else
                    {
                        <text>@string.Format(I18n.T("statistics.goalRemaining"), target - _stats.Goal.BooksFinishedThisYear)</text>
                    }
                </p>
            }
            else
            {
                <p class="text-muted">@I18n.T("statistics.goalSetPrompt")</p>
            }
            <form class="goal-form" @onsubmit="SaveGoalAsync" @onsubmit:preventDefault="true">
                <input type="number" min="1" placeholder="@I18n.T("statistics.goalInputPlaceholder")" @bind="_goalInput" @bind:event="oninput" />
                <button type="submit" class="btn btn-primary">@I18n.T("statistics.goalSaveButton")</button>
                @if (_stats.Goal.TargetBooks is not null)
                {
                    <button type="button" class="btn" @onclick="ClearGoalAsync">@I18n.T("statistics.goalRemoveButton")</button>
                }
            </form>
        </section>

        <section class="stats-panel calendar-card">
            <h2><Icon Name="calendar" /> @I18n.T("statistics.calendarTitle")</h2>
            <div class="calendar-heatmap">
                @foreach (var week in _calendarWeeks)
                {
                    <div class="calendar-week">
                        @foreach (var day in week)
                        {
                            <div class="calendar-cell calendar-cell--level-@day.Level" title="@day.Tooltip" role="@(day.Count > 0 ? "img" : null)" aria-label="@(day.Count > 0 ? day.Tooltip : null)"></div>
                        }
                    </div>
                }
            </div>
            <div class="calendar-legend">
                <span class="calendar-legend-label">@I18n.T("statistics.calendarLegendLess")</span>
                <span class="calendar-cell calendar-cell--level-0"></span>
                <span class="calendar-cell calendar-cell--level-1"></span>
                <span class="calendar-cell calendar-cell--level-2"></span>
                <span class="calendar-cell calendar-cell--level-3"></span>
                <span class="calendar-cell calendar-cell--level-4"></span>
                <span class="calendar-legend-label">@I18n.T("statistics.calendarLegendMore")</span>
            </div>
        </section>
    </div>

    @if (_stats.YearlyOverview.Count > 0)
    {
        <h2><Icon Name="chart" /> @I18n.T("statistics.yearlyOverviewTitle")</h2>
        <div class="yearly-overview-list">
            @{
                var maxBooksPerYear = Math.Max(1, _stats.YearlyOverview.Max(y => y.BooksFinished));
            }
            @foreach (var year in _stats.YearlyOverview)
            {
                <div class="yearly-overview-row">
                    <span class="yearly-overview-year">@year.Year</span>
                    <MiniDial Value="@year.BooksFinished" Percentage="@(year.BooksFinished * 100.0 / maxBooksPerYear)" aria-hidden="true" />
                    <span class="yearly-overview-detail">@string.Format(I18n.T("statistics.yearlyOverviewDetail"), year.BooksFinished, year.PagesRead, year.ActiveDays)</span>
                </div>
            }
        </div>
    }

    @if (_stats.GenreBreakdown.Count > 0)
    {
        <h2>@I18n.T("statistics.genresTitle")</h2>
        <div class="statistics-genre-list">
            @{
                var maxGenreCount = _stats.GenreBreakdown.Max(g => g.Count);
            }
            @foreach (var genre in _stats.GenreBreakdown)
            {
                <div class="statistics-genre-row">
                    <span class="statistics-genre-label">@genre.Genre</span>
                    <MiniDial Value="@genre.Count" Percentage="@(genre.Count * 100.0 / maxGenreCount)" />
                </div>
            }
        </div>
    }

    @if (_stats.RecentActivity.Count > 0)
    {
        <h2>@I18n.T("statistics.recentActivityTitle")</h2>
        <div class="library-grid">
            @foreach (var item in _stats.RecentActivity)
            {
                <BookCard Book="item.Book" ProgressPercentage="item.Percentage" Href="@($"library/books/{item.Book.Id}/read")" />
            }
        </div>
    }
}

@code {
    private ElementReference _heroRef;
    private ElementReference _heroSentinelRef;
    private IJSObjectReference? _motionModule;

    private StatisticsResponse? _stats;
    private int? _goalInput;
    private List<List<CalendarCell>> _calendarWeeks = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiClient.GetAsync<StatisticsResponse>("/api/statistics");
        _stats = response is { Success: true, Data: not null } ? response.Data : new StatisticsResponse();
        _goalInput = _stats.Goal.TargetBooks;
        BuildCalendarWeeks();
    }

    // Reuses motion.js's initHeaderCompact for the hero itself (already
    // generic over any header/sentinel element pair, not app-header- or
    // Home-page-specific). Wrapped in try/catch matching every other
    // motion.js call site in this codebase — a blocked/failed module load
    // just leaves the hero uncompacted, same "progressive enhancement"
    // shape as everywhere else this module is used.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _motionModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
            await _motionModule.InvokeVoidAsync("initHeaderCompact", _heroRef, _heroSentinelRef);
        }
        catch (Exception)
        {
        }
    }

    // Builds a full Monday-start grid covering the last 52 weeks, even for
    // days with zero activity -- the API only returns days that actually
    // have a reading_activity row (sparse), but a heatmap needs every cell.
    private void BuildCalendarWeeks()
    {
        if (_stats is null)
        {
            _calendarWeeks = [];
            return;
        }

        var countByDate = _stats.ReadingCalendar.ToDictionary(d => d.Date, d => d.Count);
        var maxCount = countByDate.Count > 0 ? countByDate.Values.Max() : 0;

        var today = DateTime.UtcNow.Date;
        var mondayOffset = ((int)today.AddDays(-364).DayOfWeek + 6) % 7;
        var start = today.AddDays(-364).AddDays(-mondayOffset);

        var weeks = new List<List<CalendarCell>>();
        for (var current = start; current <= today; current = current.AddDays(7))
        {
            var week = new List<CalendarCell>();
            for (var offset = 0; offset < 7; offset++)
            {
                var date = current.AddDays(offset);
                if (date > today)
                {
                    week.Add(new CalendarCell(0, 0, ""));
                    continue;
                }

                var dateKey = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                var count = countByDate.GetValueOrDefault(dateKey, 0);
                var level = count == 0 ? 0 : Math.Clamp((int)Math.Ceiling(count * 4.0 / Math.Max(1, maxCount)), 1, 4);
                var tooltip = string.Format(I18n.T("statistics.calendarTooltip"), date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture), count);
                week.Add(new CalendarCell(count, level, tooltip));
            }
            weeks.Add(week);
        }
        _calendarWeeks = weeks;
    }

    private async Task SaveGoalAsync()
    {
        if (_goalInput is not { } target || target <= 0 || _stats is null) return;

        var response = await ApiClient.PutAsync<SetReadingGoalRequest, ReadingGoal>("/api/statistics/goal", new SetReadingGoalRequest { TargetBooks = target });
        if (response is { Success: true, Data: { } goal })
        {
            _stats.Goal = goal;
        }
    }

    private async Task ClearGoalAsync()
    {
        if (_stats is null) return;

        var response = await ApiClient.PutAsync<SetReadingGoalRequest, ReadingGoal>("/api/statistics/goal", new SetReadingGoalRequest { TargetBooks = null });
        if (response is { Success: true, Data: { } goal })
        {
            _stats.Goal = goal;
            _goalInput = null;
        }
    }

    private record CalendarCell(int Count, int Level, string Tooltip);

    public async ValueTask DisposeAsync()
    {
        if (_motionModule is not null)
        {
            try
            {
                await _motionModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
