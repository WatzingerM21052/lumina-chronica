@page "/statistics"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject II18nService I18n
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<PageTitle>@I18n.T("statistics.pageTitle") — Lumina Chronica</PageTitle>

<div class="stats-hero">
    <img src="images/statistics-hero-layer1-background.webp" alt="" class="stats-hero-layer stats-hero-layer-1" fetchpriority="high" />
    <img src="images/statistics-hero-layer2-moonlight.webp" alt="" class="stats-hero-layer stats-hero-layer-2" fetchpriority="low" decoding="async" />
    <img src="images/statistics-hero-layer3-armillary.webp" alt="" class="stats-hero-layer stats-hero-layer-3" fetchpriority="low" decoding="async" />
    <div class="stats-hero-scrim"></div>
    <div class="stats-hero-content">
        <h1>@I18n.T("statistics.heroTitle")</h1>
        <p class="stats-subtitle">@I18n.T("statistics.heroSubtitle")</p>
    </div>
</div>

@if (_stats is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Processing" Text="@I18n.T("statistics.loadingText")" />
}
else if (_stats is { BooksRead: 0, BooksInProgress: 0 })
{
    <EmptyState Message="@I18n.T("statistics.emptyMessage")" />
}
else
{
    <div class="dashboard-overview stats-overview">
        <StatCard Value="@_stats.BooksRead.ToString()" Label="@I18n.T("statistics.statBooksRead")" />
        <StatCard Value="@_stats.BooksInProgress.ToString()" Label="@I18n.T("statistics.statInProgress")" />
        <StatCard Value="@_stats.PagesRead.ToString()" Label="@I18n.T("statistics.statPagesRead")" />
        <StatCard Value="@_stats.Streaks.CurrentStreak.ToString()" Label="@I18n.T("statistics.statCurrentStreak")" IconName="flame" />
        <StatCard Value="@_stats.Streaks.LongestStreak.ToString()" Label="@I18n.T("statistics.statLongestStreak")" IconName="trophy" />
    </div>

    @* Dashboard grid (plan C2/C3): three columns on a wide screen, the
       calendar, trend and yearly cards spanning two; one column on a phone. *@
    <div class="stats-grid">
        @* Theme studio order: the calendar gets its own full-width row
           under the tiles; goal + trend, then genres, pace and years. *@
        <section class="stats-card stats-card--full calendar-card" @ref="_calendarCardRef">
            <div class="stats-card-head">
                <h2><Icon Name="calendar" /> @I18n.T("statistics.calendarTitle")</h2>
                @if (_stats.CalendarYears.Count > 1)
                {
                    <select class="calendar-year-select" aria-label="@I18n.T("statistics.calendarYearLabel")" value="@(_calendarYear?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="OnCalendarYearChanged">
                        <option value="">@I18n.T("statistics.calendarLast12")</option>
                        @foreach (var year in _stats.CalendarYears)
                        {
                            <option value="@year.ToString(CultureInfo.InvariantCulture)">@year</option>
                        }
                    </select>
                }
            </div>
            @* .calendar-scroll is a row-reverse flex box, so on a phone the
               swipeable heatmap starts scrolled to its right end -- the most
               recent weeks -- instead of last year's. *@
            <div class="calendar-scroll">
                <div class="calendar-heatmap" style="--weeks: @_calendarWeeks.Count" tabindex="0" aria-label="@I18n.T("statistics.calendarKeyboardHint")">
                    <div class="calendar-months" aria-hidden="true">
                        @foreach (var (column, label) in _monthLabels)
                        {
                            <span style="grid-column: @column">@label</span>
                        }
                    </div>
                    <div class="calendar-body">
                        <div class="calendar-weekdays" aria-hidden="true">
                            @foreach (var (label, index) in WeekdayNames().Select((label, index) => (label, index)))
                            {
                                <span>@(index % 2 == 0 ? label : "")</span>
                            }
                        </div>
                        <div class="calendar-weeks">
                            @foreach (var week in _calendarWeeks)
                            {
                                <div class="calendar-week">
                                    @foreach (var day in week)
                                    {
                                        @if (day.DateLabel is null)
                                        {
                                            <div class="calendar-cell calendar-cell--level-0 calendar-cell--outside"></div>
                                        }
                                        else
                                        {
                                            <div class="calendar-cell calendar-cell--level-@day.Level" data-date="@day.DateLabel" data-main="@day.Main" data-books="@day.Books"
                                                 role="@(day.Count > 0 ? "img" : null)" aria-label="@(day.Count > 0 ? day.AriaLabel : null)"></div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="calendar-tooltip" role="status" hidden></div>
            <div class="calendar-legend">
                <span class="calendar-legend-label">@I18n.T("statistics.calendarLegendLess")</span>
                <span class="calendar-cell calendar-cell--level-0"></span>
                <span class="calendar-cell calendar-cell--level-1"></span>
                <span class="calendar-cell calendar-cell--level-2"></span>
                <span class="calendar-cell calendar-cell--level-3"></span>
                <span class="calendar-cell calendar-cell--level-4"></span>
                <span class="calendar-legend-label">@I18n.T("statistics.calendarLegendMore")</span>
            </div>
        </section>

        <section class="stats-card goal-card">
            <div class="stats-card-head">
                <h2><Icon Name="target" /> @I18n.T("statistics.goalTitle")</h2>
                @if (!_editingGoal)
                {
                    <button type="button" class="btn btn-icon btn-icon-sm goal-edit" aria-label="@I18n.T("statistics.goalEditLabel")" title="@I18n.T("statistics.goalEditLabel")" @onclick="StartEditingGoal">
                        <Icon Name="edit" />
                    </button>
                }
            </div>
            @if (_stats.Goal.TargetBooks is { } target && target > 0)
            {
                var pct = Math.Clamp(_stats.Goal.BooksFinishedThisYear * 100.0 / target, 0, 100);
                <div class="goal-ring" style="--goal-pct: @(pct.ToString("F0", CultureInfo.InvariantCulture))">
                    <div class="goal-ring-inner">
                        <span class="goal-ring-value">@_stats.Goal.BooksFinishedThisYear</span>
                        <span class="goal-ring-of">@string.Format(I18n.T("statistics.goalOfLabel"), target)</span>
                    </div>
                </div>
                @if (!_editingGoal)
                {
                    <p class="goal-status">
                        @if (_stats.Goal.BooksFinishedThisYear >= target)
                        {
                            <text>@I18n.T("statistics.goalReached")</text>
                        }
                        else
                        {
                            <text>@string.Format(I18n.T("statistics.goalRemaining"), target - _stats.Goal.BooksFinishedThisYear)</text>
                        }
                    </p>
                }
            }
            else if (!_editingGoal)
            {
                <p class="text-muted goal-status">@I18n.T("statistics.goalSetPrompt")</p>
                <button type="button" class="btn btn-primary goal-set" @onclick="StartEditingGoal">@I18n.T("statistics.goalSetButton")</button>
            }
            @if (_editingGoal)
            {
                <form class="goal-form" @onsubmit="SaveGoalAsync" @onsubmit:preventDefault="true">
                    <div class="goal-stepper">
                        <button type="button" class="btn btn-icon goal-stepper-minus" aria-label="@I18n.T("statistics.goalDecrease")" disabled="@(_goalDraft <= MinGoal)" @onclick="() => StepGoal(-1)">−</button>
                        <output class="goal-stepper-value" aria-live="polite">@_goalDraft <span>@I18n.T("statistics.goalStepperUnit")</span></output>
                        <button type="button" class="btn btn-icon goal-stepper-plus" aria-label="@I18n.T("statistics.goalIncrease")" disabled="@(_goalDraft >= MaxGoal)" @onclick="() => StepGoal(1)">+</button>
                    </div>
                    <div class="goal-form-actions">
                        <button type="submit" class="btn btn-primary">@I18n.T("statistics.goalSaveButton")</button>
                        <button type="button" class="btn goal-cancel" @onclick="CancelEditingGoal">@I18n.T("statistics.goalCancelButton")</button>
                        @if (_stats.Goal.TargetBooks is not null)
                        {
                            <button type="button" class="btn goal-remove" @onclick="ClearGoalAsync">@I18n.T("statistics.goalRemoveButton")</button>
                        }
                    </div>
                </form>
            }
        </section>

        @if (_stats.MonthlyOverview.Count > 0)
        {
            <section class="stats-card stats-card--wide trend-card">
                <div class="stats-card-head">
                    <h2><Icon Name="chart" /> @I18n.T("statistics.trendTitle")</h2>
                    <div class="trend-toggle" role="group" aria-label="@I18n.T("statistics.trendTitle")">
                        <button type="button" class="trend-toggle-option" aria-pressed="@(_trendShowsBooks ? "false" : "true")" @onclick="() => _trendShowsBooks = false">@I18n.T("statistics.trendActiveDays")</button>
                        <button type="button" class="trend-toggle-option" aria-pressed="@(_trendShowsBooks ? "true" : "false")" @onclick="() => _trendShowsBooks = true">@I18n.T("statistics.trendBooksFinished")</button>
                    </div>
                </div>
                <LineChart Points="@TrendPoints()" AriaLabel="@I18n.T(_trendShowsBooks ? "statistics.trendChartLabelBooks" : "statistics.trendChartLabelActiveDays")" />
            </section>
        }

        @if (_stats.GenreBreakdown.Count > 0)
        {
            <section class="stats-card genre-card">
                <div class="stats-card-head">
                    <h2>@I18n.T("statistics.genresTitle")</h2>
                </div>
                <GenreDonut Genres="@_stats.GenreBreakdown" OtherLabel="@I18n.T("statistics.genresOther")" CenterLabel="@I18n.T("statistics.genresCenter")" AriaLabel="@I18n.T("statistics.genresChartLabel")" />
            </section>
        }

        <section class="stats-card pace-card">
            <div class="stats-card-head">
                <h2>@I18n.T("statistics.paceTitle")</h2>
            </div>
            <dl class="pace-figures">
                <div>
                    <dt>@I18n.T("statistics.pacePagesPerDay")</dt>
                    <dd>@Approx(_stats.ReadingPace.PagesPerActiveDay)</dd>
                </div>
                <div>
                    <dt>@I18n.T("statistics.paceDaysPerBook")</dt>
                    <dd>@Approx(_stats.ReadingPace.ActiveDaysPerBook)</dd>
                </div>
            </dl>
            <p class="pace-note">@I18n.T("statistics.paceNote")</p>
        </section>

        @if (_stats.YearlyOverview.Count > 0)
        {
            var maxBooksPerYear = Math.Max(1, _stats.YearlyOverview.Max(y => y.BooksFinished));
            <section class="stats-card yearly-card">
                <div class="stats-card-head">
                    <h2>@I18n.T("statistics.yearlyOverviewTitle")</h2>
                </div>
                <ul class="yearly-rows">
                    @foreach (var year in _stats.YearlyOverview)
                    {
                        <li class="yearly-row">
                            <span class="yearly-row-year">@year.Year</span>
                            <span class="yearly-row-bar" aria-hidden="true"><span style="width: @((year.BooksFinished * 100.0 / maxBooksPerYear).ToString("F0", CultureInfo.InvariantCulture))%"></span></span>
                            <span class="yearly-row-detail">@string.Format(I18n.T("statistics.yearlyOverviewDetail"), year.BooksFinished, year.PagesRead, year.ActiveDays)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    @if (_stats.RecentActivity.Count > 0)
    {
        <h2>@I18n.T("statistics.recentActivityTitle")</h2>
        <div class="library-grid">
            @foreach (var item in _stats.RecentActivity)
            {
                <BookCard Book="item.Book" ProgressPercentage="item.Percentage" Href="@($"library/books/{item.Book.Id}/read")" />
            }
        </div>
    }
}

@code {
    private const int MinGoal = 1;
    private const int MaxGoal = 999;
    private const int DefaultGoal = 12;

    private StatisticsResponse? _stats;
    private bool _editingGoal;
    private int _goalDraft = DefaultGoal;
    private bool _trendShowsBooks;
    private int? _calendarYear;
    private List<CalendarDay> _calendarDays = [];
    private List<List<CalendarCell>> _calendarWeeks = [];
    private List<(int Column, string Label)> _monthLabels = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiClient.GetAsync<StatisticsResponse>("/api/statistics");
        _stats = response is { Success: true, Data: not null } ? response.Data : new StatisticsResponse();
        _calendarDays = _stats.ReadingCalendar;
        BuildCalendarWeeks();
    }

    private string[] MonthNames() => I18n.T("statistics.monthsShort").Split(',');

    // Theme studio scale: pages per day (1-20, 21-40, 41-60, over 60). Days
    // without a page count (before backend migration 0028, or books with
    // no page number) fall back to the old relative activity level.
    private static int Level(CalendarDay? day, int maxCount)
    {
        if (day is null || day.Count == 0) return 0;
        if (day.Pages is { } pages and > 0)
        {
            return pages switch { <= 20 => 1, <= 40 => 2, <= 60 => 3, _ => 4 };
        }
        return Math.Clamp((int)Math.Ceiling(day.Count * 4.0 / Math.Max(1, maxCount)), 1, 4);
    }

    private string[] WeekdayNames() => I18n.T("statistics.weekdaysShort").Split(',');

    // Tooltip text for one day, e.g. "Mi, 13. Mai 2026" / "24 Seiten" /
    // "Dune · Emma". Built from the app language's own name lists and plain
    // integers, never CurrentCulture (see #554). Days before the backend
    // recorded pages (and books without a page count) say "Gelesen".
    private CalendarCell BuildCell(DateTime date, CalendarDay? day, int level)
    {
        var weekdays = WeekdayNames();
        var months = I18n.T("statistics.monthsLong").Split(',');
        var weekday = weekdays.Length == 7 ? weekdays[((int)date.DayOfWeek + 6) % 7] : "";
        var month = months.Length == 12 ? months[date.Month - 1] : date.Month.ToString(CultureInfo.InvariantCulture);
        var dateLabel = string.Format(CultureInfo.InvariantCulture, I18n.T("statistics.calendarDayLabel"), weekday, date.Day, month, date.Year);

        var count = day?.Count ?? 0;
        string main;
        if (count == 0)
        {
            main = I18n.T("statistics.calendarNotRead");
        }
        else if (day?.Pages is { } pages && pages > 0)
        {
            main = string.Format(CultureInfo.InvariantCulture, I18n.T(pages == 1 ? "statistics.calendarPage" : "statistics.calendarPages"), pages);
        }
        else
        {
            main = I18n.T("statistics.calendarRead");
        }

        var books = day is { Books.Count: > 0 } ? string.Join(" · ", day.Books) : null;
        var aria = books is null ? $"{dateLabel}: {main}" : $"{dateLabel}: {main}, {books}";
        return new CalendarCell(count, level, dateLabel, main, books, aria);
    }

    // Default: a Monday-start grid over the last 52 weeks. With a year
    // picked: 1 January to 31 December of that year. Either way every day
    // gets a cell, since the API only returns days that had activity.
    private void BuildCalendarWeeks()
    {
        var dayByDate = _calendarDays.ToDictionary(d => d.Date);
        var maxCount = dayByDate.Count > 0 ? dayByDate.Values.Max(d => d.Count) : 0;

        var today = DateTime.UtcNow.Date;
        var (first, last) = _calendarYear is { } year
            ? (new DateTime(year, 1, 1), new DateTime(year, 12, 31))
            : (today.AddDays(-364), today);
        var start = first.AddDays(-(((int)first.DayOfWeek + 6) % 7));
        var months = MonthNames();

        var weeks = new List<List<CalendarCell>>();
        var labels = new List<(int Column, string Label)>();
        for (var current = start; current <= last; current = current.AddDays(7))
        {
            var week = new List<CalendarCell>();
            for (var offset = 0; offset < 7; offset++)
            {
                var date = current.AddDays(offset);
                if (date < first || date > last || date > today)
                {
                    week.Add(new CalendarCell(0, 0, null, null, null, null));
                    continue;
                }

                // A month's name sits above the week holding its 1st (and
                // above the first column for the month the range starts in).
                if ((date.Day == 1 || date == first) && months.Length == 12)
                {
                    labels.Add((weeks.Count + 1, months[date.Month - 1]));
                }

                var dateKey = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                var day = dayByDate.GetValueOrDefault(dateKey);
                var count = day?.Count ?? 0;
                week.Add(BuildCell(date, day, Level(day, maxCount)));
            }
            weeks.Add(week);
        }

        // The partial month the rolling range starts in would overlap the
        // next month's label when it's only a week or two long: drop it.
        if (labels.Count > 1 && labels[1].Column - labels[0].Column < 3)
        {
            labels.RemoveAt(0);
        }

        _calendarWeeks = weeks;
        _monthLabels = labels;
    }

    private async Task OnCalendarYearChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year))
        {
            _calendarYear = null;
            _calendarDays = _stats?.ReadingCalendar ?? [];
            BuildCalendarWeeks();
            return;
        }

        var response = await ApiClient.GetAsync<List<CalendarDay>>($"/api/statistics/calendar?year={year}");
        if (response is { Success: true, Data: { } days })
        {
            _calendarYear = year;
            _calendarDays = days;
            BuildCalendarWeeks();
        }
    }

    private List<LineChartPoint> TrendPoints()
    {
        var months = MonthNames();
        return _stats!.MonthlyOverview.Select(m =>
        {
            var monthIndex = m.Month.Length >= 7 && int.TryParse(m.Month.AsSpan(5, 2), NumberStyles.Integer, CultureInfo.InvariantCulture, out var mm) ? mm : 0;
            var label = monthIndex is >= 1 and <= 12 && months.Length == 12 ? months[monthIndex - 1] : m.Month;
            var value = _trendShowsBooks ? m.BooksFinished : m.ActiveDays;
            var text = string.Format(I18n.T(_trendShowsBooks ? "statistics.trendValueBooks" : "statistics.trendValueDays"), value);
            return new LineChartPoint(label, value, text);
        }).ToList();
    }

    // "≈ 6,5" in German, "≈ 6.5" in English; "–" while there's no data yet.
    private string Approx(double? value)
    {
        if (value is not { } v) return "–";
        var separator = I18n.CurrentLanguage == "en" ? "." : ",";
        return "≈ " + v.ToString("0.#", CultureInfo.InvariantCulture).Replace(".", separator);
    }

    private void StartEditingGoal()
    {
        _goalDraft = _stats?.Goal.TargetBooks is { } target and > 0 ? target : DefaultGoal;
        _editingGoal = true;
    }

    private void CancelEditingGoal() => _editingGoal = false;

    private void StepGoal(int delta) => _goalDraft = Math.Clamp(_goalDraft + delta, MinGoal, MaxGoal);

    private async Task SaveGoalAsync()
    {
        if (_stats is null) return;

        var response = await ApiClient.PutAsync<SetReadingGoalRequest, ReadingGoal>("/api/statistics/goal", new SetReadingGoalRequest { TargetBooks = _goalDraft });
        if (response is { Success: true, Data: { } goal })
        {
            _stats.Goal = goal;
            _editingGoal = false;
        }
    }

    private async Task ClearGoalAsync()
    {
        if (_stats is null) return;

        var response = await ApiClient.PutAsync<SetReadingGoalRequest, ReadingGoal>("/api/statistics/goal", new SetReadingGoalRequest { TargetBooks = null });
        if (response is { Success: true, Data: { } goal })
        {
            _stats.Goal = goal;
            _editingGoal = false;
        }
    }

    private ElementReference _calendarCardRef;
    private IJSObjectReference? _calendarTooltipModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_calendarTooltipModule is not null || _stats is null) return;

        try
        {
            _calendarTooltipModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/calendarTooltip.js");
            await _calendarTooltipModule.InvokeVoidAsync("init", _calendarCardRef);
        }
        catch (Exception)
        {
            // Progressive enhancement: the cells keep their aria-labels.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_calendarTooltipModule is null) return;
        try
        {
            await _calendarTooltipModule.InvokeVoidAsync("dispose", _calendarCardRef);
            await _calendarTooltipModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // DateLabel is null for padding cells outside the shown range.
    private record CalendarCell(int Count, int Level, string? DateLabel, string? Main, string? Books, string? AriaLabel);
}
