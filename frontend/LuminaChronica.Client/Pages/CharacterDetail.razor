@page "/projects/{ProjectId:int}/characters/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@(_character?.Name ?? I18n.T("characterDetail.defaultTitle")) — Lumina Chronica</PageTitle>

<a href="@($"projects/{ProjectId}")">@I18n.T("characterDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_character is null)
{
    <LoadingIndicator Text="@I18n.T("characterDetail.loading")" />
}
else
{
    @* UI/UX plan A5: same header layout as book and project (image beside
       the info column); editing and relationships happen in dialogs. *@
    <div class="book-detail">
        <div class="book-detail-cover">
            @if (_imageObjectUrl is not null)
            {
                <img src="@_imageObjectUrl" alt="@_character.Name" />
            }
            else
            {
                <div class="book-card-cover-placeholder" aria-hidden="true"><Icon Name="person" /></div>
            }
        </div>

        <div class="book-detail-info">
            <h1>@_character.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_character.Origin) || !string.IsNullOrWhiteSpace(_character.Age))
            {
                <dl class="book-detail-meta">
                    @if (!string.IsNullOrWhiteSpace(_character.Origin))
                    {
                        <dt>@I18n.T("characterDetail.originLabel")</dt><dd>@_character.Origin</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_character.Age))
                    {
                        <dt>@I18n.T("characterDetail.ageLabel")</dt><dd>@_character.Age</dd>
                    }
                </dl>
            }
            @if (!string.IsNullOrWhiteSpace(_character.Description))
            {
                <p>@_character.Description</p>
            }
            @if (!string.IsNullOrWhiteSpace(_character.Personality))
            {
                <p><strong>@I18n.T("characterDetail.personalityLabel"):</strong> @_character.Personality</p>
            }
            @if (!string.IsNullOrWhiteSpace(_character.Biography))
            {
                <p><strong>@I18n.T("characterDetail.biographyLabel"):</strong> @_character.Biography</p>
            }
            <div class="form-actions">
                <button type="button" id="character-edit-button" class="btn" @onclick="StartEditing">@I18n.T("characterDetail.editButton")</button>
                <button type="button" class="btn" @onclick="() => _confirmingDelete = true">@I18n.T("characterDetail.deleteButton")</button>
            </div>
        </div>
    </div>
    <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("characterDetail.deleteConfirmMessage")"
                   OnConfirm="DeleteCharacterAsync" OnCancel="() => _confirmingDelete = false" />

    <Dialog IsOpen="_isEditing" Size="DialogSize.Large" Title="@I18n.T("characterDetail.editDialogTitle")"
            OnClose="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">
        <ChildContent>
            <EditForm id="character-edit-form" Model="_editForm" OnValidSubmit="() => _guard.SubmitAsync(SaveAsync)" class="auth-form">
                @if (_saveErrorMessage is not null)
                {
                    <p class="form-error">@_saveErrorMessage</p>
                }
                <h3 class="form-section-title">@I18n.T("characterDetail.editSectionGeneral")</h3>
                <div class="form-group">
                    <label for="character-edit-name">@I18n.T("characterDetail.nameLabel")</label>
                    <InputText id="character-edit-name" @bind-Value="_editForm.Name" />
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="character-edit-age">@I18n.T("characterDetail.ageLabel")</label>
                        <InputText id="character-edit-age" @bind-Value="_editForm.Age" />
                    </div>
                    <div class="form-group">
                        <label for="character-edit-origin">@I18n.T("characterDetail.originLabel")</label>
                        <InputText id="character-edit-origin" @bind-Value="_editForm.Origin" />
                    </div>
                </div>

                <h3 class="form-section-title">@I18n.T("characterDetail.editSectionStory")</h3>
                <div class="form-group">
                    <label for="character-edit-description">@I18n.T("characterDetail.descriptionLabel")</label>
                    <InputTextArea id="character-edit-description" @bind-Value="_editForm.Description" />
                </div>
                <div class="form-group">
                    <label for="character-edit-personality">@I18n.T("characterDetail.personalityLabel")</label>
                    <InputTextArea id="character-edit-personality" @bind-Value="_editForm.Personality" />
                </div>
                <div class="form-group">
                    <label for="character-edit-biography">@I18n.T("characterDetail.biographyLabel")</label>
                    <InputTextArea id="character-edit-biography" @bind-Value="_editForm.Biography" />
                </div>

                <h3 class="form-section-title">@I18n.T("characterDetail.replaceImageLabel")</h3>
                <FileDropzone Id="character-edit-image" Accept="image/*" Label="@I18n.T("characterDetail.dropzoneLabel")"
                              SelectedFileName="@_selectedEditImage?.Name" OnChange="OnEditImageSelected" />
                @if (_imageSaveErrorMessage is not null)
                {
                    <p class="form-error">@_imageSaveErrorMessage</p>
                }
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">@I18n.T("characterDetail.cancelButton")</button>
            <button type="submit" form="character-edit-form" class="btn btn-primary" disabled="@_guard.IsSubmitting">@I18n.T("characterDetail.saveButton")</button>
        </Footer>
    </Dialog>

    <div class="library-header">
        <h2>@I18n.T("characterDetail.relationshipsTitle")</h2>
        <button type="button" id="add-relationship-button" class="btn btn-primary" @onclick="OpenCreateRelationship">@I18n.T("characterDetail.addRelationshipButton")</button>
    </div>

    <Dialog IsOpen="_showCreateRelationshipForm" Title="@I18n.T("characterDetail.addRelationshipButton")"
            OnClose="() => _guard.RequestClose(IsCreateRelationshipDirty, () => _showCreateRelationshipForm = false)">
        <ChildContent>
            <EditForm id="create-relationship-form" Model="_createRelationshipForm" OnValidSubmit="() => _guard.SubmitAsync(CreateRelationshipAsync)" class="auth-form">
                @if (_createRelationshipErrorMessage is not null)
                {
                    <p class="form-error">@_createRelationshipErrorMessage</p>
                }
                <div class="form-group">
                    <label for="relationship-other-character">@I18n.T("characterDetail.otherCharacterLabel")</label>
                    <InputSelect id="relationship-other-character" @bind-Value="_createRelationshipForm.OtherCharacterId">
                        <option value="0">@I18n.T("characterDetail.selectPlaceholder")</option>
                        @if (_otherCharacters is not null)
                        {
                            @foreach (var other in _otherCharacters)
                            {
                                <option value="@other.Id">@other.Name</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label for="relationship-type">@I18n.T("characterDetail.relationshipTypeLabel")</label>
                    <InputText id="relationship-type" @bind-Value="_createRelationshipForm.RelationshipType" />
                </div>
                <div class="form-group">
                    <label for="relationship-description">@I18n.T("characterDetail.relationshipDescriptionLabel")</label>
                    <InputTextArea id="relationship-description" @bind-Value="_createRelationshipForm.Description" />
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="() => _guard.RequestClose(IsCreateRelationshipDirty, () => _showCreateRelationshipForm = false)">@I18n.T("characterDetail.cancelButton")</button>
            <button type="submit" form="create-relationship-form" class="btn btn-primary" disabled="@_guard.IsSubmitting">@I18n.T("characterDetail.addRelationshipSubmitButton")</button>
        </Footer>
    </Dialog>

    <Dialog IsOpen="_editingRelationshipId is not null" Title="@I18n.T("characterDetail.editRelationshipDialogTitle")"
            OnClose="() => _guard.RequestClose(IsEditRelationshipDirty, () => _editingRelationshipId = null)">
        <ChildContent>
            <EditForm id="edit-relationship-form" Model="_editRelationshipForm" OnValidSubmit="() => _guard.SubmitAsync(SaveRelationshipAsync)" class="auth-form">
                @if (_editRelationshipErrorMessage is not null)
                {
                    <p class="form-error">@_editRelationshipErrorMessage</p>
                }
                <div class="form-group">
                    <label for="relationship-edit-type">@I18n.T("characterDetail.relationshipLabel")</label>
                    <InputText id="relationship-edit-type" @bind-Value="_editRelationshipForm.RelationshipType" />
                </div>
                <div class="form-group">
                    <label for="relationship-edit-description">@I18n.T("characterDetail.descriptionLabel")</label>
                    <InputTextArea id="relationship-edit-description" @bind-Value="_editRelationshipForm.Description" />
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="() => _guard.RequestClose(IsEditRelationshipDirty, () => _editingRelationshipId = null)">@I18n.T("characterDetail.cancelButton")</button>
            <button type="submit" form="edit-relationship-form" class="btn btn-primary" disabled="@_guard.IsSubmitting">@I18n.T("characterDetail.saveButton")</button>
        </Footer>
    </Dialog>

    @if (_relationshipsErrorMessage is not null)
    {
        <p class="form-error">@_relationshipsErrorMessage</p>
    }
    else if (_relationships is null)
    {
        <LoadingIndicator Text="@I18n.T("characterDetail.relationshipsLoading")" />
    }
    else if (_relationships.Count == 0)
    {
        <p class="text-muted">@I18n.T("characterDetail.noRelationshipsMessage")</p>
    }
    else
    {
        @foreach (var relationship in _relationships)
        {
            <div class="book-form-card">
                <p><strong>@relationship.CharacterAName</strong> — @relationship.RelationshipType — <strong>@relationship.CharacterBName</strong></p>
                @if (!string.IsNullOrWhiteSpace(relationship.Description))
                {
                    <p>@relationship.Description</p>
                }
                <div class="form-actions">
                    <button type="button" class="btn" @onclick="() => StartEditingRelationship(relationship)">@I18n.T("characterDetail.editButton")</button>
                    <button type="button" class="btn" @onclick="() => DeleteRelationshipAsync(relationship.Id)">@I18n.T("characterDetail.deleteButton")</button>
                </div>
            </div>
        }
    }

    <ConfirmDialog IsOpen="_guard.IsConfirmingDiscard" Message="@I18n.T("dialog.discardChangesMessage")"
                   ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
                   OnConfirm="_guard.ConfirmDiscard" OnCancel="_guard.CancelDiscard" />
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Character? _character;
    private string? _loadErrorMessage;
    private string? _imageObjectUrl;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private string? _imageSaveErrorMessage;
    private IBrowserFile? _selectedEditImage;
    private EditFormModel _editForm = new();
    private EditFormModel _editFormSnapshot = new();
    private readonly DialogGuard _guard = new();
    private bool _confirmingDelete;

    private List<CharacterRelationship>? _relationships;
    private string? _relationshipsErrorMessage;
    private List<Character>? _otherCharacters;
    private bool _showCreateRelationshipForm;
    private string? _createRelationshipErrorMessage;
    private CreateRelationshipFormModel _createRelationshipForm = new();
    private int? _editingRelationshipId;
    private string? _editRelationshipErrorMessage;
    private UpdateCharacterRelationshipRequest _editRelationshipForm = new();
    private (string? Type, string? Description)? _editRelationshipSnapshot;

    protected override Task OnParametersSetAsync() =>
        Task.WhenAll(LoadCharacterAsync(), LoadRelationshipsAsync(), LoadOtherCharactersAsync());

    private async Task LoadCharacterAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Character>($"/api/projects/{ProjectId}/characters/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _character = response.Data;
            await LoadImageAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? I18n.T("characterDetail.loadError");
        }
    }

    private async Task LoadImageAsync()
    {
        if (_imageObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
            _imageObjectUrl = null;
        }

        if (_character?.ImageUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_character.ImageUrl);
        if (result is { } image)
        {
            _imageObjectUrl = await BlobUrlService.CreateObjectUrlAsync(image.Bytes, image.ContentType);
        }
    }

    private void StartEditing()
    {
        if (_character is null) return;
        _editForm = new EditFormModel
        {
            Name = _character.Name,
            Age = _character.Age,
            Origin = _character.Origin,
            Description = _character.Description,
            Personality = _character.Personality,
            Biography = _character.Biography,
        };
        _editFormSnapshot = _editForm with { };
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;
        _selectedEditImage = null;
        _isEditing = true;
    }

    private bool IsEditFormDirty => _editForm != _editFormSnapshot || _selectedEditImage is not null;

    private bool IsCreateRelationshipDirty =>
        _createRelationshipForm.OtherCharacterId != 0 ||
        DialogGuard.HasText(_createRelationshipForm.RelationshipType) ||
        DialogGuard.HasText(_createRelationshipForm.Description);

    private bool IsEditRelationshipDirty =>
        _editRelationshipSnapshot is not { } snapshot ||
        (_editRelationshipForm.RelationshipType ?? "") != (snapshot.Type ?? "") ||
        (_editRelationshipForm.Description ?? "") != (snapshot.Description ?? "");

    // Opens on a fresh form every time, so a cancelled attempt leaves nothing behind.
    private void OpenCreateRelationship()
    {
        _createRelationshipForm = new CreateRelationshipFormModel();
        _createRelationshipErrorMessage = null;
        _showCreateRelationshipForm = true;
    }

    private void OnEditImageSelected(InputFileChangeEventArgs e) => _selectedEditImage = e.File;

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateCharacterRequest, Character>($"/api/projects/{ProjectId}/characters/{Id}", new UpdateCharacterRequest
        {
            Name = _editForm.Name,
            Age = _editForm.Age,
            Origin = _editForm.Origin,
            Description = _editForm.Description,
            Personality = _editForm.Personality,
            Biography = _editForm.Biography,
        });

        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? I18n.T("characterDetail.saveError");
            return;
        }

        _character = response.Data;

        if (_selectedEditImage is not null)
        {
            const long maxImageBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditImage.OpenReadStream(maxImageBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditImage.ContentType) ? "application/octet-stream" : _selectedEditImage.ContentType);
            content.Add(streamContent, "\"image\"", $"\"{_selectedEditImage.Name}\"");

            var imageResponse = await ApiClient.PutMultipartAsync<Character>($"/api/projects/{ProjectId}/characters/{Id}/image", content);
            if (imageResponse is { Success: true, Data: not null })
            {
                _character = imageResponse.Data;
                await LoadImageAsync();
            }
            else
            {
                _imageSaveErrorMessage = imageResponse?.Error?.Message ?? I18n.T("characterDetail.imageSaveError");
                return;
            }
        }

        _isEditing = false;
    }

    private async Task DeleteCharacterAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/characters/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = I18n.T("characterDetail.deleteError");
        }
    }

    private async Task LoadRelationshipsAsync()
    {
        _relationshipsErrorMessage = null;
        var response = await ApiClient.GetAsync<List<CharacterRelationship>>($"/api/projects/{ProjectId}/relationships");
        if (response is { Success: true, Data: not null })
        {
            _relationships = [.. response.Data.Where(r => r.CharacterAId == Id || r.CharacterBId == Id)];
        }
        else
        {
            _relationshipsErrorMessage = response?.Error?.Message ?? I18n.T("characterDetail.relationshipsLoadError");
        }
    }

    private async Task LoadOtherCharactersAsync()
    {
        var response = await ApiClient.GetAsync<List<Character>>($"/api/projects/{ProjectId}/characters");
        if (response is { Success: true, Data: not null })
        {
            _otherCharacters = [.. response.Data.Where(c => c.Id != Id)];
        }
    }

    private async Task CreateRelationshipAsync()
    {
        _createRelationshipErrorMessage = null;

        if (_createRelationshipForm.OtherCharacterId == 0)
        {
            _createRelationshipErrorMessage = I18n.T("characterDetail.characterRequiredError");
            return;
        }
        if (string.IsNullOrWhiteSpace(_createRelationshipForm.RelationshipType))
        {
            _createRelationshipErrorMessage = I18n.T("characterDetail.relationshipRequiredError");
            return;
        }

        var response = await ApiClient.PostAsync<CreateCharacterRelationshipRequest, CharacterRelationship>($"/api/projects/{ProjectId}/relationships", new CreateCharacterRelationshipRequest
        {
            CharacterAId = Id,
            CharacterBId = _createRelationshipForm.OtherCharacterId,
            RelationshipType = _createRelationshipForm.RelationshipType,
            Description = _createRelationshipForm.Description,
        });

        if (response is { Success: true, Data: not null })
        {
            _showCreateRelationshipForm = false;
            _createRelationshipForm = new CreateRelationshipFormModel();
            await LoadRelationshipsAsync();
        }
        else
        {
            _createRelationshipErrorMessage = response?.Error?.Message ?? I18n.T("characterDetail.createRelationshipError");
        }
    }

    private void StartEditingRelationship(CharacterRelationship relationship)
    {
        _editRelationshipForm = new UpdateCharacterRelationshipRequest { RelationshipType = relationship.RelationshipType, Description = relationship.Description };
        _editRelationshipSnapshot = (relationship.RelationshipType, relationship.Description);
        _editRelationshipErrorMessage = null;
        _editingRelationshipId = relationship.Id;
    }

    private async Task SaveRelationshipAsync()
    {
        if (_editingRelationshipId is not { } relationshipId) return;
        _editRelationshipErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateCharacterRelationshipRequest, CharacterRelationship>($"/api/projects/{ProjectId}/relationships/{relationshipId}", _editRelationshipForm);
        if (response is { Success: true, Data: not null })
        {
            _editingRelationshipId = null;
            await LoadRelationshipsAsync();
        }
        else
        {
            _editRelationshipErrorMessage = response?.Error?.Message ?? I18n.T("characterDetail.saveError");
        }
    }

    private async Task DeleteRelationshipAsync(int relationshipId)
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/relationships/{relationshipId}");
        if (succeeded)
        {
            await LoadRelationshipsAsync();
        }
    }

    public void Dispose()
    {
        if (_imageObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
        }
    }

    private record EditFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Age { get; set; }
        public string? Origin { get; set; }
        public string? Description { get; set; }
        public string? Personality { get; set; }
        public string? Biography { get; set; }
    }

    private class CreateRelationshipFormModel
    {
        public int OtherCharacterId { get; set; }
        public string RelationshipType { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
