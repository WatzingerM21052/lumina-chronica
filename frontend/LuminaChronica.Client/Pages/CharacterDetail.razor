@page "/projects/{ProjectId:int}/characters/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager

<PageTitle>@(_character?.Name ?? "Charakter") — Lumina Chronica</PageTitle>

<a href="@($"projects/{ProjectId}")">← Zurück zum Projekt</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_character is null)
{
    <LoadingIndicator Text="Charakter wird geladen..." />
}
else
{
    <div class="book-detail-cover">
        @if (_imageObjectUrl is not null)
        {
            <img src="@_imageObjectUrl" alt="@_character.Name" />
        }
        else
        {
            <div class="book-card-cover-placeholder">🧑</div>
        }
    </div>

    @if (!_isEditing)
    {
        <h1>@_character.Name</h1>
        @if (!string.IsNullOrWhiteSpace(_character.Origin))
        {
            <p class="text-muted">@_character.Origin</p>
        }
        @if (!string.IsNullOrWhiteSpace(_character.Age))
        {
            <p><strong>Alter:</strong> @_character.Age</p>
        }
        @if (!string.IsNullOrWhiteSpace(_character.Description))
        {
            <p>@_character.Description</p>
        }
        @if (!string.IsNullOrWhiteSpace(_character.Personality))
        {
            <p><strong>Persönlichkeit:</strong> @_character.Personality</p>
        }
        @if (!string.IsNullOrWhiteSpace(_character.Biography))
        {
            <p><strong>Geschichte:</strong> @_character.Biography</p>
        }
        <div class="form-actions">
            <button type="button" class="btn" @onclick="StartEditing">Bearbeiten</button>
            <button type="button" class="btn" @onclick="() => _confirmingDelete = true">Löschen</button>
        </div>
        <ConfirmDialog IsOpen="_confirmingDelete" Message="Charakter wirklich löschen?"
                       OnConfirm="DeleteCharacterAsync" OnCancel="() => _confirmingDelete = false" />
    }
    else
    {
        <EditForm Model="_editForm" OnValidSubmit="SaveAsync" class="auth-form">
            @if (_saveErrorMessage is not null)
            {
                <p class="form-error">@_saveErrorMessage</p>
            }
            <div class="form-group">
                <label for="character-edit-image">Bild ersetzen</label>
                <div class="dropzone @(_isDraggingImage ? "dropzone--active" : "")"
                     @ondragenter="() => _isDraggingImage = true" @ondragleave="() => _isDraggingImage = false"
                     @ondragover:preventDefault @ondrop="() => _isDraggingImage = false">
                    <InputFile id="character-edit-image" OnChange="OnEditImageSelected" />
                    <span class="dropzone-label">Bild hierher ziehen oder klicken zum Auswählen</span>
                </div>
                @if (_imageSaveErrorMessage is not null)
                {
                    <p class="form-error">@_imageSaveErrorMessage</p>
                }
            </div>
            <div class="form-group">
                <label for="character-edit-name">Name</label>
                <InputText id="character-edit-name" @bind-Value="_editForm.Name" />
            </div>
            <div class="form-group">
                <label for="character-edit-age">Alter</label>
                <InputText id="character-edit-age" @bind-Value="_editForm.Age" />
            </div>
            <div class="form-group">
                <label for="character-edit-origin">Herkunft</label>
                <InputText id="character-edit-origin" @bind-Value="_editForm.Origin" />
            </div>
            <div class="form-group">
                <label for="character-edit-description">Beschreibung</label>
                <InputTextArea id="character-edit-description" @bind-Value="_editForm.Description" />
            </div>
            <div class="form-group">
                <label for="character-edit-personality">Persönlichkeit</label>
                <InputTextArea id="character-edit-personality" @bind-Value="_editForm.Personality" />
            </div>
            <div class="form-group">
                <label for="character-edit-biography">Geschichte</label>
                <InputTextArea id="character-edit-biography" @bind-Value="_editForm.Biography" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Speichern</button>
                <button type="button" class="btn" @onclick="() => _isEditing = false">Abbrechen</button>
            </div>
        </EditForm>
    }

    <div class="library-header">
        <h2>Beziehungen</h2>
        <button type="button" class="btn btn-primary" @onclick="() => _showCreateRelationshipForm = !_showCreateRelationshipForm">
            @(_showCreateRelationshipForm ? "Abbrechen" : "Beziehung hinzufügen")
        </button>
    </div>

    @if (_showCreateRelationshipForm)
    {
        <EditForm Model="_createRelationshipForm" OnValidSubmit="CreateRelationshipAsync" class="book-form-card">
            @if (_createRelationshipErrorMessage is not null)
            {
                <p class="form-error">@_createRelationshipErrorMessage</p>
            }
            <div class="form-group">
                <label for="relationship-other-character">Anderer Charakter</label>
                <InputSelect id="relationship-other-character" @bind-Value="_createRelationshipForm.OtherCharacterId">
                    <option value="0">-- auswählen --</option>
                    @if (_otherCharacters is not null)
                    {
                        @foreach (var other in _otherCharacters)
                        {
                            <option value="@other.Id">@other.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="form-group">
                <label for="relationship-type">Beziehung (z.B. "Mentor von")</label>
                <InputText id="relationship-type" @bind-Value="_createRelationshipForm.RelationshipType" />
            </div>
            <div class="form-group">
                <label for="relationship-description">Beschreibung (optional)</label>
                <InputTextArea id="relationship-description" @bind-Value="_createRelationshipForm.Description" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Hinzufügen</button>
            </div>
        </EditForm>
    }

    @if (_relationshipsErrorMessage is not null)
    {
        <p class="form-error">@_relationshipsErrorMessage</p>
    }
    else if (_relationships is null)
    {
        <LoadingIndicator Text="Beziehungen werden geladen..." />
    }
    else if (_relationships.Count == 0)
    {
        <p class="text-muted">Dieser Charakter hat noch keine Beziehungen.</p>
    }
    else
    {
        @foreach (var relationship in _relationships)
        {
            <div class="book-form-card">
                @if (_editingRelationshipId == relationship.Id)
                {
                    <EditForm Model="_editRelationshipForm" OnValidSubmit="SaveRelationshipAsync">
                        @if (_editRelationshipErrorMessage is not null)
                        {
                            <p class="form-error">@_editRelationshipErrorMessage</p>
                        }
                        <div class="form-group">
                            <label for="@($"relationship-edit-type-{relationship.Id}")">Beziehung</label>
                            <InputText id="@($"relationship-edit-type-{relationship.Id}")" @bind-Value="_editRelationshipForm.RelationshipType" />
                        </div>
                        <div class="form-group">
                            <label for="@($"relationship-edit-description-{relationship.Id}")">Beschreibung</label>
                            <InputTextArea id="@($"relationship-edit-description-{relationship.Id}")" @bind-Value="_editRelationshipForm.Description" />
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Speichern</button>
                            <button type="button" class="btn" @onclick="() => _editingRelationshipId = null">Abbrechen</button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <p><strong>@relationship.CharacterAName</strong> — @relationship.RelationshipType — <strong>@relationship.CharacterBName</strong></p>
                    @if (!string.IsNullOrWhiteSpace(relationship.Description))
                    {
                        <p>@relationship.Description</p>
                    }
                    <div class="form-actions">
                        <button type="button" class="btn" @onclick="() => StartEditingRelationship(relationship)">Bearbeiten</button>
                        <button type="button" class="btn" @onclick="() => DeleteRelationshipAsync(relationship.Id)">Löschen</button>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Character? _character;
    private string? _loadErrorMessage;
    private string? _imageObjectUrl;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private string? _imageSaveErrorMessage;
    private IBrowserFile? _selectedEditImage;
    private bool _isDraggingImage;
    private EditFormModel _editForm = new();
    private bool _confirmingDelete;

    private List<CharacterRelationship>? _relationships;
    private string? _relationshipsErrorMessage;
    private List<Character>? _otherCharacters;
    private bool _showCreateRelationshipForm;
    private string? _createRelationshipErrorMessage;
    private CreateRelationshipFormModel _createRelationshipForm = new();
    private int? _editingRelationshipId;
    private string? _editRelationshipErrorMessage;
    private UpdateCharacterRelationshipRequest _editRelationshipForm = new();

    protected override Task OnParametersSetAsync() =>
        Task.WhenAll(LoadCharacterAsync(), LoadRelationshipsAsync(), LoadOtherCharactersAsync());

    private async Task LoadCharacterAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Character>($"/api/projects/{ProjectId}/characters/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _character = response.Data;
            await LoadImageAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? "Charakter konnte nicht geladen werden.";
        }
    }

    private async Task LoadImageAsync()
    {
        if (_imageObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
            _imageObjectUrl = null;
        }

        if (_character?.ImageUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_character.ImageUrl);
        if (result is { } image)
        {
            _imageObjectUrl = await BlobUrlService.CreateObjectUrlAsync(image.Bytes, image.ContentType);
        }
    }

    private void StartEditing()
    {
        if (_character is null) return;
        _editForm = new EditFormModel
        {
            Name = _character.Name,
            Age = _character.Age,
            Origin = _character.Origin,
            Description = _character.Description,
            Personality = _character.Personality,
            Biography = _character.Biography,
        };
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;
        _selectedEditImage = null;
        _isEditing = true;
    }

    private void OnEditImageSelected(InputFileChangeEventArgs e) => _selectedEditImage = e.File;

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateCharacterRequest, Character>($"/api/projects/{ProjectId}/characters/{Id}", new UpdateCharacterRequest
        {
            Name = _editForm.Name,
            Age = _editForm.Age,
            Origin = _editForm.Origin,
            Description = _editForm.Description,
            Personality = _editForm.Personality,
            Biography = _editForm.Biography,
        });

        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? "Speichern fehlgeschlagen.";
            return;
        }

        _character = response.Data;

        if (_selectedEditImage is not null)
        {
            const long maxImageBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditImage.OpenReadStream(maxImageBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditImage.ContentType) ? "application/octet-stream" : _selectedEditImage.ContentType);
            content.Add(streamContent, "\"image\"", $"\"{_selectedEditImage.Name}\"");

            var imageResponse = await ApiClient.PutMultipartAsync<Character>($"/api/projects/{ProjectId}/characters/{Id}/image", content);
            if (imageResponse is { Success: true, Data: not null })
            {
                _character = imageResponse.Data;
                await LoadImageAsync();
            }
            else
            {
                _imageSaveErrorMessage = imageResponse?.Error?.Message ?? "Bild konnte nicht ersetzt werden.";
                return;
            }
        }

        _isEditing = false;
    }

    private async Task DeleteCharacterAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/characters/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = "Löschen fehlgeschlagen.";
        }
    }

    private async Task LoadRelationshipsAsync()
    {
        _relationshipsErrorMessage = null;
        var response = await ApiClient.GetAsync<List<CharacterRelationship>>($"/api/projects/{ProjectId}/relationships");
        if (response is { Success: true, Data: not null })
        {
            _relationships = [.. response.Data.Where(r => r.CharacterAId == Id || r.CharacterBId == Id)];
        }
        else
        {
            _relationshipsErrorMessage = response?.Error?.Message ?? "Beziehungen konnten nicht geladen werden.";
        }
    }

    private async Task LoadOtherCharactersAsync()
    {
        var response = await ApiClient.GetAsync<List<Character>>($"/api/projects/{ProjectId}/characters");
        if (response is { Success: true, Data: not null })
        {
            _otherCharacters = [.. response.Data.Where(c => c.Id != Id)];
        }
    }

    private async Task CreateRelationshipAsync()
    {
        _createRelationshipErrorMessage = null;

        if (_createRelationshipForm.OtherCharacterId == 0)
        {
            _createRelationshipErrorMessage = "Bitte wähle einen Charakter aus.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_createRelationshipForm.RelationshipType))
        {
            _createRelationshipErrorMessage = "Bitte gib eine Beziehung ein.";
            return;
        }

        var response = await ApiClient.PostAsync<CreateCharacterRelationshipRequest, CharacterRelationship>($"/api/projects/{ProjectId}/relationships", new CreateCharacterRelationshipRequest
        {
            CharacterAId = Id,
            CharacterBId = _createRelationshipForm.OtherCharacterId,
            RelationshipType = _createRelationshipForm.RelationshipType,
            Description = _createRelationshipForm.Description,
        });

        if (response is { Success: true, Data: not null })
        {
            _showCreateRelationshipForm = false;
            _createRelationshipForm = new CreateRelationshipFormModel();
            await LoadRelationshipsAsync();
        }
        else
        {
            _createRelationshipErrorMessage = response?.Error?.Message ?? "Beziehung konnte nicht erstellt werden.";
        }
    }

    private void StartEditingRelationship(CharacterRelationship relationship)
    {
        _editRelationshipForm = new UpdateCharacterRelationshipRequest { RelationshipType = relationship.RelationshipType, Description = relationship.Description };
        _editRelationshipErrorMessage = null;
        _editingRelationshipId = relationship.Id;
    }

    private async Task SaveRelationshipAsync()
    {
        if (_editingRelationshipId is not { } relationshipId) return;
        _editRelationshipErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateCharacterRelationshipRequest, CharacterRelationship>($"/api/projects/{ProjectId}/relationships/{relationshipId}", _editRelationshipForm);
        if (response is { Success: true, Data: not null })
        {
            _editingRelationshipId = null;
            await LoadRelationshipsAsync();
        }
        else
        {
            _editRelationshipErrorMessage = response?.Error?.Message ?? "Speichern fehlgeschlagen.";
        }
    }

    private async Task DeleteRelationshipAsync(int relationshipId)
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/relationships/{relationshipId}");
        if (succeeded)
        {
            await LoadRelationshipsAsync();
        }
    }

    public void Dispose()
    {
        if (_imageObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
        }
    }

    private class EditFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Age { get; set; }
        public string? Origin { get; set; }
        public string? Description { get; set; }
        public string? Personality { get; set; }
        public string? Biography { get; set; }
    }

    private class CreateRelationshipFormModel
    {
        public int OtherCharacterId { get; set; }
        public string RelationshipType { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
