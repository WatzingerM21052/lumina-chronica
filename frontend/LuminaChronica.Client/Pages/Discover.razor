@page "/discover"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>Entdecken — Lumina Chronica</PageTitle>

<h1 data-reveal style="--reveal-delay: 0ms">Entdecken <span class="discover-heading-caption">— Werke und Welten aus aller Welt</span></h1>

<section class="discover-section" data-reveal style="--reveal-delay: 60ms">
    <h2 class="discover-subheading">Nutzer suchen</h2>
    <div class="discover-search-field">
        <Icon Name="search" Class="discover-search-icon" />
        <input placeholder="Benutzername…" aria-label="Nutzer nach Benutzername durchsuchen" @oninput="OnUserSearchInput" />
    </div>

    @* aria-live="polite" -- announces the debounced search's outcome
       (result count via the list itself, or the empty/loading message)
       without interrupting whatever the user is currently doing, which
       aria-live="assertive" would. aria-busy reflects the in-flight state
       explicitly rather than leaving a silent gap during the 400ms
       debounce + request. *@
    <div aria-live="polite" aria-busy="@(_isSearchingUsers ? "true" : "false")">
        @if (_isSearchingUsers)
        {
            <p class="text-muted">Suche läuft…</p>
        }
        else if (_userSearchResults is { Count: > 0 })
        {
            <ul class="discover-author-results">
                @foreach (var user in _userSearchResults)
                {
                    <li>
                        <a class="discover-author-card" href="@($"u/{user.Username}")">
                            @if (user.AvatarUrl is { } avatarUrl)
                            {
                                <img src="@avatarUrl" alt="" class="discover-author-avatar" />
                            }
                            else
                            {
                                <span class="discover-author-avatar discover-author-avatar-placeholder" aria-hidden="true"><Icon Name="person" /></span>
                            }
                            <span class="discover-author-info">
                                <span class="discover-author-name">@user.Username</span>
                                <span class="discover-author-role">Autor / Worldbuilder</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
        else if (!string.IsNullOrWhiteSpace(_userSearchTerm))
        {
            <p class="text-muted">Keine Nutzer gefunden.</p>
        }
    </div>
</section>

<section class="discover-section" data-reveal style="--reveal-delay: 120ms">
    <div class="discover-books-toolbar">
        <h2 class="chapter-title">Bibliotheksregal <span class="chapter-caption">— öffentliche Bücher</span></h2>
        <div class="discover-sort-field">
            <label class="discover-sort-label" for="discover-sort">Sortieren</label>
            <select id="discover-sort" @bind="_sort" @bind:after="LoadBooksAsync">
                <option value="newest">Neueste</option>
                <option value="rating">Beste Bewertung</option>
            </select>
        </div>
    </div>

    @if (_books is null)
    {
        <span class="visually-hidden" role="status">Bücher werden geladen…</span>
        <div class="catalog-grid" aria-hidden="true" aria-busy="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="discover-skeleton-card">
                    <div class="skeleton-shape discover-skeleton-cover"></div>
                    <div class="skeleton-shape discover-skeleton-line"></div>
                </div>
            }
        </div>
    }
    else if (_books.Count == 0)
    {
        <div class="empty-state-literary">
            <span class="empty-state-ornament" aria-hidden="true">❦</span>
            <p>Dieses Regal wartet noch auf seinen ersten Eintrag.</p>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var book in _books)
            {
                <CatalogCard Kind="book"
                             Href="@($"library/books/{book.Id}")"
                             Title="@book.Title"
                             Subtitle="@book.Author"
                             CoverUrl="@(_coverObjectUrls.TryGetValue(book.Id, out var coverUrl) ? coverUrl : null)"
                             OwnerUsername="@book.OwnerUsername"
                             OnOwnerClick="GoToProfile"
                             RatingAverage="@book.AverageRating"
                             RatingCount="@book.RatingCount" />
            }
        </div>
    }
</section>

@code {
    private List<DiscoverBook>? _books;
    private string _sort = "newest";
    private readonly Dictionary<int, string> _coverObjectUrls = [];

    // Passed to CatalogCard's OnOwnerClick -- see CatalogCard.razor for why
    // that's a stopPropagation span rather than a nested <a>.
    private void GoToProfile(string username) => NavigationManager.NavigateTo($"u/{username}");

    private string _userSearchTerm = string.Empty;
    private List<DiscoverUser>? _userSearchResults;
    private System.Threading.Timer? _userSearchDebounceTimer;
    private bool _isSearchingUsers;
    private IJSObjectReference? _motionModule;

    protected override async Task OnInitializedAsync() => await LoadBooksAsync();

    // See PublicProfile.razor's OnAfterRenderAsync for why this can't live
    // in MainLayout: the book grid/skeleton only exist in the DOM once
    // _books finishes loading, which happens after MainLayout's own first
    // render. Called every render (idempotent, cheap) rather than gated on
    // firstRender, since above-fold-vs-below-fold intersection can change
    // as the skeleton grid resolves into real content.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _motionModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
            await _motionModule.InvokeVoidAsync("initReveal");
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadBooksAsync()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            await BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _coverObjectUrls.Clear();

        var response = await ApiClient.GetAsync<DiscoverBookListResponse>($"/api/discover/books?sort={_sort}");
        _books = response is { Success: true, Data: not null } ? response.Data.Items : [];

        foreach (var book in _books)
        {
            if (book.CoverUrl is null) continue;
            var result = await ApiClient.GetBytesAsync(book.CoverUrl);
            if (result is { } cover)
            {
                _coverObjectUrls[book.Id] = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
            }
        }
    }

    private void OnUserSearchInput(ChangeEventArgs e)
    {
        _userSearchTerm = e.Value?.ToString() ?? string.Empty;
        // Set as soon as typing happens, not just once the debounce fires
        // below -- covers the full "nothing's happened yet" gap (issue
        // #341's search-accessibility requirement) with a single flag.
        _isSearchingUsers = !string.IsNullOrWhiteSpace(_userSearchTerm);

        _userSearchDebounceTimer?.Dispose();
        _userSearchDebounceTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () =>
            {
                await SearchUsersAsync();
                // Same gap as Library.razor's search-as-you-type: a Timer
                // callback reached via InvokeAsync doesn't auto-render.
                StateHasChanged();
            }),
            null,
            400,
            Timeout.Infinite);
    }

    private async Task SearchUsersAsync()
    {
        if (string.IsNullOrWhiteSpace(_userSearchTerm))
        {
            _userSearchResults = null;
            _isSearchingUsers = false;
            return;
        }

        var response = await ApiClient.GetAsync<DiscoverUserListResponse>($"/api/discover/users?search={Uri.EscapeDataString(_userSearchTerm)}");
        _userSearchResults = response is { Success: true, Data: not null } ? response.Data.Items : [];
        _isSearchingUsers = false;
    }

    public void Dispose()
    {
        _userSearchDebounceTimer?.Dispose();
        if (_motionModule is not null)
        {
            _ = _motionModule.DisposeAsync();
        }
        foreach (var url in _coverObjectUrls.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
    }
}
