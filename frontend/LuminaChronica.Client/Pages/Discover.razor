@page "/discover"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@implements IDisposable
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager

<PageTitle>Entdecken — Lumina Chronica</PageTitle>

<h1>Entdecken</h1>

<section>
    <h2>Nutzer suchen</h2>
    <input placeholder="Benutzername..." @oninput="OnUserSearchInput" />

    @if (_userSearchResults is { Count: > 0 })
    {
        <ul class="discover-user-results">
            @foreach (var user in _userSearchResults)
            {
                <li>
                    <a href="@($"u/{user.Username}")">
                        @if (user.AvatarUrl is { } avatarUrl)
                        {
                            <img src="@avatarUrl" alt="" class="discover-user-avatar" />
                        }
                        else
                        {
                            <span class="discover-user-avatar discover-user-avatar-placeholder" aria-hidden="true"><Icon Name="person" /></span>
                        }
                        @user.Username
                    </a>
                </li>
            }
        </ul>
    }
    else if (!string.IsNullOrWhiteSpace(_userSearchTerm))
    {
        <p class="text-muted">Keine Nutzer gefunden.</p>
    }
</section>

<section>
    <div class="library-header">
        <h2>Öffentliche Bücher</h2>
        <select @bind="_sort" @bind:after="LoadBooksAsync">
            <option value="newest">Neueste</option>
            <option value="rating">Beste Bewertung</option>
        </select>
    </div>

    @if (_books is null)
    {
        <p>Lädt…</p>
    }
    else if (_books.Count == 0)
    {
        <p class="text-muted">Noch keine öffentlichen Bücher vorhanden.</p>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var book in _books)
            {
                <CatalogCard Kind="book"
                             Href="@($"library/books/{book.Id}")"
                             Title="@book.Title"
                             Subtitle="@book.Author"
                             CoverUrl="@(_coverObjectUrls.TryGetValue(book.Id, out var coverUrl) ? coverUrl : null)"
                             OwnerUsername="@book.OwnerUsername"
                             OnOwnerClick="GoToProfile"
                             RatingAverage="@book.AverageRating"
                             RatingCount="@book.RatingCount" />
            }
        </div>
    }
</section>

@code {
    private List<DiscoverBook>? _books;
    private string _sort = "newest";
    private readonly Dictionary<int, string> _coverObjectUrls = [];

    // Passed to CatalogCard's OnOwnerClick -- see CatalogCard.razor for why
    // that's a stopPropagation span rather than a nested <a>.
    private void GoToProfile(string username) => NavigationManager.NavigateTo($"u/{username}");

    private string _userSearchTerm = string.Empty;
    private List<DiscoverUser>? _userSearchResults;
    private System.Threading.Timer? _userSearchDebounceTimer;

    protected override async Task OnInitializedAsync() => await LoadBooksAsync();

    private async Task LoadBooksAsync()
    {
        foreach (var url in _coverObjectUrls.Values)
        {
            await BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _coverObjectUrls.Clear();

        var response = await ApiClient.GetAsync<DiscoverBookListResponse>($"/api/discover/books?sort={_sort}");
        _books = response is { Success: true, Data: not null } ? response.Data.Items : [];

        foreach (var book in _books)
        {
            if (book.CoverUrl is null) continue;
            var result = await ApiClient.GetBytesAsync(book.CoverUrl);
            if (result is { } cover)
            {
                _coverObjectUrls[book.Id] = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
            }
        }
    }

    private void OnUserSearchInput(ChangeEventArgs e)
    {
        _userSearchTerm = e.Value?.ToString() ?? string.Empty;

        _userSearchDebounceTimer?.Dispose();
        _userSearchDebounceTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () =>
            {
                await SearchUsersAsync();
                // Same gap as Library.razor's search-as-you-type: a Timer
                // callback reached via InvokeAsync doesn't auto-render.
                StateHasChanged();
            }),
            null,
            400,
            Timeout.Infinite);
    }

    private async Task SearchUsersAsync()
    {
        if (string.IsNullOrWhiteSpace(_userSearchTerm))
        {
            _userSearchResults = null;
            return;
        }

        var response = await ApiClient.GetAsync<DiscoverUserListResponse>($"/api/discover/users?search={Uri.EscapeDataString(_userSearchTerm)}");
        _userSearchResults = response is { Success: true, Data: not null } ? response.Data.Items : [];
    }

    public void Dispose()
    {
        _userSearchDebounceTimer?.Dispose();
        foreach (var url in _coverObjectUrls.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
    }
}
