@page "/oauth-callback"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject LuminaAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Anmelden — Lumina Chronica</PageTitle>

@if (_errorMessage is not null)
{
    <div class="auth-form">
        <p class="form-error">@_errorMessage</p>
        <p class="text-muted"><a href="login">Zurück zur Anmeldung</a></p>
    </div>
}
else
{
    <LoadingIndicator Text="Anmelden..." />
}

@code {
    private string? _errorMessage;

    // The backend's /api/auth/oauth/:provider/callback redirects here with
    // either ?code=<single-use exchange code> or ?error=<reason> -- never
    // both. See backend/src/routes/auth.ts's OAuth section and
    // oauthService.ts's module comments for why the handoff goes through a
    // short-lived code (POSTed below) rather than a token embedded directly
    // in this URL: this app has no shared cookie between the GitHub Pages
    // frontend and Workers backend origins, and a JWT sitting in the URL
    // would land in browser history and any referrer header.
    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?');
        string? code = null;
        string? error = null;
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;
            if (parts[0] == "code") code = Uri.UnescapeDataString(parts[1]);
            else if (parts[0] == "error") error = Uri.UnescapeDataString(parts[1]);
        }

        if (error is not null)
        {
            _errorMessage = DescribeError(error);
            return;
        }

        if (code is null)
        {
            _errorMessage = "Diese Seite wird nur nach einer Google-/GitHub-Anmeldung aufgerufen.";
            return;
        }

        var response = await ApiClient.PostAsync<OAuthExchangeRequest, AuthResult>(
            "/api/auth/oauth/exchange", new OAuthExchangeRequest { Code = code });

        if (response is { Success: true, Data: not null })
        {
            await AuthStateProvider.MarkUserAsAuthenticatedAsync(response.Data.Token);
            NavigationManager.NavigateTo("");
            return;
        }

        _errorMessage = "Der Anmeldelink ist abgelaufen oder wurde bereits verwendet. Bitte versuche es erneut.";
    }

    private static string DescribeError(string error) => error switch
    {
        "invalid_state" => "Die Anmeldeanfrage ist abgelaufen. Bitte versuche es erneut.",
        "exchange_failed" => "Die Anmeldung beim Anbieter ist fehlgeschlagen. Bitte versuche es erneut.",
        _ => "Die Anmeldung ist fehlgeschlagen. Bitte versuche es erneut.",
    };
}
