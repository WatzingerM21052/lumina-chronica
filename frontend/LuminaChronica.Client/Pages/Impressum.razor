@page "/impressum"
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject II18nService I18n

<PageTitle>@I18n.T("impressum.title") — Lumina Chronica</PageTitle>

<WorldBanner Page="impressum" Title="@I18n.T("impressum.title")" />
<div class="page-header">
    <h1>@I18n.T("impressum.title")</h1>
</div>

@* Themed worlds: the sections sit on one content card. *@
<div class="world-surface">

<section class="impressum-section">
    <h2>@I18n.T("impressum.section1Title")</h2>
    <p>
        Matthias Watzinger<br />
        Aigen 27<br />
        4710 Hofkirchen an der Trattnach<br />
        @I18n.T("impressum.country")
    </p>
</section>

<section class="impressum-section">
    <h2>@I18n.T("impressum.contactTitle")</h2>
    <p>
        @I18n.T("impressum.emailLabel"): matthias.watzinger1@gmail.com<br />
        @I18n.T("impressum.supportEmailLabel"): luminachronica@gmx.at
    </p>
</section>

<section class="impressum-section">
    <h2>@I18n.T("impressum.responsibleTitle")</h2>
    <p>
        <a href="bible" class="impressum-name">Matthias Watzinger</a><br />
        @I18n.T("impressum.addressLine")
    </p>
</section>

<section class="impressum-section">
    <h2>@I18n.T("impressum.disclaimerTitle")</h2>
    <p>
        @I18n.T("impressum.disclaimerParagraph1")
    </p>
    <p>
        @I18n.T("impressum.disclaimerParagraph2")
    </p>
</section>

<section class="impressum-section">
    <h2>@I18n.T("impressum.copyrightTitle")</h2>
    <p>
        @I18n.T("impressum.copyrightParagraph1")
    </p>
    <p>
        @I18n.T("impressum.copyrightParagraph2")
    </p>
</section>

<section class="impressum-section">
    <h2>@I18n.T("impressum.legalTitle")</h2>
    <p class="legal-related">
        <a href="datenschutz">@I18n.T("legal.privacyLink")</a>
        <a href="nutzungsbedingungen">@I18n.T("legal.termsLink")</a>
    </p>
</section>
</div>
