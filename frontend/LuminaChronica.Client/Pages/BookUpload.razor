@page "/library/upload"
@attribute [Authorize]
@using System.Globalization
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject BlobUrlService BlobUrlService
@inject IJSRuntime JsRuntime
@implements IDisposable

<PageTitle>Buch hinzufügen — Lumina Chronica</PageTitle>

<h1>Buch hinzufügen</h1>

<EditForm Model="_form" OnValidSubmit="SubmitAsync" class="book-form-card">
    @if (_errorMessage is not null)
    {
        <p class="form-error">@_errorMessage</p>
    }

    <div class="book-form-cover-preview">
        @if (_coverPreviewUrl is not null)
        {
            <img src="@_coverPreviewUrl" alt="Cover-Vorschau" />
        }
        else
        {
            <div class="cover-placeholder"></div>
        }
        <span class="text-muted">Cover-Vorschau</span>
    </div>

    <div class="form-group">
        <label for="title">Titel</label>
        <InputText id="title" @bind-Value="_form.Title" />
    </div>

    <div class="form-group">
        <label for="author">Autor</label>
        <InputText id="author" @bind-Value="_form.Author" />
    </div>

    <div class="form-group">
        <label for="description">Beschreibung</label>
        <InputTextArea id="description" @bind-Value="_form.Description" />
    </div>

    <div class="form-group">
        <label for="genre">Genre</label>
        <InputText id="genre" @bind-Value="_form.Genre" />
    </div>

    <div class="form-group">
        <label for="language">Sprache</label>
        <InputText id="language" @bind-Value="_form.Language" />
    </div>

    <div class="form-group">
        <label for="tags">Tags (durch Komma getrennt)</label>
        <InputText id="tags" @bind-Value="_form.Tags" />
    </div>

    <div class="form-group">
        <label for="isbn">ISBN</label>
        <InputText id="isbn" @bind-Value="_form.Isbn" />
    </div>

    <div class="form-group">
        <label for="publisher">Verlag</label>
        <InputText id="publisher" @bind-Value="_form.Publisher" />
    </div>

    <div class="form-group">
        <label for="releaseDate">Erscheinungsdatum</label>
        <InputDate id="releaseDate" @bind-Value="_form.ReleaseDateValue" />
    </div>

    <div class="form-group">
        <label for="pages">Seitenzahl</label>
        <InputNumber id="pages" @bind-Value="_form.Pages" />
    </div>

    <div class="form-group">
        <label for="file">Buchdatei (.epub, .pdf, .txt, .md — max. 50MB)</label>
        <InputFile id="file" OnChange="OnFileSelectedAsync" />
        @if (_fileError is not null)
        {
            <p class="form-error">@_fileError</p>
        }
    </div>

    <div class="form-group">
        <label for="cover">Cover (optional, .jpg/.png/.webp — max. 5MB)</label>
        <InputFile id="cover" OnChange="OnCoverSelectedAsync" />
        @if (_coverError is not null)
        {
            <p class="form-error">@_coverError</p>
        }
    </div>

    @if (_isSubmitting)
    {
        <LoadingIndicator Text="Wird hochgeladen..." />
    }
    else
    {
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Hochladen</button>
        </div>
    }
</EditForm>

@code {
    private const long MaxFileBytes = 50 * 1024 * 1024;
    private const long MaxCoverBytes = 5 * 1024 * 1024;
    private static readonly string[] AllowedFileExtensions = [".epub", ".pdf", ".txt", ".md"];
    private static readonly string[] AllowedCoverExtensions = [".jpg", ".jpeg", ".png", ".webp"];

    private readonly UploadFormModel _form = new();
    private IBrowserFile? _selectedFile;
    private IBrowserFile? _selectedCover;
    private string? _fileError;
    private string? _coverError;
    private string? _coverPreviewUrl;
    private byte[]? _extractedCoverBytes;
    private string? _extractedCoverContentType;
    private bool _isSubmitting;
    private string? _errorMessage;
    private IJSObjectReference? _metadataModule;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _fileError = ValidateFile(e.File, AllowedFileExtensions, MaxFileBytes);

        if (_fileError is not null)
        {
            return;
        }

        var extension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (extension is not (".epub" or ".pdf"))
        {
            // TXT/MD carry no container-level metadata to extract.
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(MaxFileBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var bytes = memoryStream.ToArray();

            _metadataModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/metadataExtractor.js");

            var metadata = extension == ".epub"
                ? await _metadataModule.InvokeAsync<ExtractedMetadata>("extractEpub", bytes)
                : await _metadataModule.InvokeAsync<ExtractedMetadata>("extractPdf", bytes);

            // Extraction only fills fields the user hasn't already typed
            // into -- it never overwrites a manually entered value.
            if (string.IsNullOrWhiteSpace(_form.Title) && !string.IsNullOrWhiteSpace(metadata.Title)) _form.Title = metadata.Title;
            if (string.IsNullOrWhiteSpace(_form.Author) && !string.IsNullOrWhiteSpace(metadata.Author)) _form.Author = metadata.Author;
            if (string.IsNullOrWhiteSpace(_form.Description) && !string.IsNullOrWhiteSpace(metadata.Description)) _form.Description = metadata.Description;
            if (string.IsNullOrWhiteSpace(_form.Language) && !string.IsNullOrWhiteSpace(metadata.Language)) _form.Language = metadata.Language;
            if (string.IsNullOrWhiteSpace(_form.Publisher) && !string.IsNullOrWhiteSpace(metadata.Publisher)) _form.Publisher = metadata.Publisher;
            if (string.IsNullOrWhiteSpace(_form.Isbn) && !string.IsNullOrWhiteSpace(metadata.Isbn)) _form.Isbn = metadata.Isbn;

            if (metadata.HasCover && _selectedCover is null)
            {
                var coverBytes = await _metadataModule.InvokeAsync<byte[]?>("getCoverBytes");
                if (coverBytes is { Length: > 0 })
                {
                    var contentType = await _metadataModule.InvokeAsync<string?>("getCoverContentType");

                    if (_coverPreviewUrl is not null)
                    {
                        await BlobUrlService.RevokeObjectUrlAsync(_coverPreviewUrl);
                    }

                    _extractedCoverBytes = coverBytes;
                    _extractedCoverContentType = string.IsNullOrWhiteSpace(contentType) ? "image/jpeg" : contentType;
                    _coverPreviewUrl = await BlobUrlService.CreateObjectUrlAsync(coverBytes, _extractedCoverContentType);
                }
            }
        }
        catch (Exception)
        {
            // Extraction is a convenience, not a requirement -- an unusual
            // or malformed file (or any other interop failure) just leaves
            // the manual form fields as-is rather than blocking the upload.
        }
    }

    private async Task OnCoverSelectedAsync(InputFileChangeEventArgs e)
    {
        _selectedCover = e.File;
        _coverError = ValidateFile(e.File, AllowedCoverExtensions, MaxCoverBytes);
        // A manually chosen cover always wins over an extracted one.
        _extractedCoverBytes = null;
        _extractedCoverContentType = null;

        if (_coverPreviewUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_coverPreviewUrl);
            _coverPreviewUrl = null;
        }

        if (_coverError is null)
        {
            using var stream = e.File.OpenReadStream(MaxCoverBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var contentType = string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType;
            _coverPreviewUrl = await BlobUrlService.CreateObjectUrlAsync(memoryStream.ToArray(), contentType);
        }
    }

    public void Dispose()
    {
        if (_coverPreviewUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_coverPreviewUrl);
        }
        if (_metadataModule is not null)
        {
            _ = _metadataModule.DisposeAsync();
        }
    }

    private static string? ValidateFile(IBrowserFile file, string[] allowedExtensions, long maxBytes)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!allowedExtensions.Contains(extension))
        {
            return $"Dateityp muss eines von {string.Join(", ", allowedExtensions)} sein.";
        }
        if (file.Size > maxBytes)
        {
            return $"Datei überschreitet das {maxBytes / (1024 * 1024)}MB-Limit.";
        }
        return null;
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (_selectedFile is null)
        {
            _errorMessage = "Bitte wähle eine Buchdatei aus.";
            return;
        }
        if (_fileError is not null || _coverError is not null)
        {
            return;
        }

        _isSubmitting = true;

        using var content = new MultipartFormDataContent
        {
            { new StringContent(_form.Title), QuoteFieldName("title") }
        };
        AddIfPresent(content, _form.Author, "author");
        AddIfPresent(content, _form.Description, "description");
        AddIfPresent(content, _form.Genre, "genre");
        AddIfPresent(content, _form.Language, "language");
        AddIfPresent(content, _form.Tags, "tags");
        AddIfPresent(content, _form.Isbn, "isbn");
        AddIfPresent(content, _form.Publisher, "publisher");
        AddIfPresent(content, _form.ReleaseDate, "releaseDate");
        if (_form.Pages is { } pages) content.Add(new StringContent(pages.ToString()), QuoteFieldName("pages"));

        content.Add(BuildFileContent(_selectedFile, MaxFileBytes), QuoteFieldName("file"), QuoteFieldName(_selectedFile.Name));
        if (_selectedCover is not null)
        {
            content.Add(BuildFileContent(_selectedCover, MaxCoverBytes), QuoteFieldName("cover"), QuoteFieldName(_selectedCover.Name));
        }
        else if (_extractedCoverBytes is not null)
        {
            content.Add(BuildExtractedCoverContent(_extractedCoverBytes, _extractedCoverContentType), QuoteFieldName("cover"), QuoteFieldName(ExtractedCoverFileName(_extractedCoverContentType)));
        }

        var response = await ApiClient.PostMultipartAsync<Book>("/api/books/upload", content);
        if (response is { Success: true, Data: not null })
        {
            NavigationManager.NavigateTo("library");
            return;
        }

        _errorMessage = response?.Error?.Message ?? "Hochladen fehlgeschlagen. Bitte versuche es erneut.";
        _isSubmitting = false;
    }

    private static void AddIfPresent(MultipartFormDataContent content, string? value, string name)
    {
        if (!string.IsNullOrWhiteSpace(value)) content.Add(new StringContent(value), QuoteFieldName(name));
    }

    // .NET's MultipartFormDataContent only quotes a Content-Disposition
    // name/filename when it contains characters outside the plain HTTP
    // "token" grammar -- "title" or "book.epub" don't, so it emits
    // `name=title` unquoted. That's valid generic HTTP header syntax, but
    // RFC 7578 (multipart/form-data) requires name/filename to always be a
    // quoted-string, and the backend's parser (workerd's request.formData())
    // enforces that strictly and rejects the unquoted form. Pre-wrapping the
    // value in literal quotes forces .NET to emit it already-quoted instead
    // of re-deriving quoting from the token grammar.
    private static string QuoteFieldName(string value) => $"\"{value}\"";

    private static StreamContent BuildFileContent(IBrowserFile file, long maxBytes)
    {
        var streamContent = new StreamContent(file.OpenReadStream(maxBytes));
        streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
        return streamContent;
    }

    // Same RFC 7578 quoting requirement as QuoteFieldName above applies to
    // this content's own name/filename when it's added to the multipart
    // body -- handled by the caller passing already-quoted values.
    private static ByteArrayContent BuildExtractedCoverContent(byte[] bytes, string? contentType)
    {
        var byteContent = new ByteArrayContent(bytes);
        byteContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(contentType) ? "image/jpeg" : contentType);
        return byteContent;
    }

    private static string ExtractedCoverFileName(string? contentType) => contentType switch
    {
        "image/png" => "cover.png",
        "image/webp" => "cover.webp",
        _ => "cover.jpg",
    };

    private class UploadFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string? Author { get; set; }
        public string? Description { get; set; }
        public string? Genre { get; set; }
        public string? Language { get; set; }
        public string? Tags { get; set; }
        public string? Isbn { get; set; }
        public string? Publisher { get; set; }
        public string? ReleaseDate { get; set; }
        public int? Pages { get; set; }

        // InputDate needs a DateOnly?-typed property to bind to; ReleaseDate
        // itself stays a string since that's what crosses the wire (the
        // backend's release_date column is opaque TEXT, not a date type).
        public DateOnly? ReleaseDateValue
        {
            get => DateOnly.TryParse(ReleaseDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
            set => ReleaseDate = value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }
}
