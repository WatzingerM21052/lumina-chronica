@page "/library/shelves/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@(_shelf?.Name ?? I18n.T("shelfDetail.defaultTitle")) — Lumina Chronica</PageTitle>

<a class="back-link" href="library/shelves">@I18n.T("shelfDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_shelf is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Library" Text="@I18n.T("shelfDetail.loading")" />
}
else
{
    <div class="book-detail-cover">
        @if (_coverObjectUrl is not null)
        {
            <img src="@_coverObjectUrl" alt="@_shelf.Name" />
        }
        else
        {
            <div class="book-card-cover-placeholder" aria-hidden="true"><Icon Name="book" /></div>
        }
    </div>

    <h1>@_shelf.Name</h1>
    @if (!string.IsNullOrWhiteSpace(_shelf.Description))
    {
        <p class="user-text">@_shelf.Description</p>
    }
    <div class="form-actions">
        <button type="button" class="btn" @onclick="StartEditing">@I18n.T("shelfDetail.editButton")</button>
        <button type="button" class="btn" @onclick="() => _confirmingDelete = true">@I18n.T("shelfDetail.deleteButton")</button>
    </div>
    <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("shelfDetail.deleteConfirmMessage")"
                   OnConfirm="DeleteShelfAsync" OnCancel="() => _confirmingDelete = false" />

    <Dialog IsOpen="_isEditing" Title="@I18n.T("shelfDetail.editDialogTitle")" OnClose="RequestCloseEdit">
        <ChildContent>
            <EditForm id="shelf-edit-form" Model="_editForm" OnValidSubmit="SaveAsync" class="auth-form">
                @if (_saveErrorMessage is not null)
                {
                    <p class="form-error">@_saveErrorMessage</p>
                }
                <div class="form-group">
                    <label for="shelf-edit-cover">@I18n.T("shelfDetail.replaceCoverLabel")</label>
                    <div class="dropzone @(_isDraggingCover ? "dropzone--active" : "")"
                         @ondragenter="() => _isDraggingCover = true" @ondragleave="() => _isDraggingCover = false"
                         @ondragover:preventDefault @ondrop="() => _isDraggingCover = false">
                        <InputFile id="shelf-edit-cover" OnChange="OnEditCoverSelected" />
                        <span class="dropzone-label">@I18n.T("shelfDetail.dropzoneLabel")</span>
                    </div>
                    @if (_coverSaveErrorMessage is not null)
                    {
                        <p class="form-error">@_coverSaveErrorMessage</p>
                    }
                </div>
                <div class="form-group">
                    <label for="shelf-edit-name">@I18n.T("shelfDetail.nameLabel")</label>
                    <InputText id="shelf-edit-name" maxlength="@TextLimits.Title" @bind-Value="_editForm.Name" />
                </div>
                <div class="form-group">
                    <label for="shelf-edit-description">@I18n.T("shelfDetail.descriptionLabel")</label>
                    <InputTextArea id="shelf-edit-description" maxlength="@TextLimits.Description" @bind-Value="_editForm.Description" />
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="RequestCloseEdit">@I18n.T("shelfDetail.cancelButton")</button>
            <button type="submit" form="shelf-edit-form" class="btn btn-primary" disabled="@_isSaving">@I18n.T("shelfDetail.saveButton")</button>
        </Footer>
    </Dialog>
    <ConfirmDialog IsOpen="_confirmingDiscardEdit" Message="@I18n.T("dialog.discardChangesMessage")"
                   ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
                   OnConfirm="ConfirmDiscardEdit" OnCancel="() => _confirmingDiscardEdit = false" />

    @if (_booksErrorMessage is not null)
    {
        <p class="form-error">@_booksErrorMessage</p>
    }
    else if (_books is null)
    {
        <LoadingIndicator Text="@I18n.T("shelfDetail.booksLoading")" />
    }
    else if (_books.Items.Count == 0)
    {
        <p class="text-muted">@I18n.T("shelfDetail.noBooksMessage")</p>
    }
    else
    {
        <div class="library-grid">
            @foreach (var book in _books.Items)
            {
                <div class="shelf-book-entry">
                    <BookCard Book="book" />
                    <button type="button" class="btn shelf-book-remove" @onclick="() => RemoveBookAsync(book.Id)">@I18n.T("shelfDetail.removeBookButton")</button>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Shelf? _shelf;
    private string? _loadErrorMessage;
    private ShelfBooksResponse? _books;
    private string? _booksErrorMessage;
    private string? _coverObjectUrl;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private string? _coverSaveErrorMessage;
    private IBrowserFile? _selectedEditCover;
    private bool _isDraggingCover;
    private EditFormModel _editForm = new();
    private EditFormModel _editFormSnapshot = new();
    private bool _confirmingDiscardEdit;
    private bool _isSaving;
    private bool _confirmingDelete;

    protected override async Task OnParametersSetAsync()
    {
        await LoadShelfAsync();
        await LoadBooksAsync();
    }

    private async Task LoadShelfAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Shelf>($"/api/shelves/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _shelf = response.Data;
            await LoadCoverAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? I18n.T("shelfDetail.loadError");
        }
    }

    private async Task LoadCoverAsync()
    {
        if (_coverObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
            _coverObjectUrl = null;
        }

        if (_shelf?.CoverUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_shelf.CoverUrl);
        if (result is { } cover)
        {
            _coverObjectUrl = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
        }
    }

    private async Task LoadBooksAsync()
    {
        _booksErrorMessage = null;
        var response = await ApiClient.GetAsync<ShelfBooksResponse>($"/api/shelves/{Id}/books");
        if (response is { Success: true, Data: not null })
        {
            _books = response.Data;
        }
        else
        {
            _booksErrorMessage = response?.Error?.Message ?? I18n.T("shelfDetail.booksLoadError");
        }
    }

    private void StartEditing()
    {
        if (_shelf is null) return;
        _editForm = new EditFormModel { Name = _shelf.Name, Description = _shelf.Description };
        _editFormSnapshot = _editForm with { };
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;
        _selectedEditCover = null;
        _isEditing = true;
    }

    private void OnEditCoverSelected(InputFileChangeEventArgs e) => _selectedEditCover = e.File;

    // Same dirty-state guard as BookDetail's edit dialog (D12), but Escape
    // and overlay stay enabled and route through here instead of being
    // switched off (review M-4/N-4).
    private bool IsEditFormDirty => _editForm != _editFormSnapshot || _selectedEditCover is not null;

    private void RequestCloseEdit()
    {
        if (IsEditFormDirty)
        {
            _confirmingDiscardEdit = true;
            return;
        }
        _isEditing = false;
    }

    private void ConfirmDiscardEdit()
    {
        _confirmingDiscardEdit = false;
        _isEditing = false;
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            await SaveCoreAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveCoreAsync()
    {
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateShelfRequest, Shelf>($"/api/shelves/{Id}", new UpdateShelfRequest
        {
            Name = _editForm.Name,
            Description = _editForm.Description,
        });

        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? I18n.T("shelfDetail.saveError");
            return;
        }

        _shelf = response.Data;

        if (_selectedEditCover is not null)
        {
            const long maxCoverBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditCover.OpenReadStream(maxCoverBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditCover.ContentType) ? "application/octet-stream" : _selectedEditCover.ContentType);
            content.Add(streamContent, "\"cover\"", $"\"{_selectedEditCover.Name}\"");

            var coverResponse = await ApiClient.PutMultipartAsync<Shelf>($"/api/shelves/{Id}/cover", content);
            if (coverResponse is { Success: true, Data: not null })
            {
                _shelf = coverResponse.Data;
                await LoadCoverAsync();
            }
            else
            {
                _coverSaveErrorMessage = coverResponse?.Error?.Message ?? I18n.T("shelfDetail.coverSaveError");
                return;
            }
        }

        _isEditing = false;
    }

    private async Task DeleteShelfAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/shelves/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo("library/shelves");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = I18n.T("shelfDetail.deleteError");
        }
    }

    private async Task RemoveBookAsync(int bookId)
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/shelves/{Id}/books/{bookId}");
        if (succeeded)
        {
            await LoadShelfAsync();
            await LoadBooksAsync();
        }
    }

    public void Dispose()
    {
        if (_coverObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
        }
    }

    private record EditFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
