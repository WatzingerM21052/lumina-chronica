    private async Task OnMapClickAsync(MouseEventArgs e)
    {
        if (_placingLocationId is not { } locationId) return;
        _positionErrorMessage = null;

        var size = await ElementMetricsService.GetElementSizeAsync(_mapImageRef);
        if (size.Width <= 0 || size.Height <= 0) return;

        var x = Math.Clamp(e.OffsetX / size.Width * 100, 0, 100);
        var y = Math.Clamp(e.OffsetY / size.Height * 100, 0, 100);

        var response = await ApiClient.PutAsync<UpdateLocationPositionRequest, Location>($"/api/projects/{Id}/locations/{locationId}/position", new UpdateLocationPositionRequest
        {
            X = x,
            Y = y,
        });

        if (response is { Success: true, Data: not null })
        {
            _placingLocationId = null;
            await LoadLocationsAsync();
        }
        else
        {
            _positionErrorMessage = response?.Error?.Message ?? "Position konnte nicht gespeichert werden.";
        }
    }

    // Interpolating a double directly into an @-block formats it with the
    // current culture -- under a German locale that's a comma decimal
    // separator ("42,5%"), which is invalid CSS and silently drops the pin
    // to the wrong spot. Same class of bug as the reading-progress
    // decimal-separator fix (see Architecture.md); always InvariantCulture
    // for anything landing in markup/CSS/query strings.
    private static string PinStyle(Location location) =>
        $"left:{location.X?.ToString("0.##", CultureInfo.InvariantCulture)}%; top:{location.Y?.ToString("0.##", CultureInfo.InvariantCulture)}%;";

