        if (_mapObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_mapObjectUrl);
        }
        foreach (var url in _fileThumbnails.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
    }

