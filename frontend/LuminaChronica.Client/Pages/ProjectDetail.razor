@page "/projects/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using LuminaChronica.Client.Components
@using Markdig
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject ElementMetricsService ElementMetricsService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject II18nService I18n
@inject TimeProvider TimeProvider

<PageTitle>@(_project?.Title ?? I18n.T("projectDetail.defaultTitle")) — Lumina Chronica</PageTitle>
<WorldBackdrop Kind="project" ImageUrl="@_coverObjectUrl" Pending="@(_project is null || (_project.CoverUrl is not null && _coverObjectUrl is null))" />

<a class="back-link" href="projects">@I18n.T("projectDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_project is null)
{
    <LoadingIndicator Text="@I18n.T("projectDetail.loading")" />
}
else
{
    @* Design audit F3: the other tabs showed no project name at all, only
       "Charaktere" etc. The overview has the full header below. *@
    @if (_activeTab != "overview")
    {
        <h1 class="project-compact-title">@_project.Title</h1>
    }
    <div class="project-tabs" role="tablist">
        <button type="button" class="project-tab @(_activeTab == "overview" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "overview" ? "true" : "false")" @onclick="@(() => _activeTab = "overview")">@I18n.T("projectDetail.tabOverview")</button>
        <button type="button" class="project-tab @(_activeTab == "characters" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "characters" ? "true" : "false")" @onclick="@(() => _activeTab = "characters")">@I18n.T("projectDetail.tabCharacters")</button>
        <button type="button" class="project-tab @(_activeTab == "map" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "map" ? "true" : "false")" @onclick="@(() => _activeTab = "map")">@I18n.T("projectDetail.tabMap")</button>
        <button type="button" class="project-tab @(_activeTab == "timeline" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "timeline" ? "true" : "false")" @onclick="@(() => _activeTab = "timeline")">@I18n.T("projectDetail.tabTimeline")</button>
        <button type="button" class="project-tab @(_activeTab == "lore" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "lore" ? "true" : "false")" @onclick="@(() => _activeTab = "lore")">@I18n.T("projectDetail.tabLore")</button>
        <button type="button" class="project-tab @(_activeTab == "books" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "books" ? "true" : "false")" @onclick="@(() => _activeTab = "books")">@I18n.T("projectDetail.tabBooks")</button>
        <button type="button" class="project-tab @(_activeTab == "files" ? "is-active" : "")" role="tab" aria-selected="@(_activeTab == "files" ? "true" : "false")" @onclick="@(() => _activeTab = "files")">@I18n.T("projectDetail.tabFiles")</button>
    </div>

    @* Themed worlds: every tab but the overview (which has its own cards)
       sits on one content card; display: contents elsewhere. *@
    <div class="world-surface @(_activeTab == "overview" ? "world-surface--bare" : null)">
    @if (_activeTab == "overview")
    {
        <div class="book-detail project-overview">
            <div class="book-detail-cover">
                @if (_coverObjectUrl is not null)
                {
                    <img src="@_coverObjectUrl" alt="@_project.Title" />
                }
                else
                {
                    <div class="book-card-cover-placeholder" aria-hidden="true"><Icon Name="project" /></div>
                }
            </div>

            <div class="book-detail-info">
                <h1>@_project.Title</h1>
                <p class="text-muted">@ProjectTypeLabel.For(_project.Type, I18n)</p>
                @if (!string.IsNullOrWhiteSpace(_project.Description))
                {
                    <p class="user-text">@_project.Description</p>
                }
                <div class="form-actions">
                    <button type="button" id="project-edit-button" class="btn btn-icon" @onclick="StartEditing" title="@I18n.T("projectDetail.editButton")"><Icon Name="edit" /><span class="visually-hidden">@I18n.T("projectDetail.editButton")</span></button>
                    <button type="button" class="btn btn-icon btn-icon-danger" @onclick="() => _confirmingDelete = true" title="@I18n.T("projectDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("projectDetail.deleteButton")</span></button>
                </div>
            </div>
        </div>

        @* Design audit F3: what the project holds at a glance; each tile
           opens its tab. *@
        <nav class="project-stats" aria-label="@I18n.T("projectDetail.statsLabel")">
            @foreach (var (tab, count, labelKey) in ProjectStats)
            {
                <button type="button" class="project-stat" @onclick="() => _activeTab = tab">
                    <span class="project-stat-value">@count</span>
                    <span class="project-stat-label">@I18n.T(labelKey)</span>
                </button>
            }
        </nav>

        @* UI/UX plan A3: edit in a dialog like book and shelf, instead of
           swapping the header for an inline form. Every way out except
           Speichern goes through the unsaved-changes guard. *@
        <Dialog IsOpen="_isEditing" Title="@I18n.T("projectDetail.editDialogTitle")" OnClose="RequestCloseEdit">
            <ChildContent>
                <EditForm id="project-edit-form" Model="_editForm" OnValidSubmit="SaveAsync" class="auth-form">
                    @if (_saveErrorMessage is not null)
                    {
                        <p class="form-error">@_saveErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="project-edit-title">@I18n.T("projectDetail.titleLabel")</label>
                        <InputText id="project-edit-title" maxlength="@TextLimits.Title" @bind-Value="_editForm.Title" />
                    </div>
                    <div class="form-group">
                        <label for="project-edit-type">@I18n.T("projectDetail.typeLabel")</label>
                        <InputSelect id="project-edit-type" @bind-Value="_editForm.Type">
                            @foreach (var type in ProjectTypeLabel.Options)
                            {
                                <option value="@type">@ProjectTypeLabel.For(type, I18n)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label for="project-edit-description">@I18n.T("projectDetail.descriptionLabel")</label>
                        <InputTextArea id="project-edit-description" maxlength="@TextLimits.Description" @bind-Value="_editForm.Description" />
                    </div>
                    <div class="form-group">
                        <label for="project-edit-cover">@I18n.T("projectDetail.replaceCoverLabel")</label>
                        <div class="dropzone @(_isDraggingCover ? "dropzone--active" : "")"
                             @ondragenter="() => _isDraggingCover = true" @ondragleave="() => _isDraggingCover = false"
                             @ondragover:preventDefault @ondrop="() => _isDraggingCover = false">
                            <InputFile id="project-edit-cover" OnChange="OnEditCoverSelected" />
                            <span class="dropzone-label">@(_selectedEditCover?.Name ?? I18n.T("projectDetail.coverDropzoneLabel"))</span>
                        </div>
                        @if (_coverSaveErrorMessage is not null)
                        {
                            <p class="form-error">@_coverSaveErrorMessage</p>
                        }
                    </div>
                    <div class="form-group">
                        <label for="project-edit-visibility">@I18n.T("projectDetail.visibilityLabel")</label>
                        <InputSelect id="project-edit-visibility" @bind-Value="_editForm.Visibility">
                            @foreach (var option in VisibilityOption.Options)
                            {
                                <option value="@option">@VisibilityOption.For(option, I18n)</option>
                            }
                        </InputSelect>
                        <p class="text-muted">@I18n.T("projectDetail.visibilityHint")</p>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="RequestCloseEdit">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="project-edit-form" class="btn btn-primary" disabled="@_isSaving">@I18n.T("projectDetail.saveButton")</button>
            </Footer>
        </Dialog>
        <ConfirmDialog IsOpen="_confirmingDiscardEdit" Message="@I18n.T("dialog.discardChangesMessage")"
                       ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
                       OnConfirm="ConfirmDiscardEdit" OnCancel="() => _confirmingDiscardEdit = false" />

        <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("projectDetail.deleteConfirmMessage")"
                       OnConfirm="DeleteProjectAsync" OnCancel="() => _confirmingDelete = false" />

        <section class="book-comments">
            <h2>@I18n.T("projectDetail.commentsTitle")</h2>
            @if (_comments is null)
            {
                <p class="text-muted">@I18n.T("projectDetail.commentsLoading")</p>
            }
            else
            {
                @if (_comments.Count == 0)
                {
                    <p class="text-muted">@I18n.T("projectDetail.noCommentsMessage")</p>
                }
                else
                {
                    <ul class="book-comment-list">
                        @foreach (var comment in _comments)
                        {
                            <li class="book-comment-item">
                                @* Delete sits small in the header next to the date instead of a
                                   row of its own under every comment (plan F9). *@
                                <div class="book-comment-header">
                                    <strong>@comment.Username</strong>
                                    <span class="book-comment-meta">
                                        <span class="text-muted">@comment.CreatedAt</span>
                                        @if (comment.UserId == _currentUserId)
                                        {
                                            <button type="button" class="btn btn-icon btn-icon-sm btn-icon-danger" disabled="@_commentActionInProgress.Contains(comment.Id)" @onclick="() => DeleteCommentAsync(comment.Id)" title="@I18n.T("projectDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("projectDetail.deleteButton")</span></button>
                                        }
                                    </span>
                                </div>
                                <p class="user-text">@comment.Content</p>
                            </li>
                        }
                    </ul>
                }

                <EditForm Model="_commentForm" OnValidSubmit="SubmitCommentAsync" class="comment-form">
                    @if (_commentErrorMessage is not null)
                    {
                        <p class="form-error">@_commentErrorMessage</p>
                    }
                    @* Plain textarea bound on every keystroke (InputTextArea only updates on
                       blur), so the counter below follows the typing. *@
                    <textarea @bind="_commentForm.Content" @bind:event="oninput" maxlength="@TextLimits.Comment" rows="3"
                              aria-label="@I18n.T("projectDetail.commentPlaceholder")" placeholder="@I18n.T("projectDetail.commentPlaceholder")"></textarea>
                    <div class="comment-form-footer">
                        <CharCounter Value="@_commentForm.Content" Max="TextLimits.Comment" />
                        <button type="submit" class="btn btn-primary" disabled="@(_isSubmittingComment || string.IsNullOrWhiteSpace(_commentForm.Content))">@I18n.T("projectDetail.commentSubmitButton")</button>
                    </div>
                </EditForm>
            }
        </section>
    }
    else if (_activeTab == "characters")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.charactersTitle")</h2>
            <button type="button" id="add-character-button" class="btn btn-primary" @onclick="OpenCreateCharacter">@I18n.T("projectDetail.addCharacterButton")</button>
        </div>

        <Dialog IsOpen="_showCreateCharacterForm" Title="@I18n.T("projectDetail.addCharacterButton")"
                OnClose="() => RequestCloseDialog(IsCreateCharacterDirty, () => _showCreateCharacterForm = false)">
            <ChildContent>
                <EditForm id="create-character-form" Model="_createCharacterForm" OnValidSubmit="() => SubmitDialogAsync(CreateCharacterAsync)" class="auth-form">
                    @if (_createCharacterErrorMessage is not null)
                    {
                        <p class="form-error">@_createCharacterErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="character-name">@I18n.T("projectDetail.nameLabel")</label>
                        <InputText id="character-name" maxlength="@TextLimits.Title" @bind-Value="_createCharacterForm.Name" />
                    </div>
                    <div class="form-group">
                        <label for="character-image">@I18n.T("projectDetail.imageOptionalLabel")</label>
                        <FileDropzone Id="character-image" Accept="image/*" Label="@I18n.T("projectDetail.imageDropzoneLabel")"
                                      SelectedFileName="@_selectedCharacterImage?.Name" OnChange="OnCharacterImageSelected" />
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="() => RequestCloseDialog(IsCreateCharacterDirty, () => _showCreateCharacterForm = false)">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="create-character-form" class="btn btn-primary" disabled="@_isSubmittingDialog">@I18n.T("projectDetail.addButton")</button>
            </Footer>
        </Dialog>

        @if (_charactersErrorMessage is not null)
        {
            <p class="form-error">@_charactersErrorMessage</p>
        }
        else if (_characters is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.charactersLoading")" />
        }
        else if (_characters.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noCharactersMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var character in _characters)
                {
                    <CharacterCard Character="character" />
                }
            </div>
        }
    }
    else if (_activeTab == "map")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.mapTitle")</h2>
            @if (_mapObjectUrl is not null)
            {
                @* A button, not the browser's raw "choose file" bar across the
                   page: the (invisible) file input covers the button, so a
                   click or a dropped file lands on it directly. *@
                <span class="btn file-button">
                    <Icon Name="image" />@I18n.T("projectDetail.replaceMapLabel")
                    <InputFile id="map-replace" OnChange="OnMapSelected" aria-label="@I18n.T("projectDetail.replaceMapLabel")" accept="image/*" />
                </span>
            }
        </div>

        @if (_mapObjectUrl is not null)
        {
            <div class="map-wrapper">
                <img @ref="_mapImageRef" src="@_mapObjectUrl" alt="@string.Format(I18n.T("projectDetail.mapAlt"), _project.Title)" class="map-image"
                     @onclick="OnMapClickAsync" style="@(_placingLocationId is not null ? "cursor: crosshair;" : "")" />
                @if (_locations is not null)
                {
                    @foreach (var location in _locations.Where(l => l.X is not null && l.Y is not null))
                    {
                        <a class="map-pin" style="@PinStyle(location)" href="@($"projects/{Id}/locations/{location.Id}")" title="@location.Name" aria-label="@location.Name"><Icon Name="location-pin" /></a>
                    }
                }
            </div>
            @if (_placingLocationId is not null)
            {
                <p class="text-muted">@string.Format(I18n.T("projectDetail.placeOnMapHint"), _locations?.FirstOrDefault(l => l.Id == _placingLocationId)?.Name) <button type="button" class="btn" @onclick="() => _placingLocationId = null">@I18n.T("projectDetail.cancelButton")</button></p>
            }
            @if (_positionErrorMessage is not null)
            {
                <p class="form-error">@_positionErrorMessage</p>
            }
        }
        else
        {
            <div class="form-group">
                <label for="map-upload">@I18n.T("projectDetail.uploadMapLabel")</label>
                <div class="dropzone @(_isDraggingMap ? "dropzone--active" : "")"
                     @ondragenter="() => _isDraggingMap = true" @ondragleave="() => _isDraggingMap = false"
                     @ondragover:preventDefault @ondrop="() => _isDraggingMap = false">
                    <InputFile id="map-upload" OnChange="OnMapSelected" />
                    <span class="dropzone-label">@I18n.T("projectDetail.mapDropzoneLabel")</span>
                </div>
            </div>
        }
        @if (_mapSaveErrorMessage is not null)
        {
            <p class="form-error">@_mapSaveErrorMessage</p>
        }

        <div class="library-header">
            <h2>@I18n.T("projectDetail.locationsTitle")</h2>
            <button type="button" id="add-location-button" class="btn btn-primary" @onclick="OpenCreateLocation">@I18n.T("projectDetail.addLocationButton")</button>
        </div>

        <Dialog IsOpen="_showCreateLocationForm" Title="@I18n.T("projectDetail.addLocationButton")"
                OnClose="() => RequestCloseDialog(IsCreateLocationDirty, () => _showCreateLocationForm = false)">
            <ChildContent>
                <EditForm id="create-location-form" Model="_createLocationForm" OnValidSubmit="() => SubmitDialogAsync(CreateLocationAsync)" class="auth-form">
                    @if (_createLocationErrorMessage is not null)
                    {
                        <p class="form-error">@_createLocationErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="location-name">@I18n.T("projectDetail.nameLabel")</label>
                        <InputText id="location-name" maxlength="@TextLimits.Title" @bind-Value="_createLocationForm.Name" />
                    </div>
                    <div class="form-group">
                        <label for="location-image">@I18n.T("projectDetail.imageOptionalLabel")</label>
                        <FileDropzone Id="location-image" Accept="image/*" Label="@I18n.T("projectDetail.imageDropzoneLabel")"
                                      SelectedFileName="@_selectedLocationImage?.Name" OnChange="OnLocationImageSelected" />
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="() => RequestCloseDialog(IsCreateLocationDirty, () => _showCreateLocationForm = false)">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="create-location-form" class="btn btn-primary" disabled="@_isSubmittingDialog">@I18n.T("projectDetail.addButton")</button>
            </Footer>
        </Dialog>

        @if (_locationsErrorMessage is not null)
        {
            <p class="form-error">@_locationsErrorMessage</p>
        }
        else if (_locations is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.locationsLoading")" />
        }
        else if (_locations.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLocationsMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var location in _locations)
                {
                    <div class="shelf-book-entry">
                        <LocationCard Location="location" />
                        @if (location.X is null && _mapObjectUrl is not null)
                        {
                            <button type="button" class="btn btn-icon btn-icon-sm shelf-book-remove" @onclick="() => _placingLocationId = location.Id" title="@I18n.T("projectDetail.placeOnMapButton")"><Icon Name="location-pin" /><span class="visually-hidden">@I18n.T("projectDetail.placeOnMapButton")</span></button>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (_activeTab == "timeline")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.timelineTitle")</h2>
            <button type="button" id="add-event-button" class="btn btn-primary" @onclick="OpenCreateEvent">@I18n.T("projectDetail.addEventButton")</button>
        </div>

        <Dialog IsOpen="_showCreateEventForm" Title="@I18n.T("projectDetail.addEventButton")"
                OnClose="() => RequestCloseDialog(IsCreateEventDirty, () => _showCreateEventForm = false)">
            <ChildContent>
                <EditForm id="create-event-form" Model="_createEventForm" OnValidSubmit="() => SubmitDialogAsync(CreateTimelineEventAsync)" class="auth-form">
                    @if (_createEventErrorMessage is not null)
                    {
                        <p class="form-error">@_createEventErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="event-title">@I18n.T("projectDetail.titleLabel")</label>
                        <InputText id="event-title" maxlength="@TextLimits.Title" @bind-Value="_createEventForm.Title" />
                    </div>
                    <div class="form-group">
                        <label for="event-date">@I18n.T("projectDetail.eventDateLabel")</label>
                        <InputText id="event-date" maxlength="@TextLimits.ShortText" @bind-Value="_createEventForm.Date" />
                    </div>
                    <div class="form-group">
                        <label for="event-description">@I18n.T("projectDetail.descriptionLabel")</label>
                        <InputTextArea id="event-description" maxlength="@TextLimits.Description" @bind-Value="_createEventForm.Description" />
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="() => RequestCloseDialog(IsCreateEventDirty, () => _showCreateEventForm = false)">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="create-event-form" class="btn btn-primary" disabled="@_isSubmittingDialog">@I18n.T("projectDetail.addButton")</button>
            </Footer>
        </Dialog>

        <Dialog IsOpen="_editingEventId is not null" Title="@I18n.T("projectDetail.editEventDialogTitle")"
                OnClose="() => RequestCloseDialog(IsEditEventDirty, () => _editingEventId = null)">
            <ChildContent>
                <EditForm id="edit-event-form" Model="_editEventForm" OnValidSubmit="() => SubmitDialogAsync(SaveTimelineEventAsync)" class="auth-form">
                    @if (_editEventErrorMessage is not null)
                    {
                        <p class="form-error">@_editEventErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="event-edit-title">@I18n.T("projectDetail.titleLabel")</label>
                        <InputText id="event-edit-title" maxlength="@TextLimits.Title" @bind-Value="_editEventForm.Title" />
                    </div>
                    <div class="form-group">
                        <label for="event-edit-date">@I18n.T("projectDetail.dateLabel")</label>
                        <InputText id="event-edit-date" maxlength="@TextLimits.ShortText" @bind-Value="_editEventForm.Date" />
                    </div>
                    <div class="form-group">
                        <label for="event-edit-description">@I18n.T("projectDetail.descriptionLabel")</label>
                        <InputTextArea id="event-edit-description" maxlength="@TextLimits.Description" @bind-Value="_editEventForm.Description" />
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="() => RequestCloseDialog(IsEditEventDirty, () => _editingEventId = null)">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="edit-event-form" class="btn btn-primary" disabled="@_isSubmittingDialog">@I18n.T("projectDetail.saveButton")</button>
            </Footer>
        </Dialog>

        @if (_eventsErrorMessage is not null)
        {
            <p class="form-error">@_eventsErrorMessage</p>
        }
        else if (_events is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.timelineLoading")" />
        }
        else if (_events.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noEventsMessage")</p>
        }
        else
        {
            <ol class="timeline">
                @foreach (var (timelineEvent, index) in _events.Select((e, i) => (e, i)))
                {
                    <li class="timeline-event">
                        <div class="timeline-event-card">
                            @if (!string.IsNullOrWhiteSpace(timelineEvent.Date))
                            {
                                <div class="timeline-event-date">@timelineEvent.Date</div>
                            }
                            <div class="timeline-event-title">@timelineEvent.Title</div>
                            @if (!string.IsNullOrWhiteSpace(timelineEvent.Description))
                            {
                                <p class="user-text">@timelineEvent.Description</p>
                            }
                            @* One row, top right: reorder (only when there is something
                               to reorder), edit, delete. *@
                            <div class="timeline-event-controls">
                                @if (_events.Count > 1)
                                {
                                    <button type="button" class="btn btn-icon btn-icon-sm timeline-move-button" disabled="@(index == 0)" @onclick='() => MoveTimelineEventAsync(timelineEvent.Id, "up")' title="@I18n.T("projectDetail.moveUpTitle")"><Icon Name="chevron-up" /><span class="visually-hidden">@I18n.T("projectDetail.moveUpTitle")</span></button>
                                    <button type="button" class="btn btn-icon btn-icon-sm timeline-move-button" disabled="@(index == _events.Count - 1)" @onclick='() => MoveTimelineEventAsync(timelineEvent.Id, "down")' title="@I18n.T("projectDetail.moveDownTitle")"><Icon Name="chevron-down" /><span class="visually-hidden">@I18n.T("projectDetail.moveDownTitle")</span></button>
                                }
                                <button type="button" class="btn btn-icon btn-icon-sm" @onclick="() => StartEditingEvent(timelineEvent)" title="@I18n.T("projectDetail.editButton")"><Icon Name="edit" /><span class="visually-hidden">@I18n.T("projectDetail.editButton")</span></button>
                                <button type="button" class="btn btn-icon btn-icon-sm btn-icon-danger" @onclick="() => _confirmingEventDeleteId = timelineEvent.Id" title="@I18n.T("projectDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("projectDetail.deleteButton")</span></button>
                            </div>
                        </div>
                    </li>
                }
            </ol>
            <ConfirmDialog IsOpen="_confirmingEventDeleteId is not null" Message="@I18n.T("projectDetail.deleteEventConfirmMessage")"
                           OnConfirm="DeleteTimelineEventAsync" OnCancel="() => _confirmingEventDeleteId = null" />
        }
    }
    else if (_activeTab == "lore")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.loreTitle")</h2>
            <button type="button" id="add-lore-button" class="btn btn-primary" @onclick="OpenCreateLore">@I18n.T("projectDetail.addLoreButton")</button>
        </div>

        <Dialog IsOpen="_showCreateLoreForm" Size="DialogSize.Large" Title="@I18n.T("projectDetail.addLoreButton")"
                OnClose="() => RequestCloseDialog(IsCreateLoreDirty, () => _showCreateLoreForm = false)">
            <ChildContent>
                <EditForm id="create-lore-form" Model="_createLoreForm" OnValidSubmit="() => SubmitDialogAsync(CreateLoreEntryAsync)" class="auth-form">
                    @if (_createLoreErrorMessage is not null)
                    {
                        <p class="form-error">@_createLoreErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="lore-title">@I18n.T("projectDetail.titleLabel")</label>
                        <InputText id="lore-title" maxlength="@TextLimits.Title" @bind-Value="_createLoreForm.Title" />
                    </div>
                    <div class="form-group">
                        <label for="lore-content">@I18n.T("projectDetail.loreContentLabel")</label>
                        <InputTextArea id="lore-content" maxlength="@TextLimits.LoreContent" @bind-Value="_createLoreForm.Content" rows="10" />
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="() => RequestCloseDialog(IsCreateLoreDirty, () => _showCreateLoreForm = false)">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="create-lore-form" class="btn btn-primary" disabled="@_isSubmittingDialog">@I18n.T("projectDetail.addButton")</button>
            </Footer>
        </Dialog>

        @if (_loreErrorMessage is not null)
        {
            <p class="form-error">@_loreErrorMessage</p>
        }
        else if (_loreEntries is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.loreLoading")" />
        }
        else if (_loreEntries.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLoreMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var entry in _loreEntries)
                {
                    <LoreEntryCard Entry="entry" />
                }
            </div>
        }
    }
    else if (_activeTab == "books")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.linkedBooksTitle")</h2>
        </div>

        <SearchInput Class="library-search-wrapper" Placeholder="@I18n.T("projectDetail.bookSearchPlaceholder")" Value="@_bookSearchTerm" OnInput="OnBookSearchInput">
            @if (_bookSuggestions is { Count: > 0 })
            {
                <ul class="library-search-suggestions">
                    @foreach (var book in _bookSuggestions)
                    {
                        <li>
                            <button type="button" @onclick="() => AddBookAsync(book.Id)">
                                @book.Title
                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <span class="text-muted"> — @book.Author</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </SearchInput>
        @if (_addBookErrorMessage is not null)
        {
            <p class="form-error">@_addBookErrorMessage</p>
        }

        @if (_linkedBooksErrorMessage is not null)
        {
            <p class="form-error">@_linkedBooksErrorMessage</p>
        }
        else if (_linkedBooks is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.linkedBooksLoading")" />
        }
        else if (_linkedBooks.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLinkedBooksMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var book in _linkedBooks)
                {
                    <div class="shelf-book-entry">
                        <BookCard Book="book" />
                        <button type="button" class="btn shelf-book-remove" @onclick="() => RemoveBookAsync(book.Id)">@I18n.T("projectDetail.removeBookButton")</button>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @* Same shape as the other tabs (heading left, action right, form in
           a dialog) instead of a centred form card above the gallery. *@
        <div class="library-header">
            <h2>@I18n.T("projectDetail.filesTitle")</h2>
            <button type="button" id="add-file-button" class="btn btn-primary" @onclick="() => _showCreateFileForm = true">@I18n.T("projectDetail.addFileButton")</button>
        </div>

        <Dialog IsOpen="_showCreateFileForm" Title="@I18n.T("projectDetail.addFileButton")" OnClose="CloseCreateFile">
            <ChildContent>
                @* Up to ten files in one go (user request). Each file's kind
                   (image or document) comes from its extension; files that
                   can't go up are named with the reason before anything is
                   sent, and every file shows its own status. *@
                <form id="create-file-form" class="auth-form" @onsubmit="UploadProjectFilesAsync" @onsubmit:preventDefault="true">
                    @if (_createFileErrorMessage is not null)
                    {
                        <p class="form-error">@_createFileErrorMessage</p>
                    }
                    <div class="form-group">
                        <label for="file-upload">@I18n.T("projectDetail.filesLabel")</label>
                        <FileDropzone Id="file-upload" Label="@I18n.T("projectDetail.filesDropzoneLabel")" Multiple="true"
                                      Accept="@ProjectFileAccept" Hint="@I18n.T("projectDetail.fileFormatsHint")"
                                      SelectedFileName="@(_pendingUploads.Count == 0 ? null : string.Format(I18n.T("projectDetail.filesSelected"), _pendingUploads.Count))"
                                      OnChange="OnProjectFilesSelected" />
                    </div>
                    @if (_pendingUploads.Count > 0)
                    {
                        <ul class="file-upload-list" aria-live="polite">
                            @foreach (var upload in _pendingUploads)
                            {
                                <li class="file-upload-item file-upload-item--@upload.Status.ToString().ToLowerInvariant()">
                                    <Icon Name="@(upload.Category == "IMAGE" ? "image" : "document")" />
                                    <span class="file-upload-name">@upload.File.Name</span>
                                    <span class="file-upload-meta">@FormatFileSize(upload.File.Size)</span>
                                    <span class="file-upload-status">@UploadStatusText(upload)</span>
                                </li>
                            }
                        </ul>
                    }
                </form>
            </ChildContent>
            <Footer>
                <button type="button" class="btn" @onclick="CloseCreateFile" disabled="@_isUploadingFiles">@I18n.T("projectDetail.cancelButton")</button>
                <button type="submit" form="create-file-form" class="btn btn-primary" disabled="@(_isUploadingFiles || !_pendingUploads.Any(u => u.Status == UploadStatus.Ready))">
                    @(UploadableCount == 0 ? I18n.T("projectDetail.uploadButton") : string.Format(I18n.T("projectDetail.uploadFilesButton"), UploadableCount))
                </button>
            </Footer>
        </Dialog>

        @if (_filesErrorMessage is not null)
        {
            <p class="form-error">@_filesErrorMessage</p>
        }
        else if (_files is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.filesLoading")" />
        }
        else if (_files.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noFilesMessage")</p>
        }
        else
        {
            @* File viewer (user decisions 2026-10-02): images as a compact
               square grid that opens a lightbox, documents as slim rows;
               PDF/TXT/MD open in a viewer dialog, DOC/DOCX download. *@
            var imageFiles = _files.Where(f => f.Category == "IMAGE").ToList();
            var documentFiles = _files.Where(f => f.Category != "IMAGE").ToList();
            @if (imageFiles.Count > 0)
            {
                <section class="file-section" aria-labelledby="file-images-heading">
                    <h3 id="file-images-heading">@I18n.T("projectDetail.imagesHeading")</h3>
                    <ul class="file-image-grid">
                        @for (var i = 0; i < imageFiles.Count; i++)
                        {
                            var file = imageFiles[i];
                            var index = i;
                            <li class="file-image-tile">
                                <button type="button" class="file-image-open" @onclick="() => OpenLightbox(index)" title="@file.Name">
                                    @if (_fileThumbnails.TryGetValue(file.Id, out var thumbnailUrl))
                                    {
                                        <img src="@thumbnailUrl" alt="@file.Name" />
                                    }
                                    else
                                    {
                                        <span class="file-image-placeholder" aria-hidden="true"><Icon Name="image" /></span>
                                        <span class="visually-hidden">@file.Name</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-icon btn-icon-sm btn-icon-danger file-image-delete" @onclick="() => _confirmingFileDeleteId = file.Id" title="@I18n.T("projectDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("projectDetail.deleteButton") @file.Name</span></button>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (documentFiles.Count > 0)
            {
                <section class="file-section" aria-labelledby="file-documents-heading">
                    <h3 id="file-documents-heading">@I18n.T("projectDetail.documentsHeading")</h3>
                    <ul class="file-document-list">
                        @foreach (var file in documentFiles)
                        {
                            var kind = DocumentKind(file);
                            <li class="file-document-row">
                                <button type="button" class="file-document-open" @onclick="() => OpenDocumentAsync(file)"
                                        title="@(kind == DocumentViewKind.None ? I18n.T("projectDetail.downloadButton") : I18n.T("projectDetail.openFileButton"))">
                                    <Icon Name="document" />
                                    <span class="file-document-name">@file.Name</span>
                                    <span class="file-document-meta">@FileExtension(file).ToUpperInvariant() · @FormatFileSize(file.Size)</span>
                                </button>
                                <button type="button" class="btn btn-icon btn-icon-sm" @onclick="() => DownloadProjectFileAsync(file)" title="@I18n.T("projectDetail.downloadButton")"><Icon Name="download" /><span class="visually-hidden">@I18n.T("projectDetail.downloadButton") @file.Name</span></button>
                                <button type="button" class="btn btn-icon btn-icon-sm btn-icon-danger" @onclick="() => _confirmingFileDeleteId = file.Id" title="@I18n.T("projectDetail.deleteButton")"><Icon Name="trash" /><span class="visually-hidden">@I18n.T("projectDetail.deleteButton") @file.Name</span></button>
                            </li>
                        }
                    </ul>
                </section>
            }

            <ImageLightbox Images="@LightboxImages(imageFiles)" IsOpen="_lightboxOpen" @bind-Index="_lightboxIndex"
                           OnClose="() => _lightboxOpen = false" OnDownload="DownloadLightboxImageAsync" />

            <Dialog IsOpen="_viewedDocument is not null" Size="DialogSize.Viewer" Title="@_viewedDocument?.File.Name" OnClose="CloseDocument">
                <ChildContent>
                    <div class="file-viewer">
                        @if (_viewedDocument is { } doc)
                        {
                            @if (doc.Kind == DocumentViewKind.Pdf)
                            {
                                <PdfReader Bytes="doc.Bytes" ReaderMode="scroll" />
                            }
                            else if (doc.Kind == DocumentViewKind.Markdown)
                            {
                                <article class="file-viewer-text file-viewer-markdown">@((MarkupString)Markdown.ToHtml(doc.Text, FileMarkdownPipeline))</article>
                            }
                            else
                            {
                                <pre class="file-viewer-text">@doc.Text</pre>
                            }
                        }
                    </div>
                </ChildContent>
                <Footer>
                    <button type="button" class="btn" @onclick="CloseDocument">@I18n.T("projectDetail.closeButton")</button>
                    <button type="button" class="btn btn-primary" @onclick="() => DownloadProjectFileAsync(_viewedDocument!.File)">@I18n.T("projectDetail.downloadButton")</button>
                </Footer>
            </Dialog>

            <ConfirmDialog IsOpen="_confirmingFileDeleteId is not null" Message="@I18n.T("projectDetail.deleteFileConfirmMessage")"
                           OnConfirm="DeleteProjectFileAsync" OnCancel="() => _confirmingFileDeleteId = null" />
        }
    }
    </div>
}


@* Shared by the create/edit dialogs on the Charaktere, Karte, Zeitleiste and
   Lore tabs: RequestCloseDialog parks the close action here when there are
   unsaved changes, and only "Verwerfen" runs it. *@
<ConfirmDialog IsOpen="_pendingDiscard is not null" Message="@I18n.T("dialog.discardChangesMessage")"
               ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
               OnConfirm="ConfirmPendingDiscard" OnCancel="() => _pendingDiscard = null" />
@code {
    [Parameter]
    public int Id { get; set; }

    private Project? _project;
    private string? _loadErrorMessage;
    private string? _coverObjectUrl;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private string? _coverSaveErrorMessage;
    private IBrowserFile? _selectedEditCover;
    private bool _isDraggingCover;
    private EditFormModel _editForm = new();
    private EditFormModel _editFormSnapshot = new();
    private bool _confirmingDiscardEdit;
    private bool _isSaving;
    private bool _confirmingDelete;

    private string _activeTab = "overview";
    private IEnumerable<(string Tab, int Count, string LabelKey)> ProjectStats =>
    [
        ("characters", _characters?.Count ?? 0, "projectDetail.tabCharacters"),
        ("map", _locations?.Count ?? 0, "projectDetail.statLocations"),
        ("timeline", _events?.Count ?? 0, "projectDetail.statEvents"),
        ("lore", _loreEntries?.Count ?? 0, "projectDetail.tabLore"),
        ("books", _linkedBooks?.Count ?? 0, "projectDetail.tabBooks"),
        ("files", _files?.Count ?? 0, "projectDetail.tabFiles"),
    ];

    private List<Character>? _characters;
    private string? _charactersErrorMessage;
    private bool _showCreateCharacterForm;
    private string? _createCharacterErrorMessage;
    private CreateCharacterFormModel _createCharacterForm = new();
    private IBrowserFile? _selectedCharacterImage;

    private string? _mapObjectUrl;
    private bool _isDraggingMap;
    private string? _mapSaveErrorMessage;
    private ElementReference _mapImageRef;
    private List<Location>? _locations;
    private string? _locationsErrorMessage;
    private bool _showCreateLocationForm;
    private string? _createLocationErrorMessage;
    private CreateLocationFormModel _createLocationForm = new();
    private IBrowserFile? _selectedLocationImage;
    private int? _placingLocationId;
    private string? _positionErrorMessage;

    private List<TimelineEvent>? _events;
    private string? _eventsErrorMessage;
    private bool _showCreateEventForm;
    private string? _createEventErrorMessage;
    private CreateTimelineEventRequest _createEventForm = new();
    private int? _editingEventId;
    private string? _editEventErrorMessage;
    private UpdateTimelineEventRequest _editEventForm = new();
    private (string? Title, string? Date, string? Description)? _editEventSnapshot;

    private List<LoreEntry>? _loreEntries;
    private string? _loreErrorMessage;
    private bool _showCreateLoreForm;
    private string? _createLoreErrorMessage;
    private CreateLoreEntryRequest _createLoreForm = new();

    private List<ProjectFile>? _files;
    private string? _filesErrorMessage;
    private string? _createFileErrorMessage;
    private List<PendingUpload> _pendingUploads = [];
    private bool _isUploadingFiles;
    private readonly Dictionary<int, string> _fileThumbnails = new();

    private List<Book>? _linkedBooks;
    private string? _linkedBooksErrorMessage;
    private string _bookSearchTerm = string.Empty;
    private List<Book>? _bookSuggestions;
    private ITimer? _bookSearchDebounceTimer;
    private string? _addBookErrorMessage;

    // Comments (v3.3, issue #325). GET /api/projects/:id is strictly
    // owner-only (findOwnedProjectRow, unlike books' findAccessibleBookRow),
    // so this page is currently only ever reachable by the project's own
    // owner -- non-owner commenting on a PUBLIC project is a real backend
    // capability (routes/projects.ts's :id/comments), exercised via the API
    // and live-verified, but has no frontend surface yet since there's no
    // public-facing project detail page for a non-owner to load. Deferred
    // until one exists (possibly as part of #315's premium design rework).
    private List<Comment>? _comments;
    private int? _currentUserId;
    private CommentFormModel _commentForm = new();
    private bool _isSubmittingComment;
    private string? _commentErrorMessage;
    private readonly HashSet<int> _commentActionInProgress = [];

    protected override Task OnParametersSetAsync() =>
        Task.WhenAll(
            LoadProjectAsync(), LoadCharactersAsync(), LoadLocationsAsync(), LoadTimelineEventsAsync(),
            LoadLoreEntriesAsync(), LoadLinkedBooksAsync(), LoadProjectFilesAsync(), LoadCurrentUserIdAsync(), LoadCommentsAsync());

    private async Task LoadCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _currentUserId = int.TryParse(idClaim, out var id) ? id : null;
    }

    private async Task LoadCommentsAsync()
    {
        // Best-effort, same reasoning as BookDetail.razor's LoadCommentsAsync
        // -- a response shape mismatch shouldn't take down the rest of the page.
        try
        {
            var response = await ApiClient.GetAsync<List<Comment>>($"/api/projects/{Id}/comments");
            _comments = response is { Success: true, Data: not null } ? response.Data : [];
        }
        catch (System.Text.Json.JsonException)
        {
            _comments = [];
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentForm.Content)) return;

        _isSubmittingComment = true;
        _commentErrorMessage = null;

        var succeeded = await ApiClient.PostAsync($"/api/projects/{Id}/comments", new { content = _commentForm.Content });
        if (succeeded)
        {
            _commentForm = new CommentFormModel();
            await LoadCommentsAsync();
        }
        else
        {
            _commentErrorMessage = I18n.T("projectDetail.commentSaveError");
        }

        _isSubmittingComment = false;
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        if (!_commentActionInProgress.Add(commentId)) return;

        var succeeded = await ApiClient.DeleteAsync($"/api/comments/{commentId}");
        if (succeeded) await LoadCommentsAsync();

        _commentActionInProgress.Remove(commentId);
    }

    private async Task LoadProjectAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Project>($"/api/projects/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _project = response.Data;
            await LoadCoverAsync();
            await LoadMapAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? I18n.T("projectDetail.loadError");
        }
    }

    private async Task LoadCoverAsync()
    {
        if (_coverObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
            _coverObjectUrl = null;
        }

        if (_project?.CoverUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_project.CoverUrl);
        if (result is { } cover)
        {
            _coverObjectUrl = await BlobUrlService.CreateObjectUrlAsync(cover.Bytes, cover.ContentType);
        }
    }

    private void StartEditing()
    {
        if (_project is null) return;
        _editForm = new EditFormModel { Title = _project.Title, Type = _project.Type, Description = _project.Description, Visibility = _project.Visibility };
        _editFormSnapshot = _editForm with { };
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;
        _selectedEditCover = null;
        _isEditing = true;
    }

    private void OnEditCoverSelected(InputFileChangeEventArgs e) => _selectedEditCover = e.File;

    private bool IsEditFormDirty => _editForm != _editFormSnapshot || _selectedEditCover is not null;

    private void RequestCloseEdit()
    {
        if (IsEditFormDirty)
        {
            _confirmingDiscardEdit = true;
            return;
        }
        _isEditing = false;
    }

    private void ConfirmDiscardEdit()
    {
        _confirmingDiscardEdit = false;
        _isEditing = false;
    }

    // Guarded like ShelfDetail's: a double click on Speichern must not send
    // the update (and the cover upload) twice.
    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            await SaveCoreAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveCoreAsync()
    {
        _saveErrorMessage = null;
        _coverSaveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateProjectRequest, Project>($"/api/projects/{Id}", new UpdateProjectRequest
        {
            Title = _editForm.Title,
            Type = _editForm.Type,
            Description = _editForm.Description,
            Visibility = _editForm.Visibility,
        });

        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? I18n.T("projectDetail.saveError");
            return;
        }

        _project = response.Data;

        if (_selectedEditCover is not null)
        {
            const long maxCoverBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditCover.OpenReadStream(maxCoverBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditCover.ContentType) ? "application/octet-stream" : _selectedEditCover.ContentType);
            content.Add(streamContent, "\"cover\"", $"\"{_selectedEditCover.Name}\"");

            var coverResponse = await ApiClient.PutMultipartAsync<Project>($"/api/projects/{Id}/cover", content);
            if (coverResponse is { Success: true, Data: not null })
            {
                _project = coverResponse.Data;
                await LoadCoverAsync();
            }
            else
            {
                _coverSaveErrorMessage = coverResponse?.Error?.Message ?? I18n.T("projectDetail.coverSaveError");
                return;
            }
        }

        _isEditing = false;
    }

    private async Task DeleteProjectAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo("projects");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = I18n.T("projectDetail.deleteError");
        }
    }

    private async Task LoadCharactersAsync()
    {
        _charactersErrorMessage = null;
        var response = await ApiClient.GetAsync<List<Character>>($"/api/projects/{Id}/characters");
        if (response is { Success: true, Data: not null })
        {
            _characters = response.Data;
        }
        else
        {
            _charactersErrorMessage = response?.Error?.Message ?? I18n.T("projectDetail.charactersLoadError");
        }
    }

    private void OnCharacterImageSelected(InputFileChangeEventArgs e) => _selectedCharacterImage = e.File;

    // --- Create/edit dialogs on the tabs (UI/UX plan A5) --------------------
    // Each dialog opens on a fresh form (no leftovers from a cancelled
    // attempt, cf. review N-2), asks before discarding typed input, and
    // SubmitDialogAsync keeps a double click from creating two entries.
    private Action? _pendingDiscard;
    private bool _isSubmittingDialog;

    private void RequestCloseDialog(bool isDirty, Action close)
    {
        if (isDirty)
        {
            _pendingDiscard = close;
            return;
        }
        close();
    }

    private void ConfirmPendingDiscard()
    {
        var close = _pendingDiscard;
        _pendingDiscard = null;
        close?.Invoke();
    }

    private async Task SubmitDialogAsync(Func<Task> submit)
    {
        if (_isSubmittingDialog) return;
        _isSubmittingDialog = true;
        try
        {
            await submit();
        }
        finally
        {
            _isSubmittingDialog = false;
        }
    }

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);

    private bool IsCreateCharacterDirty => HasText(_createCharacterForm.Name) || _selectedCharacterImage is not null;
    private bool IsCreateLocationDirty => HasText(_createLocationForm.Name) || _selectedLocationImage is not null;
    private bool IsCreateEventDirty => HasText(_createEventForm.Title) || HasText(_createEventForm.Date) || HasText(_createEventForm.Description);
    private bool IsCreateLoreDirty => HasText(_createLoreForm.Title) || HasText(_createLoreForm.Content);
    private bool IsEditEventDirty =>
        _editEventSnapshot is not { } snapshot ||
        (_editEventForm.Title ?? "") != (snapshot.Title ?? "") ||
        (_editEventForm.Date ?? "") != (snapshot.Date ?? "") ||
        (_editEventForm.Description ?? "") != (snapshot.Description ?? "");

    private void OpenCreateCharacter()
    {
        _createCharacterForm = new CreateCharacterFormModel();
        _selectedCharacterImage = null;
        _createCharacterErrorMessage = null;
        _showCreateCharacterForm = true;
    }

    private void OpenCreateLocation()
    {
        _createLocationForm = new CreateLocationFormModel();
        _selectedLocationImage = null;
        _createLocationErrorMessage = null;
        _showCreateLocationForm = true;
    }

    private void OpenCreateEvent()
    {
        _createEventForm = new CreateTimelineEventRequest();
        _createEventErrorMessage = null;
        _showCreateEventForm = true;
    }

    private void OpenCreateLore()
    {
        _createLoreForm = new CreateLoreEntryRequest();
        _createLoreErrorMessage = null;
        _showCreateLoreForm = true;
    }

    private async Task CreateCharacterAsync()
    {
        _createCharacterErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_createCharacterForm.Name))
        {
            _createCharacterErrorMessage = I18n.T("projectDetail.nameRequiredError");
