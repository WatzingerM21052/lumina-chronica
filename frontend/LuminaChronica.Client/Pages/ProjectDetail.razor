@page "/projects/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject ElementMetricsService ElementMetricsService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject II18nService I18n
@inject TimeProvider TimeProvider

<PageTitle>@(_project?.Title ?? I18n.T("projectDetail.defaultTitle")) — Lumina Chronica</PageTitle>

<a href="projects">@I18n.T("projectDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_project is null)
{
    <LoadingIndicator Text="@I18n.T("projectDetail.loading")" />
}
else
{
    <div class="form-actions">
        <button type="button" class="btn @(_activeTab == "overview" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "overview")">@I18n.T("projectDetail.tabOverview")</button>
        <button type="button" class="btn @(_activeTab == "characters" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "characters")">@I18n.T("projectDetail.tabCharacters")</button>
        <button type="button" class="btn @(_activeTab == "map" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "map")">@I18n.T("projectDetail.tabMap")</button>
        <button type="button" class="btn @(_activeTab == "timeline" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "timeline")">@I18n.T("projectDetail.tabTimeline")</button>
        <button type="button" class="btn @(_activeTab == "lore" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "lore")">@I18n.T("projectDetail.tabLore")</button>
        <button type="button" class="btn @(_activeTab == "books" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "books")">@I18n.T("projectDetail.tabBooks")</button>
        <button type="button" class="btn @(_activeTab == "files" ? "btn-primary" : "")" @onclick="@(() => _activeTab = "files")">@I18n.T("projectDetail.tabFiles")</button>
    </div>

    @if (_activeTab == "overview")
    {
        <div class="book-detail-cover">
            @if (_coverObjectUrl is not null)
            {
                <img src="@_coverObjectUrl" alt="@_project.Title" />
            }
            else
            {
                <div class="book-card-cover-placeholder" aria-hidden="true"><Icon Name="project" /></div>
            }
        </div>

        @if (!_isEditing)
        {
            <h1>@_project.Title</h1>
            <p class="text-muted">@ProjectTypeLabel.For(_project.Type, I18n)</p>
            @if (!string.IsNullOrWhiteSpace(_project.Description))
            {
                <p>@_project.Description</p>
            }
            <div class="form-actions">
                <button type="button" class="btn" @onclick="StartEditing">@I18n.T("projectDetail.editButton")</button>
                <button type="button" class="btn" @onclick="() => _confirmingDelete = true">@I18n.T("projectDetail.deleteButton")</button>
            </div>
            <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("projectDetail.deleteConfirmMessage")"
                           OnConfirm="DeleteProjectAsync" OnCancel="() => _confirmingDelete = false" />

            <section class="book-comments">
                <h2>@I18n.T("projectDetail.commentsTitle")</h2>
                @if (_comments is null)
                {
                    <p class="text-muted">@I18n.T("projectDetail.commentsLoading")</p>
                }
                else
                {
                    @if (_comments.Count == 0)
                    {
                        <p class="text-muted">@I18n.T("projectDetail.noCommentsMessage")</p>
                    }
                    else
                    {
                        <ul class="book-comment-list">
                            @foreach (var comment in _comments)
                            {
                                <li class="book-comment-item">
                                    <div class="book-comment-header">
                                        <strong>@comment.Username</strong>
                                        <span class="text-muted">@comment.CreatedAt</span>
                                    </div>
                                    <p>@comment.Content</p>
                                    @if (comment.UserId == _currentUserId)
                                    {
                                        <button type="button" class="btn" disabled="@_commentActionInProgress.Contains(comment.Id)" @onclick="() => DeleteCommentAsync(comment.Id)">@I18n.T("projectDetail.deleteButton")</button>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    <EditForm Model="_commentForm" OnValidSubmit="SubmitCommentAsync" class="comment-form">
                        @if (_commentErrorMessage is not null)
                        {
                            <p class="form-error">@_commentErrorMessage</p>
                        }
                        <InputTextArea @bind-Value="_commentForm.Content" placeholder="@I18n.T("projectDetail.commentPlaceholder")" />
                        <button type="submit" class="btn btn-primary" disabled="@(_isSubmittingComment || string.IsNullOrWhiteSpace(_commentForm.Content))">@I18n.T("projectDetail.commentSubmitButton")</button>
                    </EditForm>
                }
            </section>
        }
        else
        {
            <EditForm Model="_editForm" OnValidSubmit="SaveAsync" class="auth-form">
                @if (_saveErrorMessage is not null)
                {
                    <p class="form-error">@_saveErrorMessage</p>
                }
                <div class="form-group">
                    <label for="project-edit-cover">@I18n.T("projectDetail.replaceCoverLabel")</label>
                    <div class="dropzone @(_isDraggingCover ? "dropzone--active" : "")"
                         @ondragenter="() => _isDraggingCover = true" @ondragleave="() => _isDraggingCover = false"
                         @ondragover:preventDefault @ondrop="() => _isDraggingCover = false">
                        <InputFile id="project-edit-cover" OnChange="OnEditCoverSelected" />
                        <span class="dropzone-label">@I18n.T("projectDetail.coverDropzoneLabel")</span>
                    </div>
                    @if (_coverSaveErrorMessage is not null)
                    {
                        <p class="form-error">@_coverSaveErrorMessage</p>
                    }
                </div>
                <div class="form-group">
                    <label for="project-edit-title">@I18n.T("projectDetail.titleLabel")</label>
                    <InputText id="project-edit-title" @bind-Value="_editForm.Title" />
                </div>
                <div class="form-group">
                    <label for="project-edit-type">@I18n.T("projectDetail.typeLabel")</label>
                    <InputSelect id="project-edit-type" @bind-Value="_editForm.Type">
                        @foreach (var type in ProjectTypeLabel.Options)
                        {
                            <option value="@type">@ProjectTypeLabel.For(type, I18n)</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label for="project-edit-description">@I18n.T("projectDetail.descriptionLabel")</label>
                    <InputTextArea id="project-edit-description" @bind-Value="_editForm.Description" />
                </div>
                <div class="form-group">
                    <label for="project-edit-visibility">@I18n.T("projectDetail.visibilityLabel")</label>
                    <InputSelect id="project-edit-visibility" @bind-Value="_editForm.Visibility">
                        @foreach (var option in VisibilityOption.Options)
                        {
                            <option value="@option">@VisibilityOption.For(option, I18n)</option>
                        }
                    </InputSelect>
                    <p class="text-muted">@I18n.T("projectDetail.visibilityHint")</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.saveButton")</button>
                    <button type="button" class="btn" @onclick="() => _isEditing = false">@I18n.T("projectDetail.cancelButton")</button>
                </div>
            </EditForm>
        }
    }
    else if (_activeTab == "characters")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.charactersTitle")</h2>
            <button type="button" class="btn btn-primary" @onclick="() => _showCreateCharacterForm = !_showCreateCharacterForm">
                @(_showCreateCharacterForm ? I18n.T("projectDetail.cancelButton") : I18n.T("projectDetail.addCharacterButton"))
            </button>
        </div>

        @if (_showCreateCharacterForm)
        {
            <EditForm Model="_createCharacterForm" OnValidSubmit="CreateCharacterAsync" class="book-form-card">
                @if (_createCharacterErrorMessage is not null)
                {
                    <p class="form-error">@_createCharacterErrorMessage</p>
                }
                <div class="form-group">
                    <label for="character-name">@I18n.T("projectDetail.nameLabel")</label>
                    <InputText id="character-name" @bind-Value="_createCharacterForm.Name" />
                </div>
                <div class="form-group">
                    <label for="character-image">@I18n.T("projectDetail.imageOptionalLabel")</label>
                    <InputFile id="character-image" OnChange="OnCharacterImageSelected" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.addButton")</button>
                </div>
            </EditForm>
        }

        @if (_charactersErrorMessage is not null)
        {
            <p class="form-error">@_charactersErrorMessage</p>
        }
        else if (_characters is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.charactersLoading")" />
        }
        else if (_characters.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noCharactersMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var character in _characters)
                {
                    <CharacterCard Character="character" />
                }
            </div>
        }
    }
    else if (_activeTab == "map")
    {
        <h2>@I18n.T("projectDetail.mapTitle")</h2>

        @if (_mapObjectUrl is not null)
        {
            <div class="map-wrapper">
                <img @ref="_mapImageRef" src="@_mapObjectUrl" alt="@string.Format(I18n.T("projectDetail.mapAlt"), _project.Title)" class="map-image"
                     @onclick="OnMapClickAsync" style="@(_placingLocationId is not null ? "cursor: crosshair;" : "")" />
                @if (_locations is not null)
                {
                    @foreach (var location in _locations.Where(l => l.X is not null && l.Y is not null))
                    {
                        <a class="map-pin" style="@PinStyle(location)" href="@($"projects/{Id}/locations/{location.Id}")" title="@location.Name" aria-label="@location.Name"><Icon Name="location-pin" /></a>
                    }
                }
            </div>
            @if (_placingLocationId is not null)
            {
                <p class="text-muted">@string.Format(I18n.T("projectDetail.placeOnMapHint"), _locations?.FirstOrDefault(l => l.Id == _placingLocationId)?.Name) <button type="button" class="btn" @onclick="() => _placingLocationId = null">@I18n.T("projectDetail.cancelButton")</button></p>
            }
            @if (_positionErrorMessage is not null)
            {
                <p class="form-error">@_positionErrorMessage</p>
            }
            <div class="form-group">
                <label for="map-replace">@I18n.T("projectDetail.replaceMapLabel")</label>
                <InputFile id="map-replace" OnChange="OnMapSelected" />
            </div>
        }
        else
        {
            <div class="form-group">
                <label for="map-upload">@I18n.T("projectDetail.uploadMapLabel")</label>
                <div class="dropzone @(_isDraggingMap ? "dropzone--active" : "")"
                     @ondragenter="() => _isDraggingMap = true" @ondragleave="() => _isDraggingMap = false"
                     @ondragover:preventDefault @ondrop="() => _isDraggingMap = false">
                    <InputFile id="map-upload" OnChange="OnMapSelected" />
                    <span class="dropzone-label">@I18n.T("projectDetail.mapDropzoneLabel")</span>
                </div>
            </div>
        }
        @if (_mapSaveErrorMessage is not null)
        {
            <p class="form-error">@_mapSaveErrorMessage</p>
        }

        <div class="library-header">
            <h2>@I18n.T("projectDetail.locationsTitle")</h2>
            <button type="button" class="btn btn-primary" @onclick="() => _showCreateLocationForm = !_showCreateLocationForm">
                @(_showCreateLocationForm ? I18n.T("projectDetail.cancelButton") : I18n.T("projectDetail.addLocationButton"))
            </button>
        </div>

        @if (_showCreateLocationForm)
        {
            <EditForm Model="_createLocationForm" OnValidSubmit="CreateLocationAsync" class="book-form-card">
                @if (_createLocationErrorMessage is not null)
                {
                    <p class="form-error">@_createLocationErrorMessage</p>
                }
                <div class="form-group">
                    <label for="location-name">@I18n.T("projectDetail.nameLabel")</label>
                    <InputText id="location-name" @bind-Value="_createLocationForm.Name" />
                </div>
                <div class="form-group">
                    <label for="location-image">@I18n.T("projectDetail.imageOptionalLabel")</label>
                    <InputFile id="location-image" OnChange="OnLocationImageSelected" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.addButton")</button>
                </div>
            </EditForm>
        }

        @if (_locationsErrorMessage is not null)
        {
            <p class="form-error">@_locationsErrorMessage</p>
        }
        else if (_locations is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.locationsLoading")" />
        }
        else if (_locations.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLocationsMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var location in _locations)
                {
                    <div class="shelf-book-entry">
                        <LocationCard Location="location" />
                        @if (location.X is null && _mapObjectUrl is not null)
                        {
                            <button type="button" class="btn shelf-book-remove" @onclick="() => _placingLocationId = location.Id">@I18n.T("projectDetail.placeOnMapButton")</button>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (_activeTab == "timeline")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.timelineTitle")</h2>
            <button type="button" class="btn btn-primary" @onclick="() => _showCreateEventForm = !_showCreateEventForm">
                @(_showCreateEventForm ? I18n.T("projectDetail.cancelButton") : I18n.T("projectDetail.addEventButton"))
            </button>
        </div>

        @if (_showCreateEventForm)
        {
            <EditForm Model="_createEventForm" OnValidSubmit="CreateTimelineEventAsync" class="book-form-card">
                @if (_createEventErrorMessage is not null)
                {
                    <p class="form-error">@_createEventErrorMessage</p>
                }
                <div class="form-group">
                    <label for="event-title">@I18n.T("projectDetail.titleLabel")</label>
                    <InputText id="event-title" @bind-Value="_createEventForm.Title" />
                </div>
                <div class="form-group">
                    <label for="event-date">@I18n.T("projectDetail.eventDateLabel")</label>
                    <InputText id="event-date" @bind-Value="_createEventForm.Date" />
                </div>
                <div class="form-group">
                    <label for="event-description">@I18n.T("projectDetail.descriptionLabel")</label>
                    <InputTextArea id="event-description" @bind-Value="_createEventForm.Description" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.addButton")</button>
                </div>
            </EditForm>
        }

        @if (_eventsErrorMessage is not null)
        {
            <p class="form-error">@_eventsErrorMessage</p>
        }
        else if (_events is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.timelineLoading")" />
        }
        else if (_events.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noEventsMessage")</p>
        }
        else
        {
            <ol class="timeline">
                @foreach (var (timelineEvent, index) in _events.Select((e, i) => (e, i)))
                {
                    <li class="timeline-event">
                        @if (_editingEventId == timelineEvent.Id)
                        {
                            <EditForm Model="_editEventForm" OnValidSubmit="SaveTimelineEventAsync" class="timeline-event-card">
                                @if (_editEventErrorMessage is not null)
                                {
                                    <p class="form-error">@_editEventErrorMessage</p>
                                }
                                <div class="form-group">
                                    <label for="@($"event-edit-title-{timelineEvent.Id}")">@I18n.T("projectDetail.titleLabel")</label>
                                    <InputText id="@($"event-edit-title-{timelineEvent.Id}")" @bind-Value="_editEventForm.Title" />
                                </div>
                                <div class="form-group">
                                    <label for="@($"event-edit-date-{timelineEvent.Id}")">@I18n.T("projectDetail.dateLabel")</label>
                                    <InputText id="@($"event-edit-date-{timelineEvent.Id}")" @bind-Value="_editEventForm.Date" />
                                </div>
                                <div class="form-group">
                                    <label for="@($"event-edit-description-{timelineEvent.Id}")">@I18n.T("projectDetail.descriptionLabel")</label>
                                    <InputTextArea id="@($"event-edit-description-{timelineEvent.Id}")" @bind-Value="_editEventForm.Description" />
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.saveButton")</button>
                                    <button type="button" class="btn" @onclick="() => _editingEventId = null">@I18n.T("projectDetail.cancelButton")</button>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <div class="timeline-event-card">
                                @if (!string.IsNullOrWhiteSpace(timelineEvent.Date))
                                {
                                    <div class="timeline-event-date">@timelineEvent.Date</div>
                                }
                                <div class="timeline-event-title">@timelineEvent.Title</div>
                                @if (!string.IsNullOrWhiteSpace(timelineEvent.Description))
                                {
                                    <p>@timelineEvent.Description</p>
                                }
                                <div class="timeline-event-controls">
                                    <div class="timeline-move-buttons">
                                        <button type="button" class="btn" disabled="@(index == 0)" @onclick='() => MoveTimelineEventAsync(timelineEvent.Id, "up")' title="@I18n.T("projectDetail.moveUpTitle")">▲</button>
                                        <button type="button" class="btn" disabled="@(index == _events.Count - 1)" @onclick='() => MoveTimelineEventAsync(timelineEvent.Id, "down")' title="@I18n.T("projectDetail.moveDownTitle")">▼</button>
                                    </div>
                                    <button type="button" class="btn" @onclick="() => StartEditingEvent(timelineEvent)">@I18n.T("projectDetail.editButton")</button>
                                    <button type="button" class="btn" @onclick="() => DeleteTimelineEventAsync(timelineEvent.Id)">@I18n.T("projectDetail.deleteButton")</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ol>
        }
    }
    else if (_activeTab == "lore")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.loreTitle")</h2>
            <button type="button" class="btn btn-primary" @onclick="() => _showCreateLoreForm = !_showCreateLoreForm">
                @(_showCreateLoreForm ? I18n.T("projectDetail.cancelButton") : I18n.T("projectDetail.addLoreButton"))
            </button>
        </div>

        @if (_showCreateLoreForm)
        {
            <EditForm Model="_createLoreForm" OnValidSubmit="CreateLoreEntryAsync" class="book-form-card">
                @if (_createLoreErrorMessage is not null)
                {
                    <p class="form-error">@_createLoreErrorMessage</p>
                }
                <div class="form-group">
                    <label for="lore-title">@I18n.T("projectDetail.titleLabel")</label>
                    <InputText id="lore-title" @bind-Value="_createLoreForm.Title" />
                </div>
                <div class="form-group">
                    <label for="lore-content">@I18n.T("projectDetail.loreContentLabel")</label>
                    <InputTextArea id="lore-content" @bind-Value="_createLoreForm.Content" rows="8" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.addButton")</button>
                </div>
            </EditForm>
        }

        @if (_loreErrorMessage is not null)
        {
            <p class="form-error">@_loreErrorMessage</p>
        }
        else if (_loreEntries is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.loreLoading")" />
        }
        else if (_loreEntries.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLoreMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var entry in _loreEntries)
                {
                    <LoreEntryCard Entry="entry" />
                }
            </div>
        }
    }
    else if (_activeTab == "books")
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.linkedBooksTitle")</h2>
        </div>

        <div class="library-search-wrapper">
            <input type="search" placeholder="@I18n.T("projectDetail.bookSearchPlaceholder")" value="@_bookSearchTerm" @oninput="OnBookSearchInput" />
            @if (_bookSuggestions is { Count: > 0 })
            {
                <ul class="library-search-suggestions">
                    @foreach (var book in _bookSuggestions)
                    {
                        <li>
                            <button type="button" @onclick="() => AddBookAsync(book.Id)">
                                @book.Title
                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <span class="text-muted"> — @book.Author</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
        @if (_addBookErrorMessage is not null)
        {
            <p class="form-error">@_addBookErrorMessage</p>
        }

        @if (_linkedBooksErrorMessage is not null)
        {
            <p class="form-error">@_linkedBooksErrorMessage</p>
        }
        else if (_linkedBooks is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.linkedBooksLoading")" />
        }
        else if (_linkedBooks.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noLinkedBooksMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var book in _linkedBooks)
                {
                    <div class="shelf-book-entry">
                        <BookCard Book="book" />
                        <button type="button" class="btn shelf-book-remove" @onclick="() => RemoveBookAsync(book.Id)">@I18n.T("projectDetail.removeBookButton")</button>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="library-header">
            <h2>@I18n.T("projectDetail.filesTitle")</h2>
        </div>

        <EditForm Model="_createFileForm" OnValidSubmit="CreateProjectFileAsync" class="book-form-card">
            @if (_createFileErrorMessage is not null)
            {
                <p class="form-error">@_createFileErrorMessage</p>
            }
            <div class="form-group">
                <label for="file-category">@I18n.T("projectDetail.typeLabel")</label>
                <InputSelect id="file-category" @bind-Value="_createFileForm.Category">
                    <option value="IMAGE">@I18n.T("projectDetail.categoryImage")</option>
                    <option value="DOCUMENT">@I18n.T("projectDetail.categoryDocument")</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label for="file-upload">@I18n.T("projectDetail.fileLabel")</label>
                <InputFile id="file-upload" OnChange="OnProjectFileSelected" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@I18n.T("projectDetail.uploadButton")</button>
            </div>
        </EditForm>

        @if (_filesErrorMessage is not null)
        {
            <p class="form-error">@_filesErrorMessage</p>
        }
        else if (_files is null)
        {
            <LoadingIndicator Text="@I18n.T("projectDetail.filesLoading")" />
        }
        else if (_files.Count == 0)
        {
            <p class="text-muted">@I18n.T("projectDetail.noFilesMessage")</p>
        }
        else
        {
            <div class="library-grid">
                @foreach (var file in _files)
                {
                    <div class="project-card file-gallery-item">
                        <div class="project-card-cover">
                            @if (file.Category == "IMAGE" && _fileThumbnails.TryGetValue(file.Id, out var thumbnailUrl))
                            {
                                <img src="@thumbnailUrl" alt="@file.Name" />
                            }
                            else
                            {
                                <div class="project-card-cover-placeholder" aria-hidden="true"><Icon Name="@(file.Category == "IMAGE" ? "image" : "document")" /></div>
                            }
                        </div>
                        <div class="project-card-info">
                            <div class="project-card-title">@file.Name</div>
                            <div class="project-card-type">@FormatFileSize(file.Size)</div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn" @onclick="() => DownloadProjectFileAsync(file)">@I18n.T("projectDetail.downloadButton")</button>
                            <button type="button" class="btn" @onclick="() => DeleteProjectFileAsync(file.Id)">@I18n.T("projectDetail.deleteButton")</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

