    private void OnBookSearchInput(ChangeEventArgs e)
    {
        _bookSearchTerm = e.Value?.ToString() ?? string.Empty;

        _bookSearchDebounceTimer?.Dispose();
        // Created through the injected TimeProvider (TimeProvider.System in
        // Program.cs) rather than `new System.Threading.Timer` so bUnit tests
        // can advance a fake clock instead of racing a real 400ms timer
        // against a wall-clock WaitForAssertion timeout.
        _bookSearchDebounceTimer = TimeProvider.CreateTimer(
            _ => InvokeAsync(async () =>
            {
                await LoadBookSuggestionsAsync();
                // Same real-browser-only re-render gap as Library.razor's
                // search debounce -- a Timer callback reached via InvokeAsync
                // doesn't automatically trigger a re-render afterwards.
                StateHasChanged();
            }),
            null,
            TimeSpan.FromMilliseconds(400),
            Timeout.InfiniteTimeSpan);
    }

