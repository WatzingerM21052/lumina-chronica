        foreach (var url in _fileThumbnails.Values)
        {
            await BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _fileThumbnails.Clear();

        foreach (var file in _files.Where(f => f.Category == "IMAGE"))
        {
            var result = await ApiClient.GetBytesAsync(file.Url);
            if (result is { } image)
            {
                _fileThumbnails[file.Id] = await BlobUrlService.CreateObjectUrlAsync(image.Bytes, image.ContentType);
            }
        }
    }

