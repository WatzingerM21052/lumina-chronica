    private async Task DownloadProjectFileAsync(ProjectFile file)
    {
        var result = await ApiClient.GetBytesAsync(file.Url);
        if (result is not { } bytes) return;

        var objectUrl = await BlobUrlService.CreateObjectUrlAsync(bytes.Bytes, bytes.ContentType);
        await BlobUrlService.TriggerDownloadAsync(objectUrl, file.Name);
        await BlobUrlService.RevokeObjectUrlAsync(objectUrl);
    }

