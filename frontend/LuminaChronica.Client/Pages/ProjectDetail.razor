    // What the backend takes (projectFileService.ts / fileValidation.ts).
    private const int MaxFilesPerUpload = 10;
    private static readonly string[] ImageExtensions = ["jpg", "jpeg", "png", "webp"];
    private static readonly string[] DocumentExtensions = ["pdf", "txt", "md", "doc", "docx"];
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private const long MaxDocumentBytes = 20 * 1024 * 1024;
    private static readonly string ProjectFileAccept = string.Join(",", ImageExtensions.Concat(DocumentExtensions).Select(e => "." + e));

    private enum UploadStatus { Ready, Uploading, Done, Failed, Rejected }

    private sealed class PendingUpload(IBrowserFile file, string category)
    {
        public IBrowserFile File { get; } = file;
        public string Category { get; } = category;
        public UploadStatus Status { get; set; } = UploadStatus.Ready;
        public string? Message { get; set; }
    }

    private int UploadableCount => _pendingUploads.Count(u => u.Status == UploadStatus.Ready);

    private string UploadStatusText(PendingUpload upload) => upload.Status switch
    {
        UploadStatus.Ready => upload.Category == "IMAGE" ? I18n.T("projectDetail.categoryImage") : I18n.T("projectDetail.categoryDocument"),
        UploadStatus.Uploading => I18n.T("projectDetail.uploadStatusUploading"),
        UploadStatus.Done => I18n.T("projectDetail.uploadStatusDone"),
        _ => upload.Message ?? I18n.T("projectDetail.fileUploadError"),
    };

    // Picks (or drops) up to ten files and sorts out the ones the backend
    // would refuse, so the user learns why before anything is sent.
    private void OnProjectFilesSelected(InputFileChangeEventArgs e)
    {
        _createFileErrorMessage = null;
        var files = e.GetMultipleFiles(int.MaxValue);
        if (files.Count > MaxFilesPerUpload)
        {
            _createFileErrorMessage = string.Format(I18n.T("projectDetail.tooManyFilesError"), MaxFilesPerUpload);
        }

        _pendingUploads = files.Take(MaxFilesPerUpload).Select(file =>
        {
            var extension = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
            var category = ImageExtensions.Contains(extension) ? "IMAGE" : "DOCUMENT";
            var upload = new PendingUpload(file, category);
            if (!ImageExtensions.Contains(extension) && !DocumentExtensions.Contains(extension))
            {
                upload.Status = UploadStatus.Rejected;
                upload.Message = I18n.T("projectDetail.fileTypeNotAllowed");
            }
            else if (file.Size > (category == "IMAGE" ? MaxImageBytes : MaxDocumentBytes))
            {
                upload.Status = UploadStatus.Rejected;
                upload.Message = string.Format(I18n.T("projectDetail.fileTooLarge"), (category == "IMAGE" ? MaxImageBytes : MaxDocumentBytes) / 1024 / 1024);
            }
            return upload;
        }).ToList();
    }

    // One request per file, one after another, each with its own status.
    // The dialog closes on its own once everything went up; otherwise it
    // stays open with the files that didn't.
    private async Task UploadProjectFilesAsync()
    {
        _createFileErrorMessage = null;
        if (UploadableCount == 0)
        {
            _createFileErrorMessage = I18n.T("projectDetail.fileRequiredError");
            return;
        }

        _isUploadingFiles = true;
        foreach (var upload in _pendingUploads.Where(u => u.Status == UploadStatus.Ready).ToList())
        {
            upload.Status = UploadStatus.Uploading;
            StateHasChanged();

            using var content = new MultipartFormDataContent
            {
                { new StringContent(upload.Category), "\"category\"" }
            };
            var streamContent = new StreamContent(upload.File.OpenReadStream(upload.Category == "IMAGE" ? MaxImageBytes : MaxDocumentBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(upload.File.ContentType) ? "application/octet-stream" : upload.File.ContentType);
            content.Add(streamContent, "\"file\"", $"\"{upload.File.Name}\"");

            var response = await ApiClient.PostMultipartAsync<ProjectFile>($"/api/projects/{Id}/files", content);
            if (response is { Success: true, Data: not null })
            {
                upload.Status = UploadStatus.Done;
            }
            else
            {
                upload.Status = UploadStatus.Failed;
                upload.Message = response?.Error?.Message ?? I18n.T("projectDetail.fileUploadError");
            }
            StateHasChanged();
        }
        _isUploadingFiles = false;

        await LoadProjectFilesAsync();
        if (_pendingUploads.All(u => u.Status == UploadStatus.Done))
        {
            CloseCreateFile();
        }
    }

    private enum DocumentViewKind { None, Pdf, Text, Markdown }

    private sealed record ViewedDocument(ProjectFile File, DocumentViewKind Kind, byte[] Bytes, string Text);

    // HTML in a user's .md is shown as text, never run (same as lore entries).
    private static readonly MarkdownPipeline FileMarkdownPipeline = new MarkdownPipelineBuilder().DisableHtml().Build();

    private bool _lightboxOpen;
    private int _lightboxIndex;
    private ViewedDocument? _viewedDocument;

    private static string FileExtension(ProjectFile file)
    {
        var dot = file.Name.LastIndexOf('.');
        return dot >= 0 && dot < file.Name.Length - 1 ? file.Name[(dot + 1)..].ToLowerInvariant() : "";
    }

    private static DocumentViewKind DocumentKind(ProjectFile file) => FileExtension(file) switch
    {
        "pdf" => DocumentViewKind.Pdf,
        "txt" => DocumentViewKind.Text,
        "md" => DocumentViewKind.Markdown,
        _ => DocumentViewKind.None,
    };

    private List<LightboxImage> LightboxImages(List<ProjectFile> imageFiles) =>
        imageFiles.Where(f => _fileThumbnails.ContainsKey(f.Id)).Select(f => new LightboxImage(f.Id, _fileThumbnails[f.Id], f.Name)).ToList();

    // The grid's index counts every image; the lightbox only gets those
    // whose blob loaded, so map by id.
    private void OpenLightbox(int gridIndex)
    {
        var imageFiles = _files?.Where(f => f.Category == "IMAGE").ToList() ?? [];
        if (gridIndex >= imageFiles.Count) return;
        var index = LightboxImages(imageFiles).FindIndex(i => i.Id == imageFiles[gridIndex].Id);
        if (index < 0) return;
        _lightboxIndex = index;
        _lightboxOpen = true;
    }

    private Task DownloadLightboxImageAsync(LightboxImage image) =>
        _files?.FirstOrDefault(f => f.Id == image.Id) is { } file ? DownloadProjectFileAsync(file) : Task.CompletedTask;

    private async Task OpenDocumentAsync(ProjectFile file)
    {
        var kind = DocumentKind(file);
        if (kind == DocumentViewKind.None)
        {
            await DownloadProjectFileAsync(file);
            return;
        }

        var result = await ApiClient.GetBytesAsync(file.Url);
        if (result is not { } content) return;
        var text = kind == DocumentViewKind.Pdf ? "" : System.Text.Encoding.UTF8.GetString(content.Bytes);
        _viewedDocument = new ViewedDocument(file, kind, content.Bytes, text);
    }

    private void CloseDocument() => _viewedDocument = null;

    private async Task DownloadProjectFileAsync(ProjectFile file)
    {
        var result = await ApiClient.GetBytesAsync(file.Url);
        if (result is not { } bytes) return;

        var objectUrl = await BlobUrlService.CreateObjectUrlAsync(bytes.Bytes, bytes.ContentType);
        await BlobUrlService.TriggerDownloadAsync(objectUrl, file.Name);
        await BlobUrlService.RevokeObjectUrlAsync(objectUrl);
    }

    private async Task DeleteProjectFileAsync()
    {
        if (_confirmingFileDeleteId is not { } fileId) return;
        _confirmingFileDeleteId = null;
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{Id}/files/{fileId}");
        if (succeeded)
        {
            await LoadProjectFilesAsync();
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return bytes.ToString(CultureInfo.InvariantCulture) + " B";
        var mb = bytes / 1024.0 / 1024.0;
        return mb >= 1
            ? mb.ToString("F1", CultureInfo.InvariantCulture) + " MB"
            : (bytes / 1024.0).ToString("F0", CultureInfo.InvariantCulture) + " KB";
    }

    public void Dispose()
    {
        if (_coverObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_coverObjectUrl);
        }
        if (_mapObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_mapObjectUrl);
        }
        foreach (var url in _fileThumbnails.Values)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(url);
        }
        _bookSearchDebounceTimer?.Dispose();
    }

