@page "/projects/{ProjectId:int}/locations/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject BlobUrlService BlobUrlService
@inject NavigationManager NavigationManager
@inject II18nService I18n

<PageTitle>@(_location?.Name ?? I18n.T("locationDetail.defaultTitle")) — Lumina Chronica</PageTitle>

<a class="back-link" href="@($"projects/{ProjectId}")">@I18n.T("locationDetail.backLink")</a>

@if (_loadErrorMessage is not null)
{
    <p class="form-error">@_loadErrorMessage</p>
}
else if (_location is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Type="LoadingIndicatorType.Map" Text="@I18n.T("locationDetail.loading")" />
}
else
{
    @* UI/UX plan A5: same header layout as book and project; editing in a dialog. *@
    <div class="book-detail">
        <div class="book-detail-cover">
            @if (_imageObjectUrl is not null)
            {
                <img src="@_imageObjectUrl" alt="@_location.Name" />
            }
            else
            {
                <div class="book-card-cover-placeholder" aria-hidden="true"><Icon Name="location-pin" /></div>
            }
        </div>

        <div class="book-detail-info">
            <h1>@_location.Name</h1>
            <p class="text-muted">@(_location.X is not null ? I18n.T("locationDetail.placedOnMap") : I18n.T("locationDetail.notPlacedOnMap"))</p>
            @if (!string.IsNullOrWhiteSpace(_location.Description))
            {
                <p>@_location.Description</p>
            }
            <div class="form-actions">
                <button type="button" id="location-edit-button" class="btn" @onclick="StartEditing">@I18n.T("locationDetail.editButton")</button>
                @if (_location.X is not null)
                {
                    <button type="button" class="btn" @onclick="RemovePositionAsync">@I18n.T("locationDetail.removeFromMapButton")</button>
                }
                <button type="button" class="btn" @onclick="() => _confirmingDelete = true">@I18n.T("locationDetail.deleteButton")</button>
            </div>
        </div>
    </div>
    <ConfirmDialog IsOpen="_confirmingDelete" Message="@I18n.T("locationDetail.deleteConfirmMessage")"
                   OnConfirm="DeleteLocationAsync" OnCancel="() => _confirmingDelete = false" />

    <Dialog IsOpen="_isEditing" Title="@I18n.T("locationDetail.editDialogTitle")"
            OnClose="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">
        <ChildContent>
            <EditForm id="location-edit-form" Model="_editForm" OnValidSubmit="() => _guard.SubmitAsync(SaveAsync)" class="auth-form">
                @if (_saveErrorMessage is not null)
                {
                    <p class="form-error">@_saveErrorMessage</p>
                }
                <div class="form-group">
                    <label for="location-edit-name">@I18n.T("locationDetail.nameLabel")</label>
                    <InputText id="location-edit-name" @bind-Value="_editForm.Name" />
                </div>
                <div class="form-group">
                    <label for="location-edit-description">@I18n.T("locationDetail.descriptionLabel")</label>
                    <InputTextArea id="location-edit-description" @bind-Value="_editForm.Description" />
                </div>
                <div class="form-group">
                    <label for="location-edit-image">@I18n.T("locationDetail.replaceImageLabel")</label>
                    <FileDropzone Id="location-edit-image" Accept="image/*" Label="@I18n.T("locationDetail.dropzoneLabel")"
                                  SelectedFileName="@_selectedEditImage?.Name" OnChange="OnEditImageSelected" />
                    @if (_imageSaveErrorMessage is not null)
                    {
                        <p class="form-error">@_imageSaveErrorMessage</p>
                    }
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn" @onclick="() => _guard.RequestClose(IsEditFormDirty, () => _isEditing = false)">@I18n.T("locationDetail.cancelButton")</button>
            <button type="submit" form="location-edit-form" class="btn btn-primary" disabled="@_guard.IsSubmitting">@I18n.T("locationDetail.saveButton")</button>
        </Footer>
    </Dialog>

    <ConfirmDialog IsOpen="_guard.IsConfirmingDiscard" Message="@I18n.T("dialog.discardChangesMessage")"
                   ConfirmText="@I18n.T("dialog.discardChangesConfirm")" CancelText="@I18n.T("dialog.discardChangesCancel")"
                   OnConfirm="_guard.ConfirmDiscard" OnCancel="_guard.CancelDiscard" />
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Location? _location;
    private string? _loadErrorMessage;
    private string? _imageObjectUrl;

    private bool _isEditing;
    private string? _saveErrorMessage;
    private string? _imageSaveErrorMessage;
    private IBrowserFile? _selectedEditImage;
    private EditFormModel _editForm = new();
    private EditFormModel _editFormSnapshot = new();
    private readonly DialogGuard _guard = new();
    private bool _confirmingDelete;

    protected override Task OnParametersSetAsync() => LoadLocationAsync();

    private async Task LoadLocationAsync()
    {
        _loadErrorMessage = null;
        var response = await ApiClient.GetAsync<Location>($"/api/projects/{ProjectId}/locations/{Id}");
        if (response is { Success: true, Data: not null })
        {
            _location = response.Data;
            await LoadImageAsync();
        }
        else
        {
            _loadErrorMessage = response?.Error?.Message ?? I18n.T("locationDetail.loadError");
        }
    }

    private async Task LoadImageAsync()
    {
        if (_imageObjectUrl is not null)
        {
            await BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
            _imageObjectUrl = null;
        }

        if (_location?.ImageUrl is null) return;

        var result = await ApiClient.GetBytesAsync(_location.ImageUrl);
        if (result is { } image)
        {
            _imageObjectUrl = await BlobUrlService.CreateObjectUrlAsync(image.Bytes, image.ContentType);
        }
    }

    private void StartEditing()
    {
        if (_location is null) return;
        _editForm = new EditFormModel { Name = _location.Name, Description = _location.Description };
        _editFormSnapshot = _editForm with { };
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;
        _selectedEditImage = null;
        _isEditing = true;
    }

    private void OnEditImageSelected(InputFileChangeEventArgs e) => _selectedEditImage = e.File;

    private bool IsEditFormDirty => _editForm != _editFormSnapshot || _selectedEditImage is not null;

    private async Task SaveAsync()
    {
        _saveErrorMessage = null;
        _imageSaveErrorMessage = null;

        var response = await ApiClient.PutAsync<UpdateLocationRequest, Location>($"/api/projects/{ProjectId}/locations/{Id}", new UpdateLocationRequest
        {
            Name = _editForm.Name,
            Description = _editForm.Description,
        });

        if (response is not { Success: true, Data: not null })
        {
            _saveErrorMessage = response?.Error?.Message ?? I18n.T("locationDetail.saveError");
            return;
        }

        _location = response.Data;

        if (_selectedEditImage is not null)
        {
            const long maxImageBytes = 5 * 1024 * 1024;
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(_selectedEditImage.OpenReadStream(maxImageBytes));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(_selectedEditImage.ContentType) ? "application/octet-stream" : _selectedEditImage.ContentType);
            content.Add(streamContent, "\"image\"", $"\"{_selectedEditImage.Name}\"");

            var imageResponse = await ApiClient.PutMultipartAsync<Location>($"/api/projects/{ProjectId}/locations/{Id}/image", content);
            if (imageResponse is { Success: true, Data: not null })
            {
                _location = imageResponse.Data;
                await LoadImageAsync();
            }
            else
            {
                _imageSaveErrorMessage = imageResponse?.Error?.Message ?? I18n.T("locationDetail.imageSaveError");
                return;
            }
        }

        _isEditing = false;
    }

    private async Task RemovePositionAsync()
    {
        var response = await ApiClient.PutAsync<UpdateLocationPositionRequest, Location>($"/api/projects/{ProjectId}/locations/{Id}/position", new UpdateLocationPositionRequest
        {
            X = null,
            Y = null,
        });
        if (response is { Success: true, Data: not null })
        {
            _location = response.Data;
        }
    }

    private async Task DeleteLocationAsync()
    {
        var succeeded = await ApiClient.DeleteAsync($"/api/projects/{ProjectId}/locations/{Id}");
        if (succeeded)
        {
            NavigationManager.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            _confirmingDelete = false;
            _loadErrorMessage = I18n.T("locationDetail.deleteError");
        }
    }

    public void Dispose()
    {
        if (_imageObjectUrl is not null)
        {
            _ = BlobUrlService.RevokeObjectUrlAsync(_imageObjectUrl);
        }
    }

    private record EditFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
