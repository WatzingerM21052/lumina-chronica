@page "/not-found"
@layout MainLayout
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Services
@inject II18nService I18n

<PageTitle>@I18n.T("notFound.title") — Lumina Chronica</PageTitle>

<EmptyState Message="@I18n.T("notFound.message")" ActionText="@I18n.T("notFound.actionText")" OnAction="GoHome" />

@code {
    [Inject]
    private Microsoft.AspNetCore.Components.NavigationManager Nav { get; set; } = default!;

    private void GoHome() => Nav.NavigateTo("");
}
