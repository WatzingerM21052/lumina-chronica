@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject IThemeService ThemeService
@inject ApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject II18nService I18n
@inject NavigationManager NavigationManager

<PageTitle>@I18n.T("settings.title") — Lumina Chronica</PageTitle>

<WorldBanner Page="settings" Title="@I18n.T("settings.title")" Subtitle="@I18n.T("worldBanner.settingsSubtitle")" />
<div class="settings-hero">
    <img src="images/settings-hero.webp" alt="" class="settings-hero-image" loading="eager" decoding="async" />
    <div class="settings-hero-scrim"></div>
    <div class="settings-hero-content">
        <h1>@I18n.T("settings.title")</h1>
    </div>
</div>

@* Plan A7: one "appearance" card (theme previews, language, shelf cover
   text) instead of three; preferences are switches with the label left
   and the switch right; in-app notifications and what the public
   activity log shows are separate groups. *@
<div class="settings-card">
    <h2>@I18n.T("settings.appearanceTitle")</h2>

    <h3 class="settings-subheading">@I18n.T("settings.themeTitle")</h3>
    @* Each preview carries its own data-theme, so the theme files' own
       tokens paint it: always the real colours, nothing duplicated here. *@
    <div class="theme-cards" role="group" aria-label="@I18n.T("settings.themeTitle")">
        @foreach (var (value, label) in Themes)
        {
            var isActive = _currentTheme == value;
            <button type="button" class="theme-card @(isActive ? "is-active" : null)" aria-pressed="@(isActive ? "true" : "false")" @onclick="() => SetThemeAsync(value)">
                @if (value == "system")
                {
                    <span class="theme-card-preview theme-card-preview--split" aria-hidden="true">
                        <span class="theme-card-half" data-theme="modern-light">@ThemePreview</span>
                        <span class="theme-card-half" data-theme="dark-library">@ThemePreview</span>
                    </span>
                }
                else
                {
                    <span class="theme-card-preview" data-theme="@value" aria-hidden="true">@ThemePreview</span>
                }
                <span class="theme-card-label">@label</span>
            </button>
        }
    </div>

    @* Babylon and Alexandria: Home as the immersive journey (default) or
       as the calmer card dashboard. *@
    @if (_currentTheme is "babylon" or "alexandria")
    {
        <label class="preference-row immersive-theme-row">
            <span class="preference-row-text">
                <strong>@I18n.T("settings.immersiveLabel")</strong>
                <span class="text-muted">@I18n.T("settings.immersiveDescription")</span>
            </span>
            <input type="checkbox" role="switch" class="switch" checked="@_immersive" @onchange="e => SetImmersiveAsync((bool)e.Value!)" />
        </label>
    }

    <h3 class="settings-subheading">@I18n.T("settings.languageTitle")</h3>
    <div class="theme-picker">
        <button class="btn @(I18n.CurrentLanguage == "de" ? "btn-primary" : "")" @onclick='() => SetLanguageAsync("de")'>@I18n.T("settings.languageGerman")</button>
        <button class="btn @(I18n.CurrentLanguage == "en" ? "btn-primary" : "")" @onclick='() => SetLanguageAsync("en")'>@I18n.T("settings.languageEnglish")</button>
    </div>

    <h3 class="settings-subheading">@I18n.T("settings.libraryTitle")</h3>
    <label class="preference-row library-preference-row">
        <span class="preference-row-text">
            <strong>@I18n.T("settings.showCoverTextLabel")</strong>
            <span class="text-muted">@I18n.T("settings.showCoverTextDescription")</span>
        </span>
        <input type="checkbox" role="switch" class="switch" checked="@_showShelfCoverText" @onchange="e => SetShowShelfCoverTextAsync((bool)e.Value!)" />
    </label>
    @* The scroll shelf belongs to the card dashboard only. *@
    @if (_currentTheme == "alexandria" && !_immersive)
    {
        <label class="preference-row home-scroll-shelf-row">
            <span class="preference-row-text">
                <strong>@I18n.T("settings.homeScrollShelfLabel")</strong>
                <span class="text-muted">@I18n.T("settings.homeScrollShelfDescription")</span>
            </span>
            <input type="checkbox" role="switch" class="switch" checked="@_homeScrollShelf" @onchange="e => SetHomeScrollShelfAsync((bool)e.Value!)" />
        </label>
    }
</div>

@if (_preferences is null)
{
    <div class="settings-card">
        <h2>@I18n.T("settings.notificationsTitle")</h2>
        <p class="text-muted">@I18n.T("settings.loadingPreferences")</p>
    </div>
}
else
{
    @foreach (var (titleKey, types) in PreferenceGroups)
    {
        <div class="settings-card">
            <h2>@I18n.T(titleKey)</h2>
            <div class="notification-preferences">
                @foreach (var type in types)
                {
                    <label class="preference-row notification-preference-row">
                        <span class="preference-row-text">
                            <strong>@I18n.T(type.LabelKey)</strong>
                            <span class="text-muted">@I18n.T(type.DescriptionKey)</span>
                        </span>
                        <input type="checkbox" role="switch" class="switch" checked="@GetPreference(type.Type)" @onchange="e => SetPreferenceAsync(type.Type, (bool)e.Value!)" />
                    </label>
                }
            </div>
        </div>
    }
}

@code {
    private static readonly (string Value, string Label)[] Themes =
    [
        ("classic-library", "Classic Library"),
        ("modern-light", "Modern Light"),
        ("dark-library", "Dark Library"),
        ("system", "System"),
        ("babylon", "Babylon"),
        ("alexandria", "Alexandria"),
        ("skriptorium", "Skriptorium"),
        ("abendhafen", "Abendhafen"),
        ("ischtar", "Ischtar-Tor"),
        ("daemmergarten", "Gärten in der Dämmerung"),
        ("nachtgarten", "Nachtgarten"),
    ];

    // (preference type, label key, description key) -- FOLLOW/COMMENT/RATING/SHARE
    // gate an in-app notification and default to enabled. ACTIVITY_RATING
    // gates whether a rating shows up in the profile's own "Aktivitäten"
    // log at all; ACTIVITY_RATING_STARS separately gates whether the
    // specific star count is shown once it does (split in issue #315
    // Phase 3, raised by the user directly: the star value is the more
    // sensitive part, not just that a rating happened). Both default to
    // disabled -- opt-in, not opt-out, since both reveal something
    // genuinely personal on a page anyone can view.
    //
    // Label/description are i18n keys, not raw text: this array is a
    // private static readonly field, so it can't call the instance method
    // I18n.T() at field-initialization time -- the lookup happens in the
    // markup's @foreach instead.
    private static readonly (string Type, string LabelKey, string DescriptionKey)[] NotificationTypes =
    [
        ("FOLLOW", "settings.notif.follow.label", "settings.notif.follow.description"),
        ("COMMENT", "settings.notif.comment.label", "settings.notif.comment.description"),
        ("RATING", "settings.notif.rating.label", "settings.notif.rating.description"),
        ("SHARE", "settings.notif.share.label", "settings.notif.share.description"),
        ("ACTIVITY_RATING", "settings.notif.activityRating.label", "settings.notif.activityRating.description"),
        ("ACTIVITY_RATING_STARS", "settings.notif.activityRatingStars.label", "settings.notif.activityRatingStars.description"),
    ];

    // In-app notifications vs. what the public activity log reveals: same
    // preference store, but different questions for the user.
    private static readonly (string TitleKey, (string Type, string LabelKey, string DescriptionKey)[] Types)[] PreferenceGroups =
    [
        ("settings.notificationsTitle", NotificationTypes[..4]),
        ("settings.privacyTitle", NotificationTypes[4..]),
    ];

    // A miniature page: dark header bar, a card with two text lines and an
    // accent button, all in the preview's own theme tokens.
    private static readonly RenderFragment ThemePreview = @<text><span class="tp-bar"></span><span class="tp-card"><span class="tp-line"></span><span class="tp-line tp-line--short"></span><span class="tp-button"></span></span></text>;

    private string? _currentTheme;
    private NotificationPreferences? _preferences;
    private bool _showShelfCoverText;
    private IJSObjectReference? _shelfCoverTextModule;
    private bool _homeScrollShelf = true;
    private IJSObjectReference? _libraryPreferencesModule;
    private bool _immersive = true;
    private IJSObjectReference? _worldPreferencesModule;

    protected override async Task OnInitializedAsync()
    {
        _currentTheme = await ThemeService.GetThemeAsync();
        var response = await ApiClient.GetAsync<NotificationPreferences>("/api/notifications/preferences");
        _preferences = response is { Success: true, Data: not null } ? response.Data : new NotificationPreferences();

        _shelfCoverTextModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/shelfCoverText.js");
        _showShelfCoverText = await _shelfCoverTextModule.InvokeAsync<bool>("getShowCoverText");

        // Loaded whatever the theme, so the switch is right the moment the
        // Alexandria card is picked. null = never chosen: on.
        _libraryPreferencesModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
        _homeScrollShelf = await _libraryPreferencesModule.InvokeAsync<bool?>("getHomeScrollShelf") ?? true;

        // Same: right the moment a world theme is picked. null = never chosen: on.
        _worldPreferencesModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/worldPreferences.js");
        _immersive = await _worldPreferencesModule.InvokeAsync<bool?>("getImmersive") ?? true;
    }

    private async Task SetImmersiveAsync(bool immersive)
    {
        _immersive = immersive;
        _worldPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/worldPreferences.js");
        await _worldPreferencesModule.InvokeVoidAsync("setImmersive", immersive);
    }

    private async Task SetHomeScrollShelfAsync(bool show)
    {
        _homeScrollShelf = show;
        _libraryPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
        await _libraryPreferencesModule.InvokeVoidAsync("setHomeScrollShelf", show);
    }

    private async Task SetShowShelfCoverTextAsync(bool show)
    {
        _showShelfCoverText = show;
        _shelfCoverTextModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/shelfCoverText.js");
        await _shelfCoverTextModule.InvokeVoidAsync("setShowCoverText", show);
    }

    private async Task SetThemeAsync(string theme)
    {
        await ThemeService.SetThemeAsync(theme);
        _currentTheme = theme;
    }

    // Full reload (not an in-place re-render) -- see I18nService's own
    // comment on SetLanguageAsync for why: reactively re-rendering every
    // I18n.T()-using component app-wide would need a cascading-subscription
    // mechanism nothing else in this app has yet, for a switch that happens
    // rarely. NavigationManager.Uri already reflects "settings" (this page),
    // so the reload lands the user back here with the new language applied.
    private async Task SetLanguageAsync(string language)
    {
        // Also stored on the account, so emails (password reset, security
        // notices) are sent in it. Awaited so the reload below can't cut
        // the request off; best effort, a failure doesn't block the switch.
        await ApiClient.PutAsync("/api/users/me/language", new { language });
        await I18n.SetLanguageAsync(language);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private bool GetPreference(string type) => type switch
    {
        "FOLLOW" => _preferences?.Follow ?? true,
        "COMMENT" => _preferences?.Comment ?? true,
        "RATING" => _preferences?.Rating ?? true,
        "SHARE" => _preferences?.Share ?? true,
        "ACTIVITY_RATING" => _preferences?.ActivityRating ?? false,
        "ACTIVITY_RATING_STARS" => _preferences?.ActivityRatingStars ?? false,
        _ => true,
    };

    private async Task SetPreferenceAsync(string type, bool enabled)
    {
        if (_preferences is null) return;
        switch (type)
        {
            case "FOLLOW": _preferences.Follow = enabled; break;
            case "COMMENT": _preferences.Comment = enabled; break;
            case "RATING": _preferences.Rating = enabled; break;
            case "SHARE": _preferences.Share = enabled; break;
            case "ACTIVITY_RATING": _preferences.ActivityRating = enabled; break;
            case "ACTIVITY_RATING_STARS": _preferences.ActivityRatingStars = enabled; break;
        }
        await ApiClient.PutAsync("/api/notifications/preferences", new { type, enabled });
    }
}
