@page "/settings"
@using LuminaChronica.Client.Services
@inject IThemeService ThemeService

<PageTitle>Einstellungen — Lumina Chronica</PageTitle>

<h1>Einstellungen</h1>

<h2>Theme</h2>
<div class="theme-picker">
    <button class="btn" @onclick='() => SetThemeAsync("classic-library")'>Classic Library</button>
    <button class="btn" @onclick='() => SetThemeAsync("modern-light")'>Modern Light</button>
    <button class="btn" @onclick='() => SetThemeAsync("dark-library")'>Dark Library</button>
    <button class="btn" @onclick='() => SetThemeAsync("system")'>System</button>
</div>

@code {
    private async Task SetThemeAsync(string theme) => await ThemeService.SetThemeAsync(theme);
}
