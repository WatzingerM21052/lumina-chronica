@page "/settings"
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject IThemeService ThemeService
@inject ApiClient ApiClient

<PageTitle>Einstellungen — Lumina Chronica</PageTitle>

<h1>Einstellungen</h1>

<h2>Theme</h2>
<div class="theme-picker">
    @foreach (var (value, label) in Themes)
    {
        <button class="btn @(_currentTheme == value ? "btn-primary" : "")" @onclick="() => SetThemeAsync(value)">@label</button>
    }
</div>

<h2>Benachrichtigungen</h2>
@if (_preferences is null)
{
    <p class="text-muted">Lade …</p>
}
else
{
    <div class="notification-preferences">
        @foreach (var (type, label, description) in NotificationTypes)
        {
            <label class="notification-preference-row">
                <input type="checkbox" checked="@GetPreference(type)" @onchange="e => SetPreferenceAsync(type, (bool)e.Value!)" />
                <span>
                    <strong>@label</strong>
                    <span class="text-muted"> — @description</span>
                </span>
            </label>
        }
    </div>
}

@code {
    private static readonly (string Value, string Label)[] Themes =
    [
        ("classic-library", "Classic Library"),
        ("modern-light", "Modern Light"),
        ("dark-library", "Dark Library"),
        ("system", "System"),
    ];

    // (preference type, label, description) -- FOLLOW/COMMENT/RATING/SHARE
    // gate an in-app notification; ACTIVITY_RATING gates whether a rating
    // shows up in the profile's own "Aktivitäten" log at all (added via
    // AskUserQuestion, 2026-08-08, since RATING_GIVEN is the first activity
    // entry that reveals a specific action rather than restating something
    // already public).
    private static readonly (string Type, string Label, string Description)[] NotificationTypes =
    [
        ("FOLLOW", "Neuer Follower", "Wenn dir jemand folgt"),
        ("COMMENT", "Neuer Kommentar", "Wenn jemand dein Buch oder Projekt kommentiert"),
        ("RATING", "Neue Bewertung", "Wenn jemand dein Buch bewertet"),
        ("SHARE", "Buch geteilt", "Wenn dir ein Buch freigegeben wird"),
        ("ACTIVITY_RATING", "Eigene Bewertungen im Aktivitäten-Log", "Ob deine eigenen Bewertungen in deinem öffentlichen Profil auftauchen"),
    ];

    private string? _currentTheme;
    private NotificationPreferences? _preferences;

    protected override async Task OnInitializedAsync()
    {
        _currentTheme = await ThemeService.GetThemeAsync();
        var response = await ApiClient.GetAsync<NotificationPreferences>("/api/notifications/preferences");
        _preferences = response is { Success: true, Data: not null } ? response.Data : new NotificationPreferences();
    }

    private async Task SetThemeAsync(string theme)
    {
        await ThemeService.SetThemeAsync(theme);
        _currentTheme = theme;
    }

    private bool GetPreference(string type) => type switch
    {
        "FOLLOW" => _preferences?.Follow ?? true,
        "COMMENT" => _preferences?.Comment ?? true,
        "RATING" => _preferences?.Rating ?? true,
        "SHARE" => _preferences?.Share ?? true,
        "ACTIVITY_RATING" => _preferences?.ActivityRating ?? true,
        _ => true,
    };

    private async Task SetPreferenceAsync(string type, bool enabled)
    {
        if (_preferences is null) return;
        switch (type)
        {
            case "FOLLOW": _preferences.Follow = enabled; break;
            case "COMMENT": _preferences.Comment = enabled; break;
            case "RATING": _preferences.Rating = enabled; break;
            case "SHARE": _preferences.Share = enabled; break;
            case "ACTIVITY_RATING": _preferences.ActivityRating = enabled; break;
        }
        await ApiClient.PutAsync("/api/notifications/preferences", new { type, enabled });
    }
}
