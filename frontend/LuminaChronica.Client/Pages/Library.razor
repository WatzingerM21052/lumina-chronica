@page "/library"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Bibliothek — Lumina Chronica</PageTitle>

<div class="library-header">
    <h1>Bibliothek</h1>
    <div class="form-actions">
        <a class="btn" href="library/shelves">Regale</a>
        <a class="btn btn-primary" href="library/upload">Buch hinzufügen</a>
    </div>
</div>

<div class="library-toolbar">
    <div class="library-search-wrapper">
        <input type="search" placeholder="Titel oder Autor suchen..." value="@_searchTerm" @oninput="OnSearchInput" />
        @if (_suggestions is { Count: > 0 })
        {
            <ul class="library-search-suggestions">
                @foreach (var book in _suggestions)
                {
                    <li>
                        <button type="button" @onclick="() => GoToBook(book.Id)">
                            @book.Title
                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <span class="text-muted"> — @book.Author</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <MultiSelectDropdown Label="Genre" Options="@(_facets?.Genres ?? [])" SelectedValues="_genreFilters" SelectedValuesChanged="OnGenreFiltersChanged" />
    <MultiSelectDropdown Label="Tag" Options="@(_facets?.Tags ?? [])" SelectedValues="_tagFilters" SelectedValuesChanged="OnTagFiltersChanged" />

    <select @bind="_sort" @bind:after="ApplyFiltersAsync">
        <option value="createdAt">Hinzugefügt</option>
        <option value="title">Titel</option>
        <option value="author">Autor</option>
    </select>
    <select @bind="_order" @bind:after="ApplyFiltersAsync">
        <option value="desc">Absteigend</option>
        <option value="asc">Aufsteigend</option>
    </select>

    <label class="library-favorite-filter">
        <input type="checkbox" @bind="_favoritesOnly" @bind:after="ApplyFiltersAsync" />
        Nur Favoriten
    </label>

    <button type="button" class="btn" @onclick="ClearFiltersAsync">Filter zurücksetzen</button>

    <div class="library-view-toggle">
        <button type="button" class="btn @(_viewMode == LibraryViewMode.Grid ? "btn-primary" : "")" @onclick='() => SetViewMode(LibraryViewMode.Grid)'>Raster</button>
        <button type="button" class="btn @(_viewMode == LibraryViewMode.List ? "btn-primary" : "")" @onclick='() => SetViewMode(LibraryViewMode.List)'>Liste</button>
    </div>
</div>

@if (_errorMessage is not null)
{
    <p class="form-error">@_errorMessage</p>
}
else if (_result is null)
{
    <LoadingIndicator Text="Bibliothek wird geladen..." />
}
else if (_result.Total == 0 && !HasActiveFilters)
{
    <EmptyState Message="Deine Bibliothek ist noch leer. Füge dein erstes Buch hinzu und beginne deine Sammlung."
                ActionText="Buch hinzufügen"
                OnAction="GoToUpload" />
}
else if (_result.Items.Count == 0)
{
    <p class="text-muted">Keine Bücher gefunden.</p>
}
else
{
    <div class="@(_viewMode == LibraryViewMode.Grid ? "library-grid" : "library-list")">
        @foreach (var book in _result.Items)
        {
            <BookCard Book="book" Size="@(_viewMode == LibraryViewMode.Grid ? BookCardSize.Normal : BookCardSize.Small)" />
        }
    </div>

    @if (_result.Total > _result.PageSize)
    {
        <div class="library-pager">
            <button type="button" class="btn" disabled="@(_result.Page <= 1)" @onclick="() => GoToPageAsync(_result.Page - 1)">← Zurück</button>
            <span>Seite @_result.Page von @PageCount</span>
            <button type="button" class="btn" disabled="@(_result.Page >= PageCount)" @onclick="() => GoToPageAsync(_result.Page + 1)">Weiter →</button>
        </div>
    }
}

@code {
    private enum LibraryViewMode { Grid, List }

    private const int PageSize = 20;

    private BookListResponse? _result;
    private BookFacets? _facets;
    private List<Book>? _suggestions;
    private string? _errorMessage;
    private LibraryViewMode _viewMode = LibraryViewMode.Grid;

    private string _searchTerm = string.Empty;
    private IReadOnlyList<string> _genreFilters = [];
    private IReadOnlyList<string> _tagFilters = [];
    private bool _favoritesOnly;
    private string _sort = "createdAt";
    private string _order = "desc";
    private int _page = 1;

    private System.Threading.Timer? _searchDebounceTimer;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchTerm) || _genreFilters.Count > 0 || _tagFilters.Count > 0 || _favoritesOnly;

    private int PageCount => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling((double)_result.Total / _result.PageSize));

    protected override async Task OnInitializedAsync()
    {
        // Supports deep-linking from a tag link on Book Detail (library?tag=X).
        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts[0] == "tag" && parts.Length == 2)
            {
                _tagFilters = [Uri.UnescapeDataString(parts[1])];
            }
        }

        var facetsResponse = await ApiClient.GetAsync<BookFacets>("/api/books/facets");
        if (facetsResponse is { Success: true, Data: not null })
        {
            _facets = facetsResponse.Data;
        }

        await LoadBooksAsync();
    }

    private void SetViewMode(LibraryViewMode mode) => _viewMode = mode;

    private void GoToUpload() => NavigationManager.NavigateTo("library/upload");

    private void GoToBook(int id)
    {
        _suggestions = null;
        NavigationManager.NavigateTo($"library/books/{id}");
    }

    private async Task OnGenreFiltersChanged(IReadOnlyList<string> values)
    {
        _genreFilters = values;
        await ApplyFiltersAsync();
    }

    private async Task OnTagFiltersChanged(IReadOnlyList<string> values)
    {
        _tagFilters = values;
        await ApplyFiltersAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () =>
            {
                await LoadSuggestionsAsync();
                await ApplyFiltersAsync();
                // Unlike handlers invoked directly from Blazor's own event
                // pipeline (@onclick, @bind:after), a callback reached via
                // InvokeAsync from a System.Threading.Timer does not
                // automatically trigger a re-render afterwards in a real
                // browser -- without this, the fetched data updates but the
                // UI never reflects it. Confirmed missing via live testing;
                // bUnit's test renderer does not reproduce this gap, so no
                // automated test catches it -- see LibraryPageTests.cs.
                StateHasChanged();
            }),
            null,
            400,
            Timeout.Infinite);
    }

    private async Task LoadSuggestionsAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _suggestions = null;
            return;
        }

        var response = await ApiClient.GetAsync<BookListResponse>($"/api/books?search={Uri.EscapeDataString(_searchTerm)}&pageSize=8");
        _suggestions = response is { Success: true, Data: not null } ? response.Data.Items : null;
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = string.Empty;
        _genreFilters = [];
        _tagFilters = [];
        _favoritesOnly = false;
        _suggestions = null;
        await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync()
    {
        _page = 1;
        return LoadBooksAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        _errorMessage = null;

        var query = new List<string> { $"sort={_sort}", $"order={_order}", $"page={_page}", $"pageSize={PageSize}" };
        if (!string.IsNullOrWhiteSpace(_searchTerm)) query.Add($"search={Uri.EscapeDataString(_searchTerm)}");
        if (_genreFilters.Count > 0) query.Add($"genre={Uri.EscapeDataString(string.Join(",", _genreFilters))}");
        if (_tagFilters.Count > 0) query.Add($"tag={Uri.EscapeDataString(string.Join(",", _tagFilters))}");
        if (_favoritesOnly) query.Add("favorite=true");

        var response = await ApiClient.GetAsync<BookListResponse>($"/api/books?{string.Join('&', query)}");
        if (response is { Success: true, Data: not null })
        {
            _result = response.Data;
        }
        else
        {
            _errorMessage = response?.Error?.Message ?? "Bibliothek konnte nicht geladen werden.";
        }
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
    }
}
