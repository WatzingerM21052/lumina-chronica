@page "/library"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using LuminaChronica.Client.Components
@using LuminaChronica.Client.Models
@using LuminaChronica.Client.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject II18nService I18n
@inject TimeProvider TimeProvider

<PageTitle>@I18n.T("library.title") — Lumina Chronica</PageTitle>

@* Shared page header (design audit F1): title left, actions right. *@
<div class="page-header">
    <h1>@I18n.T("library.title")</h1>
    <div class="form-actions">
        <a class="btn" href="library/shelves">@I18n.T("library.shelvesLink")</a>
        <a class="btn btn-primary" href="library/upload">@I18n.T("library.addBookLink")</a>
    </div>
</div>


@* Compact toolbar (plan F9, user feedback: fewer controls, icons where a
   word isn't needed): one row -- search, a "Filter" toggle that folds the
   genre/tag/favourite filters out underneath, sort, the view as two icon
   buttons, and the view's size/page setting. Labels that were visible
   text are now aria-labels/titles. *@
<div class="library-toolbar">
    <div class="library-toolbar-row">
        <SearchInput Class="library-search-wrapper" Placeholder="@I18n.T("library.searchPlaceholder")" Value="@_searchTerm" OnInput="OnSearchInput">
            @if (_suggestions is { Count: > 0 })
            {
                <ul class="library-search-suggestions">
                    @foreach (var book in _suggestions)
                    {
                        <li>
                            <button type="button" @onclick="() => GoToBook(book.Id)">
                                @book.Title
                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <span class="text-muted"> — @book.Author</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </SearchInput>

        <button type="button" id="library-filter-toggle" class="btn library-filter-toggle @(ActiveFilterCount > 0 ? "has-active" : null)"
                aria-expanded="@(_filtersOpen ? "true" : "false")" aria-controls="library-filter-panel"
                @onclick="() => _filtersOpen = !_filtersOpen">
            <Icon Name="filter" />
            <span>@I18n.T("library.filterGroupLabel")</span>
            @if (ActiveFilterCount > 0)
            {
                <span class="library-filter-count">@ActiveFilterCount</span>
            }
        </button>

        <div class="library-sort">
            <select class="library-sort-field" aria-label="@I18n.T("library.sortLabel")" title="@I18n.T("library.sortLabel")"
                    @bind="_sort" @bind:after="ApplyFiltersAsync">
                <option value="createdAt">@I18n.T("library.sortCreatedAt")</option>
                <option value="title">@I18n.T("library.sortTitle")</option>
                <option value="author">@I18n.T("library.sortAuthor")</option>
                <option value="genre">@I18n.T("library.sortGenre")</option>
            </select>
            @{
                var orderLabel = I18n.T(_order == "desc" ? "library.orderDesc" : "library.orderAsc");
            }
            <button type="button" class="btn library-sort-order" @onclick="ToggleOrderAsync"
                    aria-label="@string.Format(I18n.T("library.orderToggleLabel"), orderLabel)" title="@orderLabel">
                <Icon Name="@(_order == "desc" ? "sort-desc" : "sort-asc")" />
            </button>
        </div>

        <div class="library-view-settings" role="group" aria-label="@I18n.T("library.viewGroupLabel")">
            @* Raster first and default (user request); icon buttons, the
               name lives in aria-label + tooltip. *@
            <div class="library-view-toggle segmented">
                <button type="button" id="view-raster" class="segmented-option segmented-option--icon @(_viewMode == LibraryViewMode.List ? "is-selected" : "")"
                        aria-pressed="@(_viewMode == LibraryViewMode.List ? "true" : "false")"
                        aria-label="@I18n.T("library.viewModeRaster")" title="@I18n.T("library.viewModeRaster")"
                        @onclick='() => SetViewMode(LibraryViewMode.List)'><Icon Name="grid" /></button>
                <button type="button" id="view-shelf" class="segmented-option segmented-option--icon @(_viewMode == LibraryViewMode.Grid ? "is-selected" : "")"
                        aria-pressed="@(_viewMode == LibraryViewMode.Grid ? "true" : "false")"
                        aria-label="@I18n.T("library.viewModeShelf")" title="@I18n.T("library.viewModeShelf")"
                        @onclick='() => SetViewMode(LibraryViewMode.Grid)'><Icon Name="shelf" /></button>
            </div>
            @if (_viewMode == LibraryViewMode.Grid)
            {
                <select class="library-shelf-book-zoom" aria-label="@I18n.T("library.bookSizeLabel")" title="@I18n.T("library.bookSizeLabel")"
                        @bind="_shelfBookZoom" @bind:after="OnShelfBookZoomChangedAsync">
                    @foreach (var zoom in ShelfBookZoomOptions)
                    {
                        <option value="@zoom">@ShelfBookZoomLabel(zoom)</option>
                    }
                </select>
            }
            @if (_viewMode == LibraryViewMode.List)
            {
                <select class="library-raster-page-size" aria-label="@I18n.T("library.pageSizeLabel")" title="@I18n.T("library.pageSizeLabel")"
                        @bind="_rasterPageSize" @bind:after="OnRasterPageSizeChangedAsync">
                    @foreach (var size in RasterPageSizeOptions)
                    {
                        <option value="@size">@string.Format(I18n.T("library.pageSizeOption"), size)</option>
                    }
                </select>
            }
        </div>
    </div>

    @if (_filtersOpen)
    {
        <div class="library-filters" id="library-filter-panel" role="group" aria-label="@I18n.T("library.filterGroupLabel")">
            <MultiSelectDropdown Label="@I18n.T("library.genreLabel")" Options="@(_facets?.Genres ?? [])" SelectedValues="_genreFilters" SelectedValuesChanged="OnGenreFiltersChanged" />
            <MultiSelectDropdown Label="@I18n.T("library.tagLabel")" Options="@(_facets?.Tags ?? [])" SelectedValues="_tagFilters" SelectedValuesChanged="OnTagFiltersChanged" />
            <label class="library-favorite-filter @(_favoritesOnly ? "is-active" : "")">
                <input type="checkbox" @bind="_favoritesOnly" @bind:after="ApplyFiltersAsync" />
                @I18n.T("library.favoritesOnlyLabel")
            </label>
            @if (HasActiveFilters)
            {
                <button type="button" class="btn-link library-clear-filters" @onclick="ClearFiltersAsync">@I18n.T("library.clearFiltersButton")</button>
            }
        </div>
    }
</div>

@if (_errorMessage is not null)
{
    <p class="form-error">@_errorMessage</p>
}
else if (_allItems is null)
{
    <LoadingIndicator Mode="LoadingIndicatorMode.Page" Text="@I18n.T("library.loading")" />
}
else if (_allItems.Count == 0 && !HasActiveFilters)
{
    <EmptyState Message="@I18n.T("library.emptyMessage")"
                ActionText="@I18n.T("library.addBookLink")"
                ActionHref="library/upload" />
}
else if (_allItems.Count == 0)
{
    @* No dead end (plan A6): the way back sits right under the message. *@
    <div class="library-no-results">
        <p class="text-muted">@I18n.T("library.noResultsMessage")</p>
        <button type="button" class="btn" @onclick="ClearFiltersAsync">@I18n.T("library.clearFiltersButton")</button>
    </div>
}
else
{
    @if (_viewMode == LibraryViewMode.Grid)
    {
        var allGroups = LibraryShelfGrouping.Group(_allItems ?? [], _sort, _genreFilters, _tagFilters, new LibraryGroupLabels(
            NoGenre: I18n.T("library.noGenreLabel"),
            ThisWeek: I18n.T("library.thisWeekLabel"),
            ThisMonth: I18n.T("library.thisMonthLabel"),
            ThisYear: I18n.T("library.thisYearLabel"),
            Older: I18n.T("library.olderLabel")));
        var totalBookCount = _allItems?.Count ?? 0;

        <div class="library-shelf" @ref="_shelfRef">
            <div class="shelf-cabinet" style="--shelf-book-zoom: @_shelfBookZoom">
                @foreach (var group in TakeUpToBookCount(allGroups, _visibleBookCount))
                {
                    <ShelfRow @key="group.Label" Label="@group.Label" Books="group.Books" />
                }
            </div>
        </div>
        @if (_visibleBookCount < totalBookCount)
        {
            <div class="shelf-load-more-sentinel" @ref="_loadMoreSentinelRef"></div>
        }
    }
    else
    {
        <div class="library-raster">
            @foreach (var book in (_allItems ?? []).Skip((_rasterPage - 1) * _rasterPageSize).Take(_rasterPageSize))
            {
                <BookCard Book="book" />
            }
        </div>

        @if ((_allItems?.Count ?? 0) > _rasterPageSize)
        {
            <div class="library-pager">
                <button type="button" class="btn" disabled="@(_rasterPage <= 1)" @onclick="() => GoToRasterPage(_rasterPage - 1)">@I18n.T("library.prevPage")</button>
                <span>@string.Format(I18n.T("library.pageOf"), _rasterPage, RasterPageCount)</span>
                <button type="button" class="btn" disabled="@(_rasterPage >= RasterPageCount)" @onclick="() => GoToRasterPage(_rasterPage + 1)">@I18n.T("library.nextPage")</button>
            </div>
        }
    }
}

@code {
    private enum LibraryViewMode { Grid, List }

    private const int FetchPageSize = 100; // backend's MAX_PAGE_SIZE
    private const int DefaultRasterPageSize = 20;

    private List<Book>? _allItems;
    private BookFacets? _facets;
    private List<Book>? _suggestions;
    private string? _errorMessage;
    // Raster (List) is the default view (user request 2026-09-28); the 3D
    // shelf (Grid) is one click away. Note the enum names predate the
    // labels: Grid = "Regal", List = "Raster".
    private LibraryViewMode _viewMode = LibraryViewMode.List;
    private bool _filtersOpen;

    private string _searchTerm = string.Empty;
    private IReadOnlyList<string> _genreFilters = [];
    private IReadOnlyList<string> _tagFilters = [];
    private bool _favoritesOnly;
    private string _sort = "createdAt";
    private string _order = "desc";
    private int _rasterPage = 1;
    private int _rasterPageSize;
    private string _shelfBookZoom = DefaultShelfBookZoom;

    private static readonly int[] RasterPageSizeOptions = [20, 40, 60, 100];
    // Plain invariant strings, not double -- these round-trip through a
    // <select>'s bound value, a CSS custom property, and localStorage; a
    // double field bound via @bind formats/parses using the CURRENT
    // culture (e.g. "1,25" under de-DE), which silently desyncs from the
    // invariant-formatted option values and breaks both display and
    // change-handling. Keeping it a string end-to-end sidesteps that.
    private static readonly string[] ShelfBookZoomOptions = ["1", "1.25", "1.5"];
    private const string DefaultShelfBookZoom = "1";

    private const int InitialVisibleBookCount = 40;
    private const int VisibleBookBatchSize = 40;

    private int _visibleBookCount = InitialVisibleBookCount;
    private ElementReference _loadMoreSentinelRef;
    private DotNetObjectReference<Library>? _dotNetHelper;

    private IJSObjectReference? _libraryPreferencesModule;

    private ITimer? _searchDebounceTimer;

    private ElementReference _shelfRef;
    private IJSObjectReference? _shelfPhysicsModule;
    private bool _shelfPhysicsInitialized;

    private Task ToggleOrderAsync()
    {
        _order = _order == "desc" ? "asc" : "desc";
        return ApplyFiltersAsync();
    }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchTerm) || _genreFilters.Count > 0 || _tagFilters.Count > 0 || _favoritesOnly;

    // Shown on the collapsed "Filter" button, so active filters are visible
    // without opening the panel. The search has its own field.
    private int ActiveFilterCount => _genreFilters.Count + _tagFilters.Count + (_favoritesOnly ? 1 : 0);

    private int RasterPageCount => _allItems is null ? 1 : Math.Max(1, (int)Math.Ceiling((double)_allItems.Count / _rasterPageSize));

    protected override async Task OnInitializedAsync()
    {
        // Supports deep-linking from a tag link on Book Detail (library?tag=X).
        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts[0] == "tag" && parts.Length == 2)
            {
                _tagFilters = [Uri.UnescapeDataString(parts[1])];
                // Arriving with a tag filter: show the panel that holds it.
                _filtersOpen = true;
            }
        }

        _rasterPageSize = await LoadPreferredRasterPageSizeAsync();
        _shelfBookZoom = await LoadPreferredShelfBookZoomAsync();

        var facetsResponse = await ApiClient.GetAsync<BookFacets>("/api/books/facets");
        if (facetsResponse is { Success: true, Data: not null })
        {
            _facets = facetsResponse.Data;
        }

        await LoadAllBooksAsync();
    }

    private async Task<int> LoadPreferredRasterPageSizeAsync()
    {
        try
        {
            _libraryPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
            var stored = await _libraryPreferencesModule.InvokeAsync<int?>("getRasterPageSize");
            return stored.HasValue && RasterPageSizeOptions.Contains(stored.Value) ? stored.Value : DefaultRasterPageSize;
        }
        catch (Exception)
        {
            return DefaultRasterPageSize;
        }
    }

    private async Task SavePreferredRasterPageSizeAsync(int size)
    {
        try
        {
            _libraryPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
            await _libraryPreferencesModule.InvokeVoidAsync("setRasterPageSize", size);
        }
        catch (Exception)
        {
        }
    }

    private async Task OnRasterPageSizeChangedAsync()
    {
        _rasterPage = 1;
        await SavePreferredRasterPageSizeAsync(_rasterPageSize);
    }

    private async Task<string> LoadPreferredShelfBookZoomAsync()
    {
        try
        {
            _libraryPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
            var stored = await _libraryPreferencesModule.InvokeAsync<string?>("getShelfBookZoom");
            return stored is not null && ShelfBookZoomOptions.Contains(stored) ? stored : DefaultShelfBookZoom;
        }
        catch (Exception)
        {
            return DefaultShelfBookZoom;
        }
    }

    private async Task SavePreferredShelfBookZoomAsync(string zoom)
    {
        try
        {
            _libraryPreferencesModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/libraryPreferences.js");
            await _libraryPreferencesModule.InvokeVoidAsync("setShelfBookZoom", zoom);
        }
        catch (Exception)
        {
        }
    }

    private async Task OnShelfBookZoomChangedAsync() => await SavePreferredShelfBookZoomAsync(_shelfBookZoom);

    private string ShelfBookZoomLabel(string zoom) => zoom switch
    {
        "1.5" => I18n.T("library.zoomVeryLarge"),
        "1.25" => I18n.T("library.zoomLarge"),
        _ => I18n.T("library.zoomNormal"),
    };

    // Walks the already-grouped shelf in order, including whole groups until
    // the remaining book budget runs out, then truncates the group that
    // crosses the budget boundary instead of skipping it entirely -- so a
    // partially-revealed shelf compartment grows in place on the next reveal
    // rather than appearing all-or-nothing.
    private static IEnumerable<BookGroup> TakeUpToBookCount(IEnumerable<BookGroup> groups, int bookCount)
    {
        var remaining = bookCount;
        foreach (var group in groups)
        {
            if (remaining <= 0) yield break;

            if (group.Books.Count <= remaining)
            {
                yield return group;
                remaining -= group.Books.Count;
            }
            else
            {
                yield return new BookGroup(group.Label, group.Books.Take(remaining).ToList());
                remaining = 0;
            }
        }
    }

    [JSInvokable]
    public void RevealMoreBooks()
    {
        var total = _allItems?.Count ?? 0;
        _visibleBookCount = Math.Min(_visibleBookCount + VisibleBookBatchSize, total);
        StateHasChanged();
    }

    private bool ShelfIsRendered =>
        _errorMessage is null
        && _allItems is not null
        && !(_allItems.Count == 0 && !HasActiveFilters)
        && _allItems.Count != 0
        && _viewMode == LibraryViewMode.Grid;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ShelfIsRendered)
        {
            // .library-shelf isn't in the DOM right now for any reason (still
            // loading, error, empty result, List view, etc.) -- force re-init
            // next time it reappears, since it may be a new DOM node.
            _shelfPhysicsInitialized = false;
            return;
        }

        if (!_shelfPhysicsInitialized)
        {
            try
            {
                _shelfPhysicsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/shelf-physics.js");
                await _shelfPhysicsModule.InvokeVoidAsync("initShelfPhysics", _shelfRef);
                await _shelfPhysicsModule.InvokeVoidAsync("initShelfTouch", _shelfRef);
                // Re-check rather than unconditionally setting true: a later
                // OnAfterRenderAsync invocation (e.g. a view-mode toggle mid-import)
                // may have already reset this while these awaits were suspended --
                // only claim "initialized" if the shelf is still actually rendered
                // now that we've resumed.
                _shelfPhysicsInitialized = ShelfIsRendered;
            }
            catch (Exception)
            {
            }
        }

        var totalBookCount = _allItems?.Count ?? 0;
        if (_visibleBookCount < totalBookCount)
        {
            try
            {
                _shelfPhysicsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/shelf-physics.js");
                _dotNetHelper ??= DotNetObjectReference.Create(this);
                await _shelfPhysicsModule.InvokeVoidAsync("observeLoadMore", _loadMoreSentinelRef, _dotNetHelper, nameof(RevealMoreBooks));
            }
            catch (Exception)
            {
            }
        }
    }

    private void SetViewMode(LibraryViewMode mode) => _viewMode = mode;

    private void GoToBook(int id)
    {
        _suggestions = null;
        NavigationManager.NavigateTo($"library/books/{id}");
    }

    private async Task OnGenreFiltersChanged(IReadOnlyList<string> values)
    {
        _genreFilters = values;
        await ApplyFiltersAsync();
    }

    private async Task OnTagFiltersChanged(IReadOnlyList<string> values)
    {
        _tagFilters = values;
        await ApplyFiltersAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceTimer?.Dispose();
        // Created through the injected TimeProvider (TimeProvider.System in
        // Program.cs) rather than `new System.Threading.Timer` so bUnit tests
        // can advance a fake clock instead of racing a real 400ms timer
        // against a wall-clock WaitForAssertion timeout.
        _searchDebounceTimer = TimeProvider.CreateTimer(
            _ => InvokeAsync(async () =>
            {
                await LoadSuggestionsAsync();
                await ApplyFiltersAsync();
                // Unlike handlers invoked directly from Blazor's own event
                // pipeline (@onclick, @bind:after), a callback reached via
                // InvokeAsync from a System.Threading.Timer does not
                // automatically trigger a re-render afterwards in a real
                // browser -- without this, the fetched data updates but the
                // UI never reflects it. Confirmed missing via live testing;
                // bUnit's test renderer does not reproduce this gap, so no
                // automated test catches it -- see LibraryPageTests.cs.
                StateHasChanged();
            }),
            null,
            TimeSpan.FromMilliseconds(400),
            Timeout.InfiniteTimeSpan);
    }

    private async Task LoadSuggestionsAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _suggestions = null;
            return;
        }

        var response = await ApiClient.GetAsync<BookListResponse>($"/api/books?search={Uri.EscapeDataString(_searchTerm)}&pageSize=8");
        _suggestions = response is { Success: true, Data: not null } ? response.Data.Items : null;
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = string.Empty;
        _genreFilters = [];
        _tagFilters = [];
        _favoritesOnly = false;
        _suggestions = null;
        await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync() => LoadAllBooksAsync();

    private void GoToRasterPage(int page)
    {
        _rasterPage = page;
    }

    private async Task LoadAllBooksAsync()
    {
        _errorMessage = null;

        var query = new List<string> { $"sort={_sort}", $"order={_order}", $"pageSize={FetchPageSize}" };
        if (!string.IsNullOrWhiteSpace(_searchTerm)) query.Add($"search={Uri.EscapeDataString(_searchTerm)}");
        if (_genreFilters.Count > 0) query.Add($"genre={Uri.EscapeDataString(string.Join(",", _genreFilters))}");
        if (_tagFilters.Count > 0) query.Add($"tag={Uri.EscapeDataString(string.Join(",", _tagFilters))}");
        if (_favoritesOnly) query.Add("favorite=true");

        var items = new List<Book>();
        var page = 1;
        while (true)
        {
            var response = await ApiClient.GetAsync<BookListResponse>($"/api/books?{string.Join('&', query)}&page={page}");
            if (response is not { Success: true, Data: not null })
            {
                _errorMessage = response?.Error?.Message ?? I18n.T("library.loadError");
                return;
            }

            items.AddRange(response.Data.Items);

            // Stop once we've collected everything the server says exists, or
            // if a page ever comes back empty despite Total not being reached
            // yet -- the latter guards against an infinite loop if the server
            // and its own reported Total ever disagree.
            if (items.Count >= response.Data.Total || response.Data.Items.Count == 0)
            {
                break;
            }

            page++;
        }

        // Dedupe by Id before assigning: a backend page query with no
        // secondary sort-key tiebreaker could in principle return the same
        // row across two page fetches if the primary sort column ties,
        // which would otherwise violate ShelfRow's @key="book.Id"
        // uniqueness within a shelf group.
        _allItems = items.DistinctBy(b => b.Id).ToList();

        // Reset only on success, together with _allItems, and only here --
        // not at the top of this method -- so a reload keeps showing the
        // previous results (and the previous reveal/page position) for as
        // long as the new fetch is in flight, and only snaps back to the
        // initial batch/page once the new result set is actually what's
        // about to be shown. On failure (the early return above), none of
        // this runs, leaving whatever was already on screen untouched.
        _rasterPage = 1;
        _visibleBookCount = InitialVisibleBookCount;
    }

    public async ValueTask DisposeAsync()
    {
        _searchDebounceTimer?.Dispose();

        if (_shelfPhysicsModule is not null)
        {
            try
            {
                await _shelfPhysicsModule.InvokeVoidAsync("disconnectLoadMore");
                await _shelfPhysicsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetHelper?.Dispose();

        if (_libraryPreferencesModule is not null)
        {
            try
            {
                await _libraryPreferencesModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
